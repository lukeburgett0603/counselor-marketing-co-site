# Copy to .env for local dev. In production these are set as GitHub Actions
# repo secrets (Settings -> Secrets and variables -> Actions) with the same
# names, since the build step needs them to fetch content from Supabase.
#
# The anon key is safe to expose (it's what ships in the built site's JS for
# the lead-capture form) as long as Row Level Security policies are applied
# per supabase/migrations/0001_init.sql — never use the service_role key here.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Required by Unsplash's API guidelines for attribution links on any photo
# sourced through their API (see OptimizedImage.astro). This identifies the
# Unsplash *Application* registered on unsplash.com/oauth/applications, not
# this client's business name — if one Unsplash app is reused to source
# images across every client site built from this template, this is the
# same value in every client's .env, not a per-client name.
PUBLIC_UNSPLASH_APP_NAME=
