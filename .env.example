# Copy to .env for local dev. In production these are set as GitHub Actions
# repo secrets (Settings -> Secrets and variables -> Actions) with the same
# names, since the build step needs them to fetch content from Supabase.
#
# The anon key is safe to expose (it's what ships in the built site's JS for
# the lead-capture form) as long as Row Level Security policies are applied
# per supabase/migrations/0001_init.sql — never use the service_role key here.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
