---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
import LeadGenerator from '../components/LeadGenerator.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import StatusPill from '../components/StatusPill.astro';
import TelehealthPill from '../components/TelehealthPill.astro';
import SpecialtyPills from '../components/SpecialtyPills.astro';
import { renderCopy } from '../lib/markdown';
import { withBase } from '../lib/url';
import { getCounselorOptions } from '../lib/pages';
import type { Page, Business } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;
const counselors = getCounselorOptions(allPages);

// Same self-maintaining pattern as Services Overview / Who We Serve /
// Service Areas Overview — a new counselor shows up here automatically
// the moment their profile page exists, nothing to manually curate.
const counselorPages = allPages
  .filter((p) => p.page_type === 'Counselor Profile')
  .sort((a, b) => a.nav_order - b.nav_order);
---

<BaseLayout page={page} allPages={allPages} business={business}>
  <Hero
    h1={page.h1 ?? page.title}
    imageUrl={page.images.hero?.url}
    imageAlt={page.images.hero?.alt}
    imageCreditName={page.images.hero?.creditName}
    imageCreditUrl={page.images.hero?.creditUrl}
    imageFocalY={page.hero_image_focal_y}
    compact
  />
  {counselorPages.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-10">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {counselorPages.map((counselor) => (
          <a
            href={withBase(`/${counselor.slug}`)}
            class="block rounded-lg border border-slate-200 p-6 text-center hover:border-brand-primary hover:shadow-md"
          >
            {counselor.images.headshot && (
              <img
                src={counselor.images.headshot.url}
                alt={counselor.images.headshot.alt}
                class="avatar-crop mx-auto mb-3 h-24 w-24 rounded-full object-cover"
              />
            )}
            <h3 class="font-[family-name:var(--font-heading)] text-lg font-bold text-brand-ink">
              {counselor.title}
            </h3>
            {counselor.credentials && <p class="mt-1 text-sm text-brand-primary">{counselor.credentials}</p>}
            {counselor.license_number && (
              <p class="mt-0.5 text-xs text-slate-500">License #{counselor.license_number}</p>
            )}
            {(counselor.availability_status || counselor.telehealth_available) && (
              <div class="mt-2 flex flex-wrap justify-center gap-1.5">
                <StatusPill status={counselor.availability_status} />
                <TelehealthPill telehealthAvailable={counselor.telehealth_available} />
              </div>
            )}
            {counselor.meta_description && (
              <p class="mt-2 text-sm text-slate-600">{counselor.meta_description}</p>
            )}
            {counselor.specialties.length > 0 && (
              <div class="mt-3">
                <SpecialtyPills specialties={counselor.specialties} linkable={false} centered />
              </div>
            )}
          </a>
        ))}
      </div>
    </section>
  )}
  <Section>
    <Fragment set:html={renderCopy(page.copy)} />
  </Section>
  <CTA heading={page.cta_heading ?? 'Not sure who to pick?'} subheading={page.cta_subheading} buttonText={page.cta_button_text ?? undefined} />
  <LeadMagnet pageId={page.id} turnstileSiteKey={business.cloudflare_turnstile_site_key} />
  <LeadGenerator
    slug={page.slug}
    heading={page.cta_button_text ?? undefined}
    submitText={page.cta_button_text ?? undefined}
    collectWebsiteUrl={business.collect_website_in_leads}
    responseTimeNote={business.lead_response_time_note}
    turnstileSiteKey={business.cloudflare_turnstile_site_key}
    collectCounselorPreference={business.collect_counselor_preference}
    collectSessionFormat={business.collect_session_format_preference}
    counselors={counselors}
  />
</BaseLayout>
