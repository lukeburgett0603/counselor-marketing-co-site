---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import TableOfContents from '../components/TableOfContents.astro';
import CTA from '../components/CTA.astro';
import LeadGenerator from '../components/LeadGenerator.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { renderCopy, extractTableOfContents } from '../lib/markdown';
import { withBase } from '../lib/url';
import { getCounselorOptions } from '../lib/pages';
import type { Page, Business } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;
const counselors = getCounselorOptions(allPages);

// The hub page whose `category` matches this post's — used for the
// "back to [category]" link so a spoke post links back to its pillar,
// same as the pillar links out to its spokes (BlogPreview.astro).
// Both 'Content Pillar' and 'Service Hub' can own a category (see
// CLAUDE.md's "Service Hub" section) — a client whose categories are
// all Service Hub pages (e.g. Freedom Counseling Services) would
// otherwise never get a working back-link on any of its blog posts.
const hubPage = page.category
  ? allPages.find(
      (p) => (p.page_type === 'Content Pillar' || p.page_type === 'Service Hub') && p.category === page.category
    )
  : undefined;

// Sticky "On this page" list beside the body (the post's ### sections,
// whose ids come from renderCopy), as on hub pages (ContentPillar.astro).
const tocItems = extractTableOfContents(page.copy);

const publishedDate = page.date_published
  ? new Date(page.date_published).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<BaseLayout page={page} allPages={allPages} business={business}>
  <Hero
    h1={page.h1 ?? page.title}
    imageUrl={page.images.hero?.url}
    imageAlt={page.images.hero?.alt}
    imageCreditName={page.images.hero?.creditName}
    imageCreditUrl={page.images.hero?.creditUrl}
    imageFocalY={page.hero_image_focal_y}
    compact
  />
  <div class="mx-auto max-w-3xl px-6 pt-6 text-sm text-slate-500">
    {page.author_name && (
      <span>By {page.author_name}{page.credentials && <>, {page.credentials}</>}</span>
    )}
    {page.author_name && (publishedDate || page.category) && <span> &middot; </span>}
    {publishedDate && <span>{publishedDate}</span>}
    {publishedDate && page.category && <span> &middot; </span>}
    {page.category && hubPage && (
      <a href={withBase(`/${hubPage.slug}`)} class="text-brand-primary hover:underline">{page.category}</a>
    )}
    {page.category && !hubPage && <span>{page.category}</span>}
  </div>
  <div class="mx-auto max-w-3xl px-6 pt-6">
    <KeyTakeaways items={page.key_takeaways} />
  </div>
  {tocItems.length > 1 && (
    <details class="mx-auto mb-2 max-w-3xl rounded-lg border border-slate-200 px-6 py-3 lg:hidden">
      <summary class="cursor-pointer font-semibold">In this article</summary>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm">
        {tocItems.map((item) => <li><a href={`#${item.id}`} class="text-slate-700 hover:underline">{item.text}</a></li>)}
      </ol>
    </details>
  )}
  <div class:list={['mx-auto grid grid-cols-1 gap-10 px-6 pb-10 pt-4', tocItems.length > 1 ? 'max-w-5xl lg:grid-cols-[220px_1fr]' : 'max-w-3xl']}>
    <TableOfContents items={tocItems} />
    <article class="prose prose-lg">
      <Fragment set:html={renderCopy(page.copy)} />
    </article>
  </div>
  <CTA heading={page.cta_heading ?? `Want help from ${business.display_name}?`} subheading={page.cta_subheading} buttonText={page.cta_button_text ?? undefined} />
  <LeadMagnet pageId={page.id} turnstileSiteKey={business.cloudflare_turnstile_site_key} />
  <LeadGenerator
    slug={page.slug}
    heading={page.cta_button_text ?? undefined}
    submitText={page.cta_button_text ?? undefined}
    collectWebsiteUrl={business.collect_website_in_leads}
    responseTimeNote={business.lead_response_time_note}
    turnstileSiteKey={business.cloudflare_turnstile_site_key}
    collectCounselorPreference={business.collect_counselor_preference}
    collectSessionFormat={business.collect_session_format_preference}
    counselors={counselors}
  />
</BaseLayout>
