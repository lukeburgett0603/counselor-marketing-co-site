---
// Pages still stored in Supabase after the 2026-09-30 rebuild (topic hubs,
// blog posts, the blog index, legal pages), rendered in the new design.
// Everything else on the public site is authored in src/pages/.
import SiteLayout from '../layouts/SiteLayout.astro';
import Faq from '../components/site/Faq.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Ph from '../components/site/Ph.astro';
import { renderCopy, extractTableOfContents } from '../lib/markdown';
import { withBase } from '../lib/url';
import { article, webPage } from '../lib/siteSchema';
import type { Page } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
}
const { page, allPages } = Astro.props;

const siteUrl = new URL(withBase('/'), Astro.site ?? Astro.url).toString().replace(/\/$/, '');
const path = `/${page.slug}`;
const title = page.meta_title ?? page.title;
const description = page.meta_description ?? '';
const h1 = page.h1 ?? page.title;
const isArticle = page.page_type === 'Content Pillar' || page.page_type === 'Blog Post';
const isLegal = page.page_type === 'Other';
const isIndex = page.page_type === 'Blog Index';
const faqs = (page.faqs ?? []).map((f) => ({ q: f.question, a: f.answer }));
const toc = isArticle ? extractTableOfContents(page.copy) : [];
const fmt = (d: string | null) => (d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : null);
const updated = fmt(page.date_modified ?? page.date_published);

const hubs = allPages.filter((p) => p.page_type === 'Content Pillar' && p.category);
const posts = allPages
  .filter((p) => p.page_type === 'Blog Post')
  .sort((a, b) => (b.date_published ?? '').localeCompare(a.date_published ?? ''));
const categoryPosts = page.category ? posts.filter((p) => p.category === page.category && p.slug !== page.slug) : [];
const parentHub = page.page_type === 'Blog Post' ? hubs.find((h) => h.category === page.category) : undefined;

const crumbs =
  page.page_type === 'Blog Post'
    ? [{ name: 'Resources', path: '/blog' }, ...(parentHub ? [{ name: parentHub.title, path: `/${parentHub.slug}` }] : []), { name: page.title, path }]
    : page.page_type === 'Content Pillar'
      ? [{ name: 'Resources', path: '/blog' }, { name: page.title, path }]
      : [{ name: page.title, path }];

const schema = isArticle
  ? [
      article(siteUrl, {
        headline: h1,
        description,
        path,
        datePublished: page.date_published ?? page.date_modified ?? '2026-08-29',
        dateModified: page.date_modified ?? undefined,
        image: page.images?.hero?.url,
        type: page.page_type === 'Blog Post' ? 'BlogPosting' : 'Article',
      }),
    ]
  : [webPage(siteUrl, { name: title, description, path })];
---

<SiteLayout title={title} description={description} path={path} crumbs={crumbs} schema={schema} faqs={faqs} ogType={isArticle ? 'article' : 'website'} ogImage={page.images?.hero?.url}>
  <section class="wrap pb-10 pt-10 sm:pt-14 lg:pt-16">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href={withBase('/')} class="hover:text-ink">Home</a></li>
        {crumbs.map((c, i) => (
          <li class="flex items-center gap-1.5">
            <Ph name="caret-right" class="size-3 opacity-60" />
            {i === crumbs.length - 1 ? <span aria-current="page" class="text-ink">{c.name}</span> : <a href={withBase(c.path)} class="hover:text-ink">{c.name}</a>}
          </li>
        ))}
      </ol>
    </nav>
    <div class="max-w-3xl">
      {page.category && page.page_type === 'Blog Post' && <p class="mb-4 text-sm font-medium text-accent">{page.category}</p>}
      <h1 class:list={['font-semibold leading-[1.06] tracking-[-0.035em] text-ink', isLegal ? 'text-[clamp(32px,3.6vw,44px)]' : 'text-[clamp(36px,4.4vw,52px)]']}>{h1}</h1>
      {page.hero_subhead && <p class="lede mt-5">{page.hero_subhead}</p>}
      {isArticle && (
        <p class="mt-6 text-sm text-muted">
          By <a href={withBase('/about')} class="font-medium text-ink hover:text-accent">Luke Burgett, LPCA</a>, Licensed Professional Counselor Associate, Kentucky{updated && <> · Updated {updated}</>}
        </p>
      )}
    </div>
  </section>

  {isIndex ? (
    <section class="wrap pb-10">
      {page.copy && <div class="prose prose-site prose-lg max-w-3xl" set:html={renderCopy(page.copy)} />}
      <h2 class="h2 mt-12">Guides and tools</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {[
          { t: 'How to Get More Therapy Clients', d: 'The complete guide to filling your caseload, step by step.', h: '/how-to-get-more-therapy-clients', i: 'compass' },
          { t: 'Caseload Calculator', d: 'See your open spots and what filling them is worth.', h: '/caseload-calculator', i: 'calculator' },
          { t: 'Compare your options', d: 'Website builders, directories, platforms, and agencies, compared honestly.', h: '/compare', i: 'scales' },
        ].map((g) => (
          <li>
            <a href={withBase(g.h)} class="card block h-full p-6 transition-colors hover:border-accent">
              <Ph name={g.i} class="size-6 text-accent" />
              <p class="h3 mt-4">{g.t}</p>
              <p class="mt-1.5 text-[15px] text-muted">{g.d}</p>
            </a>
          </li>
        ))}
      </ul>
      <h2 class="h2 mt-16">Topics</h2>
      <ul class="mt-6 divide-y divide-line border-y border-line">
        {hubs.map((h) => (
          <li>
            <a href={withBase(`/${h.slug}`)} class="group flex items-center justify-between gap-6 py-5">
              <span>
                <span class="h3 block group-hover:text-accent">{h.title}</span>
                {h.meta_description && <span class="mt-1 block max-w-[70ch] text-[15px] text-muted">{h.meta_description}</span>}
              </span>
              <Ph name="arrow-right" class="size-5 text-accent" />
            </a>
          </li>
        ))}
      </ul>
      {posts.length > 0 && (
        <>
          <h2 class="h2 mt-16">Latest articles</h2>
          <ul class="mt-6 grid gap-4 md:grid-cols-2">
            {posts.map((p) => (
              <li>
                <a href={withBase(`/${p.slug}`)} class="card block h-full p-6 transition-colors hover:border-accent">
                  {p.category && <p class="text-sm text-accent">{p.category}</p>}
                  <p class="h3 mt-2">{p.title}</p>
                  {p.meta_description && <p class="mt-1.5 text-[15px] text-muted">{p.meta_description}</p>}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
  ) : (
    <div class:list={['wrap pb-6', toc.length > 2 && 'lg:grid lg:grid-cols-[220px_1fr] lg:gap-14']}>
      {toc.length > 2 && (
        <nav aria-label="On this page" class="hidden lg:block">
          <div class="sticky top-24">
            <p class="text-sm font-medium text-ink">On this page</p>
            <ul class="mt-3 space-y-2 border-l border-line">
              {toc.map((t) => (
                <li><a href={`#${t.id}`} class="-ml-px block border-l border-transparent pl-4 text-sm text-muted hover:border-accent hover:text-ink">{t.text}</a></li>
              ))}
            </ul>
          </div>
        </nav>
      )}
      <div class="max-w-3xl">
        {page.key_takeaways?.length > 0 && (
          <aside class="card mb-10 p-6">
            <p class="font-semibold text-ink">Key takeaways</p>
            <ul class="mt-3 space-y-2">
              {page.key_takeaways.map((k: string) => (
                <li class="flex gap-3 text-muted"><Ph name="check" class="mt-1 size-4 text-accent" />{k}</li>
              ))}
            </ul>
          </aside>
        )}
        <article class="prose prose-site prose-lg max-w-none" set:html={renderCopy(page.copy)} />
        {categoryPosts.length > 0 && (
          <section class="mt-14">
            <h2 class="h2">Related articles</h2>
            <ul class="mt-6 divide-y divide-line border-y border-line">
              {categoryPosts.map((p) => (
                <li><a href={withBase(`/${p.slug}`)} class="link-arrow py-4">{p.title} <Ph name="arrow-right" class="size-4" /></a></li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  )}

  {faqs.length > 0 && <Faq faqs={faqs} />}
  {!isLegal && <CtaBand />}
</SiteLayout>
