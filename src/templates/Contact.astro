---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import LeadGenerator from '../components/LeadGenerator.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { renderCopy } from '../lib/markdown';
import { getCounselorOptions } from '../lib/pages';
import type { Page, Business } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;
const counselors = getCounselorOptions(allPages);
// See Footer.astro's own comment on why this is built as one string —
// same Astro compiler whitespace-collapsing behavior applies here.
const streetLine = [business.street_address, business.street_address_2].filter(Boolean).join(', ');
const fullAddress = streetLine
  ? `${streetLine}, ${business.address_locality} ${business.address_region} ${business.postal_code}`
  : null;
---

<BaseLayout page={page} allPages={allPages} business={business}>
  <section class="mx-auto max-w-2xl px-6 py-14 text-center">
    <h1 class="font-[family-name:var(--font-heading)] text-3xl font-extrabold tracking-tight text-brand-ink">
      {page.h1 ?? page.title}
    </h1>
  </section>
  <Section tight>
    <Fragment set:html={renderCopy(page.copy)} />
  </Section>
  <div class="mx-auto max-w-2xl px-6 pb-6 text-center text-sm text-slate-600">
    {business.telephone && (
      <p>
        Call us: <a href={`tel:${business.telephone.replace(/[^0-9+]/g, '')}`} class="text-brand-primary">{business.telephone}</a>
      </p>
    )}
    {business.email && (
      <p>
        Email: <a href={`mailto:${business.email}`} class="text-brand-primary">{business.email}</a>
      </p>
    )}
    {fullAddress && <p>{fullAddress}</p>}
  </div>
  <LeadMagnet pageId={page.id} turnstileSiteKey={business.cloudflare_turnstile_site_key} />
  <LeadGenerator
    slug={page.slug}
    heading="Send us a message"
    submitText="Send"
    collectWebsiteUrl={business.collect_website_in_leads}
    responseTimeNote={business.lead_response_time_note}
    turnstileSiteKey={business.cloudflare_turnstile_site_key}
    collectCounselorPreference={business.collect_counselor_preference}
    collectSessionFormat={business.collect_session_format_preference}
    counselors={counselors}
  />
</BaseLayout>
