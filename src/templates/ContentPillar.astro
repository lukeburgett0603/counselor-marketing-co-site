---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import BlogPreview from '../components/BlogPreview.astro';
import CTA from '../components/CTA.astro';
import LeadGenerator from '../components/LeadGenerator.astro';
import { renderCopy } from '../lib/markdown';
import { withBase } from '../lib/url';
import type { Page, Business } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;

const relatedPages = allPages.filter((p) => page.internal_links.includes(p.slug));

// Hub-and-spoke: only pages acting as a content hub have `category` set
// (the Case Study, the one other 'Content Pillar' page, doesn't — so this
// is a no-op there). Never invents a category; renders nothing without one.
// Sorted by date_published — a Blog Post row is expected to always set
// this (see frontend-site-builder-supabase's page-templates.md).
const categoryPosts = page.category
  ? allPages
      .filter((p) => p.page_type === 'Blog Post' && p.category === page.category)
      .sort((a, b) => (b.date_published ?? '').localeCompare(a.date_published ?? ''))
  : [];
---

<BaseLayout page={page} allPages={allPages} business={business}>
  <Hero
    h1={page.h1 ?? page.title}
    imageUrl={page.images.hero?.url}
    imageAlt={page.images.hero?.alt}
    imageCreditName={page.images.hero?.creditName}
    imageCreditUrl={page.images.hero?.creditUrl}
    compact
  />
  <article class="prose prose-lg mx-auto max-w-3xl px-6 py-10">
    <Fragment set:html={renderCopy(page.copy)} />
  </article>
  {page.category && <BlogPreview posts={categoryPosts} category={page.category} />}
  {relatedPages.length > 0 && (
    <section class="mx-auto max-w-3xl px-6 pb-10">
      <h2 class="mb-4 font-[family-name:var(--font-heading)] text-xl font-extrabold tracking-tight text-brand-ink">Related</h2>
      <ul class="list-inside list-disc space-y-1">
        {relatedPages.map((related) => (
          <li>
            <a href={withBase(`/${related.slug}`)} class="text-brand-primary hover:underline">{related.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
  <CTA heading={page.cta_heading ?? `Want help from ${business.display_name}?`} buttonText={page.cta_button_text ?? undefined} />
  <LeadGenerator
    slug={page.slug}
    collectWebsiteUrl={business.collect_website_in_leads}
    responseTimeNote={business.lead_response_time_note}
  />
</BaseLayout>
