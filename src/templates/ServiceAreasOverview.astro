---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
import LeadGenerator from '../components/LeadGenerator.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { renderCopy } from '../lib/markdown';
import { withBase } from '../lib/url';
import type { Page, Business } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;

// Same self-maintaining pattern as Services Overview / Who We Serve — a
// new Service Area page shows up here automatically, nothing to manually
// curate. Unlike Service Page, 'Service Area' is already an unambiguous
// page_type on its own, so no extra grouping field is needed here.
const areaPages = allPages
  .filter((p) => p.page_type === 'Service Area')
  .sort((a, b) => a.nav_order - b.nav_order);
---

<BaseLayout page={page} allPages={allPages} business={business}>
  <Hero
    h1={page.h1 ?? page.title}
    imageUrl={page.images.hero?.url}
    imageAlt={page.images.hero?.alt}
    imageCreditName={page.images.hero?.creditName}
    imageCreditUrl={page.images.hero?.creditUrl}
    compact
  />
  {areaPages.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-10">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {areaPages.map((area) => (
          <a
            href={withBase(`/${area.slug}`)}
            class="block rounded-lg border border-slate-200 p-6 hover:border-brand-primary hover:shadow-md"
          >
            <h3 class="font-[family-name:var(--font-heading)] text-lg font-bold text-brand-ink">
              {area.area_served_name ?? area.title}
            </h3>
            {area.meta_description && (
              <p class="mt-2 text-sm text-slate-600">{area.meta_description}</p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}
  <Section>
    <Fragment set:html={renderCopy(page.copy)} />
  </Section>
  <CTA heading={page.cta_heading ?? 'Not sure if we serve your area?'} buttonText={page.cta_button_text ?? undefined} />
  <LeadMagnet pageId={page.id} />
  <LeadGenerator
    slug={page.slug}
    collectWebsiteUrl={business.collect_website_in_leads}
    responseTimeNote={business.lead_response_time_note}
  />
</BaseLayout>
