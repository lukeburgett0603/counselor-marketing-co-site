---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
import LeadGenerator from '../components/LeadGenerator.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { renderCopy } from '../lib/markdown';
import { withBase } from '../lib/url';
import { getCounselorOptions } from '../lib/pages';
import type { Page, Business } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;
const counselors = getCounselorOptions(allPages);

// Fully dynamic, not a manually-curated list on this page — a new
// service shows up here automatically, nothing else to remember to
// update. (The original version drove this off `internal_links` on this
// page specifically; a real bug in production was a new Service Page
// never appearing here because nobody thought to add it to that list.)
//
// Two shapes of "service" both belong here: a plain 'Service Page' with
// service_group = 'deliverable' (CMC-style — narrow, transactional
// services split from audience-segment pages, see WhoWeServe.astro), and
// a 'Service Hub' (see CLAUDE.md's Service Hub section — a bookable
// service that's also a content hub, no further deliverable/segment
// split needed since every Service Hub page already just is one of the
// business's real services).
const deliverablePages = allPages
  .filter((p) => (p.page_type === 'Service Page' && p.service_group === 'deliverable') || p.page_type === 'Service Hub')
  .sort((a, b) => a.nav_order - b.nav_order);
---

<BaseLayout page={page} allPages={allPages} business={business}>
  <Hero
    h1={page.h1 ?? page.title}
    imageUrl={page.images.hero?.url}
    imageAlt={page.images.hero?.alt}
    imageCreditName={page.images.hero?.creditName}
    imageCreditUrl={page.images.hero?.creditUrl}
    compact
  />
  {deliverablePages.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-10">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {deliverablePages.map((service) => (
          <a
            href={withBase(`/${service.slug}`)}
            class="block rounded-lg border border-slate-200 p-6 hover:border-brand-primary hover:shadow-md"
          >
            <h3 class="font-[family-name:var(--font-heading)] text-lg font-bold text-brand-ink">
              {service.title}
            </h3>
            {service.meta_description && (
              <p class="mt-2 text-sm text-slate-600">{service.meta_description}</p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}
  <Section>
    <Fragment set:html={renderCopy(page.copy)} />
  </Section>
  <CTA heading={page.cta_heading ?? 'Not sure which service you need?'} buttonText={page.cta_button_text ?? undefined} />
  <LeadMagnet pageId={page.id} />
  <LeadGenerator
    slug={page.slug}
    collectWebsiteUrl={business.collect_website_in_leads}
    responseTimeNote={business.lead_response_time_note}
    collectCounselorPreference={business.collect_counselor_preference}
    counselors={counselors}
  />
</BaseLayout>
