---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
import LeadGenerator from '../components/LeadGenerator.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { renderCopy } from '../lib/markdown';
import { withBase } from '../lib/url';
import { getCounselorOptions } from '../lib/pages';
import type { Page, Business } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;
const counselors = getCounselorOptions(allPages);

// Same self-maintaining pattern as ServicesOverview's deliverable grid — a
// new practice-type page shows up here automatically the moment it's given
// service_group = 'segment', nothing to remember to update.
const segmentPages = allPages
  .filter((p) => p.page_type === 'Service Page' && p.service_group === 'segment')
  .sort((a, b) => a.nav_order - b.nav_order);
---

<BaseLayout page={page} allPages={allPages} business={business}>
  <Hero
    h1={page.h1 ?? page.title}
    imageUrl={page.images.hero?.url}
    imageAlt={page.images.hero?.alt}
    imageCreditName={page.images.hero?.creditName}
    imageCreditUrl={page.images.hero?.creditUrl}
    imageFocalY={page.hero_image_focal_y}
    compact
  />
  {segmentPages.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-10">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {segmentPages.map((service) => (
          <a
            href={withBase(`/${service.slug}`)}
            class="block rounded-lg border border-slate-200 p-6 hover:border-brand-primary hover:shadow-md"
          >
            <h3 class="font-[family-name:var(--font-heading)] text-lg font-bold text-brand-ink">
              {service.title}
            </h3>
            {service.meta_description && (
              <p class="mt-2 text-sm text-slate-600">{service.meta_description}</p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}
  <Section>
    <Fragment set:html={renderCopy(page.copy)} />
  </Section>
  <CTA heading={page.cta_heading ?? 'Not sure which practice type fits yours?'} buttonText={page.cta_button_text ?? undefined} />
  <LeadMagnet pageId={page.id} />
  <LeadGenerator
    slug={page.slug}
    collectWebsiteUrl={business.collect_website_in_leads}
    responseTimeNote={business.lead_response_time_note}
    collectCounselorPreference={business.collect_counselor_preference}
    counselors={counselors}
  />
</BaseLayout>
