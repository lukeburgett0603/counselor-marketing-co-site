---
// Redesigned 2026-09-20 via the design-taste-frontend skill ("/taste"),
// overhaul mode: visuals treated as greenfield, content/IA/SEO/schema left
// exactly as they were. See Site Structure.md's "Design authority" note
// for the constraint this operates under, and this file's own inline
// comments for the reasoning behind each section's layout choice — the
// goal was genuine layout-family diversity (Section-Layout-Repetition
// Ban), not just a typography/color pass on the old one-layout-repeated
// structure.
//
// Every word on this page still comes from the same `page.*` fields the
// old template read (h1, hero_subhead, storybrand_problem/guide_empathy/
// pitch/success/failure, plan_steps, cta_heading/cta_button_text) — this
// file only changes how that existing content is composed visually.
// `splitByH3Sections()` (lib/markdown.ts, new) parses storybrand_pitch's
// existing 3 "### " subsections into distinct entries instead of one long
// flowing block; no copy was rewritten to make that split work, the field
// already had that exact shape.
import BaseLayout from '../layouts/BaseLayout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
import Testimonial from '../components/Testimonial.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PlanSteps from '../components/PlanSteps.astro';
import LeadGenerator from '../components/LeadGenerator.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { renderCopy, splitByH3Sections } from '../lib/markdown';
import { getCounselorOptions } from '../lib/pages';
import { withBase } from '../lib/url';
import type { Page, Business } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;
const counselors = getCounselorOptions(allPages);
const heroImage = page.images.hero;
const pitchSections = splitByH3Sections(page.storybrand_pitch);

// The Case Study page is real, existing content (not new copy) — this just
// gives the Guide/Empathy section's mention of Freedom Counseling Services
// a real linked visual instead of leaving that reference as plain text,
// the same "a split needs a real reason on the right, not filler" standard
// the redesign held itself to elsewhere on this page.
const caseStudyPage = allPages.find((p) => p.slug === 'case-study-freedom-counseling');
---

<BaseLayout page={page} allPages={allPages} business={business}>
  <!--
    Hero — Asymmetric Split, not the old form-in-a-box-or-nothing layout.
    A real photo (the founder's actual headshot, already live on the About
    page) replaces the previous image-less hero; per that same precedent
    elsewhere on this site, an image and the compact embedded lead form are
    mutually exclusive, so this hero carries a single strong CTA instead
    and the full lead form (unchanged) still sits at the bottom of the
    page for anyone who scrolls. Max 3 text elements (headline, subhead,
    CTA) — no eyebrow, no trust micro-strip, per the redesign's own Hero
    Stack Discipline.
  -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-tint/50 via-brand-neutral to-brand-neutral pb-16 pt-14 md:pb-24 md:pt-20">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
      <div>
        <h1 class="font-[family-name:var(--font-display)] text-4xl font-bold leading-[1.05] tracking-tight text-brand-ink md:text-5xl lg:text-6xl">
          {page.h1}
        </h1>
        {page.hero_subhead && <p class="mt-6 max-w-lg text-lg text-slate-600">{page.hero_subhead}</p>}
        <a
          href="#lead-generator"
          class="btn mt-8 inline-block rounded-lg bg-brand-accent px-8 py-4 font-semibold text-white shadow-sm hover:opacity-90 hover:shadow-lg"
        >
          {page.cta_button_text ?? 'Get Started'}
        </a>
      </div>
      {heroImage && (
        <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
          <div class="aspect-[4/5] overflow-hidden rounded-2xl shadow-xl">
            <OptimizedImage
              src={heroImage.url}
              alt={heroImage.alt}
              class="h-full w-full object-cover"
              loading="eager"
              widths={[400, 600, 800]}
              sizes="(min-width: 1024px) 420px, (min-width: 768px) 50vw, 90vw"
            />
          </div>
          <p class="mt-3 text-center text-sm text-slate-500 lg:text-left">
            Luke Burgett, LPCA &mdash; Licensed Counselor &amp; Founder
          </p>
        </div>
      )}
    </div>
  </section>

  <!--
    Problem — Editorial full-width statement, not another centered prose
    box. A distinct tinted band separates it from the hero, wide (not
    max-w-3xl) readable column, larger heading treatment via `.home-editorial`
    scoped below. Different layout family from the hero split and from the
    split-with-visual right after it.
  -->
  {page.storybrand_problem && (
    <section class="reveal bg-brand-tint/25 py-16 md:py-24">
      <div class="home-editorial mx-auto max-w-3xl px-6">
        <Fragment set:html={renderCopy(page.storybrand_problem)} />
      </div>
    </section>
  )}

  <!--
    Guide/Empathy — Split-Screen with a real supporting visual (not the
    Split-Header-Ban pattern: that's specifically headline-plus-filler-text
    in a section *header*; this is a full content column paired with a
    real, linked case-study card, which is exactly the exception the
    redesign brief itself calls out as legitimate).
  -->
  {page.storybrand_guide_empathy && (
    <section class="reveal py-16 md:py-24">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div class="prose">
          <Fragment set:html={renderCopy(page.storybrand_guide_empathy)} />
        </div>
        {caseStudyPage && (
          <a
            href={withBase(`/${caseStudyPage.slug}`)}
            class="block rounded-2xl border border-black/5 bg-white p-8 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-xl"
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-accent">Real, live proof</p>
            <p class="mt-3 font-[family-name:var(--font-display)] text-xl font-bold text-brand-ink">
              {caseStudyPage.title}
            </p>
            <p class="mt-3 text-sm text-slate-600">
              A full website and growth platform build, live and working today for a real Christian counseling practice in Louisville, KY.
            </p>
            <span class="mt-5 inline-block text-sm font-semibold text-brand-accent">Read the case study &rarr;</span>
          </a>
        )}
      </div>
    </section>
  )}

  <FeatureGrid items={page.concerns} heading="What you get" />
  {page.testimonial_quote && page.testimonial_author && (
    <Testimonial quote={page.testimonial_quote} author={page.testimonial_author} role={page.testimonial_role} />
  )}

  <PlanSteps steps={page.plan_steps} />

  <!--
    Pitch — a numbered stack, not a card grid (PlanSteps already owns that
    family on this page) and not more centered prose (Problem already owns
    that). Large ghost numerals, generous vertical rhythm, borderless —
    genuinely distinct from every other section family used so far.
  -->
  {pitchSections.length > 0 && (
    <section class="reveal bg-brand-neutral py-16 md:py-24">
      <div class="mx-auto max-w-3xl px-6">
        <div class="space-y-14">
          {pitchSections.map((section, index) => (
            <div class="flex gap-6">
              <span
                class="font-[family-name:var(--font-display)] text-5xl font-bold leading-none text-brand-accent/25 md:text-6xl"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="prose flex-1 pt-1">
                <h3 class="!mt-0">{section.title}</h3>
                <Fragment set:html={section.bodyHtml} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!--
    Success — a deliberate, one-time dark band (brand-primary), the page's
    single "Color Block Story" moment per the redesign brief's own Page
    Theme Lock exception. A short vision statement earns a real pause here
    rather than blending into the surrounding light sections.
  -->
  {page.storybrand_success && (
    <section class="reveal bg-brand-primary py-20 text-center md:py-28">
      <div class="mx-auto max-w-2xl px-6">
        <div class="home-editorial home-editorial--dark">
          <Fragment set:html={renderCopy(page.storybrand_success)} />
        </div>
      </div>
    </section>
  )}

  <!--
    Failure — back to light: the stakes, stated plainly, immediately before
    the CTA band (which is dark again) so the page doesn't stack two dark
    sections back to back. Deliberately NOT `tight` here (unlike this
    component's usual default elsewhere) — a short `tight` gap read as too
    thin a pause between the two dark bands on either side of it on a real
    pass in the browser; full padding gives the light band enough presence
    to actually register as a rhythm break, not just a thin seam.
  -->
  {page.storybrand_failure && (
    <Section>
      <Fragment set:html={renderCopy(page.storybrand_failure)} />
    </Section>
  )}

  <CTA heading={page.cta_heading ?? `Ready to work with ${business.display_name}?`} buttonText={page.cta_button_text ?? undefined} />
  <LeadMagnet pageId={page.id} />
  <LeadGenerator
    slug={page.slug}
    heading={page.cta_button_text ?? undefined}
    submitText={page.cta_button_text ?? undefined}
    collectWebsiteUrl={business.collect_website_in_leads}
    responseTimeNote={business.lead_response_time_note}
    collectCounselorPreference={business.collect_counselor_preference}
    counselors={counselors}
  />
</BaseLayout>

<style>
  /* Scoped to this page only (Astro's default `<style>` scoping) — the
     Problem/Success sections' headline treatment, bigger and using the
     display face, distinct from the shared `.prose h2` default everywhere
     else on the site. */
  .home-editorial :global(h2) {
    font-family: var(--font-display);
    font-size: 1.875rem;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-brand-ink);
  }
  @media (min-width: 768px) {
    .home-editorial :global(h2) {
      font-size: 2.5rem;
    }
  }
  .home-editorial :global(p) {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.7;
    color: #44403c;
  }
  .home-editorial--dark :global(h3),
  .home-editorial--dark :global(p) {
    color: white;
  }
  .home-editorial--dark :global(h3) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }
  .home-editorial--dark :global(p) {
    margin-top: 1rem;
    font-size: 1.25rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
  }
</style>
