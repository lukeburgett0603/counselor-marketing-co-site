---
// Shared shell for every /admin/* page — login/invited-password-setup
// views, then (once authenticated) a sidebar nav + the page's own content
// in the slot. Not part of the CMS `pages` system (no `pages` row for any
// /admin/* route), never linked from public nav/footer except the
// Admin Login link, excluded from the sitemap (astro.config.mjs's
// `sitemap({ filter: ... })`) and `Disallow`'d in robots.txt.ts.
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  current:
    | 'leads'
    | 'crm'
    | 'blog'
    | 'content-business-info'
    | 'content-page-copy'
    | 'lead-magnets'
    | 'team'
    | 'suggestions'
    | 'counselor-settings'
    // Client-repo-only — admin/directory.astro isn't part of the shared
    // template (see CLAUDE.md's "client directory" note), so this repo's
    // copy of AdminLayout.astro carries one extra union member the
    // template doesn't have. Re-add this after syncing any future
    // template change to AdminLayout.astro into this repo.
    | 'directory';
}

const { title, current } = Astro.props;

// Every item renders for every role — adminAuth.ts's applyNavAccess()
// hides the ones a given role can't use (data-nav-key below) once the
// caller's role is known, rather than baking role awareness into this
// static markup. "Suggestions" is agency-only — the client's own review
// of what they submitted lives on Website content instead. "Lead CRM" is
// deliberately a separate nav item from "Leads and analytics", not a tab
// on that page — the client wants Leads and analytics to stay a clean,
// numbers-only "proof of value" view for their own clients to see their
// marketing working, with day-to-day lead management (notes, follow-ups,
// detail view) kept off of it entirely.
//
// "Website content" is a collapsible group rather than a single link —
// business info/testimonials and page copy used to be three stacked
// sections on one route, but grew enough to warrant their own pages.
// Both children share `navKey: 'content'` (not each child's own `key`)
// so adminAuth.ts's role-based hide/show — which only knows about the
// single 'content' permission — keeps treating them as one unit, exactly
// as it did when this was one nav item. `key` (distinct per child) is
// only used here, for current-route highlighting and default-expanded.
const navItems = [
  { key: 'leads', label: 'Leads and analytics', href: withBase('/admin/leads') },
  { key: 'crm', label: 'Lead CRM', href: withBase('/admin/crm') },
  { key: 'blog', label: 'Blog posts', href: withBase('/admin/blog') },
  {
    key: 'content',
    label: 'Website content',
    children: [
      {
        key: 'content-business-info',
        navKey: 'content',
        label: 'Business info & testimonials',
        href: withBase('/admin/content/business-info'),
      },
      {
        key: 'content-page-copy',
        navKey: 'content',
        label: 'Page copy',
        href: withBase('/admin/content/page-copy'),
      },
    ],
  },
  { key: 'lead-magnets', label: 'Lead magnets', href: withBase('/admin/lead-magnets') },
  { key: 'suggestions', label: 'Suggestions', href: withBase('/admin/suggestions') },
  { key: 'team', label: 'Team', href: withBase('/admin/team') },
  { key: 'counselor-settings', label: 'Counselor settings', href: withBase('/admin/counselor-settings') },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-screen bg-brand-neutral">
    <div id="login-view" class="mx-auto max-w-sm px-6 py-16">
      <h1 class="mb-6 text-center font-[family-name:var(--font-heading)] text-2xl font-bold text-brand-ink">Admin</h1>
      <p class="mb-6 text-center text-sm text-slate-600">Log in to manage your site.</p>
      <form id="login-form" class="space-y-4">
        <input
          name="email"
          type="email"
          placeholder="Email"
          required
          class="w-full rounded-md border border-slate-300 px-4 py-2"
        />
        <input
          name="password"
          type="password"
          placeholder="Password"
          required
          class="w-full rounded-md border border-slate-300 px-4 py-2"
        />
        <button
          type="submit"
          class="w-full rounded-md bg-brand-primary px-6 py-3 font-semibold text-white hover:opacity-90"
        >
          Log in
        </button>
        <p id="login-status" class="text-center text-sm text-red-600" role="status"></p>
      </form>
      <button id="forgot-password-link" type="button" class="mt-4 block w-full text-center text-sm text-brand-primary hover:underline">
        Forgot password?
      </button>
      <form id="forgot-password-form" class="mt-4 hidden space-y-4">
        <input
          name="email"
          type="email"
          placeholder="Email"
          required
          class="w-full rounded-md border border-slate-300 px-4 py-2"
        />
        <button
          type="submit"
          class="w-full rounded-md border border-slate-300 px-6 py-3 font-semibold text-slate-700 hover:bg-slate-50"
        >
          Send reset link
        </button>
        <p id="forgot-password-status" class="text-center text-sm" role="status"></p>
      </form>
    </div>

    <div id="set-password-view" class="mx-auto max-w-sm px-6 py-16" style="display: none;">
      <p class="mb-4 text-sm text-slate-600">Set a password to finish setting up your admin login.</p>
      <form id="set-password-form" class="space-y-4">
        <input
          name="password"
          type="password"
          placeholder="New password"
          required
          minlength="8"
          class="w-full rounded-md border border-slate-300 px-4 py-2"
        />
        <button
          type="submit"
          class="w-full rounded-md bg-brand-primary px-6 py-3 font-semibold text-white hover:opacity-90"
        >
          Set password
        </button>
        <p id="set-password-status" class="text-center text-sm text-red-600" role="status"></p>
      </form>
    </div>

    <div id="no-access-view" class="mx-auto max-w-sm px-6 py-16 text-center" style="display: none;">
      <h1 class="mb-4 font-[family-name:var(--font-heading)] text-2xl font-bold text-brand-ink">No access</h1>
      <p class="mb-6 text-sm text-slate-600">
        Your login doesn't have admin access on this site. Contact the site owner if you think this is a mistake.
      </p>
      <button id="no-access-logout-button" class="text-sm text-brand-primary hover:underline">Log out</button>
    </div>

    <!--
      Deliberately not `class="hidden md:flex"` — Tailwind's responsive
      utilities are generated after the base `hidden` utility in the
      stylesheet, so at md+ viewports `md:flex` silently wins regardless
      of whether JS has removed `hidden` yet, showing this before login.
      An inline style always wins over any class, sidestepping that
      specificity-order footgun entirely — adminAuth.ts toggles
      `style.display`, not classList, for exactly this reason.
    -->
    <div id="admin-content" class="md:flex" style="display: none;">
      <nav class="flex shrink-0 flex-col gap-1 border-b border-slate-200 bg-white p-3 md:w-52 md:border-b-0 md:border-r md:p-4">
        <p class="mb-2 px-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Admin</p>
        <ul class="flex flex-1 flex-col gap-1">
          {navItems.map((item) =>
            'children' in item ? (
              <li data-nav-key={item.key}>
                <button
                  type="button"
                  data-nav-toggle
                  aria-expanded={item.children.some((child) => current === child.key) ? 'true' : 'false'}
                  class:list={[
                    'flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm hover:bg-brand-neutral',
                    item.children.some((child) => current === child.key) ? 'font-semibold text-brand-ink' : 'text-slate-600',
                  ]}
                >
                  {item.label}
                  <svg
                    data-nav-toggle-icon
                    class:list={[
                      'h-4 w-4 shrink-0 transition-transform',
                      item.children.some((child) => current === child.key) ? 'rotate-90' : '',
                    ]}
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.02-1.1l4.5 4.25a.75.75 0 010 1.1l-4.5 4.25a.75.75 0 01-1.06-.02z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </button>
                <ul
                  data-nav-submenu
                  class:list={[
                    'ml-3 mt-1 flex flex-col gap-1 border-l border-slate-200 pl-3',
                    item.children.some((child) => current === child.key) ? '' : 'hidden',
                  ]}
                >
                  {item.children.map((child) => (
                    <li data-nav-key={child.navKey}>
                      <a
                        href={child.href}
                        class:list={[
                          'flex items-center justify-between rounded-md px-3 py-2 text-sm',
                          current === child.key
                            ? 'bg-brand-neutral font-semibold text-brand-ink'
                            : 'text-slate-600 hover:bg-brand-neutral',
                        ]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li data-nav-key={item.key}>
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center justify-between rounded-md px-3 py-2 text-sm',
                    current === item.key
                      ? 'bg-brand-neutral font-semibold text-brand-ink'
                      : 'text-slate-600 hover:bg-brand-neutral',
                  ]}
                >
                  {item.label}
                  {item.key === 'suggestions' && (
                    <span
                      data-suggestions-badge
                      class="hidden rounded-full bg-brand-accent px-1.5 py-0.5 text-xs font-semibold text-white"
                    ></span>
                  )}
                </a>
              </li>
            )
          )}
        </ul>
        <button id="logout-button" class="mt-4 px-3 text-left text-sm text-brand-primary hover:underline">
          Log out
        </button>
      </nav>
      <main class="min-w-0 flex-1 p-6">
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  // Collapsible nav groups (currently just "Website content") — pure UI
  // state, no persistence across page loads (this app navigates between
  // admin routes with full page loads, and the group defaults collapsed
  // on each one unless the current page is one of its children, per
  // AdminLayout.astro's aria-expanded/hidden initial state above).
  document.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const submenu = button.nextElementSibling as HTMLElement | null;
      if (!submenu) return;
      const wasExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!wasExpanded));
      submenu.classList.toggle('hidden', wasExpanded);
      button.querySelector('[data-nav-toggle-icon]')?.classList.toggle('rotate-90', !wasExpanded);
    });
  });
</script>
