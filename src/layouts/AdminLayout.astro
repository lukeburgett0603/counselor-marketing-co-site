---
// Shared shell for every /admin/* page — login/invited-password-setup
// views, then (once authenticated) a sidebar nav + the page's own content
// in the slot. Not part of the CMS `pages` system (no `pages` row for any
// /admin/* route), never linked from public nav/footer except the
// Admin Login link, excluded from the sitemap (astro.config.mjs's
// `sitemap({ filter: ... })`) and `Disallow`'d in robots.txt.ts.
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  current: 'leads' | 'blog' | 'content';
}

const { title, current } = Astro.props;

const navItems = [
  { key: 'leads', label: 'Leads and analytics', href: withBase('/admin/leads') },
  { key: 'blog', label: 'Blog posts', href: withBase('/admin/blog') },
  { key: 'content', label: 'Website content', href: withBase('/admin/content') },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-screen bg-brand-neutral">
    <div id="login-view" class="mx-auto max-w-sm px-6 py-16">
      <h1 class="mb-6 text-center font-[family-name:var(--font-heading)] text-2xl font-bold text-brand-ink">Admin</h1>
      <p class="mb-6 text-center text-sm text-slate-600">Log in to manage your site.</p>
      <form id="login-form" class="space-y-4">
        <input
          name="email"
          type="email"
          placeholder="Email"
          required
          class="w-full rounded-md border border-slate-300 px-4 py-2"
        />
        <input
          name="password"
          type="password"
          placeholder="Password"
          required
          class="w-full rounded-md border border-slate-300 px-4 py-2"
        />
        <button
          type="submit"
          class="w-full rounded-md bg-brand-primary px-6 py-3 font-semibold text-white hover:opacity-90"
        >
          Log in
        </button>
        <p id="login-status" class="text-center text-sm text-red-600" role="status"></p>
      </form>
    </div>

    <div id="set-password-view" class="mx-auto max-w-sm px-6 py-16" style="display: none;">
      <p class="mb-4 text-sm text-slate-600">Set a password to finish setting up your admin login.</p>
      <form id="set-password-form" class="space-y-4">
        <input
          name="password"
          type="password"
          placeholder="New password"
          required
          minlength="8"
          class="w-full rounded-md border border-slate-300 px-4 py-2"
        />
        <button
          type="submit"
          class="w-full rounded-md bg-brand-primary px-6 py-3 font-semibold text-white hover:opacity-90"
        >
          Set password
        </button>
        <p id="set-password-status" class="text-center text-sm text-red-600" role="status"></p>
      </form>
    </div>

    <!--
      Deliberately not `class="hidden md:flex"` — Tailwind's responsive
      utilities are generated after the base `hidden` utility in the
      stylesheet, so at md+ viewports `md:flex` silently wins regardless
      of whether JS has removed `hidden` yet, showing this before login.
      An inline style always wins over any class, sidestepping that
      specificity-order footgun entirely — adminAuth.ts toggles
      `style.display`, not classList, for exactly this reason.
    -->
    <div id="admin-content" class="md:flex" style="display: none;">
      <nav class="flex shrink-0 flex-col gap-1 border-b border-slate-200 bg-white p-3 md:w-52 md:border-b-0 md:border-r md:p-4">
        <p class="mb-2 px-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Admin</p>
        <ul class="flex flex-1 flex-col gap-1">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded-md px-3 py-2 text-sm',
                  current === item.key
                    ? 'bg-brand-neutral font-semibold text-brand-ink'
                    : 'text-slate-600 hover:bg-brand-neutral',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <button id="logout-button" class="mt-4 px-3 text-left text-sm text-brand-primary hover:underline">
          Log out
        </button>
      </nav>
      <main class="flex-1 p-6">
        <slot />
      </main>
    </div>
  </body>
</html>
