---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCTABar from '../components/MobileCTABar.astro';
import SchemaScript from '../components/SchemaScript.astro';
import { buildPageSchemas, buildBreadcrumbSchema } from '../lib/schema';
import { buildBreadcrumbChain } from '../lib/pages';
import type { Page, Business } from '../lib/pages';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;

// siteUrl is the site's real root including any GitHub Pages project-page
// base path (e.g. https://user.github.io/repo-name) — every schema/canonical
// URL below is built from this so they stay correct with or without a
// custom domain (which just makes the base path '/').
const siteUrl = new URL(withBase('/'), Astro.site ?? Astro.url).toString().replace(/\/$/, '');
const canonicalUrl = page.page_type === 'Homepage' ? `${siteUrl}/` : `${siteUrl}/${page.slug}`;
const title = page.meta_title ?? page.title;
// No `?? page.purpose` fallback here on purpose: `purpose` is internal
// planning metadata (has held pricing tiers) — it must never reach a
// public tag. An empty description is a smaller problem than a leak.
const description = page.meta_description ?? '';
const ogImage = page.images.hero?.url ?? business.logo_url ?? undefined;

// True once any real 'Blog Post' rows exist — switches Article schema to
// the more specific BlogPosting type (see buildArticleSchema).
const hasBlog = allPages.some((p) => p.page_type === 'Blog Post');
const pageSchemas = buildPageSchemas(page, business, siteUrl, { hasBlog });
const breadcrumbChain = buildBreadcrumbChain(page, allPages);
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbChain, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/*
      Safety net for global.css's `.reveal` rule — see that rule's own
      comment for why this exists as `html.js .reveal` rather than a bare
      `.reveal` there: this tiny synchronous script is the only thing that
      ever adds the `js` class, so `.reveal` only hides content when JS is
      actually confirmed running. If JS is disabled, blocked, or errors out
      anywhere else on the page, every `.reveal` element just renders in
      its normal (visible) state — no `<noscript>` needed (a `<noscript>`
      containing a `<style>` was tried here first and rejected: browsers
      parse `<noscript>`'s content as raw text whenever scripting is
      actually enabled, which corrupted this document's own `<head>`
      parsing and leaked a later `{ogImage && ...}` expression as visible
      body text — caught live in the browser, not by reading the code).
      Deliberately not `is:inline` via a .astro directive — a plain inline
      <script> here is already synchronous and render-blocking by default,
      which is exactly what's needed before first paint.
    */}
    <script>document.documentElement.classList.add('js');</script>

    {business.google_fonts_url && (
      <>
        {/* Real brand webfont(s), set per client via business.google_fonts_url
            (the design-direction phase, alongside brand_colors/brand_fonts) —
            no hardcoded font here, so this stays identical across every
            client site. Preconnect lets the browser start this fetch before
            it's even parsed global.css. Null (never set) falls back to the
            OS system font, same as any other unset per-client field. */}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href={business.google_fonts_url} rel="stylesheet" />
      </>
    )}

    <meta property="og:type" content={page.page_type === 'Content Pillar' || page.page_type === 'Service Hub' || page.page_type === 'Blog Post' ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={business.display_name} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <SchemaScript schemas={[...pageSchemas, breadcrumbSchema]} />
  </head>
  <body class="pb-14 md:pb-0">
    <Header
      navPages={allPages}
      businessName={business.display_name}
      telephone={business.telephone}
      logoUrl={business.logo_in_header ? business.logo_url : null}
    />
    <main>
      <slot />
    </main>
    <Footer navPages={allPages} business={business} />
    <MobileCTABar telephone={business.telephone} ctaText={page.cta_button_text ?? undefined} />
    <script>
      // Shared reveal-on-scroll — see global.css's `.reveal`/`.is-visible`
      // rules. One observer for the whole page rather than one per
      // component; `unobserve` once revealed since this never needs to
      // reverse. No-op (and no import cost) when the browser doesn't
      // support IntersectionObserver — elements just stay in their
      // default (visible) state.
      if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
