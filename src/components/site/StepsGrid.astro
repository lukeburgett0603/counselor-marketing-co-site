---
// The Full Caseload System, the message that repeats sitewide. Rows split
// by hairlines, not five equal cards. Pass `details` to swap in a page's
// own longer copy per step (same order as STEPS).
import { STEPS } from '../../lib/site';
import { withBase } from '../../lib/url';
import Ph from './Ph.astro';

interface Props {
  details?: string[];
  current?: string;
}
const { details, current } = Astro.props;
---

<ol class="border-t border-line">
  {STEPS.map((step, i) => (
    <li class:list={['grid gap-3 border-b border-line py-6 md:grid-cols-[220px_1fr] md:gap-8', current === step.key && 'bg-accent-soft/40 md:-mx-4 md:px-4']}>
      <div class="flex items-center gap-3">
        <span class="grid size-9 place-items-center rounded-control bg-accent-soft text-accent">
          <Ph name={step.icon} class="size-5" />
        </span>
        <h3 class="h3">{step.name}</h3>
      </div>
      <div class="md:pt-1">
        <p class="max-w-[70ch] text-muted">{details?.[i] ?? step.short}</p>
        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          {step.links.map((link) => (
            <a href={withBase(link.href)} class="link-arrow whitespace-nowrap text-[15px]">
              {link.label} <Ph name="arrow-right" class="size-3.5" />
            </a>
          ))}
        </div>
      </div>
    </li>
  ))}
</ol>
