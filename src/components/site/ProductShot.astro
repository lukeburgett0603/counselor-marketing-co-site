---
// A real screenshot of the product (or of a client site), never a
// drawn-with-divs mockup. Dashboard shots use illustrative data only,
// never a real client's leads, and say so in the caption.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  shot: string;
  alt?: string;
  caption?: string | false;
  class?: string;
}
const SHOTS: Record<string, { alt: string; caption: string | false }> = {
  today: { alt: "The Today screen: a personal greeting, the practice caseload meter, new clients and inquiries this month, the next moves to make, and where new clients came from", caption: 'Today, the home screen. Sample practice, illustrative data.' },
  overview: { alt: 'The monthly report: new clients, inquiries, caseload, response time, what needs attention, and each step of the system', caption: 'The monthly report. Sample practice, illustrative data.' },
  crm: { alt: 'Inquiries: status counts, follow-ups due, and every inquiry with who it is with and where it stands', caption: 'Inquiries, with follow-ups due. Sample practice, illustrative data.' },
  caseload: { alt: 'Caseload: the practice meter and a card for each counselor showing how full they are', caption: 'Caseload for each counselor. Sample practice, illustrative data.' },
  referrals: { alt: 'Referral partners: active partners, follow-ups due, and each partner with their stage and the inquiries they sent', caption: 'Referral partners. Sample practice, illustrative data.' },
  'seo-insights': { alt: 'Search rankings: each tracked search with its Google position, monthly searches, and eight weeks of movement', caption: 'Search rankings. Sample practice, illustrative data.' },
  'freedom-home': { alt: "Freedom Counseling Services' homepage, built by Counselor Marketing Co.", caption: "Freedom Counseling Services' live homepage." },
};
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/shots/*.{png,webp,jpg}', { eager: true });
const match = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === Astro.props.shot);
const meta = SHOTS[Astro.props.shot] ?? { alt: '', caption: false };
const alt = Astro.props.alt ?? meta.alt;
const caption = Astro.props.caption ?? meta.caption;
---

{match && (
  <figure class={Astro.props.class}>
    <div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
      <Image src={match[1].default} alt={alt} widths={[640, 960, 1400]} sizes="(min-width: 1024px) 700px, 100vw" class="block h-auto w-full" />
    </div>
    {caption && <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>}
  </figure>
)}
