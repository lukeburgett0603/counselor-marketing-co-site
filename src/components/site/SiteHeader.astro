---
import { NAV, SITE } from '../../lib/site';
import { withBase } from '../../lib/url';
import Ph from './Ph.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

// An item is "current" when the page is it, or one of its dropdown links.
const isCurrent = (item: (typeof NAV)[number]) =>
  currentPath === item.href ||
  currentPath.startsWith(item.href + '/') ||
  (item.groups ?? []).some((g) => g.links.some((l) => l.href === currentPath));
---

<header class="sticky top-0 z-50 border-b border-line bg-page/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-4 px-4 sm:px-6">
    <a href={withBase('/')} class="shrink-0" aria-label="Counselor Marketing Co. home">
      <Wordmark />
    </a>

    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {NAV.map((item) => (
          <li class="nav-item relative">
            <a
              href={withBase(item.href)}
              class:list={[
                'flex items-center gap-1 whitespace-nowrap rounded-control px-3 py-2 text-[15px] transition-colors hover:text-ink',
                isCurrent(item) ? 'text-ink font-medium' : 'text-muted',
              ]}
              aria-current={currentPath === item.href ? 'page' : undefined}
              aria-haspopup={item.groups ? 'true' : undefined}
            >
              {item.label}
              {item.groups && <Ph name="caret-down" class="size-3.5 opacity-60" />}
            </a>
            {item.groups && (
              <div class="nav-panel invisible absolute left-1/2 top-full w-max min-w-64 -translate-x-1/2 pt-2 opacity-0 transition-[opacity,visibility] duration-150">
                <div class="rounded-card border border-line bg-surface p-2 shadow-card">
                  {/* The trigger word is also a real page; say so explicitly
                      (a hover menu hides that from most visitors). */}
                  <a
                    href={withBase(item.href)}
                    class="mb-1 flex items-center justify-between gap-6 rounded-control px-3 py-2 text-[15px] font-medium text-ink hover:bg-accent-soft"
                  >
                    {item.label === 'Resources' ? 'All resources' : `All ${item.label.toLowerCase()}`}
                    <Ph name="arrow-right" class="size-4 text-accent" />
                  </a>
                  <div class:list={['border-t border-line pt-1', item.groups.length > 2 && 'grid grid-cols-2 gap-x-2']}>
                    {item.groups.map((group) => (
                      <div class="py-1">
                        <p class="px-3 pb-1 pt-2 text-xs font-medium text-muted">{group.label}</p>
                        <ul>
                          {group.links.map((link) => (
                            <li>
                              <a
                                href={withBase(link.href)}
                                class:list={[
                                  'block rounded-control px-3 py-1.5 text-[15px] hover:bg-accent-soft hover:text-ink',
                                  currentPath === link.href ? 'text-accent font-medium' : 'text-ink',
                                ]}
                                aria-current={currentPath === link.href ? 'page' : undefined}
                              >
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={withBase(SITE.auditPath)}
        class="whitespace-nowrap rounded-control bg-accent px-3.5 py-2 text-[15px] font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
      >
        Free<span class="hidden sm:inline"> Caseload</span> Audit
      </a>
      <button
        type="button"
        class="menu-toggle grid size-10 place-items-center rounded-control border border-line bg-surface text-ink xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Menu</span>
        <Ph name="list" class="icon-open size-5" />
        <Ph name="x" class="icon-close hidden size-5" />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Main" class="mobile-menu border-t border-line bg-page xl:hidden" style="display: none;">
    <ul class="mx-auto max-h-[calc(100dvh-4rem)] max-w-[1200px] overflow-y-auto px-4 pb-6 pt-2 sm:px-6">
      {NAV.map((item) => (
        <li class="border-b border-line py-2 last:border-0">
          <a href={withBase(item.href)} class="block py-2 text-[17px] font-medium text-ink">{item.label}</a>
          {item.groups && (
            <ul class="grid grid-cols-1 pb-1 sm:grid-cols-2">
              {item.groups.flatMap((g) => g.links).map((link) => (
                <li>
                  <a href={withBase(link.href)} class="block py-1.5 pl-3 text-[15px] text-muted hover:text-ink">{link.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav-item:hover .nav-panel,
  .nav-item:focus-within .nav-panel {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('.mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    // Inline display, not a `hidden` class: a responsive display utility
    // would beat `hidden` in the cascade (see CLAUDE.md's real-bugs list).
    if (menu) menu.style.display = open ? 'block' : 'none';
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  });
</script>
