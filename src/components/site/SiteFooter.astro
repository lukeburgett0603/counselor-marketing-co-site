---
import { FOOTER, SITE } from '../../lib/site';
import { withBase } from '../../lib/url';
import Wordmark from './Wordmark.astro';
import Ph from './Ph.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="mx-auto grid max-w-[1200px] gap-12 px-4 py-14 sm:px-6 lg:grid-cols-[1.2fr_2fr]">
    <div class="max-w-sm">
      <Wordmark />
      <p class="mt-4 text-[15px] text-muted">
        The Full Caseload System for counselors, therapists, and psychologists in private practice. Built by {SITE.founder},
        {SITE.credential}, a {SITE.credentialLong} in {SITE.licenseState}.
      </p>
      <p class="mt-4 flex gap-2 text-[15px] text-muted">
        <Ph name="download-simple" class="mt-1 size-4 text-accent" />
        <span>Month-to-month. Your website, domain, and data always go with you.</span>
      </p>
      <a
        href={withBase(SITE.auditPath)}
        class="mt-6 inline-flex items-center gap-2 font-medium text-accent hover:underline hover:underline-offset-4"
      >
        {SITE.auditCta} <Ph name="arrow-right" class="size-4" />
      </a>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      {FOOTER.map((col) => (
        <div>
          <p class="text-sm font-semibold text-ink">{col.label}</p>
          <ul class="mt-3 space-y-2">
            {col.links.map((link) => (
              <li>
                <a href={withBase(link.href)} class="text-[15px] text-muted hover:text-ink">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-4 px-4 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>© {year} Counselor Marketing Co. <a href={withBase('/admin/leads')} class="ml-3 hover:text-ink">Client login</a></p>
      <fieldset class="theme-switch flex items-center gap-1 rounded-control border border-line p-1">
        <legend class="sr-only">Color theme</legend>
        {[
          { value: 'system', label: 'Match device', icon: 'circle-half' },
          { value: 'light', label: 'Light', icon: 'sun' },
          { value: 'dark', label: 'Dark', icon: 'moon' },
        ].map((opt) => (
          <label class="cursor-pointer rounded-[6px] p-1.5 text-muted has-[:checked]:bg-accent-soft has-[:checked]:text-ink" title={opt.label}>
            <input type="radio" name="theme" value={opt.value} class="sr-only" />
            <Ph name={opt.icon} class="size-4" label={opt.label} />
          </label>
        ))}
      </fieldset>
    </div>
  </div>
</footer>

<script>
  const root = document.documentElement;
  let saved = 'system';
  try {
    saved = localStorage.getItem('cmc-theme') ?? 'system';
  } catch {}
  document.querySelectorAll<HTMLInputElement>('.theme-switch input').forEach((input) => {
    input.checked = input.value === saved;
    input.addEventListener('change', () => {
      if (input.value === 'system') delete root.dataset.theme;
      else root.dataset.theme = input.value;
      try {
        if (input.value === 'system') localStorage.removeItem('cmc-theme');
        else localStorage.setItem('cmc-theme', input.value);
      } catch {}
    });
  });
</script>
