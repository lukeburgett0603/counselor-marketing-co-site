---
// The blog library: every article, filterable by topic and searchable.
// Ported from the client-site template's ArticleLibrary (same behavior),
// restyled with CMC's tokens. Topics are the topic hubs (Content Pillar
// rows with a category); each article's `category` ties it to one hub.
// Works without JavaScript (everything shows); with it, the topic chips
// filter in place and the choice is kept in the address (?topic=slug), so
// a hub can link straight to its own articles.
// The featured article (the newest) sits above the filter while "All
// articles" is chosen and isn't repeated in the grid. Four cards across
// on desktop, two on tablets, one on phones; 20 per page (?page=2).
// The search box ranks by match (title, then topic, then summary,
// headings, opening), knows the everyday words counselors use ("clients"
// finds caseload articles, "maps" finds Google Business Profile), and
// forgives small typos and partial words (?q=...).
import { Image } from 'astro:assets';
import Ph from './Ph.astro';
import { withBase } from '../../lib/url';

interface Topic { slug: string; label: string; count: number }
interface Article { title: string; text?: string; href: string; topic?: string; topicLabel?: string; slug?: string; date?: string; image?: { url: string; alt: string }; search?: string }

interface Props {
  topics: Topic[];
  articles: Article[];
  featured?: string;
  perPage?: number;
}

const { topics, articles, featured, perPage = 20 } = Astro.props;
const lead = featured ? articles.find((a) => a.slug === featured) : undefined;
const fmtDate = (d?: string) => (d ? new Date(`${d.slice(0, 10)}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : undefined);
---

<section class="wrap pb-14 lg:pb-20" data-library data-per-page={perPage}>
  {lead && (
    <a class="al-feature card" href={lead.href} data-featured>
      {lead.image && (
        <div class="al-feature-img">
          <Image src={lead.image.url} alt={lead.image.alt} inferSize widths={[480, 720, 960]} sizes="(max-width: 767px) 100vw, 600px" loading="eager" />
        </div>
      )}
      <div class="al-feature-body">
        <span class="al-badge">Featured article</span>
        {lead.topicLabel && <span class="al-meta">{lead.topicLabel}</span>}
        <strong class="al-feature-title">{lead.title}</strong>
        {lead.text && <span class="al-text">{lead.text}</span>}
        {fmtDate(lead.date) && <span class="al-date">{fmtDate(lead.date)}</span>}
        <span class="link-arrow mt-1">Read the article <Ph name="arrow-right" class="size-4" /></span>
      </div>
    </a>
  )}
  <form class="al-search" role="search" onsubmit="return false">
    <label for="al-q" class="mb-2 block font-medium text-ink">Search articles</label>
    <div class="al-search-box">
      <Ph name="magnifying-glass" class="size-5 text-muted" />
      <input id="al-q" type="search" name="q" autocomplete="off" placeholder="Try “referrals” or “Google”" />
      <button type="button" class="al-clear" aria-label="Clear search" hidden>Clear</button>
    </div>
  </form>
  {topics.length > 1 && (
    <div class="al-filter" role="group" aria-label="Filter articles by topic">
      <button type="button" class="al-chip" aria-pressed="true" data-topic="">All articles <span>{articles.length}</span></button>
      {topics.map((t) => <button type="button" class="al-chip" aria-pressed="false" data-topic={t.slug}>{t.label} <span>{t.count}</span></button>)}
    </div>
  )}
  <p class="al-count" aria-live="polite"></p>
  <div class="al-empty card" hidden>
    <p><strong class="text-ink">No articles match that yet.</strong> Try a broader word, choose a topic above, or <a href={withBase('/contact')} class="font-medium text-accent underline underline-offset-4">ask Luke directly</a>.</p>
  </div>
  <ul class="al-list">
    {articles.map((a) => (
      <li data-topic={a.topic ?? ''} data-title={a.title.toLowerCase()} data-topic-label={(a.topicLabel ?? '').toLowerCase()} data-search={a.search ?? ''} data-lead={lead && a.slug === lead.slug ? '' : undefined} hidden={!!lead && a.slug === lead.slug}>
        <a href={a.href} class="card">
          {a.image && (
            <div class="al-img">
              <Image src={a.image.url} alt={a.image.alt} inferSize widths={[320, 480, 640]} sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 290px" loading="lazy" />
            </div>
          )}
          {a.topicLabel && <span class="al-meta">{a.topicLabel}</span>}
          <strong class="al-title">{a.title}</strong>
          {a.text && <span class="al-text">{a.text}</span>}
          <span class="link-arrow mt-auto pt-1 text-[15px]">Read the article <Ph name="arrow-right" class="size-4" /></span>
        </a>
      </li>
    ))}
  </ul>
  <nav class="al-pages" aria-label="Article pages" hidden></nav>
</section>

<style>
  .al-feature { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); margin-bottom: 40px; overflow: hidden; text-decoration: none; transition: border-color 0.15s; }
  .al-feature:hover, .al-list a:hover { border-color: var(--muted); }
  .al-feature[hidden] { display: none; }
  .al-feature-img { min-height: 300px; background: var(--accent-soft); }
  .al-img img, .al-feature-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .al-feature-body { display: grid; gap: 10px; align-content: center; justify-items: start; padding: 32px 36px; }
  /* Badges and selected states use the soft tint or ink, never the solid
     accent fill (reserved for conversion buttons). */
  .al-badge { font-size: 13px; font-weight: 500; color: var(--accent); background: var(--accent-soft); padding: 4px 10px; border-radius: 999px; }
  .al-feature-title { font-size: clamp(24px, 2.4vw, 32px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 600; color: var(--ink); }
  .al-meta { font-size: 13px; font-weight: 500; color: var(--muted); }
  .al-date { color: var(--muted); font-size: 14px; }
  .al-text { color: var(--muted); font-size: 15px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .al-feature .al-text { -webkit-line-clamp: unset; display: block; font-size: 16px; }
  .al-search { max-width: 640px; margin-bottom: 18px; }
  .al-search-box { display: flex; align-items: center; gap: 10px; padding: 0 8px 0 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-control); }
  .al-search-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .al-search-box input { flex: 1; min-width: 0; font: inherit; font-size: 16px; padding: 12px 0; border: 0; background: transparent; color: var(--ink); outline: none; }
  .al-search-box input::placeholder { color: var(--muted); opacity: 0.8; }
  .al-search-box input::-webkit-search-cancel-button { display: none; }
  .al-clear { font: inherit; font-size: 14px; font-weight: 500; border: 0; background: transparent; color: var(--accent); cursor: pointer; padding: 8px 10px; }
  .al-clear[hidden], .al-empty[hidden] { display: none; }
  .al-filter { display: flex; flex-wrap: wrap; gap: 8px; }
  .al-chip { font: inherit; font-size: 15px; font-weight: 500; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; display: inline-flex; gap: 8px; align-items: center; transition: border-color 0.15s; }
  .al-chip:hover { border-color: var(--muted); }
  .al-chip span { color: var(--muted); font-size: 13px; font-family: var(--font-mono); }
  .al-chip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--page); }
  .al-chip[aria-pressed='true'] span { color: color-mix(in srgb, var(--page) 70%, transparent); }
  .al-count { margin-top: 16px; color: var(--muted); font-size: 15px; min-height: 1.4em; }
  .al-empty { max-width: 640px; margin-top: 8px; padding: 20px 24px; color: var(--muted); }
  .al-list { list-style: none; padding: 0; margin: 12px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .al-list li[hidden] { display: none; }
  .al-list a { height: 100%; display: flex; flex-direction: column; gap: 8px; padding: 0 20px 20px; text-decoration: none; overflow: hidden; transition: border-color 0.15s; }
  .al-list a > :first-child:not(.al-img) { margin-top: 20px; }
  .al-img { margin: 0 -20px 6px; aspect-ratio: 16 / 9; background: var(--accent-soft); overflow: hidden; }
  .al-title { font-size: 17px; line-height: 1.3; letter-spacing: -0.01em; font-weight: 600; color: var(--ink); }
  .al-pages { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 32px; }
  .al-pages[hidden] { display: none; }
  .al-pages :global(button) { font: inherit; font-size: 15px; font-weight: 500; min-width: 44px; height: 44px; padding: 0 14px; border-radius: var(--radius-control); border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; }
  .al-pages :global(button[aria-current='page']) { background: var(--ink); border-color: var(--ink); color: var(--page); }
  .al-pages :global(button:disabled) { opacity: 0.4; cursor: default; }
  @media (max-width: 1023px) { .al-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .al-list { grid-template-columns: minmax(0, 1fr); }
    .al-feature { grid-template-columns: minmax(0, 1fr); }
    .al-feature-img { min-height: 0; aspect-ratio: 16 / 9; }
    .al-feature-body { padding: 22px 24px 26px; }
  }
</style>

<script>
  // Everyday words practice owners search, mapped to the words CMC's
  // articles use.
  const SYNONYMS: Record<string, string[]> = {
    clients: ['caseload', 'client', 'lead'], client: ['caseload', 'client', 'lead'], caseload: ['caseload', 'client'], full: ['caseload'], empty: ['caseload'], slow: ['caseload'],
    leads: ['lead', 'inquiry', 'caseload'], inquiries: ['inquiry', 'lead'], calls: ['inquiry', 'lead', 'call'], booking: ['booked', 'inquiry', 'lead'], book: ['booked', 'inquiry'],
    google: ['google', 'seo', 'search'], rank: ['seo', 'ranking', 'search'], ranking: ['seo', 'ranking'], search: ['seo', 'search'], found: ['seo', 'search', 'google'], visibility: ['seo', 'search'],
    maps: ['google business profile', 'map', 'local'], map: ['google business profile', 'map', 'local'], gbp: ['google business profile'], listing: ['google business profile', 'directory'], local: ['local', 'map', 'seo'],
    reviews: ['review', 'reputation'], review: ['review', 'reputation'], stars: ['review'], testimonials: ['review', 'testimonial'], ethics: ['ethic', 'aca'], ethical: ['ethic', 'aca'],
    website: ['website', 'site', 'design'], site: ['website', 'site'], squarespace: ['website', 'squarespace'], wix: ['website', 'wix'], wordpress: ['website', 'wordpress'], copy: ['copy', 'writing', 'website'], writing: ['copy', 'writing'],
    referral: ['referral', 'partner'], referrals: ['referral', 'partner'], doctors: ['referral', 'physician'], physicians: ['referral', 'physician'], church: ['church', 'referral', 'faith'], churches: ['church', 'referral', 'faith'],
    ads: ['google ads', 'ad', 'paid'], advertising: ['google ads', 'ad', 'paid'], ppc: ['google ads', 'paid'],
    ai: ['ai', 'chatgpt', 'search'], chatgpt: ['ai', 'chatgpt'],
    psychology: ['psychology today', 'directory'], directory: ['directory', 'psychology today'], directories: ['directory', 'psychology today'],
    christian: ['christian', 'faith'], faith: ['faith', 'christian'],
    group: ['group practice', 'clinician'], hiring: ['group practice', 'clinician'], solo: ['solo', 'private practice'],
    price: ['pricing', 'cost'], cost: ['pricing', 'cost'], marketing: ['marketing'],
  };
  const STOP = new Set('a an and are as at be but by can do does for from how i if in is it its me my of on or our so that the their them they this to was what when where who why will with you your im ive dont'.split(' '));
  const stem = (w: string) => w.replace(/(ing|ed|es|s|ly)$/, '').replace(/(.)\1$/, '$1') || w;
  const words = (t: string) => t.toLowerCase().normalize('NFKD').replace(/[^a-z0-9\s]/g, ' ').split(/\s+/).filter((w) => w && !STOP.has(w));
  const near = (a: string, b: string) => {
    // True when one letter is added, removed, or changed, or two
    // neighboring letters are swapped (a small typo).
    if (Math.abs(a.length - b.length) > 1) return false;
    if (a.length === b.length) {
      const diff = [...a].map((c, k) => (c === b[k] ? -1 : k)).filter((k) => k >= 0);
      if (diff.length === 2 && diff[1] === diff[0] + 1 && a[diff[0]] === b[diff[1]] && a[diff[1]] === b[diff[0]]) return true;
    }
    let i = 0, j = 0, edits = 0;
    while (i < a.length && j < b.length) {
      if (a[i] === b[j]) { i++; j++; continue; }
      if (++edits > 1) return false;
      if (a.length > b.length) i++; else if (b.length > a.length) j++; else { i++; j++; }
    }
    return edits + (a.length - i) + (b.length - j) <= 1;
  };
  const hits = (term: string, list: string[]) => {
    let best = 0;
    for (const w of list) {
      if (w === term) return 1;
      if (term.length >= 3 && w.startsWith(term)) best = Math.max(best, 0.8);
      else if (term.length >= 5 && near(w, term)) best = Math.max(best, 0.6);
    }
    return best;
  };

  document.querySelectorAll<HTMLElement>('[data-library]').forEach((lib) => {
    const chips = [...lib.querySelectorAll<HTMLButtonElement>('.al-chip')];
    const list = lib.querySelector<HTMLElement>('.al-list')!;
    const items = [...lib.querySelectorAll<HTMLElement>('.al-list li')];
    const count = lib.querySelector<HTMLElement>('.al-count')!;
    const feature = lib.querySelector<HTMLElement>('[data-featured]');
    const nav = lib.querySelector<HTMLElement>('.al-pages')!;
    const input = lib.querySelector<HTMLInputElement>('#al-q')!;
    const clear = lib.querySelector<HTMLButtonElement>('.al-clear')!;
    const empty = lib.querySelector<HTMLElement>('.al-empty')!;
    const perPage = Number(lib.dataset.perPage) || 20;
    const index = items.map((li) => ({
      li,
      title: words(li.dataset.title ?? '').map(stem),
      topic: words(li.dataset.topicLabel ?? '').map(stem),
      body: words(li.dataset.search ?? '').map(stem),
    }));
    const score = (q: string) => {
      const terms = words(q);
      const scores = new Map<HTMLElement, number>();
      for (const doc of index) {
        let total = 0;
        let matched = 0;
        for (const raw of terms) {
          // The word itself counts fully; its everyday synonyms add a
          // smaller boost, so an exact match always ranks first. A
          // multi-word synonym counts when every word in it matches.
          const field = (t: string) => 5 * hits(t, doc.title) + 3 * hits(t, doc.topic) + 1.5 * hits(t, doc.body);
          const phrase = (p: string) => {
            const parts = words(p).map(stem);
            return parts.length ? Math.min(...parts.map(field)) : 0;
          };
          const own = stem(raw);
          const syn = [...new Set(SYNONYMS[raw] ?? [])].filter((t) => stem(t) !== own);
          const best = field(own) + 0.4 * Math.max(0, ...syn.map(phrase));
          if (best > 0) matched++;
          total += best;
        }
        // Articles matching more of the words rank higher.
        if (total > 0) scores.set(doc.li, total * (matched / terms.length));
      }
      return scores;
    };
    let topic = '';
    let page = 1;
    let query = '';
    const render = (push: boolean, scroll = false) => {
      if (topic && !chips.some((c) => c.dataset.topic === topic)) topic = '';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(!query && c.dataset.topic === topic)));
      let matching: HTMLElement[];
      if (query) {
        const s = score(query);
        matching = items.filter((li) => s.has(li)).sort((a, b) => (s.get(b) ?? 0) - (s.get(a) ?? 0));
        matching.forEach((li) => list.append(li));
      } else {
        items.forEach((li) => list.append(li));
        matching = items.filter((li) => (topic ? li.dataset.topic === topic : !('lead' in li.dataset)));
      }
      const pages = Math.max(1, Math.ceil(matching.length / perPage));
      page = Math.min(Math.max(1, page), pages);
      const shown = new Set(matching.slice((page - 1) * perPage, page * perPage));
      items.forEach((li) => { li.hidden = !shown.has(li); });
      if (feature) feature.hidden = !!topic || !!query || page > 1;
      clear.hidden = !query;
      empty.hidden = !query || matching.length > 0;
      const label = chips.find((c) => c.dataset.topic === topic)?.firstChild?.textContent?.trim();
      count.textContent = query
        ? (matching.length ? `${matching.length} article${matching.length === 1 ? '' : 's'} for “${query}”, best matches first` : '')
        : topic ? `${matching.length} article${matching.length === 1 ? '' : 's'} on ${label}` : '';
      nav.hidden = pages < 2;
      nav.innerHTML = '';
      if (pages > 1) {
        const btn = (text: string, to: number, opts: { current?: boolean; disabled?: boolean; label?: string } = {}) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = text;
          if (opts.label) b.setAttribute('aria-label', opts.label);
          if (opts.current) b.setAttribute('aria-current', 'page');
          b.disabled = !!opts.disabled;
          b.addEventListener('click', () => { page = to; render(true, true); });
          nav.append(b);
        };
        btn('Previous', page - 1, { disabled: page === 1 });
        for (let i = 1; i <= pages; i++) btn(String(i), i, { current: i === page, label: `Page ${i}` });
        btn('Next', page + 1, { disabled: page === pages });
      }
      if (push) {
        const url = new URL(location.href);
        for (const [k, v] of [['q', query], ['topic', query ? '' : topic], ['page', page > 1 ? String(page) : '']]) {
          if (v) url.searchParams.set(k, v); else url.searchParams.delete(k);
        }
        history.replaceState(null, '', url);
      }
      if (scroll) lib.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    chips.forEach((c) => c.addEventListener('click', () => { topic = c.dataset.topic ?? ''; query = ''; input.value = ''; page = 1; render(true); }));
    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { query = input.value.trim(); topic = ''; page = 1; render(true); }, 150);
    });
    clear.addEventListener('click', () => { input.value = ''; query = ''; page = 1; render(true); input.focus(); });
    const params = new URLSearchParams(location.search);
    query = params.get('q')?.trim() ?? '';
    input.value = query;
    topic = query ? '' : params.get('topic') ?? '';
    page = Number(params.get('page')) || 1;
    render(false);
  });
</script>
