---
// The main ideas of a long-form page or article (pages.key_takeaways),
// rendered before the body for skimmers and for AI answers that quote
// them. Genuine takeaways the page actually covers, never invented to
// fill the list. Renders nothing when empty.
//
// Styled like an editorial "in brief": a heavy rule, a plain heading,
// and numbered points split by hairlines. Deliberately not a tinted card
// with a colored side stripe and checkmarks (the stock AI-site look).
interface Props {
  items: string[];
  heading?: string;
}

const { items, heading = 'Key takeaways' } = Astro.props;
---

{items.length > 0 && (
  <section class="kt mx-auto mb-10 max-w-3xl border-t-[3px] border-brand-ink pt-4" aria-label={heading}>
    <h2 class="font-[family-name:var(--font-heading)] text-lg font-extrabold tracking-tight text-brand-ink">{heading}</h2>
    <ol class="mt-1">
      {items.map((item) => (
        <li class="grid grid-cols-[2.2rem_1fr] gap-1 border-b border-slate-200 py-3 text-[17px] leading-relaxed text-slate-700">{item}</li>
      ))}
    </ol>
  </section>
)}

<style>
  .kt ol { counter-reset: kt; list-style: none; padding: 0; }
  .kt li { counter-increment: kt; }
  .kt li::before { content: counter(kt); font-weight: 800; color: var(--color-brand-accent); font-variant-numeric: tabular-nums; }
</style>
