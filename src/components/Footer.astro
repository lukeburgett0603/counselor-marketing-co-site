---
// Rebuilt as part of the Homepage StoryBrand rebuild — a CTA band above
// a 3-column "junk drawer" (Explore/Company/Legal), plus a social-links
// row using business.same_as, which previously only ever fed JSON-LD
// (buildBusinessSchema's sameAs) and was never actually rendered
// anywhere a visitor could see or click it. See CLAUDE.md's "Homepage
// StoryBrand rebuild" section and 0051_footer_columns_and_cta.sql.
import type { Page, Business } from '../lib/pages';
import { withBase } from '../lib/url';
import { splitWordmark } from '../lib/wordmark';
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

interface Props {
  navPages: Page[];
  business: Business;
}

const { navPages, business } = Astro.props;
const wordmark = splitWordmark(business.display_name);

const footerLinks = navPages
  .filter((p) => p.nav_placement === 'footer')
  .sort((a, b) => a.nav_order - b.nav_order);

function hrefFor(page: Page): string {
  return withBase(page.page_type === 'Homepage' ? '/' : `/${page.slug}`);
}

// footer_column defaults to 'explore' for any page that predates
// 0051_footer_columns_and_cta.sql's backfill or was never explicitly
// categorized — keeps every footer-placed page visible somewhere rather
// than silently dropping it if the column is unset.
const COLUMNS: { key: 'explore' | 'company' | 'legal'; heading: string }[] = [
  { key: 'explore', heading: 'Explore' },
  { key: 'company', heading: 'Company' },
  { key: 'legal', heading: 'Legal' },
];
const columnLinks = COLUMNS.map((col) => ({
  ...col,
  pages: footerLinks.filter((p) => (p.footer_column ?? 'explore') === col.key),
}));

// Built as one string, not `{street_address}, {locality} {region} {zip}` —
// three consecutive expression-space-expression pairs in the markup
// silently lost their in-between spaces at compile time (confirmed live:
// rendered as "LouisvilleKY40243"), while the first comma-space pair
// didn't. One combined expression sidesteps whatever in Astro's compiler
// causes that, rather than chasing it space by space.
const streetLine = [business.street_address, business.street_address_2].filter(Boolean).join(', ');
const fullAddress = streetLine
  ? `${streetLine}, ${business.address_locality} ${business.address_region} ${business.postal_code}`
  : null;

function socialIconFor(url: string): IconName {
  if (/facebook\.com/i.test(url)) return 'facebook';
  if (/instagram\.com/i.test(url)) return 'instagram';
  if (/linkedin\.com/i.test(url)) return 'linkedin';
  return 'external-link';
}
---

<footer class="border-t border-slate-200 bg-brand-secondary text-slate-200">
  <div class="mx-auto max-w-6xl px-6 py-10">
    {/*
      A CTA in the footer, per the redesigned "junk drawer" — deliberately
      NOT a second full CTA.astro band. Every template already ends with
      its own CTA band + LeadGenerator immediately before this footer
      renders, so a second identical bg-brand-primary section here would
      stack three same-weight CTAs in a row. This stays inside the
      footer's own dark band instead — present, but visually subordinate
      to the page's real closing CTA above it.
    */}
    <div class="mb-8 border-b border-white/10 pb-8 text-center">
      <p class="font-[family-name:var(--font-heading)] text-lg font-bold text-white">
        {business.footer_cta_heading ?? `Ready to work with ${business.display_name}?`}
      </p>
      <a
        href={withBase('/contact')}
        class="mt-3 inline-block rounded-md bg-brand-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:opacity-90 hover:shadow-md"
      >
        Contact Us
      </a>
    </div>
    <div class="flex flex-wrap items-start justify-between gap-8">
      <div>
        <p class="font-[family-name:var(--font-heading)] text-lg font-extrabold tracking-tight text-white">
          {wordmark.main}{wordmark.accent && <span class="text-brand-accent">{wordmark.accent}</span>}
        </p>
        {business.telephone && (
          <p class="mt-2 text-sm">
            <a href={`tel:${business.telephone.replace(/[^0-9+]/g, '')}`} class="hover:text-white">
              {business.telephone}
            </a>
          </p>
        )}
        {business.email && (
          <p class="text-sm">
            <a href={`mailto:${business.email}`} class="hover:text-white">
              {business.email}
            </a>
          </p>
        )}
        {fullAddress && (
          <p class="text-sm">
            {business.google_maps_url ? (
              <a href={business.google_maps_url} target="_blank" rel="noopener" class="hover:text-white">
                {fullAddress}
              </a>
            ) : (
              fullAddress
            )}
          </p>
        )}
        {business.same_as.length > 0 && (
          <div class="mt-4 flex gap-3">
            {business.same_as.map((url) => (
              <a href={url} target="_blank" rel="noopener" class="text-slate-300 hover:text-white" aria-label="Visit us online">
                <Icon name={socialIconFor(url)} class="h-5 w-5" />
              </a>
            ))}
          </div>
        )}
      </div>

      {columnLinks.map(
        (col) =>
          col.pages.length > 0 && (
            <nav>
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">{col.heading}</p>
              <ul class="space-y-2">
                {col.pages.map((page) => (
                  <li>
                    <a href={hrefFor(page)} class="text-sm hover:text-white">
                      {page.title}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
      )}
    </div>
    {business.show_crisis_resources && (
      <p class="mt-8 border-t border-white/10 pt-6 text-center text-sm text-slate-200">
        If you are in a mental health crisis, call or text{' '}
        <a href="tel:988" class="font-semibold text-white hover:underline">988</a>
        {' '}to reach the Suicide &amp; Crisis Lifeline, available 24/7.
      </p>
    )}
    <p class="mt-8 text-xs text-slate-400">
      &copy; {new Date().getFullYear()} {business.legal_name ?? business.display_name}. All rights reserved.
      {' · '}
      <a href={withBase('/admin/leads')} class="hover:text-white">Admin Login</a>
      {business.client_portal_url && (
        <>
          {' · '}
          <a href={business.client_portal_url} target="_blank" rel="noopener" class="hover:text-white">
            Client Portal
          </a>
        </>
      )}
    </p>
  </div>
</footer>
