---
// Renders `pages.faqs` as a real, semantic Q&A block — pulled out of `copy`
// (see PlanSteps.astro's sibling pattern) so it's genuinely visible content,
// not just markup for FAQPage JSON-LD to point at. Per schema-markup.md rule
// 6, FAQPage schema is only ever built from what's rendered here — never the
// reverse. Only renders when real Q&A data exists; never invents questions.
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
  heading?: string;
}

const { faqs, heading = 'Common questions' } = Astro.props;
---

{faqs.length > 0 && (
  <section class="bg-brand-neutral py-14">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="mb-8 text-center font-[family-name:var(--font-heading)] text-2xl font-extrabold tracking-tight text-brand-ink">
        {heading}
      </h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-lg border border-black/5 bg-white p-5 shadow-sm transition hover:shadow-md">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-[family-name:var(--font-heading)] font-bold text-brand-ink marker:content-none">
              {faq.question}
              <span class="shrink-0 text-xl leading-none text-brand-accent transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm text-slate-600">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
