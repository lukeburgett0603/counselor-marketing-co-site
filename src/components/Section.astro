---
interface Props {
  heading?: string;
  tight?: boolean;
}

const { heading, tight = false } = Astro.props;
---

{/*
  Canonical "prose section" convention (2026-09-18): a plain markdown/
  text block, no card grid, gets max-w-3xl and left-aligned text — the
  same width Guide.astro/ExplanatoryBrandscript.astro/FAQ.astro already
  use for their own prose. A card-grid section (PlanSteps.astro, the
  benefit-card path in ValueProposition.astro) is the other half of this
  convention: max-w-5xl, a heading centered via a class on the heading
  element itself (never on a wrapping ancestor — that's what let Guide/
  ValueProposition/ExplanatoryBrandscript drift into forcing everything
  downstream, including bullet lists and CTAs, to inherit centering they
  didn't want), left-aligned card content, and a CTA explicitly wrapped
  in its own text-center div so it stays a deliberate centered focal
  point regardless of the prose alignment around it.
*/}
<section class:list={['mx-auto max-w-3xl px-6', tight ? 'py-8' : 'py-14']}>
  {heading && (
    <h2 class="mb-6 font-[family-name:var(--font-heading)] text-2xl font-extrabold tracking-tight text-brand-ink">{heading}</h2>
  )}
  {/*
    No max-w-none here on purpose — Tailwind Typography's own default
    max-width (65ch) is exactly the 45-75-character line length the
    approved Visual Design Brief's type system calls for. Removing it
    (as this div previously did) let every page's body copy stretch to
    the full max-w-4xl container width — part of the "wall of text"
    problem: unconstrained line length reads as dense even when the
    content itself is well-organized. This div's slot is always plain
    markdown-rendered prose (never a card grid — checked every call site
    before making this change), so constraining it here is safe
    everywhere it's used.
  */}
  <div class="prose">
    <slot />
  </div>
</section>
