---
// Wraps astro:assets' Image so every photo on the site (stock photos from
// an external URL, or a client-hosted logo/team photo) gets compressed,
// converted to a modern format, and given explicit dimensions at build
// time — a raw <img src="https://..."> would ship the original file
// untouched and cause layout shift, both of which hurt Core Web Vitals
// (and therefore rankings) and page-load conversion.
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  widths?: number[];
  sizes?: string;
  // Required by Unsplash's API guidelines whenever a photo sourced through
  // their API is used: visible photographer credit linking back to both
  // the photographer and Unsplash. Omit for client-supplied photos (a
  // headshot, a business's own photos) — this is Unsplash-specific, not a
  // general "every image needs a caption" rule.
  creditName?: string;
  creditUrl?: string;
  // Default true. Set false only when this image already sits inside
  // another <a> (a card whose whole body links to the full post/page) —
  // the credit badge is itself an <a>, and a nested <a> is invalid HTML
  // that breaks click behavior unpredictably. The full, uncropped image
  // this thumbnail links to should still show real attribution on its
  // own page; this just avoids a second, nested link on the card.
  showCredit?: boolean;
}

const { src, alt, class: className, loading = 'lazy', widths, sizes, creditName, creditUrl, showCredit = true } =
  Astro.props;

// Unsplash's API guidelines require utm_source to identify the actual
// registered Unsplash Application, not the end client's business — the
// same Unsplash app is typically reused to source images across every
// client site built from this template, so this is one env var set once,
// not per-client copy. Never hardcode a specific client's name here again
// (this was a real bug: shipped as `counselor_marketing_co` for one
// client, which every future client site would have silently inherited).
const unsplashAppName = import.meta.env.PUBLIC_UNSPLASH_APP_NAME || 'local-business-site-template';
---

<div class="relative">
  <Image src={src} alt={alt} inferSize class={className} loading={loading} widths={widths} sizes={sizes} />
  {showCredit && creditName && creditUrl && (
    <a
      href={`${creditUrl}?utm_source=${unsplashAppName}&utm_medium=referral`}
      target="_blank"
      rel="noopener"
      class="absolute bottom-1 right-1 rounded bg-black/50 px-1.5 py-0.5 text-[10px] text-white/90 hover:text-white"
    >
      Photo: {creditName} / Unsplash
    </a>
  )}
</div>
