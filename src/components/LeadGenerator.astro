---
interface Counselor {
  id: string;
  title: string;
}

interface Props {
  slug: string;
  heading?: string;
  collectWebsiteUrl?: boolean;
  responseTimeNote?: string | null;
  // Renders as a card (div, no full-width section/py-14) instead of a
  // standalone page section — meant to sit inside a Hero's aside slot,
  // for pages that also have the full-section form elsewhere. Never
  // remove the full-fields version entirely from a page; an embedded
  // card is a second entry point, not a replacement.
  embedded?: boolean;
  // Field set: fewer fields (no phone/message), a lower-friction ask.
  // Defaults to whatever `embedded` is, matching this component's
  // original behavior (an embedded card always used the leaner field
  // set) — pass compact explicitly to decouple the two, e.g. an
  // embedded card that still shows every field (the Hero overlay
  // style's frosted form; see CLAUDE.md's "Hero overlay style" section).
  compact?: boolean;
  // A translucent, backdrop-blurred card instead of solid white — for
  // sitting on top of a photo (the Hero overlay style). Only meaningful
  // when `embedded` is true; a full-width section wrapper (the default,
  // bottom-of-page form) isn't a "card" in the first place.
  frosted?: boolean;
  submitText?: string;
  // Multi-provider lead routing — opt-in via business.collect_counselor_preference.
  // `counselors` is derived by the caller from allPages (page_type ===
  // 'Counselor Profile'), never hand-curated here or on `business` —
  // see 0023_counselor_preference.sql.
  collectCounselorPreference?: boolean;
  counselors?: Counselor[];
  // Pre-selects this counselor instead of defaulting to "Help me choose" —
  // used on a Counselor Profile page itself, where the visitor has
  // already picked who they want by being on that page.
  defaultCounselorId?: string;
}

const {
  slug,
  heading = "Let's talk about your project",
  collectWebsiteUrl = false,
  responseTimeNote,
  embedded = false,
  compact = embedded,
  frosted = false,
  submitText = 'Send',
  collectCounselorPreference = false,
  counselors = [],
  defaultCounselorId,
} = Astro.props;

const Wrapper = embedded ? 'div' : 'section';
---

<Wrapper
  id={embedded ? undefined : 'lead-generator'}
  class:list={[
    embedded
      ? [
          'rounded-lg p-6',
          frosted ? 'border border-white/30 bg-white/70 shadow-lg backdrop-blur-md' : 'border border-black/5 bg-white shadow-md',
        ]
      : 'bg-white py-14',
  ]}
>
  <div class:list={[embedded ? '' : 'mx-auto max-w-xl px-6']}>
    <h2
      class:list={[
        'mb-4 text-center font-[family-name:var(--font-heading)] font-extrabold tracking-tight text-brand-ink',
        embedded ? 'text-lg' : 'mb-6 text-2xl',
      ]}
    >
      {heading}
    </h2>
    <form
      class="lead-form space-y-3"
      data-source-page={slug}
      data-collect-website={collectWebsiteUrl ? 'true' : 'false'}
    >
      <input
        name="name"
        type="text"
        placeholder="Name"
        required
        class="w-full rounded-md border border-slate-300 px-4 py-2"
      />
      <input
        name="email"
        type="email"
        placeholder="Email"
        required
        class="w-full rounded-md border border-slate-300 px-4 py-2"
      />
      {!compact && (
        <input
          name="phone"
          type="tel"
          placeholder="Phone (optional)"
          class="w-full rounded-md border border-slate-300 px-4 py-2"
        />
      )}
      {collectWebsiteUrl && (
        <input
          name="existing_website_url"
          type="url"
          placeholder="Current website (optional — skip if you don't have one yet)"
          class="w-full rounded-md border border-slate-300 px-4 py-2"
        />
      )}
      {collectCounselorPreference && counselors.length > 0 && (
        <select
          name="preferred_counselor_page_id"
          aria-label="Select a Counselor"
          class="w-full rounded-md border border-slate-300 px-4 py-2 text-slate-700"
        >
          <option value="" selected={!defaultCounselorId}>Help me choose</option>
          {counselors.map((counselor) => (
            <option value={counselor.id} selected={counselor.id === defaultCounselorId}>
              {counselor.title}
            </option>
          ))}
        </select>
      )}
      {!compact && (
        <textarea
          name="message"
          placeholder="How can we help?"
          rows="4"
          class="w-full rounded-md border border-slate-300 px-4 py-2"></textarea>
      )}
      <button
        type="submit"
        class="w-full rounded-md bg-brand-accent px-6 py-3 font-semibold text-white transition hover:opacity-90 hover:shadow-md"
      >
        {submitText}
      </button>
      {responseTimeNote && <p class="text-center text-xs text-slate-500">{responseTimeNote}</p>}
      <p class="lead-form-status text-center text-sm" role="status"></p>
    </form>
  </div>
</Wrapper>

<script>
  // A direct REST call instead of importing @supabase/supabase-js here:
  // the full SDK adds ~200KB of JS to every single page (this component can
  // appear more than once per page now), which drags down Core Web Vitals
  // sitewide for what's still just a one-line insert per submit.
  //
  // Class-based, not id-based: a page can have more than one LeadGenerator
  // (e.g. a compact one in the Hero plus the full one further down) — using
  // getElementById would only ever wire up the first form on the page.
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.lead-form-status');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;
      const formData = new FormData(form);
      status.textContent = 'Sending...';

      const payload: Record<string, unknown> = {
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone') || null,
        message: formData.get('message') || null,
        source_page: form.dataset.sourcePage,
      };
      if (form.dataset.collectWebsite === 'true') {
        payload.existing_website_url = formData.get('existing_website_url') || null;
      }
      if (form.querySelector('[name="preferred_counselor_page_id"]')) {
        payload.preferred_counselor_page_id = formData.get('preferred_counselor_page_id') || null;
      }

      const response = await fetch(`${SUPABASE_URL}/rest/v1/leads`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
          Prefer: 'return=minimal',
        },
        body: JSON.stringify(payload),
      });

      status.textContent = response.ok
        ? 'Thanks! We’ll be in touch soon.'
        : 'Something went wrong — please try again.';
      if (response.ok) form.reset();
    });
  });
</script>
