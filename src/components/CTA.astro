---
import { withBase } from '../lib/url';

interface Props {
  heading: string;
  buttonText?: string;
  href?: string;
}

const { heading, buttonText = 'Contact Us', href = withBase('/contact') } = Astro.props;
---

<section class="bg-brand-primary py-16 text-center text-white md:py-20">
  <div class="reveal mx-auto max-w-3xl px-6">
    <h2 class="font-[family-name:var(--font-heading)] text-2xl font-extrabold tracking-tight md:text-3xl">{heading}</h2>
    <a
      href={href}
      class="btn mt-7 inline-block rounded-lg bg-white px-7 py-3.5 font-semibold text-brand-primary shadow-sm hover:bg-brand-neutral hover:shadow-lg"
    >
      {buttonText}
    </a>
  </div>
</section>
