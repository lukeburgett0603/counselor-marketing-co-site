---
// Renders the StoryBrand "Plan" (webpage-copywriter's 3-4 simple steps) as
// a card grid instead of a numbered list buried in flowing prose — pulled
// out of `copy` into pages.plan_steps precisely so it CAN get this distinct
// treatment. Only renders when real step data exists; never invents steps.
interface Step {
  title: string;
  description: string;
}

interface Props {
  steps: Step[];
  heading?: string;
  note?: string;
}

const { steps, heading = 'How it works', note } = Astro.props;
---

{steps.length > 0 && (
  <section class="bg-brand-neutral py-14">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="mb-8 text-center font-[family-name:var(--font-heading)] text-2xl font-extrabold tracking-tight text-brand-ink">
        {heading}
      </h2>
      <div class="grid gap-6 md:grid-cols-3">
        {steps.map((step, index) => (
          <div class="rounded-lg border border-black/5 bg-white p-6 shadow-md transition duration-200 hover:-translate-y-1 hover:shadow-xl">
            <div class="mb-3 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-accent">
              {index + 1}
            </div>
            <h3 class="mb-2 font-[family-name:var(--font-heading)] font-bold text-brand-ink">{step.title}</h3>
            <p class="text-sm text-slate-600">{step.description}</p>
          </div>
        ))}
      </div>
      {note && <p class="mt-6 text-center text-sm text-slate-600">{note}</p>}
    </div>
  </section>
)}
