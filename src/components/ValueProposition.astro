---
// The positive flip right after Stakes — repurposed from the fields
// that used to back the old collapsible "Explanatory paragraph" trigger
// (storybrand_pitch/storybrand_pitch_label), now the visible heading +
// body of a standalone section, on Homepage rows only. The Explanatory
// Paragraph's own full-brandscript fields (see ExplanatoryBrandscript.
// astro) replaced the old collapsible role. Renders nothing when
// storybrand_pitch is empty — same never-show-an-empty-shell discipline
// as every other optional StoryBrand section.
//
// No image — a real client working session preferred this over the
// original image-beside-text layout once populated with real content
// (a 3-item short list read better as 3 cards than as prose next to a
// photo). Three content shapes, checked in order:
//
// 1. **Card mode** (benefits.length > 0): content shaped as 3-4
//    consecutive `### heading` + paragraph pairs. Stays centered — a
//    centered heading over a centered card grid, matching
//    PlanSteps.astro's own convention — and gets the wider max-w-5xl a
//    3-column grid needs. Reuses lib/markdown.ts's
//    extractShortBenefitList(), the same pattern StoryBrandSection.astro
//    already uses for storybrand_success — not a new detection
//    mechanism.
// 2. **Intro-list mode** (introList, checked when card mode doesn't
//    fire): content shaped as an intro (heading/paragraph) followed by a
//    short trailing bullet list — e.g. a Counselor Profile's "steady
//    steps" beat. A real client caught this exact shape looking broken
//    live (2026-09-18, Luke Burgett's page, "Move Toward Peace,
//    Resilience, and Purpose"): centering a <ul> puts its bullet marker
//    far from its own (centered) text, and even left-aligned it still
//    read as an undesigned list under a heading that felt out of step
//    with the left-aligned headings in the sections above and below.
//    Two columns instead: heading + intro + CTA on the left (all
//    left-aligned, matching Section.astro's/Guide.astro's own
//    convention), the list as a real designed checklist on the right.
//    Reuses lib/markdown.ts's extractIntroList().
// 3. **Plain-prose fallback** (neither of the above): follows
//    Section.astro's own "prose section" convention — max-w-3xl,
//    left-aligned, no centering. See Section.astro's own comment for
//    the fuller writeup of that convention. Safe drop-in regardless of
//    what a given client's copy looks like — every mode renders nothing
//    but real, already-written content, never invents a shape.
import { extractShortBenefitList, extractIntroList } from '../lib/markdown';

interface Props {
  heading?: string | null;
  body: string | null;
  ctaText?: string | null;
}

const { heading, body, ctaText } = Astro.props;
const { beforeHtml, benefits, afterHtml } = extractShortBenefitList(body);
const introList = benefits.length === 0 ? extractIntroList(body) : null;
---

{body && (
  <section class="py-14">
    {introList ? (
      <div class="mx-auto max-w-5xl px-6">
        <div class="grid gap-10 md:grid-cols-2 md:items-center">
          <div>
            {heading && (
              <h2 class="mb-4 font-[family-name:var(--font-heading)] text-2xl font-extrabold tracking-tight text-brand-ink">
                {heading}
              </h2>
            )}
            {introList.introHtml && <div class="prose" set:html={introList.introHtml} />}
            {ctaText && (
              <a
                href="#lead-generator"
                class="mt-6 inline-block rounded-md bg-brand-accent px-6 py-3 font-semibold text-white transition hover:opacity-90 hover:shadow-md"
              >
                {ctaText}
              </a>
            )}
          </div>
          <ul class="space-y-4">
            {introList.items.map((item) => (
              <li class="flex items-start gap-3 rounded-lg border border-black/5 bg-white p-4 shadow-sm">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-0.5 h-5 w-5 shrink-0 text-brand-primary"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M8.5 12.5l2.5 2.5 5-5"></path>
                </svg>
                <span class="text-brand-ink" set:html={item} />
              </li>
            ))}
          </ul>
        </div>
      </div>
    ) : (
      <div class:list={['mx-auto px-6', benefits.length > 0 ? 'max-w-5xl text-center' : 'max-w-3xl']}>
        {heading && (
          <h2 class:list={['mb-4 font-[family-name:var(--font-heading)] text-2xl font-extrabold tracking-tight text-brand-ink', benefits.length > 0 && 'text-center']}>
            {heading}
          </h2>
        )}
        {beforeHtml && <div class:list={['prose', benefits.length > 0 && 'mx-auto']} set:html={beforeHtml} />}

        {benefits.length > 0 && (
          <div class="mt-8 grid gap-6 sm:grid-cols-3">
            {benefits.map((benefit) => (
              <div class="rounded-lg border border-black/5 bg-white p-6 text-center shadow-md transition duration-200 hover:-translate-y-1 hover:shadow-xl">
                <h3 class="mb-2 font-[family-name:var(--font-heading)] font-bold text-brand-ink">{benefit.title}</h3>
                <p class="text-sm text-slate-600">{benefit.description}</p>
              </div>
            ))}
          </div>
        )}

        {afterHtml && <div class:list={['prose mt-6', benefits.length > 0 && 'mx-auto']} set:html={afterHtml} />}

        {ctaText && (
          <div class="mt-8 text-center">
            <a
              href="#lead-generator"
              class="inline-block rounded-md bg-brand-accent px-6 py-3 font-semibold text-white transition hover:opacity-90 hover:shadow-md"
            >
              {ctaText}
            </a>
          </div>
        )}
      </div>
    )}
  </section>
)}
