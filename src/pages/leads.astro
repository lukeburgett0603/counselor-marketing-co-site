---
// Internal-only: view lead submissions without opening Supabase Studio.
// Not part of the CMS page system (no `pages` row) — a static shell whose
// content is entirely client-side, gated by Supabase Auth. Excluded from
// the sitemap (astro.config.mjs) and never linked from public nav/footer.
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Leads</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-screen bg-brand-neutral">
    <div class="mx-auto max-w-5xl px-6 py-10">
      <h1 class="mb-6 font-[family-name:var(--font-heading)] text-2xl font-bold text-brand-ink">Leads</h1>

      <div id="login-view" class="mx-auto max-w-sm">
        <p class="mb-6 text-center text-sm text-slate-600">
          Log in to see everyone who's submitted your website's contact/audit request
          form — name, email, phone, and message, most recent first.
        </p>
        <form id="login-form" class="space-y-4">
          <input
            name="email"
            type="email"
            placeholder="Email"
            required
            class="w-full rounded-md border border-slate-300 px-4 py-2"
          />
          <input
            name="password"
            type="password"
            placeholder="Password"
            required
            class="w-full rounded-md border border-slate-300 px-4 py-2"
          />
          <button
            type="submit"
            class="w-full rounded-md bg-brand-primary px-6 py-3 font-semibold text-white hover:opacity-90"
          >
            Log in
          </button>
          <p id="login-status" class="text-center text-sm text-red-600" role="status"></p>
        </form>
      </div>

      <div id="set-password-view" class="mx-auto hidden max-w-sm">
        <p class="mb-4 text-sm text-slate-600">
          Set a password to finish setting up your login for viewing website leads.
        </p>
        <form id="set-password-form" class="space-y-4">
          <input
            name="password"
            type="password"
            placeholder="New password"
            required
            minlength="8"
            class="w-full rounded-md border border-slate-300 px-4 py-2"
          />
          <button
            type="submit"
            class="w-full rounded-md bg-brand-primary px-6 py-3 font-semibold text-white hover:opacity-90"
          >
            Set password
          </button>
          <p id="set-password-status" class="text-center text-sm text-red-600" role="status"></p>
        </form>
      </div>

      <div id="leads-view" class="hidden">
        <!--
          Real-data proof-of-work dashboard, computed entirely client-side
          from the same `leads` fetch the table below already does — no
          second query, no new table, no analytics tool wired in yet (see
          CLAUDE.md's "Outstanding" for the traffic/rankings tiers planned
          on top of this later). This exists so a client can see their
          marketing is working without waiting on a monthly report.
        -->
        <div class="mb-8 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Total leads</p>
            <p id="stat-total" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
          </div>
          <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">This month</p>
            <p id="stat-this-month" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
            <p id="stat-month-change" class="mt-1 text-xs"></p>
          </div>
          <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Last month</p>
            <p id="stat-last-month" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
          </div>
        </div>

        <div class="mb-8 rounded-lg border border-black/5 bg-white p-5 shadow-sm">
          <p class="mb-4 text-xs font-semibold uppercase tracking-wide text-slate-500">Leads per week (last 10 weeks)</p>
          <div id="weekly-chart" class="flex h-32 gap-2"></div>
        </div>

        <div class="mb-8 rounded-lg border border-black/5 bg-white p-5 shadow-sm">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Leads by page</p>
          <div id="by-page-list" class="space-y-2 text-sm"></div>
        </div>

        <div class="mb-4 flex items-center justify-between">
          <p id="leads-count" class="text-sm text-slate-600"></p>
          <button id="logout-button" class="text-sm text-brand-primary hover:underline">Log out</button>
        </div>
        <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-slate-200 bg-slate-50">
              <tr>
                <th class="px-4 py-3 font-semibold">Date</th>
                <th class="px-4 py-3 font-semibold">Name</th>
                <th class="px-4 py-3 font-semibold">Email</th>
                <th class="px-4 py-3 font-semibold">Phone</th>
                <th class="px-4 py-3 font-semibold">Current site</th>
                <th class="px-4 py-3 font-semibold">Message</th>
                <th class="px-4 py-3 font-semibold">From page</th>
                <th class="px-4 py-3 font-semibold">Status</th>
              </tr>
            </thead>
            <tbody id="leads-table-body"></tbody>
          </table>
        </div>
      </div>
    </div>

    <script>
      import { supabase } from '../lib/supabase';

      const loginView = document.getElementById('login-view')!;
      const setPasswordView = document.getElementById('set-password-view')!;
      const leadsView = document.getElementById('leads-view')!;
      const loginForm = document.getElementById('login-form') as HTMLFormElement;
      const setPasswordForm = document.getElementById('set-password-form') as HTMLFormElement;
      const loginStatus = document.getElementById('login-status')!;
      const setPasswordStatus = document.getElementById('set-password-status')!;
      const logoutButton = document.getElementById('logout-button')!;
      const tableBody = document.getElementById('leads-table-body')!;
      const leadsCount = document.getElementById('leads-count')!;

      function hideAllViews() {
        loginView.classList.add('hidden');
        setPasswordView.classList.add('hidden');
        leadsView.classList.add('hidden');
      }

      function escapeHtml(value: string): string {
        const div = document.createElement('div');
        div.textContent = value;
        return div.innerHTML;
      }

      type Lead = {
        created_at: string;
        name: string | null;
        email: string | null;
        phone: string | null;
        message: string | null;
        existing_website_url: string | null;
        source_page: string | null;
        status: string | null;
      };

      function renderDashboard(leads: Lead[]) {
        const now = new Date();
        const startOfThisMonth = new Date(now.getFullYear(), now.getMonth(), 1);
        const startOfLastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);

        const thisMonthCount = leads.filter((l) => new Date(l.created_at) >= startOfThisMonth).length;
        const lastMonthCount = leads.filter((l) => {
          const d = new Date(l.created_at);
          return d >= startOfLastMonth && d < startOfThisMonth;
        }).length;

        document.getElementById('stat-total')!.textContent = String(leads.length);
        document.getElementById('stat-this-month')!.textContent = String(thisMonthCount);
        document.getElementById('stat-last-month')!.textContent = String(lastMonthCount);

        const changeEl = document.getElementById('stat-month-change')!;
        if (lastMonthCount > 0) {
          const pct = Math.round(((thisMonthCount - lastMonthCount) / lastMonthCount) * 100);
          changeEl.textContent = `${pct > 0 ? '+' : ''}${pct}% vs last month`;
          changeEl.className = 'mt-1 text-xs ' + (pct >= 0 ? 'text-emerald-600' : 'text-red-500');
        } else if (thisMonthCount > 0) {
          changeEl.textContent = 'No leads last month';
          changeEl.className = 'mt-1 text-xs text-slate-500';
        } else {
          changeEl.textContent = '';
        }

        // Weekly chart: last 10 Monday-start weeks, bucketed client-side —
        // no SQL date_trunc needed for a dataset this small.
        const WEEKS = 10;
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const dayOfWeek = (today.getDay() + 6) % 7; // Mon=0 ... Sun=6
        const mondayThisWeek = new Date(today);
        mondayThisWeek.setDate(today.getDate() - dayOfWeek);

        const weekBuckets: { start: Date; end: Date; count: number }[] = [];
        for (let i = WEEKS - 1; i >= 0; i--) {
          const start = new Date(mondayThisWeek);
          start.setDate(mondayThisWeek.getDate() - i * 7);
          const end = new Date(start);
          end.setDate(start.getDate() + 7);
          weekBuckets.push({ start, end, count: 0 });
        }
        for (const lead of leads) {
          const d = new Date(lead.created_at);
          const bucket = weekBuckets.find((b) => d >= b.start && d < b.end);
          if (bucket) bucket.count++;
        }
        const maxWeekCount = Math.max(1, ...weekBuckets.map((b) => b.count));
        const chartEl = document.getElementById('weekly-chart')!;
        chartEl.innerHTML = weekBuckets
          .map((b) => {
            const heightPct = Math.max(Math.round((b.count / maxWeekCount) * 100), b.count > 0 ? 6 : 2);
            const label = b.start.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
            return `
          <div class="flex flex-1 flex-col items-center justify-end gap-1" title="${b.count} lead${b.count === 1 ? '' : 's'} — week of ${label}">
            <span class="text-[10px] font-semibold text-slate-500">${b.count > 0 ? b.count : ''}</span>
            <div class="w-full rounded-t bg-brand-accent" style="height: ${heightPct}%"></div>
            <span class="text-[9px] text-slate-400">${label}</span>
          </div>`;
          })
          .join('');

        // Which pages are actually converting — ties lead volume back to
        // specific content/SEO work, not just an undifferentiated total.
        const byPage = new Map<string, number>();
        for (const lead of leads) {
          const key = lead.source_page || '(unknown page)';
          byPage.set(key, (byPage.get(key) ?? 0) + 1);
        }
        const sorted = [...byPage.entries()].sort((a, b) => b[1] - a[1]);
        const byPageEl = document.getElementById('by-page-list')!;
        if (sorted.length === 0) {
          byPageEl.innerHTML = '<p class="text-slate-500">No leads yet.</p>';
        } else {
          const maxPageCount = sorted[0][1];
          byPageEl.innerHTML = sorted
            .map(
              ([page, count]) => `
          <div class="flex items-center gap-3">
            <span class="w-32 shrink-0 truncate text-slate-700">${escapeHtml(page)}</span>
            <div class="h-2 flex-1 rounded-full bg-slate-100">
              <div class="h-2 rounded-full bg-brand-accent" style="width: ${Math.round((count / maxPageCount) * 100)}%"></div>
            </div>
            <span class="w-6 shrink-0 text-right font-semibold text-brand-ink">${count}</span>
          </div>`
            )
            .join('');
        }
      }

      async function loadLeads() {
        const { data, error } = await supabase
          .from('leads')
          .select('*')
          .order('created_at', { ascending: false });

        if (error) {
          leadsCount.textContent = 'Could not load leads: ' + error.message;
          return;
        }

        renderDashboard(data);

        leadsCount.textContent = `${data.length} lead${data.length === 1 ? '' : 's'}`;
        tableBody.innerHTML = data
          .map(
            (lead) => `
          <tr class="border-b border-slate-100 last:border-0">
            <td class="px-4 py-3 whitespace-nowrap">${new Date(lead.created_at).toLocaleDateString()}</td>
            <td class="px-4 py-3">${escapeHtml(lead.name ?? '')}</td>
            <td class="px-4 py-3">${escapeHtml(lead.email ?? '')}</td>
            <td class="px-4 py-3">${escapeHtml(lead.phone ?? '')}</td>
            <td class="px-4 py-3">${lead.existing_website_url ? `<a href="${escapeHtml(lead.existing_website_url)}" target="_blank" rel="noopener" class="text-brand-primary hover:underline">link</a>` : ''}</td>
            <td class="px-4 py-3 max-w-xs truncate" title="${escapeHtml(lead.message ?? '')}">${escapeHtml(lead.message ?? '')}</td>
            <td class="px-4 py-3">${escapeHtml(lead.source_page ?? '')}</td>
            <td class="px-4 py-3">${escapeHtml(lead.status ?? '')}</td>
          </tr>`
          )
          .join('');
      }

      async function showAuthedState() {
        hideAllViews();
        leadsView.classList.remove('hidden');
        await loadLeads();
      }

      function showLoginState() {
        hideAllViews();
        loginView.classList.remove('hidden');
      }

      function showSetPasswordState() {
        hideAllViews();
        setPasswordView.classList.remove('hidden');
      }

      // An invite/recovery email link lands here with `type=invite` or
      // `type=recovery` in the URL hash. supabase-js (detectSessionInUrl,
      // on by default) parses that automatically and establishes a
      // session — but the person still needs to actually set a password,
      // since an invited user doesn't have one yet.
      const hashParams = new URLSearchParams(window.location.hash.slice(1));
      const isPasswordSetupLink = ['invite', 'recovery'].includes(hashParams.get('type') ?? '');

      supabase.auth.getSession().then(({ data }) => {
        if (isPasswordSetupLink && data.session) {
          showSetPasswordState();
        } else if (data.session) {
          showAuthedState();
        }
      });

      loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        loginStatus.textContent = '';
        const formData = new FormData(loginForm);
        const { error } = await supabase.auth.signInWithPassword({
          email: formData.get('email') as string,
          password: formData.get('password') as string,
        });
        if (error) {
          loginStatus.textContent = error.message;
          return;
        }
        await showAuthedState();
      });

      setPasswordForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        setPasswordStatus.textContent = '';
        const formData = new FormData(setPasswordForm);
        const { error } = await supabase.auth.updateUser({
          password: formData.get('password') as string,
        });
        if (error) {
          setPasswordStatus.textContent = error.message;
          return;
        }
        history.replaceState(null, '', window.location.pathname);
        await showAuthedState();
      });

      logoutButton.addEventListener('click', async () => {
        await supabase.auth.signOut();
        showLoginState();
      });
    </script>
  </body>
</html>
