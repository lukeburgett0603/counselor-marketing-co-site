---
import { getPublishedPages, getBusiness } from '../lib/pages';
import type { Page, PageType } from '../lib/pages';
import Homepage from '../templates/Homepage.astro';
import About from '../templates/About.astro';
import ServicesOverview from '../templates/ServicesOverview.astro';
import ServicePage from '../templates/ServicePage.astro';
import ContentPillar from '../templates/ContentPillar.astro';
import CounselorProfile from '../templates/CounselorProfile.astro';
import ServiceArea from '../templates/ServiceArea.astro';
import Contact from '../templates/Contact.astro';
import Other from '../templates/Other.astro';
import BlogPost from '../templates/BlogPost.astro';
import BlogIndex from '../templates/BlogIndex.astro';
import WhoWeServe from '../templates/WhoWeServe.astro';
import ServiceAreasOverview from '../templates/ServiceAreasOverview.astro';

// Homepage renders at "/" via index.astro instead, so it's excluded here
// even though it's still part of allPages (needed for nav/breadcrumbs).
export async function getStaticPaths() {
  const pages = await getPublishedPages();
  return pages
    .filter((p) => p.page_type !== 'Homepage')
    .map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

interface Props {
  page: Page;
}

const { page } = Astro.props as Props;
const allPages = await getPublishedPages();
const business = await getBusiness();

const templateByType: Record<PageType, unknown> = {
  Homepage: Homepage,
  About: About,
  'Services Overview': ServicesOverview,
  'Service Page': ServicePage,
  'Content Pillar': ContentPillar,
  'Counselor Profile': CounselorProfile,
  'Service Area': ServiceArea,
  Contact: Contact,
  Other: Other,
  'Blog Post': BlogPost,
  'Blog Index': BlogIndex,
  'Who We Serve': WhoWeServe,
  'Service Areas Overview': ServiceAreasOverview,
};

const Template = templateByType[page.page_type] as typeof Homepage;
---

<Template page={page} allPages={allPages} business={business} />
