---
// 2026-09-30 rebuild: most public pages are now authored in src/pages/
// (see rebuild/site-architecture.md). Supabase still owns the content
// that's edited from the admin: topic hubs (Content Pillar rows with a
// category), blog posts, the blog index, and the legal pages. Every other
// `pages` row is superseded by a code-authored page or a redirect, and is
// deliberately not built here (it would collide with those routes).
import { getPublishedPages } from '../lib/pages';
import type { Page } from '../lib/pages';
import SupabasePage from '../templates/SupabasePage.astro';

export async function getStaticPaths() {
  const pages = await getPublishedPages();
  return pages
    .filter(
      (p: Page) =>
        p.page_type === 'Blog Post' ||
        p.page_type === 'Blog Index' ||
        p.page_type === 'Other' ||
        (p.page_type === 'Content Pillar' && !!p.category),
    ).map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

interface Props {
  page: Page;
}
const { page } = Astro.props as Props;
const allPages = await getPublishedPages();
---

<SupabasePage page={page} allPages={allPages} />
