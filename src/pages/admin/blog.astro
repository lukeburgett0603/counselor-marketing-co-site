---
import AdminLayout from '../../layouts/AdminLayout.astro';
import RichTextEditor from '../../components/RichTextEditor.astro';
import UnsplashSearchModal from '../../components/UnsplashSearchModal.astro';
---

<AdminLayout title="Blog posts | Admin" current="blog">
  <div id="blog-list-view">
    <p class="i-intro">Write, schedule and publish articles for your website.</p>
    <div class="i-toolbar">
      <div class="i-seg" role="group" aria-label="Show" id="bp-filter">
        <button type="button" data-filter="all" aria-pressed="true">All <b class="a-num" id="bp-n-all"></b></button>
        <button type="button" data-filter="published" aria-pressed="false">Published <b class="a-num" id="bp-n-pub"></b></button>
        <button type="button" data-filter="draft" aria-pressed="false">Drafts <b class="a-num" id="bp-n-draft"></b></button>
      </div>
      <div class="i-actions">
        <label class="i-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input id="bp-search" type="text" placeholder="Search posts" aria-label="Search posts" />
        </label>
        <button id="new-post-button" type="button" class="a-btn a-btn-primary i-btn">+ New post</button>
      </div>
    </div>
    <section class="t-card bp-listcard">
      <h2>Posts<span class="t-aside" id="blog-count"></span></h2>
      <ul id="blog-table-body" class="bp-list"></ul>
      <div id="bp-empty" class="t-empty" hidden></div>
    </section>
  </div>

  <div id="blog-edit-view" class="hidden">
    <div class="i-detail-top">
      <button id="back-to-list-button" type="button" class="a-link">&larr; All posts</button>
      <span class="bp-state" id="bp-state"></span>
    </div>
    <h2 id="edit-heading" class="sr-only">New post</h2>
    <p id="not-your-post-note" class="i-banner hidden">
      Someone else wrote this post. You can read it, but only its author or the practice owner can edit it.
    </p>
    <!--
      Shown only when this drafting session came from a Content Plan
      "Draft blog post" hand-off — ties this exact screen back to the
      exact content-plan row it came from, and surfaces the real target
      keyword + placement guidance right where someone's about to write,
      instead of leaving them to remember it from a popup they already
      closed. See admin/content-plan.astro's startBlogDraftHandoff() and
      applyDraftHandoffIfPresent() below.
    -->
    <div id="plan-context-panel" class="hidden t-card bp-plan">
      <p class="bp-plan-k">Drafting from your Content plan</p>
      <p id="plan-context-title" class="bp-plan-t"></p>
      <p id="plan-context-keyword-row" class="bp-plan-kw"></p>
      <p id="plan-context-question" class="hidden bp-plan-q"></p>
      <details class="r-rules">
        <summary>How to work the keyword in naturally</summary>
        <ul>
          <li>Work the keyword's core topic words into the post title — title tags are one of the strongest on-page SEO signals, and the first thing both search engines and AI answer engines match against. Skip the literal "near me"/long-tail wording in the headline itself; keep the substantive topic words instead.</li>
          <li>Use the exact phrase once in a heading, only if it fits naturally there.</li>
          <li>State the core fact plainly within the first ~100 words.</li>
          <li>Repeat it naturally 2-7 times total — never force it, and use natural variations the rest of the time instead of the exact phrase everywhere.</li>
          <li>Bold the keyword the first time it appears in the body.</li>
          <li>Never chase a density number — a clear, natural, thorough post beats mechanical keyword placement every time.</li>
        </ul>
      </details>
    </div>
    <form id="post-form" class="bp-form">
      <div class="bp-main">
        <section class="t-card bp-write">
          <input id="field-title" name="title" type="text" required placeholder="Post title" aria-label="Title" class="bp-title" />
          <div class="bp-slug">
            <span>Web address: /</span>
            <input id="field-slug" name="slug" type="text" required aria-label="Web address" />
          </div>
          <div class="bp-copy">
            <RichTextEditor
              id="field-copy"
              helpText="Heading 1 is reserved for the post title. Use Heading 2 and Heading 3 for sections within the post."
            />
          </div>
        </section>
        <section class="t-card">
          <h2>Key takeaways<span class="t-aside">Optional, one per line</span></h2>
          <textarea id="field-takeaways" name="takeaways" rows="3" class="bp-area" placeholder="Shown as a short summary box at the top of the post"></textarea>
        </section>
      </div>

      <aside class="bp-side">
        <section class="t-card i-fields">
          <div class="i-field">
            <label for="field-date">Publish date</label>
            <input id="field-date" name="datePublished" type="date" required />
          </div>
          <div class="i-field">
            <label for="field-category">Category</label>
            <select id="field-category" name="category" required></select>
          </div>
          <div class="i-field">
            <label for="field-author">Author</label>
            <input id="field-author" name="author" type="text" required />
          </div>
          <div class="i-field">
            <label for="field-credentials">Credentials</label>
            <input id="field-credentials" name="credentials" type="text" placeholder="LPC, LMFT" />
          </div>
          <div class="bp-actions">
            <button id="publish-button" type="button" class="a-btn a-btn-primary">Publish</button>
            <button id="save-draft-button" type="button" class="a-btn">Save draft</button>
          </div>
          <p id="post-form-status" class="i-hint" role="status"></p>
          <button id="delete-post-button" type="button" class="a-link i-danger hidden bp-delete">Delete post</button>
        </section>

        <section class="t-card i-fields">
          <h2>Hero image<span class="t-aside">Optional</span></h2>
          <img id="field-image-preview" class="hidden bp-img" alt="" />
          <div class="i-inline">
            <button id="search-unsplash-button" type="button" class="a-btn i-btn">Search Unsplash</button>
            <label for="field-image-file" class="a-btn i-btn">Upload</label>
            <input id="field-image-file" type="file" accept="image/*" class="sr-only" />
          </div>
          <p id="field-image-status" class="i-hint"></p>
          <div class="i-field">
            <label for="field-image-alt">Describe the photo</label>
            <input id="field-image-alt" name="imageAlt" type="text" placeholder="For screen readers and Google" />
          </div>
        </section>

        <section class="t-card i-fields">
          <h2>Google preview</h2>
          <div class="bp-serp" aria-hidden="true">
            <span class="bp-serp-url" id="bp-serp-url"></span>
            <span class="bp-serp-t" id="bp-serp-t"></span>
            <span class="bp-serp-d" id="bp-serp-d"></span>
          </div>
          <div class="i-field">
            <label for="field-meta">Search description <span class="bp-count" id="bp-meta-count"></span></label>
            <textarea id="field-meta" name="metaDescription" rows="3" required class="bp-area"></textarea>
          </div>
        </section>
      </aside>
    </form>
  </div>

  <UnsplashSearchModal />
</AdminLayout>

<script>
  import { supabase, initAdminAuth, type AdminUser } from '../../lib/adminAuth';
  import { initRichTextEditor } from '../../lib/richTextEditor';
  import { triggerRebuild } from '../../lib/publishFunction';
  import { initUnsplashSearchModal, type UnsplashPhoto } from '../../lib/unsplashSearch';
  import { withBase } from '../../lib/url';

  type BlogPost = {
    id: string;
    title: string;
    slug: string;
    category: string | null;
    status: string;
    date_published: string | null;
    h1: string | null;
    meta_description: string | null;
    copy: string | null;
    key_takeaways: string[];
    author_name: string | null;
    credentials: string | null;
    images: { hero?: { url: string; alt: string; creditName?: string; creditUrl?: string } } | null;
    created_by: string | null;
  };

  const listView = document.getElementById('blog-list-view')!;
  const editView = document.getElementById('blog-edit-view')!;
  const blogCount = document.getElementById('blog-count')!;
  const tableBody = document.getElementById('blog-table-body')!;
  const newPostButton = document.getElementById('new-post-button')!;
  const backButton = document.getElementById('back-to-list-button')!;
  const editHeading = document.getElementById('edit-heading')!;
  const postForm = document.getElementById('post-form') as HTMLFormElement;
  const formStatus = document.getElementById('post-form-status')!;
  const saveDraftButton = document.getElementById('save-draft-button')! as HTMLButtonElement;
  const publishButton = document.getElementById('publish-button')! as HTMLButtonElement;
  const deleteButton = document.getElementById('delete-post-button')! as HTMLButtonElement;
  const notYourPostNote = document.getElementById('not-your-post-note')!;
  const planContextPanel = document.getElementById('plan-context-panel')!;
  const planContextTitle = document.getElementById('plan-context-title')!;
  const planContextKeywordRow = document.getElementById('plan-context-keyword-row')!;
  const planContextQuestion = document.getElementById('plan-context-question')!;

  const titleField = document.getElementById('field-title') as HTMLInputElement;
  const slugField = document.getElementById('field-slug') as HTMLInputElement;
  const categoryField = document.getElementById('field-category') as HTMLSelectElement;
  const imageFileField = document.getElementById('field-image-file') as HTMLInputElement;
  const imageStatus = document.getElementById('field-image-status')!;
  const imagePreview = document.getElementById('field-image-preview') as HTMLImageElement;
  const imageAltField = document.getElementById('field-image-alt') as HTMLInputElement;
  const metaField = document.getElementById('field-meta') as HTMLTextAreaElement;
  const copyEditor = initRichTextEditor('field-copy');
  const takeawaysField = document.getElementById('field-takeaways') as HTMLTextAreaElement;
  const authorField = document.getElementById('field-author') as HTMLInputElement;
  const credentialsField = document.getElementById('field-credentials') as HTMLInputElement;
  const dateField = document.getElementById('field-date') as HTMLInputElement;

  let posts: BlogPost[] = [];
  let editingId: string | null = null;
  let slugTouchedManually = false;
  let uploadedImageUrl: string | null = null;
  let uploadedImageCreditName: string | null = null;
  let uploadedImageCreditUrl: string | null = null;
  let currentAdminUser: AdminUser | null = null;
  // Set only when this editing session started from a Content Plan
  // "Draft blog post" hand-off — see applyDraftHandoffIfPresent() below.
  // Used after a successful save to write the result back onto that
  // content_plan_items row.
  let currentPlanItemId: string | null = null;

  function canEditPost(post: BlogPost): boolean {
    return (
      currentAdminUser?.role === 'owner' ||
      currentAdminUser?.role === 'agency' ||
      post.created_by === currentAdminUser?.id
    );
  }

  function slugify(text: string): string {
    return text
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function renderPlanContextPanel(ctx: { title: string; keyword: string | null; targetQuestion: string | null } | null) {
    if (!ctx) {
      planContextPanel.classList.add('hidden');
      return;
    }
    planContextTitle.textContent = ctx.title;
    planContextKeywordRow.innerHTML = ctx.keyword
      ? `Target keyword: <strong>${escapeHtml(ctx.keyword)}</strong>`
      : 'No target keyword set on this content plan item.';
    if (ctx.targetQuestion) {
      planContextQuestion.textContent = `Consider directly answering: "${ctx.targetQuestion}"`;
      planContextQuestion.classList.remove('hidden');
    } else {
      planContextQuestion.classList.add('hidden');
    }
    planContextPanel.classList.remove('hidden');
  }

  titleField.addEventListener('input', () => {
    if (!slugTouchedManually) {
      slugField.value = slugify(titleField.value);
    }
  });
  slugField.addEventListener('input', () => {
    slugTouchedManually = true;
  });

  async function loadCategories() {
    // Both 'Content Pillar' and 'Service Hub' can own a category (see
    // BlogPost.astro's identical hub lookup) — a client whose service
    // pages are all Service Hub (Freedom Counseling Services) had zero
    // Content Pillar rows, so this query returned nothing and the
    // dropdown rendered empty.
    const { data, error } = await supabase.from('pages').select('category').in('page_type', ['Content Pillar', 'Service Hub']);
    const categories = error
      ? []
      : [...new Set((data ?? []).map((r) => r.category).filter((c): c is string => !!c))].sort();
    categoryField.innerHTML = categories.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
  }

  async function loadPosts() {
    const { data, error } = await supabase
      .from('pages')
      .select('*')
      .eq('page_type', 'Blog Post')
      .order('date_published', { ascending: false });

    if (error) {
      blogCount.textContent = 'Could not load posts: ' + error.message;
      return;
    }
    posts = data as BlogPost[];
    renderList();
  }

  // --- List (admin redesign): filter + search over the loaded posts ---
  let listFilter: 'all' | 'published' | 'draft' = 'all';
  const isPublished = (p: BlogPost) => p.status === 'content-complete';
  const searchField = document.getElementById('bp-search') as HTMLInputElement;

  function postDate(p: BlogPost): string {
    return p.date_published
      ? new Date(p.date_published + 'T00:00:00').toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })
      : 'No date';
  }

  function renderList() {
    const pub = posts.filter(isPublished).length;
    document.getElementById('bp-n-all')!.textContent = String(posts.length);
    document.getElementById('bp-n-pub')!.textContent = String(pub);
    document.getElementById('bp-n-draft')!.textContent = String(posts.length - pub);
    const q = searchField.value.trim().toLowerCase();
    const rows = posts.filter(
      (p) =>
        (listFilter === 'all' || (listFilter === 'published') === isPublished(p)) &&
        (!q || [p.title, p.category ?? '', p.author_name ?? ''].some((v) => v.toLowerCase().includes(q)))
    );
    blogCount.textContent = `${rows.length} post${rows.length === 1 ? '' : 's'}`;
    const empty = document.getElementById('bp-empty')!;
    empty.hidden = rows.length > 0;
    empty.innerHTML = posts.length
      ? '<b>No posts match.</b>Try a different filter or search.'
      : '<b>No posts yet.</b>Start one with New post, or draft one from an idea in your Content plan.';
    tableBody.innerHTML = rows
      .map((post) => {
        const img = post.images?.hero?.url;
        const today = new Date().toISOString().slice(0, 10);
        const scheduled = isPublished(post) && post.date_published && post.date_published > today;
        const state = !isPublished(post) ? '<span class="bp-pill">Draft</span>' : scheduled ? '<span class="bp-pill bp-pill-s">Scheduled</span>' : '<span class="bp-pill bp-pill-p">Published</span>';
        return `<li class="bp-row" data-edit-id="${post.id}" tabindex="0">
          <span class="bp-thumb">${img ? `<img src="${escapeHtml(img)}" alt="" loading="lazy" />` : `<span>${escapeHtml((post.title.trim()[0] ?? '?').toUpperCase())}</span>`}</span>
          <div class="bp-row-main"><b>${escapeHtml(post.title)}</b><small>${escapeHtml([post.category, post.author_name].filter(Boolean).join(' · '))}</small></div>
          ${state}
          <span class="bp-date i-hide-sm">${postDate(post)}</span>
        </li>`;
      })
      .join('');
  }

  document.getElementById('bp-filter')!.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-filter]');
    if (!button) return;
    listFilter = button.dataset.filter as typeof listFilter;
    document.querySelectorAll('#bp-filter [data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    renderList();
  });
  searchField.addEventListener('input', renderList);

  // --- Editor extras: state chip and live Google preview ---
  const stateChip = document.getElementById('bp-state')!;
  function renderState(post: BlogPost | null) {
    stateChip.innerHTML = !post
      ? '<span class="bp-pill">New post</span>'
      : isPublished(post)
        ? `<span class="bp-pill bp-pill-p">Published</span> <a class="a-link" href="${withBase('/' + post.slug.replace(/^\/+/, ''))}" target="_blank" rel="noopener">View post</a>`
        : '<span class="bp-pill">Draft</span>';
  }

  function renderSerp() {
    const title = titleField.value.trim() || 'Post title';
    document.getElementById('bp-serp-t')!.textContent = `${title} | Blog`;
    document.getElementById('bp-serp-url')!.textContent = `${location.host}${withBase('/' + (slugField.value.trim() || 'post-address'))}`;
    const meta = metaField.value.trim();
    document.getElementById('bp-serp-d')!.textContent = meta || 'Your search description shows here. Write one or two sentences about what the reader will learn.';
    // Google typically shows about 150-160 characters of a description.
    const count = document.getElementById('bp-meta-count')!;
    count.textContent = `${meta.length} / 160`;
    count.className = 'bp-count' + (meta.length > 160 ? ' r-warn' : '');
  }
  [titleField, slugField, metaField].forEach((f) => f.addEventListener('input', renderSerp));

  function showList() {
    editView.classList.add('hidden');
    listView.classList.remove('hidden');
  }

  function showEdit() {
    listView.classList.add('hidden');
    editView.classList.remove('hidden');
  }

  function resetForm() {
    editingId = null;
    // Reset here, not just at module init — otherwise a genuinely new,
    // unrelated post started via "New post" right after a Content Plan
    // hand-off would incorrectly stay linked to that earlier plan item.
    currentPlanItemId = null;
    renderPlanContextPanel(null);
    slugTouchedManually = false;
    uploadedImageUrl = null;
    uploadedImageCreditName = null;
    uploadedImageCreditUrl = null;
    postForm.reset();
    copyEditor.setMarkdown(null);
    imageStatus.textContent = '';
    imagePreview.classList.add('hidden');
    imagePreview.src = '';
    deleteButton.classList.add('hidden');
    editHeading.textContent = 'New post';
    dateField.value = new Date().toISOString().slice(0, 10);
    setFormReadOnly(false);
    renderState(null);
    renderSerp();
  }

  // Staff can view any post (the list itself, and the pages SELECT
  // policy, are unrestricted) but only ever write their own — RLS would
  // reject a write to someone else's post anyway, but disabling the
  // controls up front avoids sending someone through the whole edit flow
  // just to hit an opaque rejected-write error at the end.
  function setFormReadOnly(readOnly: boolean) {
    notYourPostNote.classList.toggle('hidden', !readOnly);
    saveDraftButton.disabled = readOnly;
    publishButton.disabled = readOnly;
    deleteButton.disabled = readOnly;
    for (const field of postForm.elements) {
      if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement) {
        field.disabled = readOnly;
      }
    }
    copyEditor.editor.contentEditable = readOnly ? 'false' : 'true';
  }

  function loadPostIntoForm(post: BlogPost) {
    editingId = post.id;
    // Reset here too — opening an unrelated post from the plain post
    // list must not stay linked to whatever plan item was last handed
    // off. applyDraftHandoffIfPresent() re-sets this (and re-shows the
    // panel) immediately after calling this function, when that's
    // genuinely the case.
    currentPlanItemId = null;
    renderPlanContextPanel(null);
    slugTouchedManually = true;
    uploadedImageUrl = post.images?.hero?.url ?? null;
    uploadedImageCreditName = post.images?.hero?.creditName ?? null;
    uploadedImageCreditUrl = post.images?.hero?.creditUrl ?? null;
    titleField.value = post.title;
    // The strip is a defensive leftover from when savePost() used to
    // force-prepend 'blog/' to every slug (now removed) — kept here so
    // editing any post whose slug still carries a stray prefix from
    // that bug displays and re-saves clean instead of needing a manual
    // DB fix every time.
    slugField.value = post.slug.replace(/^blog\//, '');
    categoryField.value = post.category ?? '';
    imageAltField.value = post.images?.hero?.alt ?? '';
    if (uploadedImageUrl) {
      imagePreview.src = uploadedImageUrl;
      imagePreview.classList.remove('hidden');
      imageStatus.textContent = 'Current image — choose a new one to replace it.';
    } else {
      imageStatus.textContent = '';
    }
    metaField.value = post.meta_description ?? '';
    copyEditor.setMarkdown(post.copy);
    takeawaysField.value = (post.key_takeaways ?? []).join('\n');
    authorField.value = post.author_name ?? '';
    credentialsField.value = post.credentials ?? '';
    dateField.value = post.date_published ?? new Date().toISOString().slice(0, 10);
    editHeading.textContent = 'Edit post';
    deleteButton.classList.remove('hidden');
    setFormReadOnly(!canEditPost(post));
    renderState(post);
    renderSerp();
  }

  newPostButton.addEventListener('click', () => {
    resetForm();
    showEdit();
  });

  // Content Plan's "Draft blog post" hand-off — a same-tab, consume-once
  // sessionStorage handshake (see admin/content-plan.astro's
  // startBlogDraftHandoff()), not URL query params, since this never
  // needs to be shareable/bookmarkable. If the plan item already has a
  // real linked post (a previous hand-off), lands back on editing that
  // same post instead of creating a duplicate.
  function applyDraftHandoffIfPresent() {
    const raw = sessionStorage.getItem('contentPlanDraftHandoff');
    if (!raw) return;
    sessionStorage.removeItem('contentPlanDraftHandoff');

    let handoff: {
      planItemId: string;
      title: string;
      category: string | null;
      linkedPageId: string | null;
      keyword: string | null;
      targetQuestion: string | null;
    };
    try {
      handoff = JSON.parse(raw);
    } catch {
      return;
    }

    const planContext = { title: handoff.title, keyword: handoff.keyword ?? null, targetQuestion: handoff.targetQuestion ?? null };

    if (handoff.linkedPageId) {
      const existing = posts.find((p) => p.id === handoff.linkedPageId);
      if (existing) {
        loadPostIntoForm(existing);
        currentPlanItemId = handoff.planItemId;
        renderPlanContextPanel(planContext);
        showEdit();
        return;
      }
    }

    resetForm();
    currentPlanItemId = handoff.planItemId;
    titleField.value = handoff.title;
    slugField.value = slugify(handoff.title);
    slugTouchedManually = false;
    if (handoff.category) categoryField.value = handoff.category;
    renderPlanContextPanel(planContext);
    showEdit();
  }

  backButton.addEventListener('click', showList);

  function openPostFrom(target: HTMLElement) {
    const row = target.closest<HTMLElement>('[data-edit-id]');
    const post = row && posts.find((p) => p.id === row.dataset.editId);
    if (post) {
      loadPostIntoForm(post);
      showEdit();
      window.scrollTo(0, 0);
    }
  }
  tableBody.addEventListener('click', (event) => openPostFrom(event.target as HTMLElement));
  tableBody.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') openPostFrom(event.target as HTMLElement);
  });

  imageFileField.addEventListener('change', async () => {
    const file = imageFileField.files?.[0];
    if (!file) return;
    imageStatus.textContent = 'Uploading...';
    const path = `blog/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;
    const { error } = await supabase.storage.from('site-images').upload(path, file);
    if (error) {
      imageStatus.textContent = 'Upload failed: ' + error.message;
      return;
    }
    const { data: urlData } = supabase.storage.from('site-images').getPublicUrl(path);
    uploadedImageUrl = urlData.publicUrl;
    // A direct upload has no Unsplash attribution — clear any credit left
    // over from a previous Unsplash selection.
    uploadedImageCreditName = null;
    uploadedImageCreditUrl = null;
    imagePreview.src = urlData.publicUrl;
    imagePreview.classList.remove('hidden');
    imageStatus.textContent = 'Image uploaded.';
  });

  initUnsplashSearchModal({
    onSelect: (photo: UnsplashPhoto) => {
      uploadedImageUrl = photo.fullUrl;
      uploadedImageCreditName = photo.creditName || null;
      uploadedImageCreditUrl = photo.creditUrl || null;
      if (!imageAltField.value.trim()) imageAltField.value = photo.alt;
      imagePreview.src = photo.fullUrl;
      imagePreview.classList.remove('hidden');
      imageStatus.textContent = photo.creditName ? `Selected — photo by ${photo.creditName} on Unsplash.` : 'Selected.';
    },
  });

  function validate(): string | null {
    if (!titleField.value.trim()) return 'Title is required.';
    if (!slugField.value.trim()) return 'Slug is required.';
    if (!categoryField.value) return 'Choose a category.';
    if (!metaField.value.trim()) return 'Meta description is required.';
    if (!copyEditor.editor.textContent?.trim()) return 'Post content is required.';
    if (!authorField.value.trim()) return 'Author name is required.';
    if (uploadedImageUrl && !imageAltField.value.trim()) return 'Alt text is required for the hero image.';
    return null;
  }

  async function savePost(publish: boolean) {
    const validationError = validate();
    if (validationError) {
      formStatus.textContent = validationError;
      formStatus.className = 'i-hint r-err';
      return;
    }

    formStatus.textContent = publish ? 'Publishing...' : 'Saving...';
    formStatus.className = 'i-hint';
    saveDraftButton.setAttribute('disabled', 'true');
    publishButton.setAttribute('disabled', 'true');

    const takeaways = takeawaysField.value
      .split('\n')
      .map((t) => t.trim())
      .filter(Boolean);

    const payload = {
      title: titleField.value.trim(),
      // No 'blog/' prefix — every blog post lives at a bare root-level
      // URL, matching every other page type (see CLAUDE.md's "Blog
      // post slug typo" real-bugs entry: a stray `blog/${...}` prefix
      // here once forced every save, create or edit, to write a
      // prefixed slug that doesn't match how BlogPostCard.astro/the
      // sitemap actually route — silently re-breaking a post's real
      // URL on its next edit even after the slug had been fixed
      // directly in the DB).
      slug: slugify(slugField.value),
      page_type: 'Blog Post',
      h1: titleField.value.trim(),
      meta_title: `${titleField.value.trim()} | Blog`,
      meta_description: metaField.value.trim(),
      category: categoryField.value,
      copy: copyEditor.getMarkdown(),
      key_takeaways: takeaways,
      author_name: authorField.value.trim(),
      credentials: credentialsField.value.trim() || null,
      date_published: dateField.value,
      status: publish ? 'content-complete' : 'in-progress',
      images: uploadedImageUrl
        ? {
            hero: {
              url: uploadedImageUrl,
              alt: imageAltField.value.trim(),
              ...(uploadedImageCreditName && uploadedImageCreditUrl
                ? { creditName: uploadedImageCreditName, creditUrl: uploadedImageCreditUrl }
                : {}),
            },
          }
        : {},
      nav_placement: 'none',
      internal_links: [],
    };

    // created_by is set once, at creation — never touched on an update,
    // so an owner editing a staff member's post doesn't reassign it to
    // themselves.
    let error: { message: string } | null;
    if (editingId) {
      ({ error } = await supabase.from('pages').update(payload).eq('id', editingId));
    } else {
      // .select().single() to get the new row's real id back — needed
      // both to link a Content Plan item to it (below) and, since we're
      // already touching this exact line: setting editingId right after
      // means clicking Publish a second time on the same freshly-created
      // post now correctly updates it instead of silently inserting a
      // second duplicate row (a real, separate gap this create path had
      // before, found while adding the Content Plan link).
      const { data, error: insertError } = await supabase
        .from('pages')
        .insert({ ...payload, created_by: currentAdminUser?.id ?? null })
        .select()
        .single();
      error = insertError;
      if (data) editingId = data.id;
    }

    if (error) {
      formStatus.textContent = 'Could not save: ' + error.message;
      formStatus.className = 'i-hint r-err';
      saveDraftButton.removeAttribute('disabled');
      publishButton.removeAttribute('disabled');
      return;
    }

    // Closes the loop with the Content Plan item this draft started
    // from, if any — status mirrors the same save action just taken,
    // and linked_page_id records the real resulting post. Staff can
    // write both of these on their own assigned row (see
    // enforce_content_plan_staff_update() in 0062) — this update never
    // blocks the post save itself if it fails, since the post is
    // already saved by this point.
    if (currentPlanItemId) {
      await supabase
        .from('content_plan_items')
        .update({ status: publish ? 'published' : 'drafted', linked_page_id: editingId })
        .eq('id', currentPlanItemId);
    }

    if (publish) {
      formStatus.textContent = 'Publishing your post...';
      const result = await triggerRebuild();
      if (result.ok) {
        formStatus.textContent = 'Published! Your blog post will be live on your site shortly.';
        formStatus.className = 'i-hint r-ok';
      } else {
        formStatus.textContent = "Saved, but we couldn't start an update automatically — your post will go live the next time the site updates.";
        formStatus.className = 'i-hint r-warn';
      }
    } else {
      formStatus.textContent = 'Draft saved.';
      formStatus.className = 'i-hint r-ok';
    }

    saveDraftButton.removeAttribute('disabled');
    publishButton.removeAttribute('disabled');
    await loadPosts();
    renderState(posts.find((p) => p.id === editingId) ?? null);
    deleteButton.classList.remove('hidden');
  }

  saveDraftButton.addEventListener('click', () => savePost(false));
  publishButton.addEventListener('click', () => savePost(true));

  deleteButton.addEventListener('click', async () => {
    if (!editingId) return;
    if (!window.confirm('Delete this post? This cannot be undone.')) return;
    const { error } = await supabase.from('pages').delete().eq('id', editingId);
    if (error) {
      window.alert('Could not delete: ' + error.message);
      return;
    }
    await loadPosts();
    showList();
  });

  async function onAuthed(adminUser: AdminUser) {
    currentAdminUser = adminUser;
    await Promise.all([loadCategories(), loadPosts()]);
    resetForm();
    applyDraftHandoffIfPresent();
  }

  initAdminAuth(onAuthed);
</script>
