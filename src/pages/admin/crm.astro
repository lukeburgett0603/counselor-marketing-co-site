---
// Inquiries (the Lead CRM), redesigned in phase 3 of the admin redesign
// (2026-10-06). Same features and element ids as before; new layout:
// a pipeline of status counts, follow-ups due, a person-first list, and
// a two-column detail view.
//
// Owners/agency see every inquiry. A linked counselor sees "My
// inquiries": only leads assigned to them (RLS 0073 + an explicit filter
// below), can change status and follow-up date (0073's trigger enforces
// that), read and add notes on their own inquiries (0076). Practice-level
// tools (add, export, Google Ads upload, archive, delete, reassign,
// source and partner edits) are hidden for them.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { LEAD_STATUSES, STATUS_LABELS } from '../../lib/leadStatus';
import { LEAD_SOURCES } from '../../lib/leadSource';
---

<AdminLayout title="Inquiries | Admin" current="crm">
  <div id="crm-list-view">
    <p class="i-intro" id="i-intro">Every inquiry, who it's with, and where it stands.</p>

    <div class="i-toolbar">
      <div class="i-seg" role="group" aria-label="Show">
        <button type="button" id="view-leads-button" class="view-toggle-button" data-view="leads" aria-pressed="true">Inquiries</button>
        <button type="button" id="view-contacts-button" class="view-toggle-button" data-view="contacts" aria-pressed="false">Guide downloads</button>
      </div>
      <div class="i-actions" data-practice-only>
        <button id="add-lead-button" type="button" class="a-btn a-btn-primary i-btn">+ Add inquiry</button>
        <button id="export-csv-button" type="button" class="a-btn i-btn">Export CSV</button>
        <button id="ads-export-button" type="button" class="a-btn i-btn">Google Ads upload</button>
      </div>
    </div>

    <!-- Status counts double as the status filter. -->
    <div class="i-pipeline" id="i-pipeline" role="group" aria-label="Filter by status"></div>

    <div id="due-section" class="t-card i-due hidden">
      <h2>Follow-ups due<span class="t-aside" id="i-due-count"></span></h2>
      <div id="due-list" class="i-due-list"></div>
    </div>

    <div class="i-filters">
      <label class="i-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input id="filter-search" type="text" placeholder="Search by name, email, or phone" aria-label="Search inquiries" />
      </label>
      <select id="filter-status" hidden aria-hidden="true" tabindex="-1">
        <option value="all">All</option>
        {LEAD_STATUSES.map((s) => <option value={s}>{STATUS_LABELS[s]}</option>)}
      </select>
      <select id="filter-date" aria-label="Received">
        <option value="all">Any time</option>
        <option value="7">Last 7 days</option>
        <option value="30">Last 30 days</option>
        <option value="90">Last 90 days</option>
      </select>
      <select id="filter-source" aria-label="Source" data-practice-only>
        <option value="all">All sources</option>
        <option value="contact-form">Contact form</option>
        <option value="manual">Manually added</option>
      </select>
      <label class="i-check" data-practice-only>
        <input id="filter-show-archived" type="checkbox" />
        <span>Show archived</span>
      </label>
      <p id="leads-count" class="i-count"></p>
    </div>

    <div class="i-list t-card">
      <table class="i-table">
        <thead>
          <tr>
            <th>Person</th>
            <th class="i-hide-sm" data-practice-only>With</th>
            <th class="i-hide-md">Source</th>
            <th>Status</th>
            <th class="i-hide-sm">Follow-up</th>
            <th class="i-hide-md">Notes</th>
            <th data-practice-only><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody id="leads-table-body"></tbody>
      </table>
      <div id="i-empty" class="t-empty" hidden></div>
    </div>

    <div id="actions-menu" class="i-menu hidden">
      <button type="button" id="actions-menu-view">Open</button>
      <button type="button" id="actions-menu-archive">Archive</button>
      <button type="button" id="actions-menu-delete" class="i-danger">Delete</button>
    </div>
  </div>

  <div id="ads-export-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-lg bg-white p-6 shadow-xl">
      <div class="mb-3 flex items-center justify-between">
        <p class="font-semibold text-brand-ink">Google Ads conversion upload</p>
        <button id="ads-export-close" type="button" class="text-sm text-slate-500 hover:text-slate-800">Close</button>
      </div>
      <p class="text-sm text-slate-600">
        Tells Google which ad clicks turned into real inquiries, so it can show your ads to more people like them. The
        file contains only Google's own click IDs and times, never names or contact details.
      </p>
      <fieldset class="mt-4 space-y-2">
        <legend class="mb-1 text-xs font-semibold uppercase text-slate-500">What to report</legend>
        <label class="flex items-start gap-2 rounded-md border border-slate-200 px-3 py-2 text-sm">
          <input type="radio" name="ads-kind" value="request" checked class="mt-1" />
          <span><span class="font-semibold">Appointment requests</span><br /><span class="text-slate-600">Every ad click that led to a form submission. Recommended.</span></span>
        </label>
        <label class="flex items-start gap-2 rounded-md border border-slate-200 px-3 py-2 text-sm">
          <input type="radio" name="ads-kind" value="booked" class="mt-1" />
          <span><span class="font-semibold">Booked appointments</span><br /><span class="text-slate-600">Only ad clicks that became clients (marked Scheduled).</span></span>
        </label>
      </fieldset>
      <p id="ads-booked-warning" class="mt-3 hidden rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">
        This comes from your client records, not just your website: it tells Google which ad clicks became clients. Many
        practices treat client status as protected health information, and Google does not sign HIPAA business associate
        agreements. Check with your compliance advisor before uploading this one.
      </p>
      <div class="mt-4">
        <label for="ads-conversion-name" class="block text-xs font-semibold uppercase text-slate-500">Conversion action name in Google Ads</label>
        <input id="ads-conversion-name" type="text" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        <p class="mt-1 text-xs text-slate-500">Must match the name of the conversion action in your Google Ads account exactly (Goals → Conversions → create one with the "Import" source, from clicks).</p>
      </div>
      <p class="mt-3 text-xs text-slate-500">Includes the last 90 days (Google's limit). Uploading the same file twice is safe: Google ignores duplicates.</p>
      <p id="ads-export-status" class="mt-3 text-sm" role="status"></p>
      <button id="ads-export-download" type="button" class="mt-3 w-full rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Download upload file</button>
    </div>
  </div>

  <div id="add-lead-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-md rounded-lg bg-white p-6">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="font-[family-name:var(--font-heading)] text-lg font-bold text-brand-ink">Add a lead</h3>
        <button id="add-lead-close-button" type="button" class="text-sm text-slate-500 hover:text-slate-800">Close</button>
      </div>
      <form id="add-lead-form" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-500">Name</label>
          <input name="name" type="text" required class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500">Email</label>
          <input name="email" type="email" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500">Phone</label>
          <input name="phone" type="tel" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500">Status</label>
          <select name="status" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
            {LEAD_STATUSES.map((s) => <option value={s} selected={s === 'new'}>{STATUS_LABELS[s]}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500">How did they hear about you?</label>
          <select name="lead_source" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
            <option value="">Not asked / unknown</option>
            {LEAD_SOURCES.map((src) => <option value={src.value}>{src.label}</option>)}
          </select>
          <input
            name="lead_source_detail"
            type="text"
            placeholder="Who referred them? (optional)"
            class="mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500">Notes</label>
          <textarea
            name="message"
            rows="3"
            placeholder="How you got this lead, what they need..."
            class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm"></textarea>
        </div>
        <p id="add-lead-status" class="text-sm text-red-600"></p>
        <button
          type="submit"
          class="w-full rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90"
        >
          Add lead
        </button>
      </form>
    </div>
  </div>

  <div id="crm-detail-view" class="hidden">
    <div class="i-detail-top">
      <button id="back-to-list-button" type="button" class="a-link">&larr; All inquiries</button>
      <div class="i-detail-tools" data-practice-only>
        <button id="detail-archive-button" type="button" class="a-btn i-btn">Archive</button>
        <button id="detail-delete-button" type="button" class="a-btn i-btn i-danger">Delete</button>
      </div>
    </div>

    <p id="detail-archived-banner" class="i-banner hidden">
      Archived: hidden from this list, but still counted in your reports.
    </p>

    <div class="i-detail">
      <div class="i-detail-main">
        <section class="t-card i-person">
          <div class="i-person-head">
            <span class="i-avatar" id="i-detail-avatar"></span>
            <div>
              <h2 id="detail-name"></h2>
              <p id="detail-submitted"></p>
            </div>
          </div>
          <div class="i-contact">
            <div><span>Email</span><b id="detail-email"></b></div>
            <div><span>Phone</span><b id="detail-phone"></b></div>
          </div>
          <div class="i-message">
            <span>What they wrote</span>
            <p id="detail-message"></p>
          </div>
        </section>

        <section class="t-card">
          <h2>Notes<span class="t-aside">Newest first</span></h2>
          <form id="add-note-form" class="i-note-form">
            <textarea id="note-text" rows="2" placeholder="Called and left a voicemail..." required aria-label="New note"></textarea>
            <button type="submit" class="a-btn a-btn-primary i-btn">Add note</button>
          </form>
          <div id="notes-list" class="i-notes"></div>
        </section>
      </div>

      <aside class="i-detail-side">
        <section class="t-card i-fields">
          <div class="i-field">
            <span>Status</span>
            <div id="detail-status-container"></div>
          </div>
          <div class="i-field">
            <label for="detail-follow-up">Follow-up</label>
            <div class="i-inline">
              <input id="detail-follow-up" type="date" />
              <button id="save-follow-up-button" type="button" class="a-btn i-btn">Save</button>
              <button id="clear-follow-up-button" type="button" class="a-link">Clear</button>
            </div>
            <span id="follow-up-status" class="i-hint"></span>
          </div>
          <div id="detail-assigned-wrap" class="i-field hidden">
            <label for="detail-assigned-select">With counselor</label>
            <select id="detail-assigned-select"></select>
            <span id="detail-assigned-status" class="i-hint"></span>
          </div>
          <div class="i-field">
            <span>Counselor they asked for</span>
            <b id="detail-counselor"></b>
          </div>
          <div class="i-field">
            <span>Session format</span>
            <b id="detail-session-format"></b>
          </div>
        </section>

        <section class="t-card i-fields">
          <div class="i-field">
            <span>Came from</span>
            <b id="detail-source"></b>
            <span id="detail-ad" class="i-hint hidden"></span>
          </div>
          <div class="i-field">
            <label for="detail-source-select">Heard about you</label>
            <select id="detail-source-select">
              <option value="">Not answered</option>
              {LEAD_SOURCES.map((src) => <option value={src.value}>{src.label}</option>)}
            </select>
            <input id="detail-source-detail" type="text" placeholder="Who referred them? (optional)" aria-label="Who referred them" />
            <span id="detail-source-status" class="i-hint"></span>
          </div>
          <div id="detail-partner-wrap" class="i-field hidden">
            <label for="detail-partner-select">Referral partner</label>
            <select id="detail-partner-select"></select>
            <span id="detail-partner-status" class="i-hint"></span>
          </div>
          <div class="i-field">
            <span>Their current website</span>
            <b id="detail-website"></b>
          </div>
        </section>
      </aside>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth } from '../../lib/adminAuth';
  import { buildGoogleAdsUpload, isGoogleAdsLead, type ConversionKind } from '../../lib/adAttribution';
  import { leadSourceLabel } from '../../lib/leadSource';
  import { renderStatusSelect, initStatusSelectHandler, TERMINAL_LEAD_STATUSES, LEAD_STATUSES, STATUS_LABELS } from '../../lib/leadStatus';
  import { withBase } from '../../lib/url';
  import type { AdminUser } from '../../lib/adminAuth';

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  type Lead = {
    id: string;
    created_at: string;
    name: string | null;
    email: string | null;
    phone: string | null;
    message: string | null;
    existing_website_url: string | null;
    source_page: string | null;
    status: string | null;
    follow_up_date: string | null;
    lead_magnet_id: string | null;
    archived_at: string | null;
    preferred_counselor_page_id: string | null;
    assigned_counselor_page_id: string | null;
    preferred_session_format: string | null;
    lead_source: string | null;
    lead_source_detail: string | null;
    referral_partner_id: string | null;
    auto_reply_sent_at: string | null;
    gclid: string | null;
    gbraid: string | null;
    wbraid: string | null;
    utm_source: string | null;
    utm_medium: string | null;
    utm_campaign: string | null;
    utm_term: string | null;
    landing_page: string | null;
    scheduled_at: string | null;
  };

  const SESSION_FORMAT_LABELS: Record<string, string> = {
    in_person: 'In-Person',
    telehealth: 'Telehealth',
  };
  type LeadMagnet = { id: string; title: string };
  type LeadNote = { id: string; lead_id: string; note: string; created_at: string };

  // Sentinel source_page value for a lead added manually from this page
  // (a phone call, a walk-in, a referral) rather than submitted through
  // the site's own form — distinct from any real page slug, so it shows
  // up as its own honest bucket in Leads and analytics' "Leads by page"
  // breakdown instead of being folded into "(unknown page)" or attributed
  // to a page it didn't actually come from.
  const MANUAL_SOURCE = 'Manually added';

  let allLeads: Lead[] = [];
  let leadMagnets: LeadMagnet[] = [];
  // Which of the two top-level views is active — see the toggle buttons'
  // own comment for why "All" isn't a third option.
  let currentView: 'leads' | 'contacts' = 'leads';
  // Populated in init() from a live query, not hardcoded — see leads.astro's
  // identical pattern.
  let counselorNames = new Map<string, string>();
  let noteCounts = new Map<string, number>();
  let currentLeadId: string | null = null;
  // Which lead's row the single shared Actions menu is currently open
  // for, if any — the menu itself has no per-row identity, so this is
  // how its View/Archive/Delete handlers know which lead to act on.
  let actionsMenuLeadId: string | null = null;
  // A linked counselor working their own inquiries ("My inquiries").
  let counselorMode = false;

  function initials(name: string | null): string {
    const parts = (name ?? '').trim().split(/\s+/).filter(Boolean);
    return (parts.slice(0, 2).map((w) => w[0]).join('') || '?').toUpperCase();
  }
  function relative(iso: string): string {
    const mins = (Date.now() - new Date(iso).getTime()) / 60_000;
    if (mins < 60) return `${Math.max(1, Math.round(mins))} min ago`;
    const hrs = mins / 60;
    if (hrs < 24) return `${Math.round(hrs)} hr${Math.round(hrs) === 1 ? '' : 's'} ago`;
    const days = Math.round(hrs / 24);
    if (days < 14) return `${days} day${days === 1 ? '' : 's'} ago`;
    return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: new Date(iso).getFullYear() === new Date().getFullYear() ? undefined : 'numeric' });
  }
  function shortDate(ymd: string): string {
    return new Date(ymd + 'T12:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  const listView = document.getElementById('crm-list-view')!;
  const detailView = document.getElementById('crm-detail-view')!;
  const tableBody = document.getElementById('leads-table-body')!;
  const leadsCount = document.getElementById('leads-count')!;
  const dueSection = document.getElementById('due-section')!;
  const dueList = document.getElementById('due-list')!;
  const actionsMenu = document.getElementById('actions-menu')!;
  const actionsMenuViewButton = document.getElementById('actions-menu-view')!;
  const actionsMenuArchiveButton = document.getElementById('actions-menu-archive')!;
  const actionsMenuDeleteButton = document.getElementById('actions-menu-delete')!;

  const viewLeadsButton = document.getElementById('view-leads-button')!;
  const viewContactsButton = document.getElementById('view-contacts-button')!;
  const addLeadButtonRef = document.getElementById('add-lead-button')!;
  const searchInput = document.getElementById('filter-search') as HTMLInputElement;
  const statusFilter = document.getElementById('filter-status') as HTMLSelectElement;
  const dateFilter = document.getElementById('filter-date') as HTMLSelectElement;
  const sourceFilter = document.getElementById('filter-source') as HTMLSelectElement;
  const showArchivedFilter = document.getElementById('filter-show-archived') as HTMLInputElement;
  const exportButton = document.getElementById('export-csv-button')!;

  function showList() {
    detailView.classList.add('hidden');
    listView.classList.remove('hidden');
  }
  function showDetail() {
    listView.classList.add('hidden');
    detailView.classList.remove('hidden');
  }

  function sourceLabel(lead: Lead): string {
    if (lead.lead_magnet_id) return leadMagnets.find((m) => m.id === lead.lead_magnet_id)?.title ?? 'Lead magnet';
    if (lead.source_page === MANUAL_SOURCE) return MANUAL_SOURCE;
    return 'Contact form';
  }

  function applyFilters(leads: Lead[]): Lead[] {
    const search = searchInput.value.trim().toLowerCase();
    const status = statusFilter.value;
    const days = dateFilter.value;
    const source = sourceFilter.value;
    const showArchived = showArchivedFilter.checked;

    return leads.filter((lead) => {
      // View split first — a Contact (lead_magnet_id set) never appears
      // in the Leads view and vice versa, regardless of any other filter.
      if (currentView === 'leads' && lead.lead_magnet_id) return false;
      if (currentView === 'contacts' && !lead.lead_magnet_id) return false;
      if (!showArchived && lead.archived_at) return false;
      if (status !== 'all' && (lead.status ?? 'new') !== status) return false;
      if (days !== 'all') {
        const cutoff = new Date();
        cutoff.setDate(cutoff.getDate() - Number(days));
        if (new Date(lead.created_at) < cutoff) return false;
      }
      if (currentView === 'leads') {
        if (source === 'contact-form' && lead.source_page === MANUAL_SOURCE) return false;
        if (source === 'manual' && lead.source_page !== MANUAL_SOURCE) return false;
      } else if (source !== 'all' && lead.lead_magnet_id !== source) {
        return false;
      }
      if (search) {
        const haystack = `${lead.name ?? ''} ${lead.email ?? ''} ${lead.phone ?? ''}`.toLowerCase();
        if (!haystack.includes(search)) return false;
      }
      return true;
    });
  }

  // The Source dropdown's own options change meaning depending on the
  // view — "Contact form"/"Manually added" only make sense for real
  // leads, while a specific guide title only makes sense for contacts.
  // Rebuilt on every view switch rather than kept as one static list.
  function updateSourceFilterOptions() {
    sourceFilter.innerHTML =
      currentView === 'leads'
        ? '<option value="all">All sources</option><option value="contact-form">Contact form</option><option value="manual">Manually added</option>'
        : '<option value="all">All guides</option>' +
          leadMagnets.map((m) => `<option value="${m.id}">${escapeHtml(m.title)}</option>`).join('');
  }

  function setView(view: 'leads' | 'contacts') {
    currentView = view;
    viewLeadsButton.setAttribute('aria-pressed', String(view === 'leads'));
    viewContactsButton.setAttribute('aria-pressed', String(view === 'contacts'));
    // A manually-added entry always has lead_magnet_id null, so it can
    // never show up in the Contacts view — offering the button there
    // would let someone add a row they'd then not see without switching
    // views back, which is more confusing than just hiding it.
    addLeadButtonRef.hidden = view === 'contacts' || counselorMode;
    updateSourceFilterOptions();
    sourceFilter.value = 'all';
    renderList();
  }

  viewLeadsButton.addEventListener('click', () => setView('leads'));
  viewContactsButton.addEventListener('click', () => setView('contacts'));

  // "Due this week" surfaces anything with a follow-up date within the
  // next 7 days — with no lower bound, so an overdue-but-not-yet-handled
  // follow-up keeps showing here instead of silently falling off once its
  // date passes. Terminal-status (scheduled/referred/withdrawn) and
  // archived leads are excluded — no point being reminded about someone
  // already handled or no longer being worked.
  function renderDueThisWeek() {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const weekOut = new Date(today);
    weekOut.setDate(today.getDate() + 7);

    const due = allLeads
      .filter((l) => l.follow_up_date && !TERMINAL_LEAD_STATUSES.includes(l.status ?? 'new') && !l.archived_at)
      .filter((l) => new Date(l.follow_up_date + 'T00:00:00') <= weekOut)
      .sort((a, b) => (a.follow_up_date! < b.follow_up_date! ? -1 : 1));

    if (due.length === 0) {
      dueSection.classList.add('hidden');
      return;
    }
    dueSection.classList.remove('hidden');
    document.getElementById('i-due-count')!.textContent = `${due.length} in the next 7 days`;
    dueList.innerHTML = due
      .map((lead) => {
        const dueDate = new Date(lead.follow_up_date + 'T00:00:00');
        const isOverdue = dueDate < today;
        const isToday = dueDate.getTime() === today.getTime();
        const when = isOverdue ? `Overdue · was due ${shortDate(lead.follow_up_date!)}` : isToday ? 'Due today' : `Due ${shortDate(lead.follow_up_date!)}`;
        return `<button type="button" data-lead-id="${lead.id}" class="due-item"><span class="i-avatar sm">${escapeHtml(initials(lead.name))}</span><span class="i-due-name">${escapeHtml(lead.name || '(no name)')}</span><span class="i-due-when${isOverdue ? ' late' : ''}">${when}</span></button>`;
      })
      .join('');
  }

  dueList.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('.due-item');
    if (!button) return;
    openDetail(button.dataset.leadId!);
  });

  // Status counts for the current view (and archived setting), which
  // double as the status filter.
  function renderPipeline() {
    const showArchived = showArchivedFilter.checked;
    const pool = allLeads.filter(
      (l) => (currentView === 'leads' ? !l.lead_magnet_id : !!l.lead_magnet_id) && (showArchived || !l.archived_at)
    );
    const current = statusFilter.value;
    const chip = (value: string, label: string, n: number) =>
      `<button type="button" class="i-chip i-chip-${value}" data-status="${value}" aria-pressed="${current === value}"><span>${label}</span><b class="a-num">${n}</b></button>`;
    document.getElementById('i-pipeline')!.innerHTML =
      chip('all', 'All', pool.length) + LEAD_STATUSES.map((s) => chip(s, STATUS_LABELS[s], pool.filter((l) => (l.status ?? 'new') === s).length)).join('');
  }
  document.getElementById('i-pipeline')!.addEventListener('click', (event) => {
    const chip = (event.target as HTMLElement).closest<HTMLElement>('[data-status]');
    if (!chip) return;
    statusFilter.value = chip.dataset.status!;
    renderList();
  });

  function renderList() {
    renderPipeline();
    const filtered = applyFilters(allLeads);
    const noun = currentView === 'contacts' ? 'download' : 'inquiry';
    leadsCount.textContent = `${filtered.length} ${filtered.length === 1 ? noun : noun === 'inquiry' ? 'inquiries' : 'downloads'}`;
    const empty = document.getElementById('i-empty')!;
    empty.hidden = filtered.length > 0;
    if (!filtered.length) {
      const filtering = searchInput.value.trim() || statusFilter.value !== 'all' || dateFilter.value !== 'all' || sourceFilter.value !== 'all';
      empty.innerHTML = filtering
        ? '<b>Nothing matches these filters.</b>Try a different status or search.'
        : counselorMode
          ? "<b>No inquiries assigned to you yet.</b>When one is assigned to you, it shows up here."
          : '<b>No inquiries yet.</b>New ones from your website show up here the moment they arrive.';
    }
    tableBody.innerHTML = filtered
      .map((lead) => {
        const counselor = lead.assigned_counselor_page_id ? (counselorNames.get(lead.assigned_counselor_page_id) ?? '').split(',')[0] : '';
        const contact = lead.email || lead.phone || '';
        const today = new Date().toISOString().slice(0, 10);
        const late = lead.follow_up_date && lead.follow_up_date < today && !TERMINAL_LEAD_STATUSES.includes(lead.status ?? 'new');
        const notes = noteCounts.get(lead.id) ?? 0;
        return `
      <tr data-lead-id="${lead.id}" class="${lead.archived_at ? 'i-archived' : ''}">
        <td><div class="i-who"><span class="i-avatar">${escapeHtml(initials(lead.name))}</span><div><b>${escapeHtml(lead.name || '(no name)')}${lead.archived_at ? ' <span class="i-tag">Archived</span>' : ''}</b><small>${escapeHtml(contact)}${contact ? ' · ' : ''}${relative(lead.created_at)}</small></div></div></td>
        <td class="i-hide-sm i-muted" data-practice-only>${counselor ? escapeHtml(counselor) : '<span class="i-faint">Not assigned</span>'}</td>
        <td class="i-hide-md i-muted">${escapeHtml(sourceLabel(lead))}</td>
        <td data-no-row-click>${renderStatusSelect(lead.id, lead.status)}</td>
        <td class="i-hide-sm ${late ? 'i-late' : 'i-muted'}">${lead.follow_up_date ? shortDate(lead.follow_up_date) : ''}</td>
        <td class="i-hide-md i-muted">${notes ? `<span class="i-notes-count">${notes}</span>` : ''}</td>
        <td class="i-right" data-no-row-click data-practice-only><button type="button" class="actions-toggle i-more" data-lead-id="${lead.id}" aria-label="More actions for ${escapeHtml(lead.name || 'this inquiry')}">···</button></td>
      </tr>`;
      })
      .join('');
    applyCounselorMode();
  }

  // Hide practice-level controls for a counselor login. Re-run after
  // every render, since rows are rebuilt.
  function applyCounselorMode() {
    if (!counselorMode) return;
    document.querySelectorAll<HTMLElement>('[data-practice-only]').forEach((el) => (el.hidden = true));
  }

  const ACTIONS_MENU_WIDTH = 160; // matches .i-menu's width

  function closeActionsMenu() {
    actionsMenu.classList.add('hidden');
    actionsMenuLeadId = null;
  }

  // Positions the single shared menu against whichever row's toggle
  // button was clicked. `position: fixed` + viewport coordinates from
  // getBoundingClientRect() means it's placed outside the table's
  // overflow-x-auto wrapper entirely, so that wrapper's scroll bounds
  // can never clip it — the earlier per-row absolutely-positioned menu
  // did get clipped that way, cutting off "View"/"Archive"/"Delete" on
  // any row near the bottom of the visible table. Flips to open upward
  // when there isn't room below, for the same reason.
  function openActionsMenuFor(button: HTMLElement, leadId: string) {
    const lead = allLeads.find((l) => l.id === leadId);
    actionsMenuArchiveButton.textContent = lead?.archived_at ? 'Unarchive' : 'Archive';
    actionsMenuLeadId = leadId;

    const rect = button.getBoundingClientRect();
    const estimatedMenuHeight = 128; // three items ~38px each + padding
    const openUpward = window.innerHeight - rect.bottom < estimatedMenuHeight;

    const left = Math.max(8, Math.min(rect.right - ACTIONS_MENU_WIDTH, window.innerWidth - ACTIONS_MENU_WIDTH - 8));
    actionsMenu.style.left = `${left}px`;
    if (openUpward) {
      actionsMenu.style.top = 'auto';
      actionsMenu.style.bottom = `${window.innerHeight - rect.top + 4}px`;
    } else {
      actionsMenu.style.bottom = 'auto';
      actionsMenu.style.top = `${rect.bottom + 4}px`;
    }

    actionsMenu.classList.remove('hidden');
  }

  // Close on an outside click, on scroll (capture:true so this also
  // catches the table wrapper's own horizontal scroll, which doesn't
  // bubble), and on resize — all three can leave the menu's fixed
  // position misaligned with the button it was opened from.
  document.addEventListener('click', (event) => {
    if (actionsMenu.classList.contains('hidden')) return;
    const target = event.target as HTMLElement;
    if (target.closest('#actions-menu') || target.closest('.actions-toggle')) return;
    closeActionsMenu();
  });
  window.addEventListener('scroll', closeActionsMenu, true);
  window.addEventListener('resize', closeActionsMenu);

  tableBody.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const toggleButton = target.closest<HTMLElement>('.actions-toggle');
    if (toggleButton) {
      const leadId = toggleButton.dataset.leadId!;
      if (actionsMenuLeadId === leadId && !actionsMenu.classList.contains('hidden')) {
        closeActionsMenu();
      } else {
        openActionsMenuFor(toggleButton, leadId);
      }
      return;
    }

    if (target.closest('[data-no-row-click]')) return;
    const row = target.closest<HTMLElement>('tr[data-lead-id]');
    if (!row) return;
    openDetail(row.dataset.leadId!);
  });

  actionsMenuViewButton.addEventListener('click', () => {
    const leadId = actionsMenuLeadId;
    closeActionsMenu();
    if (leadId) openDetail(leadId);
  });

  actionsMenuArchiveButton.addEventListener('click', async () => {
    const leadId = actionsMenuLeadId;
    closeActionsMenu();
    if (!leadId) return;
    const lead = allLeads.find((l) => l.id === leadId);
    if (!lead) return;
    if (await setArchived(leadId, !lead.archived_at)) {
      renderDueThisWeek();
      renderList();
    }
  });

  actionsMenuDeleteButton.addEventListener('click', async () => {
    const leadId = actionsMenuLeadId;
    closeActionsMenu();
    if (!leadId) return;
    if (await deleteLead(leadId)) {
      renderDueThisWeek();
      renderList();
    }
  });

  initStatusSelectHandler(tableBody, (leadId, newStatus) => {
    const lead = allLeads.find((l) => l.id === leadId);
    if (lead) lead.status = newStatus;
    renderDueThisWeek();
    renderPipeline();
  });

  [searchInput, statusFilter, dateFilter, sourceFilter, showArchivedFilter].forEach((el) => {
    el.addEventListener('input', renderList);
    el.addEventListener('change', renderList);
  });

  function csvEscape(value: string): string {
    if (/[",\n]/.test(value)) return '"' + value.replace(/"/g, '""') + '"';
    return value;
  }

  // Exports whatever the current filters show, not the whole table — a
  // client who's filtered down to "last 30 days, new leads" expects the
  // export to match what's on screen.
  exportButton.addEventListener('click', () => {
    const filtered = applyFilters(allLeads);
    const header = ['Date', 'Name', 'Email', 'Phone', 'Status', 'Follow-up date', 'Source', 'Counselor preference', 'Assigned counselor', 'Heard about us', 'Referred by', 'Referral partner', 'Session format preference', 'Came from Google Ads', 'Ad campaign', 'Ad keyword', 'Landing page', 'Archived', 'Message'];
    const rows = filtered.map((lead) => [
      new Date(lead.created_at).toLocaleDateString(),
      lead.name ?? '',
      lead.email ?? '',
      lead.phone ?? '',
      lead.status ?? 'new',
      lead.follow_up_date ?? '',
      sourceLabel(lead),
      lead.preferred_counselor_page_id ? (counselorNames.get(lead.preferred_counselor_page_id) ?? 'Unknown') : '',
      lead.assigned_counselor_page_id ? (counselorNames.get(lead.assigned_counselor_page_id) ?? 'Unknown') : '',
      lead.lead_source ? leadSourceLabel(lead.lead_source) : '',
      lead.lead_source_detail ?? '',
      lead.referral_partner_id ? (partnerOptions.find((p) => p.id === lead.referral_partner_id)?.name ?? '') : '',
      lead.preferred_session_format ? (SESSION_FORMAT_LABELS[lead.preferred_session_format] ?? lead.preferred_session_format) : '',
      isGoogleAdsLead(lead) ? 'Yes' : '',
      lead.utm_campaign ?? '',
      lead.utm_term ?? '',
      lead.landing_page ?? '',
      lead.archived_at ? 'Yes' : '',
      lead.message ?? '',
    ]);
    const csv = [header, ...rows].map((row) => row.map((cell) => csvEscape(String(cell))).join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${currentView}-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  });

  // --- Google Ads offline conversion upload ---
  const adsModal = document.getElementById('ads-export-modal')!;
  const adsNameInput = document.getElementById('ads-conversion-name') as HTMLInputElement;
  const adsStatus = document.getElementById('ads-export-status')!;
  const adsWarning = document.getElementById('ads-booked-warning')!;
  let adsNames: { id: string; request: string; booked: string } | null = null;

  function adsKind(): ConversionKind {
    return (document.querySelector<HTMLInputElement>('input[name="ads-kind"]:checked')?.value as ConversionKind) ?? 'request';
  }

  function syncAdsKind() {
    const kind = adsKind();
    adsWarning.classList.toggle('hidden', kind !== 'booked');
    if (adsNames) adsNameInput.value = kind === 'request' ? adsNames.request : adsNames.booked;
    adsStatus.textContent = '';
  }

  document.querySelectorAll<HTMLInputElement>('input[name="ads-kind"]').forEach((r) => r.addEventListener('change', syncAdsKind));

  document.getElementById('ads-export-button')!.addEventListener('click', async () => {
    if (!adsNames) {
      const { data } = await supabase.from('business').select('id, ads_request_conversion_name, ads_booked_conversion_name').single();
      if (data) adsNames = { id: data.id, request: data.ads_request_conversion_name, booked: data.ads_booked_conversion_name };
    }
    syncAdsKind();
    adsModal.classList.remove('hidden');
    adsModal.classList.add('flex');
  });
  document.getElementById('ads-export-close')!.addEventListener('click', () => {
    adsModal.classList.add('hidden');
    adsModal.classList.remove('flex');
  });

  document.getElementById('ads-export-download')!.addEventListener('click', async () => {
    const kind = adsKind();
    const name = adsNameInput.value.trim();
    if (!name) {
      adsStatus.textContent = 'Enter the conversion action name first.';
      adsStatus.className = 'mt-3 text-sm text-red-600';
      return;
    }
    const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const { csv, count, skippedNoGclid } = buildGoogleAdsUpload(allLeads, kind, name, timeZone);
    if (count === 0) {
      adsStatus.textContent =
        'No leads from Google Ads to report in the last 90 days' + (kind === 'booked' ? ' that are marked Scheduled.' : '.');
      adsStatus.className = 'mt-3 text-sm text-slate-600';
      return;
    }
    // Remember the name so it matches next time without retyping.
    if (adsNames) {
      const column = kind === 'request' ? 'ads_request_conversion_name' : 'ads_booked_conversion_name';
      if ((kind === 'request' ? adsNames.request : adsNames.booked) !== name) {
        const { error } = await supabase.from('business').update({ [column]: name }).eq('id', adsNames.id);
        if (!error) adsNames[kind === 'request' ? 'request' : 'booked'] = name;
      }
    }
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `google-ads-${kind === 'request' ? 'appointment-requests' : 'booked-appointments'}-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    adsStatus.textContent = `Downloaded ${count} conversion${count === 1 ? '' : 's'}.${
      skippedNoGclid ? ` ${skippedNoGclid} ad lead${skippedNoGclid === 1 ? '' : 's'} tagged only by UTM or an iPhone click ID couldn't be included (the file format needs a Google Click ID).` : ''
    } Upload it in Google Ads under Goals → Conversions → Uploads.`;
    adsStatus.className = 'mt-3 text-sm text-emerald-700';
  });

  // --- Archive / delete (shared by the row Actions menu and the detail view) ---

  async function setArchived(leadId: string, archived: boolean): Promise<boolean> {
    const archivedAt = archived ? new Date().toISOString() : null;
    const { error } = await supabase.from('leads').update({ archived_at: archivedAt }).eq('id', leadId);
    if (error) {
      window.alert('Could not update lead: ' + error.message);
      return false;
    }
    const lead = allLeads.find((l) => l.id === leadId);
    if (lead) lead.archived_at = archivedAt;
    return true;
  }

  // A real, hard delete — this is what actually reduces the Leads and
  // analytics numbers, since that page just counts whatever rows exist.
  // Notes cascade-delete at the DB level (see 0017_lead_crm.sql).
  async function deleteLead(leadId: string): Promise<boolean> {
    if (
      !window.confirm(
        'Delete this lead? This removes it (and its notes) permanently, including from the Leads and analytics dashboard. This cannot be undone.'
      )
    ) {
      return false;
    }
    const { error } = await supabase.from('leads').delete().eq('id', leadId);
    if (error) {
      window.alert('Could not delete lead: ' + error.message);
      return false;
    }
    allLeads = allLeads.filter((l) => l.id !== leadId);
    noteCounts.delete(leadId);
    return true;
  }

  // --- Detail view ---

  const backButton = document.getElementById('back-to-list-button')!;
  const detailName = document.getElementById('detail-name')!;
  const detailSubmitted = document.getElementById('detail-submitted')!;
  const detailStatusContainer = document.getElementById('detail-status-container')!;
  const detailEmail = document.getElementById('detail-email')!;
  const detailPhone = document.getElementById('detail-phone')!;
  const detailWebsite = document.getElementById('detail-website')!;
  const detailCounselor = document.getElementById('detail-counselor')!;
  const detailSessionFormat = document.getElementById('detail-session-format')!;
  const detailAssignedWrap = document.getElementById('detail-assigned-wrap')!;
  const detailAssignedSelect = document.getElementById('detail-assigned-select') as HTMLSelectElement;
  const detailAssignedStatus = document.getElementById('detail-assigned-status')!;
  const detailSourceSelect = document.getElementById('detail-source-select') as HTMLSelectElement;
  const detailSourceDetail = document.getElementById('detail-source-detail') as HTMLInputElement;
  const detailSourceStatus = document.getElementById('detail-source-status')!;

  // Saves on change (select) or blur (text), same inline-save feel as the
  // status and assigned-counselor selects.
  async function saveLeadSource() {
    if (!currentLeadId) return;
    const lead = allLeads.find((l) => l.id === currentLeadId);
    if (!lead) return;
    const next = {
      lead_source: detailSourceSelect.value || null,
      lead_source_detail: detailSourceDetail.value.trim() || null,
    };
    if (next.lead_source === lead.lead_source && next.lead_source_detail === lead.lead_source_detail) return;
    const { error } = await supabase.from('leads').update(next).eq('id', lead.id);
    if (error) {
      detailSourceStatus.textContent = 'Could not save: ' + error.message;
      detailSourceStatus.className = 'text-xs text-red-600';
      return;
    }
    Object.assign(lead, next);
    detailSourceStatus.textContent = 'Saved.';
    detailSourceStatus.className = 'text-xs text-emerald-700';
  }
  detailSourceSelect.addEventListener('change', saveLeadSource);

  const detailPartnerWrap = document.getElementById('detail-partner-wrap')!;
  const detailPartnerSelect = document.getElementById('detail-partner-select') as HTMLSelectElement;
  const detailPartnerStatus = document.getElementById('detail-partner-status')!;
  let partnerOptions: { id: string; name: string; archived_at: string | null }[] = [];

  function renderPartnerSelect(lead: Lead) {
    detailPartnerWrap.classList.toggle('hidden', partnerOptions.length === 0);
    // Archived partners stay listed only when this lead already points at
    // one, so an old link never silently shows as "None".
    const visible = partnerOptions.filter((p) => !p.archived_at || p.id === lead.referral_partner_id);
    detailPartnerSelect.innerHTML =
      '<option value="">None</option>' +
      visible
        .map((p) => `<option value="${p.id}" ${p.id === lead.referral_partner_id ? 'selected' : ''}>${escapeHtml(p.name)}</option>`)
        .join('');
    detailPartnerStatus.textContent = '';
  }

  detailPartnerSelect.addEventListener('change', async () => {
    const lead = allLeads.find((l) => l.id === currentLeadId);
    if (!lead) return;
    const next = detailPartnerSelect.value || null;
    const { error } = await supabase.from('leads').update({ referral_partner_id: next }).eq('id', lead.id);
    if (error) {
      detailPartnerSelect.value = lead.referral_partner_id ?? '';
      detailPartnerStatus.textContent = 'Could not save: ' + error.message;
      detailPartnerStatus.className = 'mt-1 text-xs text-red-600';
      return;
    }
    lead.referral_partner_id = next;
    detailPartnerStatus.textContent = 'Saved.';
    detailPartnerStatus.className = 'mt-1 text-xs text-emerald-700';
  });
  detailSourceDetail.addEventListener('blur', saveLeadSource);
  const detailSource = document.getElementById('detail-source')!;
  const detailMessage = document.getElementById('detail-message')!;
  const detailFollowUp = document.getElementById('detail-follow-up') as HTMLInputElement;
  const saveFollowUpButton = document.getElementById('save-follow-up-button')!;
  const clearFollowUpButton = document.getElementById('clear-follow-up-button')!;
  const followUpStatus = document.getElementById('follow-up-status')!;
  const notesList = document.getElementById('notes-list')!;
  const addNoteForm = document.getElementById('add-note-form') as HTMLFormElement;
  const noteTextField = document.getElementById('note-text') as HTMLTextAreaElement;
  const detailArchiveButton = document.getElementById('detail-archive-button')!;
  const detailDeleteButton = document.getElementById('detail-delete-button')!;
  const detailArchivedBanner = document.getElementById('detail-archived-banner')!;

  initStatusSelectHandler(detailStatusContainer, (leadId, newStatus) => {
    const lead = allLeads.find((l) => l.id === leadId);
    if (lead) lead.status = newStatus;
    renderDueThisWeek();
    if (lead) renderAssignedHint(lead);
  });

  // In a group practice, a Scheduled client with no counselor can't be
  // credited to anyone's caseload — say so right where it can be fixed.
  // A solo practice (one counselor) never needs this.
  function renderAssignedHint(lead: Lead) {
    if (lead.status === 'scheduled' && !lead.assigned_counselor_page_id && counselorNames.size > 1) {
      detailAssignedStatus.textContent = 'Assign a counselor so this new client counts toward their caseload.';
      detailAssignedStatus.className = 'mt-1 text-xs text-amber-700';
    } else {
      detailAssignedStatus.textContent = '';
    }
  }

  function renderAssignedSelect(lead: Lead) {
    detailAssignedWrap.classList.toggle('hidden', counselorNames.size === 0);
    const options = [...counselorNames.entries()].sort((a, b) => a[1].localeCompare(b[1]));
    detailAssignedSelect.innerHTML =
      `<option value="">Not assigned</option>` +
      options
        .map(([id, name]) => `<option value="${id}" ${id === lead.assigned_counselor_page_id ? 'selected' : ''}>${escapeHtml(name)}</option>`)
        .join('');
    renderAssignedHint(lead);
  }

  detailAssignedSelect.addEventListener('change', async () => {
    if (!currentLeadId) return;
    const lead = allLeads.find((l) => l.id === currentLeadId);
    if (!lead) return;
    const previous = lead.assigned_counselor_page_id;
    const next = detailAssignedSelect.value || null;
    detailAssignedSelect.disabled = true;
    const { error } = await supabase.from('leads').update({ assigned_counselor_page_id: next }).eq('id', lead.id);
    detailAssignedSelect.disabled = false;
    if (error) {
      detailAssignedSelect.value = previous ?? '';
      detailAssignedStatus.textContent = 'Could not save: ' + error.message;
      detailAssignedStatus.className = 'mt-1 text-xs text-red-600';
      return;
    }
    lead.assigned_counselor_page_id = next;
    renderAssignedHint(lead);
    if (!detailAssignedStatus.textContent) {
      detailAssignedStatus.textContent = 'Saved.';
      detailAssignedStatus.className = 'mt-1 text-xs text-emerald-700';
    }
  });

  backButton.addEventListener('click', () => {
    history.replaceState(null, '', window.location.pathname);
    showList();
    renderList();
  });

  detailArchiveButton.addEventListener('click', async () => {
    if (!currentLeadId) return;
    const lead = allLeads.find((l) => l.id === currentLeadId);
    if (!lead) return;
    if (await setArchived(currentLeadId, !lead.archived_at)) {
      detailArchiveButton.textContent = lead.archived_at ? 'Unarchive' : 'Archive';
      detailArchivedBanner.classList.toggle('hidden', !lead.archived_at);
      renderDueThisWeek();
    }
  });

  detailDeleteButton.addEventListener('click', async () => {
    if (!currentLeadId) return;
    if (await deleteLead(currentLeadId)) {
      showList();
      renderDueThisWeek();
      renderList();
    }
  });

  async function openDetail(leadId: string) {
    const lead = allLeads.find((l) => l.id === leadId);
    if (!lead) return;
    currentLeadId = leadId;

    detailName.textContent = lead.name || '(no name)';
    document.getElementById('i-detail-avatar')!.textContent = initials(lead.name);
    detailSubmitted.textContent =
      `Reached out ${relative(lead.created_at)} (${new Date(lead.created_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })})` +
      (lead.auto_reply_sent_at ? ' · Automatic reply sent' : '');
    detailStatusContainer.innerHTML = renderStatusSelect(lead.id, lead.status);
    detailEmail.innerHTML = lead.email ? `<a class="a-link" href="mailto:${escapeHtml(lead.email)}">${escapeHtml(lead.email)}</a>` : '<span class="i-faint">Not given</span>';
    detailPhone.innerHTML = lead.phone ? `<a class="a-link" href="tel:${escapeHtml(lead.phone.replace(/[^\d+]/g, ''))}">${escapeHtml(lead.phone)}</a>` : '<span class="i-faint">Not given</span>';
    detailWebsite.innerHTML = lead.existing_website_url
      ? `<a href="${escapeHtml(lead.existing_website_url)}" target="_blank" rel="noopener" class="text-brand-primary hover:underline">${escapeHtml(lead.existing_website_url)}</a>`
      : '—';
    // Suppress the "— <page>" suffix when source_page IS the label itself
    // (the MANUAL_SOURCE sentinel) — otherwise a manually-added lead would
    // read "Manually added — Manually added".
    const pageSuffix = lead.source_page && lead.source_page !== MANUAL_SOURCE ? ` — ${lead.source_page}` : '';
    detailSource.textContent = `${sourceLabel(lead)}${pageSuffix}`;
    const detailAd = document.getElementById('detail-ad')!;
    const adParts = [lead.utm_campaign && `campaign "${lead.utm_campaign}"`, lead.utm_term && `keyword "${lead.utm_term}"`].filter(Boolean);
    detailAd.classList.toggle('hidden', !isGoogleAdsLead(lead));
    detailAd.textContent = `Clicked a Google ad${adParts.length ? `: ${adParts.join(', ')}` : ''}${lead.landing_page ? ` (landed on ${lead.landing_page})` : ''}`;
    detailCounselor.textContent = lead.preferred_counselor_page_id
      ? (counselorNames.get(lead.preferred_counselor_page_id) ?? 'Unknown')
      : 'No preference (Help me choose)';
    renderAssignedSelect(lead);
    detailSourceSelect.value = lead.lead_source ?? '';
    detailSourceDetail.value = lead.lead_source_detail ?? '';
    detailSourceStatus.textContent = '';
    renderPartnerSelect(lead);
    detailSessionFormat.textContent = lead.preferred_session_format
      ? (SESSION_FORMAT_LABELS[lead.preferred_session_format] ?? lead.preferred_session_format)
      : 'No preference stated';
    detailMessage.textContent = lead.message?.trim() || 'No message.';
    detailFollowUp.value = lead.follow_up_date ?? '';
    followUpStatus.textContent = '';
    detailArchiveButton.textContent = lead.archived_at ? 'Unarchive' : 'Archive';
    detailArchivedBanner.classList.toggle('hidden', !lead.archived_at);

    if (counselorMode) {
      // Counselors can change status, follow-up, and notes only (0073).
      detailSourceSelect.disabled = true;
      detailSourceDetail.disabled = true;
      detailAssignedWrap.classList.add('hidden');
      detailPartnerWrap.classList.add('hidden');
    }
    showDetail();
    history.replaceState(null, '', `?lead=${leadId}`);
    await loadNotes(leadId);
  }

  saveFollowUpButton.addEventListener('click', async () => {
    if (!currentLeadId) return;
    followUpStatus.textContent = 'Saving...';
    followUpStatus.className = 'text-xs text-slate-500';
    const { error } = await supabase
      .from('leads')
      .update({ follow_up_date: detailFollowUp.value || null })
      .eq('id', currentLeadId);
    if (error) {
      followUpStatus.textContent = 'Could not save: ' + error.message;
      followUpStatus.className = 'text-xs text-red-600';
      return;
    }
    const lead = allLeads.find((l) => l.id === currentLeadId);
    if (lead) lead.follow_up_date = detailFollowUp.value || null;
    followUpStatus.textContent = 'Saved.';
    followUpStatus.className = 'text-xs text-emerald-700';
    renderDueThisWeek();
  });

  clearFollowUpButton.addEventListener('click', () => {
    detailFollowUp.value = '';
    saveFollowUpButton.click();
  });

  async function loadNotes(leadId: string) {
    notesList.innerHTML = '<div class="t-skel" style="height:56px"></div>';
    const { data, error } = await supabase
      .from('lead_notes')
      .select('*')
      .eq('lead_id', leadId)
      .order('created_at', { ascending: false });

    if (error) {
      notesList.innerHTML = `<p class="text-sm text-red-600">Could not load notes: ${escapeHtml(error.message)}</p>`;
      return;
    }
    const notes = data as LeadNote[];
    noteCounts.set(leadId, notes.length);
    if (notes.length === 0) {
      notesList.innerHTML = '<p class="i-faint">No notes yet. Add the first one above.</p>';
      return;
    }
    notesList.innerHTML = notes
      .map(
        (note) => `
      <div class="i-note"><p>${escapeHtml(note.note)}</p><small>${relative(note.created_at)}</small></div>`
      )
      .join('');
  }

  addNoteForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!currentLeadId) return;
    const noteText = noteTextField.value.trim();
    if (!noteText) return;

    const { data: userData } = await supabase.auth.getUser();
    const { error } = await supabase.from('lead_notes').insert({
      lead_id: currentLeadId,
      note: noteText,
      created_by: userData.user?.id ?? null,
    });
    if (error) {
      window.alert('Could not add note: ' + error.message);
      return;
    }
    noteTextField.value = '';
    await loadNotes(currentLeadId);
  });

  // --- Add lead ---

  const addLeadButton = document.getElementById('add-lead-button')!;
  const addLeadModal = document.getElementById('add-lead-modal')!;
  const addLeadCloseButton = document.getElementById('add-lead-close-button')!;
  const addLeadForm = document.getElementById('add-lead-form') as HTMLFormElement;
  const addLeadStatusField = document.getElementById('add-lead-status')!;

  function openAddLeadModal() {
    addLeadForm.reset();
    addLeadStatusField.textContent = '';
    addLeadModal.classList.remove('hidden');
    addLeadModal.classList.add('flex');
  }
  function closeAddLeadModal() {
    addLeadModal.classList.add('hidden');
    addLeadModal.classList.remove('flex');
  }

  addLeadButton.addEventListener('click', openAddLeadModal);
  addLeadCloseButton.addEventListener('click', closeAddLeadModal);

  addLeadForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    addLeadStatusField.textContent = '';
    const formData = new FormData(addLeadForm);
    const name = (formData.get('name') as string).trim();
    if (!name) return;

    const payload = {
      name,
      email: (formData.get('email') as string).trim() || null,
      phone: (formData.get('phone') as string).trim() || null,
      message: (formData.get('message') as string).trim() || null,
      status: formData.get('status') as string,
      // A fixed, honest source label — see MANUAL_SOURCE above — rather
      // than leaving source_page null (which would render as
      // "(unknown page)" on Leads and analytics, indistinguishable from a
      // real data gap).
      source_page: MANUAL_SOURCE,
      lead_source: (formData.get('lead_source') as string) || null,
      lead_source_detail: (formData.get('lead_source_detail') as string).trim() || null,
      lead_magnet_id: null,
      existing_website_url: null,
    };

    const submitButton = addLeadForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitButton.disabled = true;
    const { data, error } = await supabase.from('leads').insert(payload).select().single();
    submitButton.disabled = false;

    if (error) {
      addLeadStatusField.textContent = 'Could not add lead: ' + error.message;
      return;
    }

    closeAddLeadModal();
    await loadLeads();
    // Jump straight into the new lead's detail view — the most likely
    // next step right after manually adding one is adding a note or
    // setting a follow-up date.
    openDetail(data.id);
  });

  async function loadLeadMagnets() {
    const { data } = await supabase.from('lead_magnets').select('id, title').order('title');
    leadMagnets = (data as LeadMagnet[]) ?? [];
    updateSourceFilterOptions();
  }

  async function loadPartners() {
    const { data } = await supabase.from('referral_partners').select('id, name, archived_at').order('name');
    partnerOptions = data ?? [];
  }

  async function loadCounselors() {
    const { data } = await supabase.from('pages').select('id, title').eq('page_type', 'Counselor Profile');
    counselorNames = new Map((data ?? []).map((p) => [p.id, p.title]));
  }

  async function loadNoteCounts() {
    const { data } = await supabase.from('lead_notes').select('lead_id');
    noteCounts = new Map();
    for (const row of (data as { lead_id: string }[]) ?? []) {
      noteCounts.set(row.lead_id, (noteCounts.get(row.lead_id) ?? 0) + 1);
    }
  }

  let myPageId: string | null = null;
  async function loadLeads() {
    let query = supabase.from('leads').select('*').order('created_at', { ascending: false });
    if (counselorMode && myPageId) query = query.eq('assigned_counselor_page_id', myPageId);
    const { data, error } = await query;
    if (error) {
      leadsCount.textContent = 'Could not load leads: ' + error.message;
      return;
    }
    allLeads = data as Lead[];
    await loadNoteCounts();
    renderDueThisWeek();
    renderList();
  }

  initAdminAuth(
    async (user: AdminUser) => {
      if (user.role === 'staff') {
        // Only a linked counselor has inquiries of their own.
        if (!user.linked_counselor_page_id) {
          window.location.href = withBase('/admin/today');
          return;
        }
        counselorMode = true;
        myPageId = user.linked_counselor_page_id;
        document.querySelector('.a-title')!.textContent = 'My inquiries';
        document.getElementById('i-intro')!.textContent = 'Inquiries assigned to you. Reply fast: people often reach out to more than one counselor.';
        viewContactsButton.parentElement!.hidden = true;
        applyCounselorMode();
      } else {
        await loadLeadMagnets();
        await loadPartners();
      }
      await loadCounselors();
      await loadLeads();
      setView('leads');
      // Deep link from Today: /admin/crm?lead=<id>
      const linked = new URLSearchParams(window.location.search).get('lead');
      if (linked && allLeads.some((l) => l.id === linked)) openDetail(linked);
    },
    { allowedRoles: ['owner', 'agency', 'staff'] }
  );
</script>
