---
import AdminLayout from '../../layouts/AdminLayout.astro';
import RichTextEditor from '../../components/RichTextEditor.astro';
import LockedField from '../../components/LockedField.astro';
import SuggestEdit from '../../components/SuggestEdit.astro';
---

<AdminLayout title="Website content | Admin" current="content">
  <div class="max-w-2xl space-y-12">
    <section>
      <h2 class="mb-4 font-[family-name:var(--font-heading)] text-xl font-extrabold text-brand-ink">Business info</h2>
      <p class="mb-4 text-sm text-slate-600">
        Your contact details and address, shown across your site — safe to edit anytime.
      </p>
      <form id="business-form" class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">Phone</label>
            <input id="biz-telephone" type="tel" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">Email</label>
            <input id="biz-email" type="email" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Street address</label>
          <input id="biz-street" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
        </div>
        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">City</label>
            <input id="biz-city" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">State</label>
            <input id="biz-region" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">ZIP</label>
            <input id="biz-postal" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Client portal URL (optional)</label>
          <input id="biz-portal" type="url" placeholder="https://..." class="w-full rounded-md border border-slate-300 px-4 py-2" />
          <p class="mt-1 text-xs text-slate-500">
            Shown as a "Client Portal" link in your site's footer, for existing clients to reach your EHR
            (SimplePractice, TherapyNotes, etc.).
          </p>
        </div>
        <button
          id="business-save-button"
          type="button"
          class="rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
        >
          Save
        </button>
        <p id="business-status" class="text-sm" role="status"></p>
      </form>
    </section>

    <section>
      <h2 class="mb-4 font-[family-name:var(--font-heading)] text-xl font-extrabold text-brand-ink">Testimonials</h2>
      <p class="mb-4 text-sm text-slate-600">A genuine quote from a client, shown on the page you choose — safe to edit anytime.</p>
      <div class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Page</label>
          <select id="testimonial-page-select" class="w-full rounded-md border border-slate-300 px-4 py-2"></select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Quote</label>
          <textarea id="testimonial-quote" rows="3" class="w-full rounded-md border border-slate-300 px-4 py-2"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">Author</label>
            <input id="testimonial-author" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">Role (optional)</label>
            <input id="testimonial-role" type="text" placeholder="Client since 2024" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
        </div>
        <button
          id="testimonial-save-button"
          type="button"
          class="rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
        >
          Save
        </button>
        <p id="testimonial-status" class="text-sm" role="status"></p>
      </div>
    </section>

    <section>
      <h2 class="mb-1 font-[family-name:var(--font-heading)] text-xl font-extrabold text-brand-ink">Page copy</h2>
      <p id="content-tier-note" class="mb-4 text-sm text-slate-600"></p>
      <div class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Page</label>
          <select id="content-page-select" class="w-full rounded-md border border-slate-300 px-4 py-2"></select>
        </div>

        <div id="content-fields" class="hidden space-y-6">
          <LockedField fieldKey="h1" label="Page heading (H1)" />
          <LockedField fieldKey="meta_description" label="Meta description" />
          <LockedField fieldKey="focus_keyword" label="Focus keyword" />

          <div data-field="hero_subhead">
            <label class="mb-1 block text-sm font-semibold text-slate-700">Hero subheading</label>
            <input id="content-hero-subhead" type="text" class="editable-view w-full rounded-md border border-slate-300 px-4 py-2" />
            <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
            <p class="tier-note mt-1 text-xs text-slate-500">
              Included as an agency-managed field on your plan — suggest a change below.
            </p>
            <SuggestEdit fieldLabel="Hero subheading" />
          </div>

          <div data-field="copy">
            <label class="mb-1 block text-sm font-semibold text-slate-700">Page copy</label>
            <div class="editable-view">
              <RichTextEditor id="content-copy-editor" />
            </div>
            <div class="locked-view prose prose-sm max-w-none rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" data-locked-value-html>
            </div>
            <p class="tier-note mt-1 text-xs text-slate-500">
              Included as an agency-managed field on your plan — suggest a change below.
            </p>
            <SuggestEdit fieldLabel="Page copy" />
          </div>

          <div data-field="images">
            <label class="mb-1 block text-sm font-semibold text-slate-700">Hero image</label>
            <div class="editable-view space-y-2">
              <input id="content-image-file" type="file" accept="image/*" class="w-full text-sm" />
              <input
                id="content-image-alt"
                type="text"
                placeholder="Describe what's in the photo"
                class="w-full rounded-md border border-slate-300 px-4 py-2 text-sm"
              />
              <p id="content-image-status" class="text-xs text-slate-500"></p>
            </div>
            <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
            <p class="tier-note mt-1 text-xs text-slate-500">
              Included as an agency-managed field on your plan — suggest a change below.
            </p>
            <SuggestEdit fieldLabel="Hero image" />
          </div>

          <button
            id="content-save-button"
            type="button"
            class="save-only-when-full rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
          >
            Save
          </button>
          <p id="content-save-status" class="text-sm" role="status"></p>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth } from '../../lib/adminAuth';
  import { initRichTextEditor } from '../../lib/richTextEditor';
  import { renderCopy } from '../../lib/markdown';

  type ContentPage = {
    id: string;
    title: string;
    page_type: string;
    h1: string | null;
    meta_description: string | null;
    focus_keyword: string | null;
    hero_subhead: string | null;
    copy: string | null;
    images: { hero?: { url: string; alt: string } } | null;
    testimonial_quote: string | null;
    testimonial_author: string | null;
    testimonial_role: string | null;
  };

  type Business = {
    id: string;
    telephone: string | null;
    email: string | null;
    street_address: string | null;
    address_locality: string | null;
    address_region: string | null;
    postal_code: string | null;
    client_portal_url: string | null;
    content_permission_level: 'restricted' | 'full';
  };

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  let business: Business | null = null;
  let pages: ContentPage[] = [];
  let currentUserId: string | null = null;
  let selectedTestimonialPage: ContentPage | null = null;
  let selectedContentPage: ContentPage | null = null;
  let uploadedImageUrl: string | null = null;

  // ---------------------------------------------------------------------
  // Business info
  // ---------------------------------------------------------------------
  const businessSaveButton = document.getElementById('business-save-button')!;
  const businessStatus = document.getElementById('business-status')!;
  const bizTelephone = document.getElementById('biz-telephone') as HTMLInputElement;
  const bizEmail = document.getElementById('biz-email') as HTMLInputElement;
  const bizStreet = document.getElementById('biz-street') as HTMLInputElement;
  const bizCity = document.getElementById('biz-city') as HTMLInputElement;
  const bizRegion = document.getElementById('biz-region') as HTMLInputElement;
  const bizPostal = document.getElementById('biz-postal') as HTMLInputElement;
  const bizPortal = document.getElementById('biz-portal') as HTMLInputElement;

  function loadBusinessForm() {
    if (!business) return;
    bizTelephone.value = business.telephone ?? '';
    bizEmail.value = business.email ?? '';
    bizStreet.value = business.street_address ?? '';
    bizCity.value = business.address_locality ?? '';
    bizRegion.value = business.address_region ?? '';
    bizPostal.value = business.postal_code ?? '';
    bizPortal.value = business.client_portal_url ?? '';
  }

  businessSaveButton.addEventListener('click', async () => {
    if (!business) return;
    businessStatus.textContent = 'Saving...';
    businessStatus.className = 'text-sm text-slate-600';
    const { error } = await supabase
      .from('business')
      .update({
        telephone: bizTelephone.value.trim() || null,
        email: bizEmail.value.trim() || null,
        street_address: bizStreet.value.trim() || null,
        address_locality: bizCity.value.trim() || null,
        address_region: bizRegion.value.trim() || null,
        postal_code: bizPostal.value.trim() || null,
        client_portal_url: bizPortal.value.trim() || null,
      })
      .eq('id', business.id);
    if (error) {
      businessStatus.textContent = 'Could not save: ' + error.message;
      businessStatus.className = 'text-sm text-red-600';
      return;
    }
    businessStatus.textContent = 'Saved.';
    businessStatus.className = 'text-sm text-emerald-700';
  });

  // ---------------------------------------------------------------------
  // Shared page picker options (every page except blog content, which has
  // its own dedicated section)
  // ---------------------------------------------------------------------
  function populatePagePicker(select: HTMLSelectElement) {
    select.innerHTML = pages
      .map((p) => `<option value="${p.id}">${escapeHtml(p.title)}</option>`)
      .join('');
  }

  // ---------------------------------------------------------------------
  // Testimonials
  // ---------------------------------------------------------------------
  const testimonialPageSelect = document.getElementById('testimonial-page-select') as HTMLSelectElement;
  const testimonialQuote = document.getElementById('testimonial-quote') as HTMLTextAreaElement;
  const testimonialAuthor = document.getElementById('testimonial-author') as HTMLInputElement;
  const testimonialRole = document.getElementById('testimonial-role') as HTMLInputElement;
  const testimonialSaveButton = document.getElementById('testimonial-save-button')!;
  const testimonialStatus = document.getElementById('testimonial-status')!;

  function loadTestimonialForm() {
    selectedTestimonialPage = pages.find((p) => p.id === testimonialPageSelect.value) ?? null;
    testimonialQuote.value = selectedTestimonialPage?.testimonial_quote ?? '';
    testimonialAuthor.value = selectedTestimonialPage?.testimonial_author ?? '';
    testimonialRole.value = selectedTestimonialPage?.testimonial_role ?? '';
    testimonialStatus.textContent = '';
  }

  testimonialPageSelect.addEventListener('change', loadTestimonialForm);

  testimonialSaveButton.addEventListener('click', async () => {
    if (!selectedTestimonialPage) return;
    testimonialStatus.textContent = 'Saving...';
    testimonialStatus.className = 'text-sm text-slate-600';
    const { error } = await supabase
      .from('pages')
      .update({
        testimonial_quote: testimonialQuote.value.trim() || null,
        testimonial_author: testimonialAuthor.value.trim() || null,
        testimonial_role: testimonialRole.value.trim() || null,
      })
      .eq('id', selectedTestimonialPage.id);
    if (error) {
      testimonialStatus.textContent = 'Could not save: ' + error.message;
      testimonialStatus.className = 'text-sm text-red-600';
      return;
    }
    selectedTestimonialPage.testimonial_quote = testimonialQuote.value.trim() || null;
    selectedTestimonialPage.testimonial_author = testimonialAuthor.value.trim() || null;
    selectedTestimonialPage.testimonial_role = testimonialRole.value.trim() || null;
    testimonialStatus.textContent = 'Saved.';
    testimonialStatus.className = 'text-sm text-emerald-700';
  });

  // ---------------------------------------------------------------------
  // Page copy — H1/meta description/focus keyword are locked on every
  // plan; hero subheading/copy/hero image are locked unless
  // business.content_permission_level is 'full'. A locked field gets a
  // "Suggest an edit" affordance (content_suggestions) instead of a
  // direct save — see 0011_content_permission_and_suggestions.sql, which
  // enforces this server-side too, not just in this UI.
  // ---------------------------------------------------------------------
  const contentTierNote = document.getElementById('content-tier-note')!;
  const contentPageSelect = document.getElementById('content-page-select') as HTMLSelectElement;
  const contentFields = document.getElementById('content-fields')!;
  const contentHeroSubhead = document.getElementById('content-hero-subhead') as HTMLInputElement;
  const copyEditor = initRichTextEditor('content-copy-editor');
  const contentImageFile = document.getElementById('content-image-file') as HTMLInputElement;
  const contentImageAlt = document.getElementById('content-image-alt') as HTMLInputElement;
  const contentImageStatus = document.getElementById('content-image-status')!;
  const contentSaveButton = document.getElementById('content-save-button')!;
  const contentSaveStatus = document.getElementById('content-save-status')!;

  function isFullTier(): boolean {
    return business?.content_permission_level === 'full';
  }

  function getCurrentValueText(fieldKey: string): string {
    if (!selectedContentPage) return '';
    switch (fieldKey) {
      case 'h1':
        return selectedContentPage.h1 ?? '';
      case 'meta_description':
        return selectedContentPage.meta_description ?? '';
      case 'focus_keyword':
        return selectedContentPage.focus_keyword ?? '';
      case 'hero_subhead':
        return selectedContentPage.hero_subhead ?? '';
      case 'copy':
        return selectedContentPage.copy ?? '';
      case 'images':
        return selectedContentPage.images?.hero
          ? `${selectedContentPage.images.hero.url} (alt: ${selectedContentPage.images.hero.alt})`
          : '(no image set)';
      default:
        return '';
    }
  }

  // Wires the generic "Suggest an edit" toggle + submit for every
  // [data-field] container on the page (shared markup from
  // components/SuggestEdit.astro).
  function wireSuggestButtons() {
    document.querySelectorAll<HTMLElement>('[data-field]').forEach((fieldEl) => {
      const fieldKey = fieldEl.dataset.field!;
      const toggleButton = fieldEl.querySelector<HTMLElement>('.suggest-edit-button')!;
      const form = fieldEl.querySelector<HTMLElement>('.suggest-form')!;
      const textarea = fieldEl.querySelector('.suggest-textarea') as HTMLTextAreaElement;
      const submitButton = fieldEl.querySelector<HTMLElement>('.submit-suggestion-button')!;
      const status = fieldEl.querySelector<HTMLElement>('.suggest-status')!;

      toggleButton.addEventListener('click', () => {
        form.classList.toggle('hidden');
      });

      submitButton.addEventListener('click', async () => {
        if (!selectedContentPage) return;
        const suggestedValue = textarea.value.trim();
        if (!suggestedValue) {
          status.textContent = 'Enter a suggestion first.';
          status.className = 'suggest-status text-xs text-red-600';
          return;
        }
        status.textContent = 'Submitting...';
        status.className = 'suggest-status text-xs text-slate-600';
        const { error } = await supabase.from('content_suggestions').insert({
          page_id: selectedContentPage.id,
          field_name: fieldKey,
          current_value: getCurrentValueText(fieldKey),
          suggested_value: suggestedValue,
          submitted_by: currentUserId,
        });
        if (error) {
          status.textContent = 'Could not submit: ' + error.message;
          status.className = 'suggest-status text-xs text-red-600';
          return;
        }
        status.textContent = "Sent — your strategist will follow up.";
        status.className = 'suggest-status text-xs text-emerald-700';
        textarea.value = '';
        form.classList.add('hidden');
      });
    });
  }

  function renderTierUI() {
    const full = isFullTier();
    contentTierNote.textContent = full
      ? 'Your plan includes full editing access to hero text, page copy, and images.'
      : "Page heading, meta description, and focus keyword are always managed by your SEO strategist. On your current plan, hero text, page copy, and images are too — suggest a change and we'll take care of it.";
    document.querySelectorAll<HTMLElement>('[data-field="hero_subhead"], [data-field="copy"], [data-field="images"]').forEach((fieldEl) => {
      fieldEl.querySelectorAll<HTMLElement>('.editable-view').forEach((el) => el.classList.toggle('hidden', !full));
      fieldEl.querySelectorAll<HTMLElement>('.locked-view').forEach((el) => el.classList.toggle('hidden', full));
      fieldEl.querySelectorAll<HTMLElement>('.tier-note, .suggest-edit-wrap').forEach((el) => el.classList.toggle('hidden', full));
    });
    contentSaveButton.classList.toggle('hidden', !full);
  }

  function loadContentForm() {
    selectedContentPage = pages.find((p) => p.id === contentPageSelect.value) ?? null;
    if (!selectedContentPage) {
      contentFields.classList.add('hidden');
      return;
    }
    contentFields.classList.remove('hidden');

    document.querySelector('[data-field="h1"] [data-locked-value]')!.textContent = selectedContentPage.h1 ?? '(not set)';
    document.querySelector('[data-field="meta_description"] [data-locked-value]')!.textContent =
      selectedContentPage.meta_description ?? '(not set)';
    document.querySelector('[data-field="focus_keyword"] [data-locked-value]')!.textContent =
      selectedContentPage.focus_keyword ?? '(not set)';

    contentHeroSubhead.value = selectedContentPage.hero_subhead ?? '';
    document.querySelector('[data-field="hero_subhead"] [data-locked-value]')!.textContent =
      selectedContentPage.hero_subhead ?? '(not set)';

    copyEditor.setMarkdown(selectedContentPage.copy);
    document.querySelector('[data-field="copy"] [data-locked-value-html]')!.innerHTML = renderCopy(selectedContentPage.copy);

    uploadedImageUrl = selectedContentPage.images?.hero?.url ?? null;
    contentImageAlt.value = selectedContentPage.images?.hero?.alt ?? '';
    contentImageStatus.textContent = uploadedImageUrl ? 'Current image on file — choose a new one to replace it.' : '';
    document.querySelector('[data-field="images"] [data-locked-value]')!.textContent = uploadedImageUrl
      ? `Current image: ${selectedContentPage.images?.hero?.alt}`
      : 'No image set.';

    contentSaveStatus.textContent = '';
    renderTierUI();
  }

  contentPageSelect.addEventListener('change', loadContentForm);

  contentImageFile.addEventListener('change', async () => {
    const file = contentImageFile.files?.[0];
    if (!file) return;
    contentImageStatus.textContent = 'Uploading...';
    const path = `content/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;
    const { error } = await supabase.storage.from('site-images').upload(path, file);
    if (error) {
      contentImageStatus.textContent = 'Upload failed: ' + error.message;
      return;
    }
    const { data: urlData } = supabase.storage.from('site-images').getPublicUrl(path);
    uploadedImageUrl = urlData.publicUrl;
    contentImageStatus.textContent = 'Image uploaded.';
  });

  contentSaveButton.addEventListener('click', async () => {
    if (!selectedContentPage || !isFullTier()) return;
    if (uploadedImageUrl && !contentImageAlt.value.trim()) {
      contentSaveStatus.textContent = 'Alt text is required for the hero image.';
      contentSaveStatus.className = 'text-sm text-red-600';
      return;
    }
    contentSaveStatus.textContent = 'Saving...';
    contentSaveStatus.className = 'text-sm text-slate-600';
    const payload = {
      hero_subhead: contentHeroSubhead.value.trim() || null,
      copy: copyEditor.getMarkdown(),
      images: uploadedImageUrl ? { hero: { url: uploadedImageUrl, alt: contentImageAlt.value.trim() } } : {},
    };
    const { error } = await supabase.from('pages').update(payload).eq('id', selectedContentPage.id);
    if (error) {
      contentSaveStatus.textContent = 'Could not save: ' + error.message;
      contentSaveStatus.className = 'text-sm text-red-600';
      return;
    }
    Object.assign(selectedContentPage, payload);
    contentSaveStatus.textContent = 'Saved.';
    contentSaveStatus.className = 'text-sm text-emerald-700';
  });

  // ---------------------------------------------------------------------
  async function onAuthed() {
    const [{ data: userData }, { data: businessData }, { data: pagesData }] = await Promise.all([
      supabase.auth.getUser(),
      supabase.from('business').select('*').single(),
      supabase.from('pages').select('*').not('page_type', 'in', '("Blog Post","Blog Index")').order('title'),
    ]);
    currentUserId = userData.user?.id ?? null;
    business = businessData as Business;
    pages = (pagesData ?? []) as ContentPage[];

    loadBusinessForm();
    populatePagePicker(testimonialPageSelect);
    populatePagePicker(contentPageSelect);
    loadTestimonialForm();
    loadContentForm();
    wireSuggestButtons();
  }

  initAdminAuth(onAuthed);
</script>
