---
// Website content used to be one page (business info + testimonials +
// page copy stacked in one scroll) — split into admin/content/
// business-info.astro and admin/content/page-copy.astro once each grew
// enough to warrant its own screen (see AdminLayout.astro's collapsible
// "Website content" nav group). This redirect keeps any old bookmark or
// hardcoded link to /admin/content working.
import { withBase } from '../../lib/url';

return Astro.redirect(withBase('/admin/content/business-info'), 302);
