---
import AdminLayout from '../../layouts/AdminLayout.astro';
import RichTextEditor from '../../components/RichTextEditor.astro';
import LockedField from '../../components/LockedField.astro';
import SuggestEdit from '../../components/SuggestEdit.astro';
import UnsplashSearchModal from '../../components/UnsplashSearchModal.astro';
---

<AdminLayout title="Website content | Admin" current="content">
  <div class="max-w-2xl space-y-12">
    <section>
      <h2 class="mb-4 font-[family-name:var(--font-heading)] text-xl font-extrabold text-brand-ink">Business info</h2>
      <p class="mb-4 text-sm text-slate-600">
        Your contact details and address, shown across your site — safe to edit anytime.
      </p>
      <form id="business-form" class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">Phone</label>
            <input id="biz-telephone" type="tel" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">Email</label>
            <input id="biz-email" type="email" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Street address</label>
          <input id="biz-street" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
        </div>
        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">City</label>
            <input id="biz-city" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">State</label>
            <input id="biz-region" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">ZIP</label>
            <input id="biz-postal" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Client portal URL (optional)</label>
          <input id="biz-portal" type="url" placeholder="https://..." class="w-full rounded-md border border-slate-300 px-4 py-2" />
          <p class="mt-1 text-xs text-slate-500">
            Shown as a "Client Portal" link in your site's footer, for existing clients to reach your EHR
            (SimplePractice, TherapyNotes, etc.).
          </p>
        </div>
        <button
          id="business-save-button"
          type="button"
          class="rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
        >
          Save
        </button>
        <p id="business-status" class="text-sm" role="status"></p>
      </form>
    </section>

    <section>
      <h2 class="mb-4 font-[family-name:var(--font-heading)] text-xl font-extrabold text-brand-ink">Testimonials</h2>
      <p class="mb-4 text-sm text-slate-600">A genuine quote from a client, shown on the page you choose — safe to edit anytime.</p>
      <div class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Page</label>
          <select id="testimonial-page-select" class="w-full rounded-md border border-slate-300 px-4 py-2"></select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Quote</label>
          <textarea id="testimonial-quote" rows="3" class="w-full rounded-md border border-slate-300 px-4 py-2"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">Author</label>
            <input id="testimonial-author" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">Role (optional)</label>
            <input id="testimonial-role" type="text" placeholder="Client since 2024" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
        </div>
        <button
          id="testimonial-save-button"
          type="button"
          class="rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
        >
          Save
        </button>
        <p id="testimonial-status" class="text-sm" role="status"></p>
      </div>
    </section>

    <section>
      <h2 class="mb-1 font-[family-name:var(--font-heading)] text-xl font-extrabold text-brand-ink">Page copy</h2>
      <p id="content-tier-note" class="mb-4 text-sm text-slate-600"></p>
      <div class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Page</label>
          <select id="content-page-select" class="w-full rounded-md border border-slate-300 px-4 py-2"></select>
        </div>

        <div id="content-fields" class="hidden space-y-6">
          <LockedField fieldKey="h1" label="Page heading (H1)" inputId="content-h1" />
          <LockedField
            fieldKey="meta_description"
            label="Meta description"
            inputId="content-meta-description"
            inputType="textarea"
          />
          <LockedField fieldKey="focus_keyword" label="Focus keyword" inputId="content-focus-keyword" />

          <div data-field="hero_subhead">
            <label class="mb-1 block text-sm font-semibold text-slate-700">Hero subheading</label>
            <input id="content-hero-subhead" type="text" class="editable-view w-full rounded-md border border-slate-300 px-4 py-2" />
            <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
            <p class="tier-note mt-1 text-xs text-slate-500">
              Included as an agency-managed field on your plan — suggest a change below.
            </p>
            <SuggestEdit fieldLabel="Hero subheading" />
          </div>

          <div data-field="copy">
            <label class="mb-1 block text-sm font-semibold text-slate-700">Page copy</label>
            <div class="editable-view">
              <RichTextEditor id="content-copy-editor" />
            </div>
            <div class="locked-view prose prose-sm max-w-none rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" data-locked-value-html>
            </div>
            <p class="tier-note mt-1 text-xs text-slate-500">
              Included as an agency-managed field on your plan — suggest a change below.
            </p>
            <SuggestEdit fieldLabel="Page copy" />
          </div>

          <div data-field="images">
            <label class="mb-1 block text-sm font-semibold text-slate-700">Hero image</label>
            <div class="editable-view space-y-2">
              <div class="flex flex-wrap items-center gap-2">
                <button
                  id="search-unsplash-button"
                  type="button"
                  class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                >
                  Search Unsplash
                </button>
                <span class="text-xs text-slate-400">or</span>
                <label
                  for="content-image-file"
                  class="inline-block cursor-pointer rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                >
                  Choose File
                </label>
                <input id="content-image-file" type="file" accept="image/*" class="sr-only" />
              </div>
              <p id="content-image-status" class="text-xs text-slate-500"></p>
              <img id="content-image-preview" class="hidden h-32 w-auto rounded-md border border-slate-200 object-cover" />
              <input
                id="content-image-alt"
                type="text"
                placeholder="Describe what's in the photo"
                class="w-full rounded-md border border-slate-300 px-4 py-2 text-sm"
              />
            </div>
            <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
            <p class="tier-note mt-1 text-xs text-slate-500">
              Included as an agency-managed field on your plan — suggest a change below.
            </p>
            <SuggestEdit fieldLabel="Hero image" />

            <!--
              Hero layout — never shown for a 'Counselor Profile' page,
              which doesn't use Hero.astro at all (see
              CounselorProfile.astro's own header card). Lives inside this
              same [data-field="images"] container so it shares its
              editable/locked tier-gating rather than needing a second
              lock group for something this closely tied to the hero
              image itself.
            -->
            <div id="content-hero-style-wrap" class="mt-4 space-y-3 border-t border-slate-100 pt-4">
              <div class="editable-view">
                <label class="mb-1 block text-sm font-semibold text-slate-700">Hero layout</label>
                <select id="content-hero-style" class="w-full rounded-md border border-slate-300 px-4 py-2 text-sm">
                  <option value="default">Default — image beside text</option>
                  <option value="overlay">Full-width image with color overlay</option>
                </select>
              </div>
              <div id="content-hero-overlay-controls" class="editable-view hidden space-y-3 rounded-md bg-slate-50 p-3">
                <div>
                  <label class="mb-1 block text-xs font-semibold text-slate-700">Overlay color</label>
                  <input id="content-hero-overlay-color" type="color" class="h-10 w-16 rounded border border-slate-300" />
                </div>
                <div>
                  <label class="mb-1 block text-xs font-semibold text-slate-700">
                    Overlay opacity — <span id="content-hero-overlay-opacity-readout">50</span>%
                  </label>
                  <input
                    id="content-hero-overlay-opacity"
                    type="range"
                    min="0"
                    max="100"
                    class="w-full"
                  />
                  <p class="mt-1 text-xs text-slate-500">
                    Darkens or lightens the image behind your heading so it stays easy to read no matter what photo you pick.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <button
            id="content-save-button"
            type="button"
            class="save-only-when-full rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
          >
            Save
          </button>
          <p id="content-save-status" class="text-sm" role="status"></p>

          <!--
            Reviewer byline — pillar/hub pages only ("Content Pillar" and
            "Service Hub" page types; see BYLINE_PAGE_TYPES below). Not
            tier-gated like the fields above: author_name/credentials/
            date_modified aren't locked by enforce_content_permission, so
            this gets its own always-on save button rather than being
            folded into content-save-button's tier-gated visibility.
          -->
          <div id="content-byline-section" class="hidden space-y-3 border-t border-slate-200 pt-6">
            <h3 class="text-sm font-semibold text-slate-700">Reviewed-by byline</h3>
            <p class="text-xs text-slate-500">
              Shown on the page as "Reviewed by [name], [credential] — Updated [date]" and included in this page's
              schema markup. Leave the name blank to hide the byline entirely.
            </p>
            <div>
              <label class="mb-1 block text-sm font-semibold text-slate-700">Reviewer name</label>
              <input id="content-byline-name" type="text" placeholder="Jane Smith" class="w-full rounded-md border border-slate-300 px-4 py-2" />
            </div>
            <div>
              <label class="mb-1 block text-sm font-semibold text-slate-700">Reviewer credential (optional)</label>
              <input id="content-byline-credential" type="text" placeholder="LCSW, Owner/Director" class="w-full rounded-md border border-slate-300 px-4 py-2" />
            </div>
            <div>
              <label class="mb-1 block text-sm font-semibold text-slate-700">Date updated</label>
              <input id="content-byline-date" type="date" class="w-full rounded-md border border-slate-300 px-4 py-2" />
            </div>
            <button
              id="content-byline-save-button"
              type="button"
              class="rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
            >
              Save byline
            </button>
            <p id="content-byline-status" class="text-sm" role="status"></p>
          </div>
        </div>
      </div>
    </section>

    <section id="your-suggestions-section" class="hidden">
      <h2 class="mb-4 font-[family-name:var(--font-heading)] text-xl font-extrabold text-brand-ink">Your suggestions</h2>
      <p class="mb-4 text-sm text-slate-600">
        Edits you've suggested for locked fields, and their status.
      </p>
      <div id="your-suggestions-list" class="space-y-3"></div>
    </section>
  </div>

  <UnsplashSearchModal />
</AdminLayout>

<script>
  import { supabase, initAdminAuth, type AdminUser } from '../../lib/adminAuth';
  import { initRichTextEditor } from '../../lib/richTextEditor';
  import { renderCopy } from '../../lib/markdown';
  import { triggerRebuild } from '../../lib/publishFunction';
  import { initUnsplashSearchModal, type UnsplashPhoto } from '../../lib/unsplashSearch';

  type ContentPage = {
    id: string;
    title: string;
    page_type: string;
    h1: string | null;
    meta_description: string | null;
    focus_keyword: string | null;
    hero_subhead: string | null;
    copy: string | null;
    images: { hero?: { url: string; alt: string; creditName?: string; creditUrl?: string } } | null;
    testimonial_quote: string | null;
    testimonial_author: string | null;
    testimonial_role: string | null;
    author_name: string | null;
    credentials: string | null;
    date_modified: string | null;
    hero_style: 'default' | 'overlay';
    hero_overlay_color: string;
    hero_overlay_opacity: number;
  };

  type Business = {
    id: string;
    telephone: string | null;
    email: string | null;
    street_address: string | null;
    address_locality: string | null;
    address_region: string | null;
    postal_code: string | null;
    client_portal_url: string | null;
    content_permission_level: 'restricted' | 'full';
  };

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  let business: Business | null = null;
  let pages: ContentPage[] = [];
  let currentUserId: string | null = null;
  let currentAdminUser: AdminUser | null = null;
  let selectedTestimonialPage: ContentPage | null = null;
  let selectedContentPage: ContentPage | null = null;
  let uploadedImageUrl: string | null = null;
  let uploadedImageCreditName: string | null = null;
  let uploadedImageCreditUrl: string | null = null;

  // ---------------------------------------------------------------------
  // Business info
  // ---------------------------------------------------------------------
  const businessSaveButton = document.getElementById('business-save-button')!;
  const businessStatus = document.getElementById('business-status')!;
  const bizTelephone = document.getElementById('biz-telephone') as HTMLInputElement;
  const bizEmail = document.getElementById('biz-email') as HTMLInputElement;
  const bizStreet = document.getElementById('biz-street') as HTMLInputElement;
  const bizCity = document.getElementById('biz-city') as HTMLInputElement;
  const bizRegion = document.getElementById('biz-region') as HTMLInputElement;
  const bizPostal = document.getElementById('biz-postal') as HTMLInputElement;
  const bizPortal = document.getElementById('biz-portal') as HTMLInputElement;

  function loadBusinessForm() {
    if (!business) return;
    bizTelephone.value = business.telephone ?? '';
    bizEmail.value = business.email ?? '';
    bizStreet.value = business.street_address ?? '';
    bizCity.value = business.address_locality ?? '';
    bizRegion.value = business.address_region ?? '';
    bizPostal.value = business.postal_code ?? '';
    bizPortal.value = business.client_portal_url ?? '';
  }

  businessSaveButton.addEventListener('click', async () => {
    if (!business) return;
    businessStatus.textContent = 'Saving...';
    businessStatus.className = 'text-sm text-slate-600';
    const { error } = await supabase
      .from('business')
      .update({
        telephone: bizTelephone.value.trim() || null,
        email: bizEmail.value.trim() || null,
        street_address: bizStreet.value.trim() || null,
        address_locality: bizCity.value.trim() || null,
        address_region: bizRegion.value.trim() || null,
        postal_code: bizPostal.value.trim() || null,
        client_portal_url: bizPortal.value.trim() || null,
      })
      .eq('id', business.id);
    if (error) {
      businessStatus.textContent = 'Could not save: ' + error.message;
      businessStatus.className = 'text-sm text-red-600';
      return;
    }
    businessStatus.textContent = 'Saving your site...';
    const result = await triggerRebuild();
    businessStatus.textContent = result.ok
      ? 'Saved! Your site will update shortly.'
      : 'Saved, but the update trigger failed — it will go live on the next rebuild.';
    businessStatus.className = result.ok ? 'text-sm text-emerald-700' : 'text-sm text-amber-700';
  });

  // ---------------------------------------------------------------------
  // Shared page picker options (every page except blog content, which has
  // its own dedicated section)
  // ---------------------------------------------------------------------
  function populatePagePicker(select: HTMLSelectElement) {
    select.innerHTML = pages
      .map((p) => `<option value="${p.id}">${escapeHtml(p.title)}</option>`)
      .join('');
  }

  // ---------------------------------------------------------------------
  // Testimonials
  // ---------------------------------------------------------------------
  const testimonialPageSelect = document.getElementById('testimonial-page-select') as HTMLSelectElement;
  const testimonialQuote = document.getElementById('testimonial-quote') as HTMLTextAreaElement;
  const testimonialAuthor = document.getElementById('testimonial-author') as HTMLInputElement;
  const testimonialRole = document.getElementById('testimonial-role') as HTMLInputElement;
  const testimonialSaveButton = document.getElementById('testimonial-save-button')!;
  const testimonialStatus = document.getElementById('testimonial-status')!;

  function loadTestimonialForm() {
    selectedTestimonialPage = pages.find((p) => p.id === testimonialPageSelect.value) ?? null;
    testimonialQuote.value = selectedTestimonialPage?.testimonial_quote ?? '';
    testimonialAuthor.value = selectedTestimonialPage?.testimonial_author ?? '';
    testimonialRole.value = selectedTestimonialPage?.testimonial_role ?? '';
    testimonialStatus.textContent = '';
  }

  testimonialPageSelect.addEventListener('change', loadTestimonialForm);

  testimonialSaveButton.addEventListener('click', async () => {
    if (!selectedTestimonialPage) return;
    testimonialStatus.textContent = 'Saving...';
    testimonialStatus.className = 'text-sm text-slate-600';
    const { error } = await supabase
      .from('pages')
      .update({
        testimonial_quote: testimonialQuote.value.trim() || null,
        testimonial_author: testimonialAuthor.value.trim() || null,
        testimonial_role: testimonialRole.value.trim() || null,
      })
      .eq('id', selectedTestimonialPage.id);
    if (error) {
      testimonialStatus.textContent = 'Could not save: ' + error.message;
      testimonialStatus.className = 'text-sm text-red-600';
      return;
    }
    selectedTestimonialPage.testimonial_quote = testimonialQuote.value.trim() || null;
    selectedTestimonialPage.testimonial_author = testimonialAuthor.value.trim() || null;
    selectedTestimonialPage.testimonial_role = testimonialRole.value.trim() || null;
    testimonialStatus.textContent = 'Saving your site...';
    const result = await triggerRebuild();
    testimonialStatus.textContent = result.ok
      ? 'Saved! Your site will update shortly.'
      : 'Saved, but the update trigger failed — it will go live on the next rebuild.';
    testimonialStatus.className = result.ok ? 'text-sm text-emerald-700' : 'text-sm text-amber-700';
  });

  // ---------------------------------------------------------------------
  // Page copy — H1/meta description/focus keyword are locked on every
  // plan; hero subheading/copy/hero image are locked unless
  // business.content_permission_level is 'full'. A locked field gets a
  // "Suggest an edit" affordance (content_suggestions) instead of a
  // direct save — see 0011_content_permission_and_suggestions.sql, which
  // enforces this server-side too, not just in this UI.
  // ---------------------------------------------------------------------
  const contentTierNote = document.getElementById('content-tier-note')!;
  const contentPageSelect = document.getElementById('content-page-select') as HTMLSelectElement;
  const contentFields = document.getElementById('content-fields')!;
  const contentH1 = document.getElementById('content-h1') as HTMLInputElement;
  const contentMetaDescription = document.getElementById('content-meta-description') as HTMLTextAreaElement;
  const contentFocusKeyword = document.getElementById('content-focus-keyword') as HTMLInputElement;
  const contentHeroSubhead = document.getElementById('content-hero-subhead') as HTMLInputElement;
  const copyEditor = initRichTextEditor('content-copy-editor');
  const contentImageFile = document.getElementById('content-image-file') as HTMLInputElement;
  const contentImageAlt = document.getElementById('content-image-alt') as HTMLInputElement;
  const contentImageStatus = document.getElementById('content-image-status')!;
  const contentImagePreview = document.getElementById('content-image-preview') as HTMLImageElement;
  const contentHeroStyleWrap = document.getElementById('content-hero-style-wrap')!;
  const contentHeroStyle = document.getElementById('content-hero-style') as HTMLSelectElement;
  const contentHeroOverlayControls = document.getElementById('content-hero-overlay-controls')!;
  const contentHeroOverlayColor = document.getElementById('content-hero-overlay-color') as HTMLInputElement;
  const contentHeroOverlayOpacity = document.getElementById('content-hero-overlay-opacity') as HTMLInputElement;
  const contentHeroOverlayOpacityReadout = document.getElementById('content-hero-overlay-opacity-readout')!;
  const contentSaveButton = document.getElementById('content-save-button')!;
  const contentSaveStatus = document.getElementById('content-save-status')!;
  const contentBylineSection = document.getElementById('content-byline-section')!;
  const contentBylineName = document.getElementById('content-byline-name') as HTMLInputElement;
  const contentBylineCredential = document.getElementById('content-byline-credential') as HTMLInputElement;
  const contentBylineDate = document.getElementById('content-byline-date') as HTMLInputElement;
  const contentBylineSaveButton = document.getElementById('content-byline-save-button')!;
  const contentBylineStatus = document.getElementById('content-byline-status')!;

  const ALWAYS_LOCKED_FIELDS = ['h1', 'meta_description', 'focus_keyword'];

  function isFullTier(): boolean {
    return business?.content_permission_level === 'full';
  }

  // Agency is exempt from the content-permission lock entirely (see the
  // enforce_content_permission trigger) — h1/meta_description/
  // focus_keyword are never owner-editable regardless of tier;
  // hero_subhead/copy/images follow the tier.
  function canEditField(fieldKey: string): boolean {
    if (currentAdminUser?.role === 'agency') return true;
    if (ALWAYS_LOCKED_FIELDS.includes(fieldKey)) return false;
    return isFullTier();
  }

  function canEditAnyField(): boolean {
    return currentAdminUser?.role === 'agency' || isFullTier();
  }

  function getCurrentValueText(fieldKey: string): string {
    if (!selectedContentPage) return '';
    switch (fieldKey) {
      case 'h1':
        return selectedContentPage.h1 ?? '';
      case 'meta_description':
        return selectedContentPage.meta_description ?? '';
      case 'focus_keyword':
        return selectedContentPage.focus_keyword ?? '';
      case 'hero_subhead':
        return selectedContentPage.hero_subhead ?? '';
      case 'copy':
        return selectedContentPage.copy ?? '';
      case 'images':
        return selectedContentPage.images?.hero
          ? `${selectedContentPage.images.hero.url} (alt: ${selectedContentPage.images.hero.alt})`
          : '(no image set)';
      default:
        return '';
    }
  }

  // Wires the generic "Suggest an edit" toggle + submit for every
  // [data-field] container on the page (shared markup from
  // components/SuggestEdit.astro).
  function wireSuggestButtons() {
    document.querySelectorAll<HTMLElement>('[data-field]').forEach((fieldEl) => {
      const fieldKey = fieldEl.dataset.field!;
      const toggleButton = fieldEl.querySelector<HTMLElement>('.suggest-edit-button')!;
      const form = fieldEl.querySelector<HTMLElement>('.suggest-form')!;
      const textarea = fieldEl.querySelector('.suggest-textarea') as HTMLTextAreaElement;
      const submitButton = fieldEl.querySelector<HTMLElement>('.submit-suggestion-button')!;
      const status = fieldEl.querySelector<HTMLElement>('.suggest-status')!;

      toggleButton.addEventListener('click', () => {
        form.classList.toggle('hidden');
      });

      submitButton.addEventListener('click', async () => {
        if (!selectedContentPage) return;
        const suggestedValue = textarea.value.trim();
        if (!suggestedValue) {
          status.textContent = 'Enter a suggestion first.';
          status.className = 'suggest-status text-xs text-red-600';
          return;
        }
        status.textContent = 'Submitting...';
        status.className = 'suggest-status text-xs text-slate-600';
        const { error } = await supabase.from('content_suggestions').insert({
          page_id: selectedContentPage.id,
          field_name: fieldKey,
          current_value: getCurrentValueText(fieldKey),
          suggested_value: suggestedValue,
          submitted_by: currentUserId,
        });
        if (error) {
          status.textContent = 'Could not submit: ' + error.message;
          status.className = 'suggest-status text-xs text-red-600';
          return;
        }
        status.textContent = "Sent — your strategist will follow up.";
        status.className = 'suggest-status text-xs text-emerald-700';
        textarea.value = '';
        form.classList.add('hidden');
      });
    });
  }

  function renderTierUI() {
    if (currentAdminUser?.role === 'agency') {
      contentTierNote.textContent = 'You have full editing access to every field as the agency admin.';
    } else if (isFullTier()) {
      contentTierNote.textContent = 'Your plan includes full editing access to hero text, page copy, and images.';
    } else {
      contentTierNote.textContent =
        "Page heading, meta description, and focus keyword are always managed by your SEO strategist. On your current plan, hero text, page copy, and images are too — suggest a change and we'll take care of it.";
    }
    document.querySelectorAll<HTMLElement>('[data-field]').forEach((fieldEl) => {
      const fieldKey = fieldEl.dataset.field!;
      const editable = canEditField(fieldKey);
      fieldEl.querySelectorAll<HTMLElement>('.editable-view').forEach((el) => el.classList.toggle('hidden', !editable));
      fieldEl.querySelectorAll<HTMLElement>('.locked-view').forEach((el) => el.classList.toggle('hidden', editable));
      fieldEl.querySelectorAll<HTMLElement>('.tier-note, .suggest-edit-wrap').forEach((el) => el.classList.toggle('hidden', editable));
    });
    contentSaveButton.classList.toggle('hidden', !canEditAnyField());
  }

  function loadContentForm() {
    selectedContentPage = pages.find((p) => p.id === contentPageSelect.value) ?? null;
    if (!selectedContentPage) {
      contentFields.classList.add('hidden');
      return;
    }
    contentFields.classList.remove('hidden');

    contentH1.value = selectedContentPage.h1 ?? '';
    document.querySelector('[data-field="h1"] [data-locked-value]')!.textContent = selectedContentPage.h1 ?? '(not set)';
    contentMetaDescription.value = selectedContentPage.meta_description ?? '';
    document.querySelector('[data-field="meta_description"] [data-locked-value]')!.textContent =
      selectedContentPage.meta_description ?? '(not set)';
    contentFocusKeyword.value = selectedContentPage.focus_keyword ?? '';
    document.querySelector('[data-field="focus_keyword"] [data-locked-value]')!.textContent =
      selectedContentPage.focus_keyword ?? '(not set)';

    contentHeroSubhead.value = selectedContentPage.hero_subhead ?? '';
    document.querySelector('[data-field="hero_subhead"] [data-locked-value]')!.textContent =
      selectedContentPage.hero_subhead ?? '(not set)';

    copyEditor.setMarkdown(selectedContentPage.copy);
    document.querySelector('[data-field="copy"] [data-locked-value-html]')!.innerHTML = renderCopy(selectedContentPage.copy);

    uploadedImageUrl = selectedContentPage.images?.hero?.url ?? null;
    uploadedImageCreditName = selectedContentPage.images?.hero?.creditName ?? null;
    uploadedImageCreditUrl = selectedContentPage.images?.hero?.creditUrl ?? null;
    contentImageAlt.value = selectedContentPage.images?.hero?.alt ?? '';
    contentImageStatus.textContent = uploadedImageUrl ? 'Current image on file — choose a new one to replace it.' : '';
    if (uploadedImageUrl) {
      contentImagePreview.src = uploadedImageUrl;
      contentImagePreview.classList.remove('hidden');
    } else {
      contentImagePreview.src = '';
      contentImagePreview.classList.add('hidden');
    }
    document.querySelector('[data-field="images"] [data-locked-value]')!.textContent = uploadedImageUrl
      ? `Current image: ${selectedContentPage.images?.hero?.alt}`
      : 'No image set.';

    // Hero.astro isn't used at all on a Counselor Profile page (it has
    // its own header card instead — see CounselorProfile.astro), so a
    // hero-layout choice would have no effect there. Hidden rather than
    // just left inert, so nobody wonders why picking "overlay" for a
    // counselor page never seems to do anything.
    contentHeroStyleWrap.classList.toggle('hidden', selectedContentPage.page_type === 'Counselor Profile');
    contentHeroStyle.value = selectedContentPage.hero_style;
    contentHeroOverlayColor.value = selectedContentPage.hero_overlay_color;
    contentHeroOverlayOpacity.value = String(selectedContentPage.hero_overlay_opacity);
    contentHeroOverlayOpacityReadout.textContent = String(selectedContentPage.hero_overlay_opacity);
    contentHeroOverlayControls.classList.toggle('hidden', selectedContentPage.hero_style !== 'overlay');

    // Content Pillar and Service Hub both render this byline (see
    // ContentPillar.astro and ServiceHub.astro) — a Service Hub is a
    // real bookable service that also functions as a content hub, so it
    // gets the same reviewer byline as a pure informational pillar.
    const BYLINE_PAGE_TYPES = ['Content Pillar', 'Service Hub'];
    contentBylineSection.classList.toggle('hidden', !BYLINE_PAGE_TYPES.includes(selectedContentPage.page_type));
    contentBylineName.value = selectedContentPage.author_name ?? '';
    contentBylineCredential.value = selectedContentPage.credentials ?? '';
    contentBylineDate.value = selectedContentPage.date_modified ?? '';
    contentBylineStatus.textContent = '';

    contentSaveStatus.textContent = '';
    renderTierUI();
  }

  contentPageSelect.addEventListener('change', loadContentForm);

  contentHeroStyle.addEventListener('change', () => {
    contentHeroOverlayControls.classList.toggle('hidden', contentHeroStyle.value !== 'overlay');
  });

  contentHeroOverlayOpacity.addEventListener('input', () => {
    contentHeroOverlayOpacityReadout.textContent = contentHeroOverlayOpacity.value;
  });

  contentImageFile.addEventListener('change', async () => {
    const file = contentImageFile.files?.[0];
    if (!file) return;
    contentImageStatus.textContent = 'Uploading...';
    const path = `content/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;
    const { error } = await supabase.storage.from('site-images').upload(path, file);
    if (error) {
      contentImageStatus.textContent = 'Upload failed: ' + error.message;
      return;
    }
    const { data: urlData } = supabase.storage.from('site-images').getPublicUrl(path);
    uploadedImageUrl = urlData.publicUrl;
    // A direct upload has no Unsplash attribution — clear any credit left
    // over from a previous Unsplash selection.
    uploadedImageCreditName = null;
    uploadedImageCreditUrl = null;
    contentImagePreview.src = urlData.publicUrl;
    contentImagePreview.classList.remove('hidden');
    contentImageStatus.textContent = 'Image uploaded.';
  });

  initUnsplashSearchModal({
    onSelect: (photo: UnsplashPhoto) => {
      uploadedImageUrl = photo.fullUrl;
      uploadedImageCreditName = photo.creditName || null;
      uploadedImageCreditUrl = photo.creditUrl || null;
      if (!contentImageAlt.value.trim()) contentImageAlt.value = photo.alt;
      contentImagePreview.src = photo.fullUrl;
      contentImagePreview.classList.remove('hidden');
      contentImageStatus.textContent = photo.creditName
        ? `Selected — photo by ${photo.creditName} on Unsplash.`
        : 'Selected.';
    },
  });

  contentSaveButton.addEventListener('click', async () => {
    if (!selectedContentPage || !canEditAnyField()) return;
    if (canEditField('images') && uploadedImageUrl && !contentImageAlt.value.trim()) {
      contentSaveStatus.textContent = 'Alt text is required for the hero image.';
      contentSaveStatus.className = 'text-sm text-red-600';
      return;
    }
    contentSaveStatus.textContent = 'Saving...';
    contentSaveStatus.className = 'text-sm text-slate-600';

    // Only ever send the fields this role is actually allowed to touch —
    // h1/meta_description/focus_keyword only for agency; hero_subhead/
    // copy/images for agency or a full-tier owner. Sending a locked field
    // would just be rejected by the enforce_content_permission trigger
    // anyway, but there's no reason to try.
    const payload: Record<string, unknown> = {};
    if (canEditField('h1')) payload.h1 = contentH1.value.trim();
    if (canEditField('meta_description')) payload.meta_description = contentMetaDescription.value.trim() || null;
    if (canEditField('focus_keyword')) payload.focus_keyword = contentFocusKeyword.value.trim() || null;
    if (canEditField('hero_subhead')) payload.hero_subhead = contentHeroSubhead.value.trim() || null;
    if (canEditField('copy')) payload.copy = copyEditor.getMarkdown();
    if (canEditField('images')) {
      payload.images = uploadedImageUrl
        ? {
            hero: {
              url: uploadedImageUrl,
              alt: contentImageAlt.value.trim(),
              ...(uploadedImageCreditName && uploadedImageCreditUrl
                ? { creditName: uploadedImageCreditName, creditUrl: uploadedImageCreditUrl }
                : {}),
            },
          }
        : {};
      // Hero layout lives in this same lock group — see the markup
      // comment on #content-hero-style-wrap for why it isn't a separate
      // tier gate. Hidden entirely (not just disabled) for a Counselor
      // Profile page, so nothing here overwrites a value that template
      // never reads anyway.
      if (selectedContentPage.page_type !== 'Counselor Profile') {
        payload.hero_style = contentHeroStyle.value;
        payload.hero_overlay_color = contentHeroOverlayColor.value;
        payload.hero_overlay_opacity = Number(contentHeroOverlayOpacity.value);
      }
    }

    const { error } = await supabase.from('pages').update(payload).eq('id', selectedContentPage.id);
    if (error) {
      contentSaveStatus.textContent = 'Could not save: ' + error.message;
      contentSaveStatus.className = 'text-sm text-red-600';
      return;
    }
    Object.assign(selectedContentPage, payload);
    contentSaveStatus.textContent = 'Saving your site...';
    const result = await triggerRebuild();
    contentSaveStatus.textContent = result.ok
      ? 'Saved! Your site will update shortly.'
      : 'Saved, but the update trigger failed — it will go live on the next rebuild.';
    contentSaveStatus.className = result.ok ? 'text-sm text-emerald-700' : 'text-sm text-amber-700';
  });

  // Independent of contentSaveButton above — author_name/credentials/
  // date_modified aren't tier-locked (see enforce_content_permission),
  // so this stays editable and savable even for a restricted-tier owner
  // who can't touch h1/copy/images on the same page.
  contentBylineSaveButton.addEventListener('click', async () => {
    if (!selectedContentPage) return;
    contentBylineStatus.textContent = 'Saving...';
    contentBylineStatus.className = 'text-sm text-slate-600';
    const payload = {
      author_name: contentBylineName.value.trim() || null,
      credentials: contentBylineCredential.value.trim() || null,
      date_modified: contentBylineDate.value || null,
    };
    const { error } = await supabase.from('pages').update(payload).eq('id', selectedContentPage.id);
    if (error) {
      contentBylineStatus.textContent = 'Could not save: ' + error.message;
      contentBylineStatus.className = 'text-sm text-red-600';
      return;
    }
    Object.assign(selectedContentPage, payload);
    contentBylineStatus.textContent = 'Saving your site...';
    const result = await triggerRebuild();
    contentBylineStatus.textContent = result.ok
      ? 'Saved! Your site will update shortly.'
      : 'Saved, but the update trigger failed — it will go live on the next rebuild.';
    contentBylineStatus.className = result.ok ? 'text-sm text-emerald-700' : 'text-sm text-amber-700';
  });

  // ---------------------------------------------------------------------
  // Your suggestions — a client-facing status list of what they've
  // submitted (owner only; agency has the dedicated Suggestions review
  // screen instead). Shows the agency's reviewer_note, most important on
  // a rejection so the client knows why.
  // ---------------------------------------------------------------------
  const FIELD_LABELS: Record<string, string> = {
    h1: 'Page heading (H1)',
    meta_description: 'Meta description',
    focus_keyword: 'Focus keyword',
    hero_subhead: 'Hero subheading',
    copy: 'Page copy',
    images: 'Hero image',
  };

  type ContentSuggestion = {
    id: string;
    page_id: string;
    field_name: string;
    suggested_value: string;
    status: 'pending' | 'approved' | 'rejected';
    reviewer_note: string | null;
    created_at: string;
  };

  const yourSuggestionsSection = document.getElementById('your-suggestions-section')!;
  const yourSuggestionsList = document.getElementById('your-suggestions-list')!;

  const STATUS_BADGE: Record<ContentSuggestion['status'], string> = {
    pending: '<span class="text-amber-700">Pending</span>',
    approved: '<span class="text-emerald-700">Approved</span>',
    rejected: '<span class="text-red-600">Rejected</span>',
  };

  async function loadYourSuggestions() {
    if (!currentUserId) return;
    const { data, error } = await supabase
      .from('content_suggestions')
      .select('*')
      .eq('submitted_by', currentUserId)
      .order('created_at', { ascending: false });
    if (error || !data || data.length === 0) {
      yourSuggestionsSection.classList.add('hidden');
      return;
    }
    yourSuggestionsSection.classList.remove('hidden');
    const suggestions = data as ContentSuggestion[];
    yourSuggestionsList.innerHTML = suggestions
      .map((s) => {
        const page = pages.find((p) => p.id === s.page_id);
        const fieldLabel = FIELD_LABELS[s.field_name] ?? s.field_name;
        const date = new Date(s.created_at).toLocaleDateString();
        return `
      <div class="rounded-md border border-slate-200 bg-white px-4 py-3 text-sm">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-slate-700">${escapeHtml(page?.title ?? 'Page')} — ${escapeHtml(fieldLabel)}</span>
          ${STATUS_BADGE[s.status]}
        </div>
        <p class="mt-1 text-slate-600">"${escapeHtml(s.suggested_value)}"</p>
        <p class="mt-1 text-xs text-slate-400">Submitted ${date}</p>
        ${
          s.reviewer_note
            ? `<p class="mt-2 rounded-md bg-slate-50 px-3 py-2 text-xs text-slate-600"><span class="font-semibold">Note: </span>${escapeHtml(s.reviewer_note)}</p>`
            : ''
        }
      </div>`;
      })
      .join('');
  }

  // ---------------------------------------------------------------------
  async function onAuthed(adminUser: AdminUser) {
    currentAdminUser = adminUser;
    const [{ data: userData }, { data: businessData }, { data: pagesData }] = await Promise.all([
      supabase.auth.getUser(),
      supabase.from('business').select('*').single(),
      supabase.from('pages').select('*').not('page_type', 'in', '("Blog Post","Blog Index")').order('title'),
    ]);
    currentUserId = userData.user?.id ?? null;
    business = businessData as Business;
    pages = (pagesData ?? []) as ContentPage[];

    loadBusinessForm();
    populatePagePicker(testimonialPageSelect);
    populatePagePicker(contentPageSelect);
    loadTestimonialForm();
    loadContentForm();
    wireSuggestButtons();
    if (adminUser.role === 'owner') {
      await loadYourSuggestions();
    }
  }

  initAdminAuth(onAuthed, { allowedRoles: ['owner', 'agency'] });
</script>
