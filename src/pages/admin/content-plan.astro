---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<!--
  Reachable by every role, unlike SEO Insights itself (owner/agency
  only) — staff/counselors already have blog-authoring access, and
  should see and act on their own content assignments too. One page
  serves both audiences via role-conditional rendering, same pattern as
  admin/counselor-settings.astro's owner/agency-vs-linked-counselor
  split, rather than two separate pages.
-->
<AdminLayout title="Content plan | Admin" current="content-plan">
  <!-- Owner/agency: the board. Columns are the statuses; cards drag
       between columns or move with their status picker. -->
  <div id="plan-board-view" class="hidden">
    <p class="i-intro">Every article and page idea, from first idea to published.</p>
    <div class="i-toolbar">
      <p id="plan-count" class="i-count cp-count"></p>
      <div class="i-actions">
        <label class="i-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input id="cp-search" type="text" placeholder="Search ideas" aria-label="Search ideas" />
        </label>
        <button id="add-idea-button" type="button" class="a-btn a-btn-primary i-btn">+ Add idea</button>
      </div>
    </div>
    <div id="plan-table-body" class="cp-board"></div>
    <p id="plan-empty" class="t-card t-empty" hidden><b>No ideas yet.</b>Add one here, or use "Plan it" on Search rankings to turn a search into an article idea.</p>
  </div>

  <!-- Staff: only their own assignments -->
  <div id="plan-my-assignments-view" class="hidden">
    <p class="i-intro">Articles and pages assigned to you, soonest due first.</p>
    <div id="my-assignments-list" class="cp-mine"></div>
    <p id="my-assignments-empty" class="t-card t-empty" hidden><b>Nothing assigned to you yet.</b>When something is assigned to you, it shows up here.</p>
  </div>

  <!-- Shared row-actions menu (owner/agency board only) -->
  <div id="actions-menu" class="i-menu hidden">
    <button type="button" id="actions-menu-edit">Edit</button>
    <button type="button" id="actions-menu-delete" class="i-danger">Delete</button>
  </div>

  <!-- Add/Edit idea modal (owner/agency only) -->
  <div id="idea-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-lg bg-white p-6">
      <div class="mb-4 flex items-center justify-between">
        <h3 id="idea-modal-title" class="font-[family-name:var(--font-heading)] text-lg font-bold text-brand-ink">Add idea</h3>
        <button id="idea-modal-close-button" type="button" class="text-sm text-slate-500 hover:text-slate-800">Close</button>
      </div>
      <button
        id="modal-draft-blog-button"
        type="button"
        class="hidden a-btn mb-4 w-full"
      >
        Draft blog post &rarr;
      </button>
      <form id="idea-form" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-500">Title</label>
          <input name="title" type="text" required class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
          <p class="mt-1 text-xs text-slate-500">Tip: work the keyword's core topic words into the title where it reads naturally — it's one of the strongest on-page SEO signals.</p>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500">Keyword</label>
          <input name="keyword" type="text" placeholder="The real keyword to work into this content" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500">Content type</label>
          <select name="content_type" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
            <option value="undecided" selected>Undecided</option>
            <option value="blog_post">Blog post</option>
            <option value="service_page">New Service Page</option>
            <option value="who_we_serve_page">New Who We Serve page</option>
            <option value="update_existing_page">Update existing page</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500">Linked page (update target, or once published)</label>
          <select name="linked_page_id" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
            <option value="">None</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-500">Category</label>
            <select name="category" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
              <option value="">None</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-500">Due date</label>
            <input name="due_date" type="date" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500">Assigned to</label>
          <select name="assigned_to" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
            <option value="">Unassigned</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500">Target question (from Mangools' Questions tab, if researched)</label>
          <input name="target_question" type="text" placeholder="e.g. How does OCD affect relationships?" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500">Notes</label>
          <textarea name="notes" rows="3" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm"></textarea>
        </div>
        <p id="idea-form-status" class="text-sm text-red-600"></p>
        <button type="submit" class="a-btn a-btn-primary w-full">Save</button>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth } from '../../lib/adminAuth';
  import { withBase } from '../../lib/url';

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  interface ContentPlanItem {
    id: string;
    title: string;
    keyword: string | null;
    target_keyword_id: string | null;
    search_volume: number | null;
    priority: 'high' | 'medium' | 'low' | null;
    source_note: string | null;
    target_question: string | null;
    content_type: 'blog_post' | 'service_page' | 'who_we_serve_page' | 'update_existing_page' | 'undecided';
    linked_page_id: string | null;
    category: string | null;
    status: 'idea' | 'assigned' | 'drafted' | 'published';
    assigned_to: string | null;
    due_date: string | null;
    notes: string | null;
  }

  type AdminUserRow = { id: string; email: string; role: string; status: string; display_name?: string | null };
  type PageRow = { id: string; title: string };

  const CONTENT_TYPE_LABELS: Record<string, string> = {
    blog_post: 'Blog post',
    service_page: 'New Service Page',
    who_we_serve_page: 'New Who We Serve page',
    update_existing_page: 'Update existing page',
    undecided: 'Undecided',
  };
  const STATUS_LABELS: Record<string, string> = {
    idea: 'Idea',
    assigned: 'Assigned',
    drafted: 'Drafted',
    published: 'Published',
  };

  let isStaffSession = false;
  let items: ContentPlanItem[] = [];
  let assignableUsers: AdminUserRow[] = [];
  let pages: PageRow[] = [];
  let categories: string[] = [];
  let editingItemId: string | null = null;
  let actionsMenuItemId: string | null = null;

  const boardView = document.getElementById('plan-board-view')!;
  const myAssignmentsView = document.getElementById('plan-my-assignments-view')!;
  const searchField = document.getElementById('cp-search') as HTMLInputElement;
  const addIdeaButton = document.getElementById('add-idea-button')!;
  const planCount = document.getElementById('plan-count')!;
  const planTableBody = document.getElementById('plan-table-body')!;
  const planEmpty = document.getElementById('plan-empty')!;
  const myAssignmentsList = document.getElementById('my-assignments-list')!;
  const myAssignmentsEmpty = document.getElementById('my-assignments-empty')!;
  const actionsMenu = document.getElementById('actions-menu')!;
  const actionsMenuEditButton = document.getElementById('actions-menu-edit')!;
  const actionsMenuDeleteButton = document.getElementById('actions-menu-delete')!;
  const ideaModal = document.getElementById('idea-modal')!;
  const ideaModalTitle = document.getElementById('idea-modal-title')!;
  const ideaModalCloseButton = document.getElementById('idea-modal-close-button')!;
  const ideaForm = document.getElementById('idea-form') as HTMLFormElement;
  const ideaFormStatus = document.getElementById('idea-form-status')!;
  const linkedPageSelect = ideaForm.elements.namedItem('linked_page_id') as HTMLSelectElement;
  const categorySelect = ideaForm.elements.namedItem('category') as HTMLSelectElement;
  const assignedToSelect = ideaForm.elements.namedItem('assigned_to') as HTMLSelectElement;
  const modalDraftBlogButton = document.getElementById('modal-draft-blog-button')!;

  // Same-tab, consume-once handshake with admin/blog.astro — not URL
  // query params, since this never needs to be shareable/bookmarkable.
  // See CLAUDE.md's "Content Planning & Management screen" section. Carries
  // keyword/target_question too, so the drafting screen can show a real
  // "what this post needs to cover" panel instead of just prefilling
  // title/category with no context about why.
  function startBlogDraftHandoff(item: ContentPlanItem) {
    sessionStorage.setItem(
      'contentPlanDraftHandoff',
      JSON.stringify({
        planItemId: item.id,
        title: item.title,
        category: item.category,
        linkedPageId: item.linked_page_id,
        keyword: item.keyword,
        targetQuestion: item.target_question,
      })
    );
    window.location.href = withBase('/admin/blog');
  }

  function userLabel(u: AdminUserRow): string {
    return u.display_name ? `${u.display_name} (${u.email})` : `${u.email} (${u.role})`;
  }

  function assigneeLabel(userId: string | null): string {
    if (!userId) return 'Unassigned';
    const u = assignableUsers.find((a) => a.id === userId);
    return u ? (u.display_name || u.email.split('@')[0]) : 'Unknown';
  }

  function initials(name: string): string {
    return (name.trim().split(/[\s.@_-]+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('') || '?').toUpperCase();
  }

  const todayIso = () => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  };
  const shortDate = (ymd: string) => new Date(ymd + 'T00:00:00').toLocaleDateString(undefined, { month: 'short', day: 'numeric' });

  // One card, shared by the board and the staff list.
  function cardHtml(item: ContentPlanItem, opts: { board: boolean }): string {
    const late = item.due_date && item.due_date < todayIso() && item.status !== 'published';
    const assignee = assigneeLabel(item.assigned_to);
    const meta = [
      item.keyword ? `<span class="cp-kw">${escapeHtml(item.keyword)}${item.search_volume != null ? ` · ${item.search_volume.toLocaleString()}/mo` : ''}</span>` : '',
      item.target_question ? `<span class="cp-q">"${escapeHtml(item.target_question)}"</span>` : '',
    ].join('');
    const statusSelect = `<select class="${opts.board ? 'row-status-select' : 'my-status-select'} cp-status" data-item-id="${item.id}" aria-label="Status">${Object.entries(STATUS_LABELS)
      .map(([value, label]) => `<option value="${value}" ${item.status === value ? 'selected' : ''}>${label}</option>`)
      .join('')}</select>`;
    return `<article class="cp-card${item.priority === 'high' ? ' cp-high' : ''}" data-item-id="${item.id}" ${opts.board ? 'draggable="true"' : ''}>
      <div class="cp-top">
        <span class="cp-type">${CONTENT_TYPE_LABELS[item.content_type]}</span>
        ${opts.board ? `<button type="button" class="actions-toggle i-more" data-item-id="${item.id}" aria-label="Actions for ${escapeHtml(item.title)}">···</button>` : statusSelect}
      </div>
      <b class="cp-title">${escapeHtml(item.title)}</b>
      ${meta ? `<div class="cp-meta">${meta}</div>` : ''}
      <div class="cp-foot">
        ${opts.board ? `<span class="cp-who" title="${escapeHtml(assignee)}"><span class="i-avatar sm">${item.assigned_to ? escapeHtml(initials(assignee)) : '–'}</span>${escapeHtml(assignee)}</span>` : ''}
        ${item.due_date ? `<span class="cp-due${late ? ' late' : ''}">${late ? 'Overdue · ' : 'Due '}${shortDate(item.due_date)}</span>` : ''}
      </div>
      ${
        item.content_type === 'blog_post' && item.status !== 'published'
          ? `<button type="button" class="draft-blog-link a-btn i-btn cp-draft" data-item-id="${item.id}">${item.linked_page_id ? 'Open draft' : 'Draft blog post'} &rarr;</button>`
          : ''
      }
      ${opts.board ? `<div class="cp-move">${statusSelect}</div>` : ''}
      ${
        opts.board
          ? ''
          : `<label class="cp-notes-l">Notes<textarea class="my-notes-field" rows="2" data-item-id="${item.id}">${escapeHtml(item.notes ?? '')}</textarea></label>
             <div class="i-inline"><button type="button" class="my-notes-save a-btn i-btn" data-item-id="${item.id}">Save notes</button><span class="my-save-status i-hint"></span></div>`
      }
    </article>`;
  }

  // --- Owner/agency board ---

  const COLUMN_HINTS: Record<string, string> = {
    idea: 'Not started',
    assigned: 'Someone is on it',
    drafted: 'Written, not live',
    published: 'Live on the site',
  };
  // Published is history: the latest few show, the rest stay a click away.
  const PUBLISHED_SHOWN = 6;
  let showAllPublished = false;
  const PRIORITY_RANK: Record<string, number> = { high: 0, medium: 1, low: 2 };

  function renderBoard() {
    const q = searchField.value.trim().toLowerCase();
    const visible = items.filter((i) => !q || [i.title, i.keyword ?? '', i.target_question ?? ''].some((v) => v.toLowerCase().includes(q)));
    const open = items.filter((i) => i.status !== 'published').length;
    planCount.textContent = `${open} in progress · ${items.length - open} published`;
    planEmpty.hidden = items.length > 0;
    planTableBody.hidden = items.length === 0;
    planTableBody.innerHTML = Object.keys(STATUS_LABELS)
      .map((status) => {
        let col = visible.filter((i) => i.status === status);
        // Within a column: overdue/soonest due first, then priority.
        col.sort((a, b) => (a.due_date ?? '9999').localeCompare(b.due_date ?? '9999') || (PRIORITY_RANK[a.priority ?? ''] ?? 3) - (PRIORITY_RANK[b.priority ?? ''] ?? 3));
        const total = col.length;
        if (status === 'published' && !showAllPublished) col = col.slice(0, PUBLISHED_SHOWN);
        return `<section class="cp-col cp-col-${status}" data-status="${status}">
          <h2><span class="cp-dot"></span>${STATUS_LABELS[status]}<span class="cp-n a-num">${total}</span><small>${COLUMN_HINTS[status]}</small></h2>
          <div class="cp-cards">${col.map((i) => cardHtml(i, { board: true })).join('') || '<p class="cp-none">Nothing here</p>'}</div>
          ${status === 'published' && total > PUBLISHED_SHOWN ? `<button type="button" class="a-link cp-more" data-toggle-published>${showAllPublished ? 'Show fewer' : `Show all ${total}`}</button>` : ''}
        </section>`;
      })
      .join('');
  }

  searchField.addEventListener('input', renderBoard);

  async function setStatus(itemId: string, status: string) {
    const item = items.find((i) => i.id === itemId);
    if (!item || item.status === status) return;
    const previous = item.status;
    item.status = status as ContentPlanItem['status'];
    renderBoard();
    const { error } = await supabase.from('content_plan_items').update({ status }).eq('id', itemId);
    if (error) {
      item.status = previous;
      renderBoard();
      window.alert('Could not update status: ' + error.message);
    }
  }

  // Drag a card to another column to change its status.
  let draggingId: string | null = null;
  planTableBody.addEventListener('dragstart', (event) => {
    const card = (event.target as HTMLElement).closest<HTMLElement>('.cp-card');
    if (!card) return;
    draggingId = card.dataset.itemId!;
    card.classList.add('dragging');
    event.dataTransfer?.setData('text/plain', draggingId);
    if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
  });
  planTableBody.addEventListener('dragend', () => {
    draggingId = null;
    planTableBody.querySelectorAll('.dragging, .drop').forEach((el) => el.classList.remove('dragging', 'drop'));
  });
  planTableBody.addEventListener('dragover', (event) => {
    const col = (event.target as HTMLElement).closest<HTMLElement>('.cp-col');
    if (!col || !draggingId) return;
    event.preventDefault();
    planTableBody.querySelectorAll('.cp-col.drop').forEach((el) => el !== col && el.classList.remove('drop'));
    col.classList.add('drop');
  });
  planTableBody.addEventListener('drop', (event) => {
    const col = (event.target as HTMLElement).closest<HTMLElement>('.cp-col');
    if (!col || !draggingId) return;
    event.preventDefault();
    setStatus(draggingId, col.dataset.status!);
  });


  function populateLinkedPagePicker() {
    linkedPageSelect.innerHTML =
      '<option value="">None</option>' + pages.map((p) => `<option value="${p.id}">${escapeHtml(p.title)}</option>`).join('');
  }

  function populateAssigneePicker() {
    assignedToSelect.innerHTML =
      '<option value="">Unassigned</option>' +
      assignableUsers.map((u) => `<option value="${u.id}">${escapeHtml(userLabel(u))}</option>`).join('');
  }

  function populateCategoryPicker() {
    categorySelect.innerHTML =
      '<option value="">None</option>' + categories.map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
  }

  function openAddModal() {
    editingItemId = null;
    ideaModalTitle.textContent = 'Add idea';
    ideaForm.reset();
    ideaFormStatus.textContent = '';
    modalDraftBlogButton.classList.add('hidden');
    ideaModal.classList.remove('hidden');
    ideaModal.classList.add('flex');
  }

  function openEditModal(itemId: string) {
    const item = items.find((i) => i.id === itemId);
    if (!item) return;
    editingItemId = itemId;
    ideaModalTitle.textContent = 'Edit idea';
    ideaForm.reset();
    (ideaForm.elements.namedItem('title') as HTMLInputElement).value = item.title;
    (ideaForm.elements.namedItem('keyword') as HTMLInputElement).value = item.keyword ?? '';
    (ideaForm.elements.namedItem('content_type') as HTMLSelectElement).value = item.content_type;
    linkedPageSelect.value = item.linked_page_id ?? '';
    categorySelect.value = item.category ?? '';
    (ideaForm.elements.namedItem('due_date') as HTMLInputElement).value = item.due_date ?? '';
    assignedToSelect.value = item.assigned_to ?? '';
    (ideaForm.elements.namedItem('target_question') as HTMLInputElement).value = item.target_question ?? '';
    (ideaForm.elements.namedItem('notes') as HTMLTextAreaElement).value = item.notes ?? '';
    ideaFormStatus.textContent = '';
    // Only a blog_post idea has a real no-code creation screen to hand
    // off to — Service Page/Who We Serve/update-existing-page ideas stay
    // planning records, same as today.
    modalDraftBlogButton.classList.toggle('hidden', item.content_type !== 'blog_post');
    ideaModal.classList.remove('hidden');
    ideaModal.classList.add('flex');
  }

  modalDraftBlogButton.addEventListener('click', () => {
    if (!editingItemId) return;
    const item = items.find((i) => i.id === editingItemId);
    if (item) startBlogDraftHandoff(item);
  });

  function closeIdeaModal() {
    ideaModal.classList.add('hidden');
    ideaModal.classList.remove('flex');
    editingItemId = null;
  }

  addIdeaButton.addEventListener('click', openAddModal);
  ideaModalCloseButton.addEventListener('click', closeIdeaModal);

  // Best-effort — the item is already saved by the time this is called,
  // so a failure here (e.g. email not configured for this site) never
  // blocks or un-does the save itself. See supabase/functions/
  // notify-content-assignment for the actual send + its own graceful
  // "not configured" handling.
  async function notifyAssignment(itemId: string) {
    try {
      const { data: sessionData } = await supabase.auth.getSession();
      const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
      const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
      await fetch(`${SUPABASE_URL}/functions/v1/notify-content-assignment`, {
        method: 'POST',
        headers: {
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${sessionData.session?.access_token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          content_plan_item_id: itemId,
          redirectTo: window.location.origin + withBase('/admin/content-plan'),
        }),
      });
    } catch {
      // Swallow — see comment above.
    }
  }

  ideaForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    ideaFormStatus.textContent = '';
    const formData = new FormData(ideaForm);
    const title = (formData.get('title') as string).trim();
    if (!title) return;

    const newAssignedTo = (formData.get('assigned_to') as string) || null;
    // Status no longer lives in this modal (moved to a row-level select on
    // the board, matching the staff assignment card's own pattern) — never
    // included in this payload, so saving content fields can't accidentally
    // reset a status someone already advanced.
    const payload = {
      title,
      keyword: (formData.get('keyword') as string).trim() || null,
      content_type: formData.get('content_type') as string,
      linked_page_id: (formData.get('linked_page_id') as string) || null,
      category: (formData.get('category') as string) || null,
      due_date: (formData.get('due_date') as string) || null,
      assigned_to: newAssignedTo,
      target_question: (formData.get('target_question') as string).trim() || null,
      notes: (formData.get('notes') as string).trim() || null,
    };

    // Only notify on a genuine new assignment — creating/editing an item
    // that's already assigned to the same person again shouldn't re-email
    // them every time an unrelated field changes.
    const previousAssignedTo = editingItemId ? items.find((i) => i.id === editingItemId)?.assigned_to ?? null : null;
    const isNewAssignment = !!newAssignedTo && newAssignedTo !== previousAssignedTo;

    const submitButton = ideaForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitButton.disabled = true;
    let savedItemId = editingItemId;
    let error: { message: string } | null;
    if (editingItemId) {
      ({ error } = await supabase.from('content_plan_items').update(payload).eq('id', editingItemId));
    } else {
      const { data, error: insertError } = await supabase.from('content_plan_items').insert(payload).select().single();
      error = insertError;
      if (data) savedItemId = data.id;
    }
    submitButton.disabled = false;

    if (error) {
      ideaFormStatus.textContent = 'Could not save: ' + error.message;
      return;
    }

    if (isNewAssignment && savedItemId) await notifyAssignment(savedItemId);

    closeIdeaModal();
    await loadBoard();
  });

  // --- Row actions menu ---

  function closeActionsMenu() {
    actionsMenu.classList.add('hidden');
    actionsMenuItemId = null;
  }

  function openActionsMenuFor(button: HTMLElement, itemId: string) {
    actionsMenuItemId = itemId;
    const rect = button.getBoundingClientRect();
    const estimatedMenuHeight = 80;
    const openUpward = window.innerHeight - rect.bottom < estimatedMenuHeight;
    const menuWidth = 128;
    const left = Math.max(8, Math.min(rect.right - menuWidth, window.innerWidth - menuWidth - 8));
    actionsMenu.style.left = `${left}px`;
    if (openUpward) {
      actionsMenu.style.top = 'auto';
      actionsMenu.style.bottom = `${window.innerHeight - rect.top + 4}px`;
    } else {
      actionsMenu.style.bottom = 'auto';
      actionsMenu.style.top = `${rect.bottom + 4}px`;
    }
    actionsMenu.classList.remove('hidden');
  }

  document.addEventListener('click', (event) => {
    if (actionsMenu.classList.contains('hidden')) return;
    const target = event.target as HTMLElement;
    if (target.closest('#actions-menu') || target.closest('.actions-toggle')) return;
    closeActionsMenu();
  });
  window.addEventListener('scroll', closeActionsMenu, true);
  window.addEventListener('resize', closeActionsMenu);

  planTableBody.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const draftLink = target.closest<HTMLElement>('.draft-blog-link');
    if (draftLink) {
      const item = items.find((i) => i.id === draftLink.dataset.itemId);
      if (item) startBlogDraftHandoff(item);
      return;
    }

    if (target.closest('[data-toggle-published]')) {
      showAllPublished = !showAllPublished;
      renderBoard();
      return;
    }

    const toggleButton = target.closest<HTMLElement>('.actions-toggle');
    if (!toggleButton) {
      // Clicking the card itself (not a control) opens it for editing.
      const card = target.closest<HTMLElement>('.cp-card');
      if (card && !target.closest('select, button, a')) openEditModal(card.dataset.itemId!);
      return;
    }
    const itemId = toggleButton.dataset.itemId!;
    if (actionsMenuItemId === itemId && !actionsMenu.classList.contains('hidden')) {
      closeActionsMenu();
    } else {
      openActionsMenuFor(toggleButton, itemId);
    }
  });

  // Row-level status select — same pattern as the staff assignment card's
  // own .my-status-select, moved here since status is no longer part of
  // the Edit modal (see CLAUDE.md's "Content Plan" sections).
  // Status picker on each card (the keyboard-friendly way to move it).
  planTableBody.addEventListener('change', (event) => {
    const select = (event.target as HTMLElement).closest<HTMLSelectElement>('.row-status-select');
    if (select) setStatus(select.dataset.itemId!, select.value);
  });

  actionsMenuEditButton.addEventListener('click', () => {
    const itemId = actionsMenuItemId;
    closeActionsMenu();
    if (itemId) openEditModal(itemId);
  });

  actionsMenuDeleteButton.addEventListener('click', async () => {
    const itemId = actionsMenuItemId;
    closeActionsMenu();
    if (!itemId) return;
    const item = items.find((i) => i.id === itemId);
    if (!item) return;
    if (!window.confirm(`Delete "${item.title}"? This cannot be undone.`)) return;
    const { error } = await supabase.from('content_plan_items').delete().eq('id', itemId);
    if (error) {
      window.alert('Could not delete: ' + error.message);
      return;
    }
    await loadBoard();
  });

  async function loadBoard() {
    const { data, error } = await supabase
      .from('content_plan_items')
      .select('*')
      .order('created_at', { ascending: false });
    if (error) {
      planTableBody.innerHTML = `<p class="i-hint r-err">Could not load: ${escapeHtml(error.message)}</p>`;
      return;
    }
    items = (data as ContentPlanItem[]) ?? [];
    renderBoard();
  }

  // --- Staff: my assignments ---

  function renderMyAssignments() {
    myAssignmentsEmpty.hidden = items.length > 0;
    myAssignmentsList.innerHTML = items.map((item) => cardHtml(item, { board: false }).replace('class="cp-card', 'class="assignment-card cp-card')).join('');
  }

  myAssignmentsList.addEventListener('change', async (event) => {
    const select = (event.target as HTMLElement).closest<HTMLSelectElement>('.my-status-select');
    if (!select) return;
    const itemId = select.dataset.itemId!;
    const { error } = await supabase.from('content_plan_items').update({ status: select.value }).eq('id', itemId);
    if (error) window.alert('Could not update status: ' + error.message);
    const item = items.find((i) => i.id === itemId);
    if (item && !error) item.status = select.value as ContentPlanItem['status'];
  });

  myAssignmentsList.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;

    const draftLink = target.closest<HTMLElement>('.draft-blog-link');
    if (draftLink) {
      const item = items.find((i) => i.id === draftLink.dataset.itemId);
      if (item) startBlogDraftHandoff(item);
      return;
    }

    const button = target.closest<HTMLButtonElement>('.my-notes-save');
    if (!button) return;
    const itemId = button.dataset.itemId!;
    const card = button.closest<HTMLElement>('.assignment-card')!;
    const textarea = card.querySelector<HTMLTextAreaElement>('.my-notes-field')!;
    const statusEl = card.querySelector<HTMLElement>('.my-save-status')!;
    statusEl.textContent = 'Saving...';
    statusEl.className = 'my-save-status i-hint';
    const { error } = await supabase.from('content_plan_items').update({ notes: textarea.value }).eq('id', itemId);
    statusEl.textContent = error ? 'Could not save: ' + error.message : 'Saved.';
    statusEl.className = 'my-save-status i-hint ' + (error ? 'r-err' : 'r-ok');
  });

  async function loadMyAssignments(userId: string) {
    const { data, error } = await supabase
      .from('content_plan_items')
      .select('*')
      .eq('assigned_to', userId)
      .order('due_date', { ascending: true, nullsFirst: false });
    if (error) {
      myAssignmentsList.innerHTML = `<p class="i-hint r-err">Could not load: ${escapeHtml(error.message)}</p>`;
      return;
    }
    items = (data as ContentPlanItem[]) ?? [];
    renderMyAssignments();
  }

  // --- Shared loaders ---

  async function loadAssignableUsers() {
    const { data } = await supabase.from('admin_users').select('id, email, role, status, display_name').eq('status', 'active');
    assignableUsers = (data as AdminUserRow[]) ?? [];
    populateAssigneePicker();
  }

  async function loadPages() {
    const { data } = await supabase.from('pages').select('id, title').order('title');
    pages = (data as PageRow[]) ?? [];
    populateLinkedPagePicker();
  }

  // Same real-categories-only query as admin/blog.astro's own category
  // dropdown (both 'Content Pillar' and 'Service Hub' can own one) — a
  // content-plan idea's category has to match a real hub page's category,
  // never a typo'd free-text value the blog category dropdown then can't
  // match against.
  async function loadCategories() {
    const { data, error } = await supabase.from('pages').select('category').in('page_type', ['Content Pillar', 'Service Hub']);
    categories = error
      ? []
      : [...new Set((data ?? []).map((r) => r.category).filter((c): c is string => !!c))].sort();
    populateCategoryPicker();
  }

  initAdminAuth(async (adminUser) => {
    // Explicitly hide both before showing the right one — onAuthed can
    // fire more than once per page load (log out, then log back in as
    // a different role, with no full navigation in between), and
    // without this the previous role's view stays stacked underneath
    // instead of being replaced.
    boardView.classList.add('hidden');
    myAssignmentsView.classList.add('hidden');

    isStaffSession = adminUser.role === 'staff';
    if (isStaffSession) {
      myAssignmentsView.classList.remove('hidden');
      await loadMyAssignments(adminUser.id);
    } else {
      boardView.classList.remove('hidden');
      await loadAssignableUsers();
      await loadPages();
      await loadCategories();
      await loadBoard();
    }
  });
</script>
