---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { withBase } from '../../../lib/url';
---

<AdminLayout title="Business info | Admin" current="content-business-info">
  <!-- Admin redesign phase 3 (2026-10-08): the three forms as cards.
       Same ids and save logic. -->
  <p class="i-intro">The details your website shows everywhere, and the email new inquiries get right away.</p>
  <div class="bi-wrap">
    <section class="t-card bi-sec">
      <h2 class="bi-h">Contact details</h2>
      <p class="bi-sub">Your phone, email and address, shown across your site. Safe to edit anytime.</p>
      <form id="business-form" class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">Phone</label>
            <input id="biz-telephone" type="tel" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">Email</label>
            <input id="biz-email" type="email" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
        </div>
        <div class="grid grid-cols-3 gap-4">
          <div class="col-span-2">
            <label class="mb-1 block text-sm font-semibold text-slate-700">Street address</label>
            <input id="biz-street" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">Suite/unit (optional)</label>
            <input id="biz-street-2" type="text" placeholder="Suite 202" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
        </div>
        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">City</label>
            <input id="biz-city" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">State</label>
            <input id="biz-region" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-semibold text-slate-700">ZIP</label>
            <input id="biz-postal" type="text" class="w-full rounded-md border border-slate-300 px-4 py-2" />
          </div>
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Client portal URL (optional)</label>
          <input id="biz-portal" type="url" placeholder="https://..." class="w-full rounded-md border border-slate-300 px-4 py-2" />
          <p class="mt-1 text-xs text-slate-500">
            Shown as a "Client Portal" link in your site's footer, for existing clients to reach your EHR
            (SimplePractice, TherapyNotes, etc.).
          </p>
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Lead notification email(s) (optional)</label>
          <input
            id="biz-lead-notification-email"
            type="text"
            placeholder="you@example.com, teammate@example.com"
            class="w-full rounded-md border border-slate-300 px-4 py-2"
          />
          <p class="mt-1 text-xs text-slate-500">
            Who gets emailed the moment someone submits your contact form. Separate multiple
            addresses with commas. Replying to that email goes straight back to the person who
            submitted it. Leave blank to turn off notification emails.
          </p>
        </div>
        <button
          id="business-save-button"
          type="button"
          class="a-btn a-btn-primary"
        >
          Save
        </button>
        <p id="business-status" class="text-sm" role="status"></p>
      </form>
    </section>

    <!--
      Automatic reply to new leads (0070_lead_auto_reply.sql). Its own Save:
      the reply is sent server-side, so saving needs no site rebuild. The
      preview is rendered by the same shared builder the real send uses
      (supabase/functions/_shared/leadAutoReply.ts, via publish-site), so
      what's shown here is exactly what a lead receives.
    -->
    <section class="t-card bi-sec">
      <h2 class="bi-h">Automatic reply</h2>
      <p class="bi-sub">
        The moment someone submits your contact form, they get a short email confirming you received it and what
        happens next, so they know their message landed while they wait for a real person to follow up.
      </p>
      <div class="space-y-4">
        <label class="flex items-center gap-2 rounded-md border border-slate-200 px-4 py-2.5">
          <input id="auto-reply-enabled" type="checkbox" />
          <span class="text-sm font-medium">Send an automatic reply to every new inquiry</span>
        </label>
        <div>
          <label for="auto-reply-message" class="mb-1 block text-sm font-semibold text-slate-700">Your personal message (optional)</label>
          <textarea
            id="auto-reply-message"
            rows="4"
            maxlength="800"
            placeholder="e.g. Reaching out takes courage, and we're glad you did."
            class="w-full rounded-md border border-slate-300 px-4 py-2"></textarea>
          <p class="mt-1 text-xs text-slate-500">
            Appears after the opening line. Keep it general: this email never repeats what the person wrote to you,
            to protect their privacy. The "What happens next" line comes from your form's response-time note.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="auto-reply-save" type="button" class="a-btn a-btn-primary">Save</button>
          <button id="auto-reply-preview" type="button" class="a-btn">Preview</button>
          <button id="auto-reply-test" type="button" class="a-btn">Send me a test</button>
        </div>
        <p id="auto-reply-status" class="text-sm" role="status"></p>
        <div id="auto-reply-preview-wrap" class="hidden rounded-md border border-slate-200 bg-white">
          <p id="auto-reply-preview-subject" class="border-b border-slate-200 px-4 py-2 text-sm"></p>
          <iframe id="auto-reply-preview-frame" title="Automatic reply preview" class="h-[28rem] w-full" sandbox="allow-same-origin"></iframe>
        </div>
      </div>
    </section>

    <!-- CMC-only: the template's per-page Testimonials section (a counseling
         practice's, with the ACA C.3.b warning) is replaced on CMC's admin by
         its own Testimonials screen, backed by the testimonials table. Keep
         this when syncing a future template change to this file. -->
    <section class="t-card bi-sec bi-wide">
      <h2 class="bi-h">Testimonials</h2>
      <p class="i-hint">Quotes from practices you've worked with live in <a class="a-link" href={withBase('/admin/testimonials')}>Clients, then Testimonials</a>.</p>
    </section>
  </div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth } from '../../../lib/adminAuth';
  import { callPublishFunction, triggerRebuild } from '../../../lib/publishFunction';

  type Business = {
    id: string;
    telephone: string | null;
    email: string | null;
    street_address: string | null;
    street_address_2: string | null;
    address_locality: string | null;
    address_region: string | null;
    postal_code: string | null;
    client_portal_url: string | null;
    lead_notification_email: string | null;
    lead_auto_reply_enabled: boolean;
    lead_auto_reply_message: string | null;
  };

  let business: Business | null = null;

  // ---------------------------------------------------------------------
  // Business info
  // ---------------------------------------------------------------------
  const businessSaveButton = document.getElementById('business-save-button')!;
  const businessStatus = document.getElementById('business-status')!;
  const bizTelephone = document.getElementById('biz-telephone') as HTMLInputElement;
  const bizEmail = document.getElementById('biz-email') as HTMLInputElement;
  const bizStreet = document.getElementById('biz-street') as HTMLInputElement;
  const bizStreet2 = document.getElementById('biz-street-2') as HTMLInputElement;
  const bizCity = document.getElementById('biz-city') as HTMLInputElement;
  const bizRegion = document.getElementById('biz-region') as HTMLInputElement;
  const bizPostal = document.getElementById('biz-postal') as HTMLInputElement;
  const bizPortal = document.getElementById('biz-portal') as HTMLInputElement;
  const bizLeadNotificationEmail = document.getElementById('biz-lead-notification-email') as HTMLInputElement;

  function loadBusinessForm() {
    if (!business) return;
    bizTelephone.value = business.telephone ?? '';
    bizEmail.value = business.email ?? '';
    bizStreet.value = business.street_address ?? '';
    bizStreet2.value = business.street_address_2 ?? '';
    bizCity.value = business.address_locality ?? '';
    bizRegion.value = business.address_region ?? '';
    bizPostal.value = business.postal_code ?? '';
    bizPortal.value = business.client_portal_url ?? '';
    bizLeadNotificationEmail.value = business.lead_notification_email ?? '';
  }

  // Normalizes a comma-separated textbox value into a clean comma-separated
  // string before saving — trims each address and drops empty entries, so
  // "a@x.com, , b@x.com," doesn't round-trip as literal empty segments the
  // Edge Function would otherwise try to email.
  function normalizeEmailList(value: string): string | null {
    const cleaned = value
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean)
      .join(', ');
    return cleaned || null;
  }

  businessSaveButton.addEventListener('click', async () => {
    if (!business) return;
    businessStatus.textContent = 'Saving...';
    businessStatus.className = 'i-hint';
    const { error } = await supabase
      .from('business')
      .update({
        telephone: bizTelephone.value.trim() || null,
        email: bizEmail.value.trim() || null,
        street_address: bizStreet.value.trim() || null,
        street_address_2: bizStreet2.value.trim() || null,
        address_locality: bizCity.value.trim() || null,
        address_region: bizRegion.value.trim() || null,
        postal_code: bizPostal.value.trim() || null,
        client_portal_url: bizPortal.value.trim() || null,
        lead_notification_email: normalizeEmailList(bizLeadNotificationEmail.value),
      })
      .eq('id', business.id);
    if (error) {
      businessStatus.textContent = 'Could not save: ' + error.message;
      businessStatus.className = 'i-hint r-err';
      return;
    }
    businessStatus.textContent = 'Saving your site...';
    const result = await triggerRebuild();
    businessStatus.textContent = result.ok
      ? 'Saved! Your site will update shortly.'
      : 'Saved, but the update trigger failed — it will go live on the next rebuild.';
    businessStatus.className = result.ok ? 'i-hint r-ok' : 'i-hint r-warn';
  });

  // ---------------------------------------------------------------------
  // Automatic reply to new leads
  // ---------------------------------------------------------------------
  const autoReplyEnabled = document.getElementById('auto-reply-enabled') as HTMLInputElement;
  const autoReplyMessage = document.getElementById('auto-reply-message') as HTMLTextAreaElement;
  const autoReplyStatus = document.getElementById('auto-reply-status')!;
  const autoReplyPreviewWrap = document.getElementById('auto-reply-preview-wrap')!;
  const autoReplyPreviewFrame = document.getElementById('auto-reply-preview-frame') as HTMLIFrameElement;

  function setAutoReplyStatus(text: string, tone: 'info' | 'ok' | 'error') {
    autoReplyStatus.textContent = text;
    autoReplyStatus.className = 'i-hint' + (tone === 'ok' ? ' r-ok' : tone === 'error' ? ' r-err' : '');
  }

  function loadAutoReplyForm() {
    if (!business) return;
    autoReplyEnabled.checked = business.lead_auto_reply_enabled;
    autoReplyMessage.value = business.lead_auto_reply_message ?? '';
  }

  document.getElementById('auto-reply-save')!.addEventListener('click', async () => {
    if (!business) return;
    setAutoReplyStatus('Saving...', 'info');
    const update = {
      lead_auto_reply_enabled: autoReplyEnabled.checked,
      lead_auto_reply_message: autoReplyMessage.value.trim() || null,
    };
    const { error } = await supabase.from('business').update(update).eq('id', business.id);
    if (error) {
      setAutoReplyStatus('Could not save: ' + error.message, 'error');
      return;
    }
    Object.assign(business, update);
    setAutoReplyStatus(update.lead_auto_reply_enabled ? 'Saved. New inquiries will get this reply.' : 'Saved. Automatic replies are off.', 'ok');
  });

  document.getElementById('auto-reply-preview')!.addEventListener('click', async () => {
    setAutoReplyStatus('Building preview...', 'info');
    const result = await callPublishFunction({ action: 'preview-auto-reply', customMessage: autoReplyMessage.value });
    if (!result.ok || !result.data) {
      setAutoReplyStatus('Could not build preview: ' + (result.error ?? 'unknown error'), 'error');
      return;
    }
    document.getElementById('auto-reply-preview-subject')!.textContent = `Subject: ${result.data.subject as string}`;
    autoReplyPreviewFrame.srcdoc = result.data.html as string;
    autoReplyPreviewWrap.classList.remove('hidden');
    setAutoReplyStatus('Preview shown with a sample name. This is exactly what someone who sends an inquiry receives.', 'info');
  });

  document.getElementById('auto-reply-test')!.addEventListener('click', async () => {
    setAutoReplyStatus('Sending...', 'info');
    const result = await callPublishFunction({ action: 'test-auto-reply', customMessage: autoReplyMessage.value });
    if (!result.ok) {
      setAutoReplyStatus('Could not send: ' + (result.error ?? 'unknown error'), 'error');
      return;
    }
    setAutoReplyStatus(`Test sent to ${(result.data?.sentTo as string) ?? 'your email'}.`, 'ok');
  });

  // ---------------------------------------------------------------------
  async function onAuthed() {
    const { data: businessData } = await supabase.from('business').select('*').single();
    business = businessData as Business;

    loadBusinessForm();
    loadAutoReplyForm();
  }

  initAdminAuth(onAuthed, { allowedRoles: ['owner', 'agency'] });
</script>
