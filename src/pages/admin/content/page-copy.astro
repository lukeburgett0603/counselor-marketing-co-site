  const ALWAYS_LOCKED_FIELDS = ['h1', 'meta_description', 'focus_keyword'];

  // What a linked-counselor staff session may directly edit on their own
  // page — must exactly match enforce_content_permission()'s linked-
  // counselor allowlist (0054_linked_counselor_full_page_access.sql), or
  // a save this UI thinks should succeed gets rejected by the trigger
  // instead. h1/meta_description/focus_keyword stay excluded
  // (ALWAYS_LOCKED_FIELDS already blocks them) — client decision
  // (2026-09-16): those three alone stay SEO-strategist-managed, every
  // other real content field on the page is fully self-service. `copy`/
  // hero-layout fields stay excluded on their own merits, not as a trust
  // decision — Counselor Profile pages always use the StoryBrand split,
  // never the plain `copy` field, and don't render Hero.astro at all
  // (they have their own header card), so those are simply irrelevant to
  // this page type. `images` IS included — it's the counselor's own
  // headshot (see imageKeyFor()), a real, meaningful, counselor-specific
  // field, unlike the irrelevant ones above.
  const LINKED_COUNSELOR_EDITABLE_FIELDS = [
    'hero_subhead',
    'hero_headline',
    'storybrand_problem',
    'storybrand_guide_empathy',
    'storybrand_pitch',
    'storybrand_pitch_label',
    'storybrand_success',
    'storybrand_failure',
    'images',
    // Joined 2026-09-16 once Counselor Profile's own rebuild started
    // using these columns for real — previously Homepage-only, and
    // 0052's reasoning for leaving them out ("a Homepage row is
    // unreachable by a linked-counselor session") no longer holds now
    // that Counselor Profile — the one page type a linked-counselor
    // session *can* reach — uses them too. Must exactly match
    // enforce_content_permission()'s own exclusion list
    // (0057_counselor_profile_storybrand_fields.sql).
    'value_add_items',
    'guide_authority_stats',
    'brandscript_one_liner',
    'brandscript_teaser',
    'brandscript_full',
    'brandscript_video_url',
    // testimonial_quote/testimonial_author deliberately do NOT go here —
    // they're ungated (no data-field wrapper), following cta_heading's
    // pattern, not this canEditField()-gated one.
  ];

  // Counselor Profile pages don't render Hero.astro at all — they have
  // their own header card (CounselorProfile.astro) that reads
  // images.headshot specifically, not images.hero. This admin field is
  // the only place a Counselor Profile's own photo gets uploaded, so it
  // has to read/write the same key the template actually looks at, or an
  // upload silently never renders. Found live: Luke Burgett's headshot
  // was uploaded here, saved under images.hero (the key every other page
  // type actually uses), and never appeared on his page because
  // CounselorProfile.astro only ever reads images.headshot.
  function imageKeyFor(pageType: string | undefined): 'headshot' | 'hero' {
    return pageType === 'Counselor Profile' ? 'headshot' : 'hero';
  }

  function isFullTier(): boolean {
    return business?.content_permission_level === 'full';
  }

  // A linked-counselor staff session is never also an owner/agency
  // session — mirrors the exact check enforce_content_permission()'s
  // trigger makes server-side (role = 'staff' and linked_counselor_page_id
  // set), so the UI and the database boundary can't disagree about who
  // this is.
  function isLinkedCounselorSession(): boolean {
    return currentAdminUser?.role === 'staff' && !!currentAdminUser?.linked_counselor_page_id;
  }

  // Agency is exempt from the content-permission lock entirely (see the
  // enforce_content_permission trigger) — h1/meta_description/
  // focus_keyword are never owner-editable regardless of tier;
  // hero_subhead/copy/images follow the tier. A linked-counselor session
  // is its own separate, narrower case: only the fields in
  // LINKED_COUNSELOR_EDITABLE_FIELDS, full stop, regardless of the
  // business's own content_permission_level tier — stricter than even a
  // restricted-tier owner on every field except the ones explicitly
  // opened up for them.
  // cta_subheading is the one exception to "ungated, safe on every
  // plan" (cta_heading/cta_button_text's own category) — client
  // decision (2026-09-16): the agency writes this one, so it's locked
  // specifically for a linked-counselor session (handled by the
  // isLinkedCounselorSession() branch below, since it's simply absent
  // from LINKED_COUNSELOR_EDITABLE_FIELDS) but stays always-editable,
  // regardless of content_permission_level, for every other role —
  // checked here, before the tier fallback, so a restricted-tier owner
  // isn't accidentally locked out of a field that was never tier-gated
  // in the first place.
  const UNGATED_EXCEPT_LINKED_COUNSELOR_FIELDS = ['cta_subheading'];

  function canEditField(fieldKey: string): boolean {
    if (currentAdminUser?.role === 'agency') return true;
    if (isLinkedCounselorSession()) return LINKED_COUNSELOR_EDITABLE_FIELDS.includes(fieldKey);
    if (ALWAYS_LOCKED_FIELDS.includes(fieldKey)) return false;
    if (UNGATED_EXCEPT_LINKED_COUNSELOR_FIELDS.includes(fieldKey)) return true;
    return isFullTier();
  }

  function canEditAnyField(): boolean {
    return currentAdminUser?.role === 'agency' || isFullTier() || isLinkedCounselorSession();
  }

  function getCurrentValueText(fieldKey: string): string {
    if (!selectedContentPage) return '';
    switch (fieldKey) {
      case 'h1':
        return selectedContentPage.h1 ?? '';
      case 'meta_description':
        return selectedContentPage.meta_description ?? '';
      case 'focus_keyword':
        return selectedContentPage.focus_keyword ?? '';
      case 'hero_subhead':
        return selectedContentPage.hero_subhead ?? '';
      case 'hero_headline':
        return selectedContentPage.hero_headline ?? '';
      case 'copy':
        return selectedContentPage.copy ?? '';
      case 'storybrand_problem':
        return selectedContentPage.storybrand_problem ?? '';
      case 'storybrand_guide_empathy':
        return selectedContentPage.storybrand_guide_empathy ?? '';
      case 'storybrand_pitch':
        return selectedContentPage.storybrand_pitch ?? '';
      case 'storybrand_pitch_label':
        return selectedContentPage.storybrand_pitch_label ?? '';
      case 'storybrand_success':
        return selectedContentPage.storybrand_success ?? '';
      case 'storybrand_failure':
        return selectedContentPage.storybrand_failure ?? '';
      case 'value_add_items':
        return selectedContentPage.value_add_items.map((i) => `${i.icon}: ${i.label}`).join(', ') || '(none set)';
      case 'guide_authority_stats':
        return selectedContentPage.guide_authority_stats.map((s) => `${s.label}: ${s.value}`).join(', ') || '(none set)';
      case 'brandscript_one_liner':
        return selectedContentPage.brandscript_one_liner ?? '';
      case 'brandscript_teaser':
        return selectedContentPage.brandscript_teaser ?? '';
      case 'brandscript_full':
        return selectedContentPage.brandscript_full ?? '';
      case 'brandscript_video_url':
        return selectedContentPage.brandscript_video_url ?? '';
      case 'cta_subheading':
        return selectedContentPage.cta_subheading ?? '';
      case 'images': {
        const img = selectedContentPage.images?.[imageKeyFor(selectedContentPage.page_type)];
        return img ? `${img.url} (alt: ${img.alt})` : '(no image set)';
      }
      default:
        return '';
    }
  }

  // Wires the generic "Suggest an edit" toggle + submit for every
  // [data-field] container on the page (shared markup from
  // components/SuggestEdit.astro).
  function wireSuggestButtons() {
    document.querySelectorAll<HTMLElement>('[data-field]').forEach((fieldEl) => {
      const fieldKey = fieldEl.dataset.field!;
      const toggleButton = fieldEl.querySelector<HTMLElement>('.suggest-edit-button')!;
      const form = fieldEl.querySelector<HTMLElement>('.suggest-form')!;
      const textarea = fieldEl.querySelector('.suggest-textarea') as HTMLTextAreaElement;
      const submitButton = fieldEl.querySelector<HTMLElement>('.submit-suggestion-button')!;
      const status = fieldEl.querySelector<HTMLElement>('.suggest-status')!;

      toggleButton.addEventListener('click', () => {
        form.classList.toggle('hidden');
      });

      submitButton.addEventListener('click', async () => {
        if (!selectedContentPage) return;
        const suggestedValue = textarea.value.trim();
        if (!suggestedValue) {
          status.textContent = 'Enter a suggestion first.';
          status.className = 'suggest-status text-xs text-red-600';
          return;
        }
        status.textContent = 'Submitting...';
        status.className = 'suggest-status text-xs text-slate-600';
        const { error } = await supabase.from('content_suggestions').insert({
          page_id: selectedContentPage.id,
          field_name: fieldKey,
          current_value: getCurrentValueText(fieldKey),
          suggested_value: suggestedValue,
          submitted_by: currentUserId,
        });
        if (error) {
          status.textContent = 'Could not submit: ' + error.message;
          status.className = 'suggest-status text-xs text-red-600';
          return;
        }
        status.textContent = "Sent — your strategist will follow up.";
        status.className = 'suggest-status text-xs text-emerald-700';
        textarea.value = '';
        form.classList.add('hidden');
      });
    });
  }

  function renderTierUI() {
    if (currentAdminUser?.role === 'agency') {
      contentTierNote.textContent = 'You have full editing access to every field as the agency admin.';
    } else if (isLinkedCounselorSession()) {
      contentTierNote.textContent =
        'You can edit your bio’s tagline and StoryBrand sections directly below. Your page heading, meta description, and focus keyword stay managed by your SEO strategist — suggest a change if one of those needs updating.';
    } else if (isFullTier()) {
      contentTierNote.textContent = 'Your plan includes full editing access to hero text, page copy, and images.';
    } else {
      contentTierNote.textContent =
        "Page heading, meta description, and focus keyword are always managed by your SEO strategist. On your current plan, hero text, page copy, and images are too — suggest a change and we'll take care of it.";
    }
    document.querySelectorAll<HTMLElement>('[data-field]').forEach((fieldEl) => {
      const fieldKey = fieldEl.dataset.field!;
      const editable = canEditField(fieldKey);
      fieldEl.querySelectorAll<HTMLElement>('.editable-view').forEach((el) => el.classList.toggle('hidden', !editable));
      fieldEl.querySelectorAll<HTMLElement>('.locked-view').forEach((el) => el.classList.toggle('hidden', editable));
      fieldEl.querySelectorAll<HTMLElement>('.tier-note, .suggest-edit-wrap').forEach((el) => el.classList.toggle('hidden', editable));
    });
    contentSaveButton.classList.toggle('hidden', !canEditAnyField());
  }

  // storybrand_problem/storybrand_pitch/storybrand_pitch_label are the
  // same columns Service Page/Counselor Profile use ("The Problem"/"The
  // Full Picture"/its link text) — on a Homepage row specifically they
  // mean something different now (Stakes / Value Proposition / its
  // heading), so only the admin-facing label/help text changes per page
  // type, never the underlying field key or stored data.
  // Counselor Profile joined Homepage in this relabeling (2026-09-16,
  // client request) once its own rebuild repurposed storybrand_problem/
  // storybrand_pitch/storybrand_pitch_label into the same Stakes/Value-
  // Proposition roles Homepage already uses these columns for — Service
  // Page is the one page type still on the original "Problem"/"Full
  // Picture" model, so it's the only one left using the `false` branch
  // below.
  function applyStorybrandLabelsFor(pageType: string) {
    const isValuePropStyle = pageType === 'Homepage' || pageType === 'Counselor Profile';
    contentStorybrandProblemFieldLabel.textContent = isValuePropStyle ? 'Stakes' : 'The Problem';
    contentStorybrandProblemHelp.textContent = isValuePropStyle
      ? `StoryBrand's "Stakes" section. What does it cost your visitor to keep living with this problem? Use honest, loss-aversion language — they were made to flourish, not to keep struggling with this. Positioned right after the Hero so it isn't buried.`
      : `StoryBrand's "Problem" section. Describe the problem your visitor is facing when they land on this page — go beyond the surface issue to how it makes them feel and why it feels unfair. The goal: a visitor reads this and thinks, "they understand exactly what I'm going through."`;

    contentStorybrandPitchFieldLabel.textContent = isValuePropStyle ? 'Value Proposition' : 'The Full Picture';
    contentStorybrandPitchHelp.textContent = isValuePropStyle
      ? `The positive flip from Stakes. Benefit-focused language — what your visitor gains once they start counseling. This is a real, visible section (not collapsed) with its own heading and call-to-action.`
      : `StoryBrand's fuller explanation. For visitors who want more detail before deciding — explain your approach and why it's the right next step. Write like you're personally reassuring someone who still has questions.`;

    contentStorybrandPitchLabelFieldLabel.textContent = isValuePropStyle
      ? 'Value Proposition heading'
      : '"The Full Picture" link text';
    contentStorybrandPitchLabel.placeholder = isValuePropStyle ? 'What You Can Expect' : 'Learn more about our approach';
    contentStorybrandPitchLabelHelp.textContent = isValuePropStyle
      ? 'Shown as the visible heading above the Value Proposition section.'
      : 'Shown as a heading visitors click to expand "The Full Picture" above. Leave blank to use the default, "Learn more about our approach."';
  }

  // Reorders admin fields to match the Homepage's real, rebuilt page
  // order (2026-09-16) — Focus keyword/Meta description/H1 already sit
  // first for every page type (fixed markup order, no reordering
  // needed). Everything below that is Homepage-specific: Hero subhead →
  // Hero image → Value Add strip → Stakes → Value Proposition (heading,
  // then body) → Guide (empathy, then Authority facts) → Plan → Explanatory
  // Paragraph → the closing CTA (heading/subheading/button). Featured
  // Services and Counselor cards intentionally have no fields here at
  // all — Featured Services is set on each Service Page's own edit
  // screen, Counselor cards derives entirely from existing Counselor
  // Profile pages. `appendChild` on an already-attached element moves it
  // (doesn't clone), so calling it in the target sequence is enough to
  // produce that exact order regardless of each element's current
  // position — no separate "anchor" bookkeeping needed for the move
  // itself, only for restoring the default order below.
  function applyHomepageFieldOrder() {
    const container = contentStorybrandFields;
    container.appendChild(contentHeroSubheadWrap);
    container.appendChild(contentImagesWrap);
    container.appendChild(contentValueAddWrap);
    container.appendChild(contentStorybrandProblemWrap);
    container.appendChild(contentStorybrandPitchLabelWrap);
    container.appendChild(contentStorybrandPitchWrap);
    container.appendChild(contentStorybrandGuideEmpathyWrap);
    container.appendChild(contentAuthorityStatsWrap);
    container.appendChild(contentPlanStepsWrap);
    container.appendChild(contentExplanatoryWrap);
    container.appendChild(contentCtaWrap);
    // Success/Failure are hidden (not part of Homepage's order at all —
    // see the isHomepage toggle above), so their exact DOM position has
    // no visual effect, but parking them at the end keeps the tree
    // predictable rather than leaving them wherever moving everything
    // else around happened to strand them.
    container.appendChild(contentStorybrandSuccessWrap);
    container.appendChild(contentStorybrandFailureWrap);
  }

  // Reorders admin fields to match CounselorProfile.astro's real render
  // order. First built 2026-09-16 as a small reorder (Hero image and
  // Plan Steps moved to match the then-existing page layout); the same
  // day, the client asked for a full StoryBrand rebuild matching
  // Homepage's own structure, so this function now establishes the
  // complete target sequence — Value Add strip → the counselor's quote
  // → Stakes → Value Proposition (heading, then body) → We Understand →
  // Guide Authority → Plan steps → Explanatory Paragraph. FAQs and the
  // closing CTA both already sit at the end, after everything here,
  // matching their real end-of-page position — left untouched, still
  // living in "Additional page elements." Every StoryBrand field's
  // relative order is fully re-specified here (not just the ones that
  // moved), for the same round-trip-robustness reason Homepage's own
  // reorder needs it: this function has to produce the correct order
  // regardless of whatever a prior Homepage or Service Page visit left
  // the DOM in during the same admin session.
  function applyCounselorProfileFieldOrder() {
    contentFields.insertBefore(contentImagesWrap, contentStorybrandFields);
    const container = contentStorybrandFields;
    container.appendChild(contentValueAddWrap);
    container.appendChild(contentTestimonialWrap);
    container.appendChild(contentStorybrandProblemWrap);
    container.appendChild(contentStorybrandPitchLabelWrap);
    container.appendChild(contentStorybrandPitchWrap);
    container.appendChild(contentStorybrandGuideEmpathyWrap);
    container.appendChild(contentAuthorityStatsWrap);
    container.appendChild(contentPlanStepsWrap);
    container.appendChild(contentExplanatoryWrap);
    // Success/Failure no longer render on Counselor Profile at all
    // (2026-09-16) — parked at the end (hidden either way via
    // loadContentForm()'s own toggle) to keep the tree predictable,
    // same reasoning as Homepage's own Success/Failure parking.
    container.appendChild(contentStorybrandSuccessWrap);
    container.appendChild(contentStorybrandFailureWrap);
  }

  // Restores every field moved above back to its original static-markup
  // position — used for every page type except Homepage, so Service
  // Page/Counselor Profile's order (already correct for their own
  // templates, untouched by this rebuild) can't end up scrambled by a
  // prior Homepage visit in the same admin session.
  function restoreDefaultFieldOrder() {
    contentFields.insertBefore(contentHeroSubheadWrap, contentPlainCopyWrap);
    contentFields.insertBefore(contentImagesWrap, contentSaveButton);
    contentPageDetailsSection.insertBefore(contentPlanStepsWrap, contentFaqsWrap);
    contentPageDetailsSection.insertBefore(contentCtaWrap, contentFeaturedWrap);
    contentStorybrandFields.appendChild(contentValueAddWrap);
    contentStorybrandFields.appendChild(contentTestimonialWrap);
    contentStorybrandFields.appendChild(contentStorybrandProblemWrap);
    contentStorybrandFields.appendChild(contentStorybrandGuideEmpathyWrap);
    contentStorybrandFields.appendChild(contentAuthorityStatsWrap);
    contentStorybrandFields.appendChild(contentStorybrandPitchWrap);
    contentStorybrandFields.appendChild(contentStorybrandPitchLabelWrap);
    contentStorybrandFields.appendChild(contentStorybrandSuccessWrap);
    contentStorybrandFields.appendChild(contentStorybrandFailureWrap);
    contentStorybrandFields.appendChild(contentExplanatoryWrap);
  }

  function loadContentForm() {
    selectedContentPage = pages.find((p) => p.id === contentPageSelect.value) ?? null;
    if (!selectedContentPage) {
      contentFields.classList.add('hidden');
      return;
    }
    contentFields.classList.remove('hidden');

    // CounselorProfile.astro never reads page.h1 — its real <h1> comes
    // from hero_headline ?? title instead (see that field below). A
    // locked, always-empty field labeled "H1" that has zero effect on
    // the actual page was real, confirmed confusion, not hypothetical.
    contentH1Wrap.classList.toggle('hidden', selectedContentPage.page_type === 'Counselor Profile');
    contentH1.value = selectedContentPage.h1 ?? '';
    document.querySelector('[data-field="h1"] [data-locked-value]')!.textContent = selectedContentPage.h1 ?? '(not set)';
    contentMetaDescription.value = selectedContentPage.meta_description ?? '';
    document.querySelector('[data-field="meta_description"] [data-locked-value]')!.textContent =
      selectedContentPage.meta_description ?? '(not set)';
    contentFocusKeyword.value = selectedContentPage.focus_keyword ?? '';
    document.querySelector('[data-field="focus_keyword"] [data-locked-value]')!.textContent =
      selectedContentPage.focus_keyword ?? '(not set)';

    contentHeroSubhead.value = selectedContentPage.hero_subhead ?? '';
    document.querySelector('[data-field="hero_subhead"] [data-locked-value]')!.textContent =
      selectedContentPage.hero_subhead ?? '(not set)';

    contentHeroHeadlineWrap.classList.toggle('hidden', !HERO_HEADLINE_PAGE_TYPES.includes(selectedContentPage.page_type));
    contentHeroHeadline.value = selectedContentPage.hero_headline ?? '';
    document.querySelector('[data-field="hero_headline"] [data-locked-value]')!.textContent =
      selectedContentPage.hero_headline ?? '(not set — showing your name instead)';

    copyEditor.setMarkdown(selectedContentPage.copy);
    document.querySelector('[data-field="copy"] [data-locked-value-html]')!.innerHTML = renderCopy(selectedContentPage.copy);

    // StoryBrand section-by-section fields replace the plain "Page copy"
    // box entirely for the 3 short/compact page types — see
    // STORYBRAND_SPLIT_PAGE_TYPES's own comment in lib/pages.ts for why
    // Content Pillar/Service Hub are excluded.
    const isStorybrandSplit = STORYBRAND_SPLIT_PAGE_TYPES.includes(selectedContentPage.page_type as never);
    contentPlainCopyWrap.classList.toggle('hidden', isStorybrandSplit);
    contentStorybrandFields.classList.toggle('hidden', !isStorybrandSplit);
    storybrandProblemEditor.setMarkdown(selectedContentPage.storybrand_problem);
    document.querySelector('[data-field="storybrand_problem"] [data-locked-value-html]')!.innerHTML = renderCopy(
      selectedContentPage.storybrand_problem
    );
    storybrandGuideEmpathyEditor.setMarkdown(selectedContentPage.storybrand_guide_empathy);
    document.querySelector('[data-field="storybrand_guide_empathy"] [data-locked-value-html]')!.innerHTML = renderCopy(
      selectedContentPage.storybrand_guide_empathy
    );
    storybrandPitchEditor.setMarkdown(selectedContentPage.storybrand_pitch);
    document.querySelector('[data-field="storybrand_pitch"] [data-locked-value-html]')!.innerHTML = renderCopy(
      selectedContentPage.storybrand_pitch
    );
    contentStorybrandPitchLabel.value = selectedContentPage.storybrand_pitch_label ?? '';
    document.querySelector('[data-field="storybrand_pitch_label"] [data-locked-value]')!.textContent =
      selectedContentPage.storybrand_pitch_label ?? '(using default: "Learn more about our approach")';
    storybrandSuccessEditor.setMarkdown(selectedContentPage.storybrand_success);
    document.querySelector('[data-field="storybrand_success"] [data-locked-value-html]')!.innerHTML = renderCopy(
      selectedContentPage.storybrand_success
    );
    storybrandFailureEditor.setMarkdown(selectedContentPage.storybrand_failure);
    document.querySelector('[data-field="storybrand_failure"] [data-locked-value-html]')!.innerHTML = renderCopy(
      selectedContentPage.storybrand_failure
    );

    applyStorybrandLabelsFor(selectedContentPage.page_type);

    // Value Add strip / Guide — Authority / Explanatory Paragraph were
    // Homepage-only from the original StoryBrand rebuild; Counselor
    // Profile joined them (2026-09-16, client request) once its own
    // rebuild started using these same columns for real. Hidden entirely
    // (not just left inert) for every other page type, matching this
    // screen's existing "hide what genuinely doesn't apply" discipline
    // (see content-h1-wrap/content-hero-style-wrap above).
    const isHomepage = selectedContentPage.page_type === 'Homepage';
    const isCounselorProfile = selectedContentPage.page_type === 'Counselor Profile';
    const usesValuePropSections = isHomepage || isCounselorProfile;
    contentValueAddWrap.classList.toggle('hidden', !usesValuePropSections);
    valueAddEditor.setItems(selectedContentPage.value_add_items);
    document.querySelector('[data-field="value_add_items"] [data-locked-value]')!.textContent =
      selectedContentPage.value_add_items.map((i) => i.label).join(', ') || '(none set)';

    contentAuthorityStatsWrap.classList.toggle('hidden', !usesValuePropSections);
    authorityStatsEditor.setItems(selectedContentPage.guide_authority_stats.map((s) => ({ a: s.label, b: s.value })));
    document.querySelector('[data-field="guide_authority_stats"] [data-locked-value]')!.textContent =
      selectedContentPage.guide_authority_stats.map((s) => `${s.label}: ${s.value}`).join(', ') || '(none set)';

    contentExplanatoryWrap.classList.toggle('hidden', !usesValuePropSections);
    contentBrandscriptOneLiner.value = selectedContentPage.brandscript_one_liner ?? '';
    document.querySelector('[data-field="brandscript_one_liner"] [data-locked-value]')!.textContent =
      selectedContentPage.brandscript_one_liner ?? '(not set)';
    contentBrandscriptTeaser.value = selectedContentPage.brandscript_teaser ?? '';
    document.querySelector('[data-field="brandscript_teaser"] [data-locked-value]')!.textContent =
      selectedContentPage.brandscript_teaser ?? '(not set)';
    brandscriptFullEditor.setMarkdown(selectedContentPage.brandscript_full);
    document.querySelector('[data-field="brandscript_full"] [data-locked-value-html]')!.innerHTML = renderCopy(
      selectedContentPage.brandscript_full
    );
    contentBrandscriptVideoUrl.value = selectedContentPage.brandscript_video_url ?? '';
    document.querySelector('[data-field="brandscript_video_url"] [data-locked-value]')!.textContent =
      selectedContentPage.brandscript_video_url ?? '(not set)';

    // The counselor's own quote — Counselor-Profile-only (2026-09-16).
    // Ungated/no data-field wrapper: matches testimonial_quote/
    // testimonial_author never being tier-gated for owner/agency either
    // (see business-info.astro's Testimonials editor, which has no tier
    // check today) — same "safe on every tier" category as cta_heading.
    contentTestimonialWrap.classList.toggle('hidden', !isCounselorProfile);
    contentTestimonialQuote.value = selectedContentPage.testimonial_quote ?? '';
    contentTestimonialAuthor.value = selectedContentPage.testimonial_author ?? '';

    // Success/Failure no longer render as their own sections on Homepage
    // or Counselor Profile (Counselor Profile joined 2026-09-16, same
    // client request/reasoning as Homepage's own rebuild) — both page
    // types now close with Explanatory Paragraph flowing into FAQs then
    // the CTA. The columns still exist (Service Page still uses them),
    // so this only hides the fields here, it doesn't touch the data.
    contentStorybrandSuccessWrap.classList.toggle('hidden', usesValuePropSections);
    contentStorybrandFailureWrap.classList.toggle('hidden', usesValuePropSections);

    // Physically reorder the fields above to match each page type's own
    // real page order — Homepage and Counselor Profile each get their
    // own reorder function (their real render order genuinely differs
    // from each other, not just from the default); Service Page falls
    // through to restoreDefaultFieldOrder(), which is a no-op if nothing
    // was ever moved (e.g. this is the first page loaded this session)
    // and a real restore if a prior Homepage/Counselor Profile selection
    // in this same session moved anything.
    if (isHomepage) {
      applyHomepageFieldOrder();
    } else if (selectedContentPage.page_type === 'Counselor Profile') {
      applyCounselorProfileFieldOrder();
    } else {
      restoreDefaultFieldOrder();
    }

    // Featured Services — Service Page/Service Hub rows only, ungated.
    const showFeatured = FEATURED_SERVICE_PAGE_TYPES.includes(selectedContentPage.page_type);
    contentFeaturedWrap.classList.toggle('hidden', !showFeatured);
    contentFeaturedCheckbox.checked = selectedContentPage.featured_on_homepage;
    contentFeaturedOrderWrap.classList.toggle('hidden', !selectedContentPage.featured_on_homepage);
    contentFeaturedOrder.value = selectedContentPage.homepage_feature_order != null ? String(selectedContentPage.homepage_feature_order) : '';

    // Footer column — any page currently placed in the footer, ungated.
    const showFooterColumn = selectedContentPage.nav_placement === 'footer';
    contentFooterColumnWrap.classList.toggle('hidden', !showFooterColumn);
    contentFooterColumn.value = selectedContentPage.footer_column ?? 'explore';

    contentCounselorGuidance.classList.toggle('hidden', !isLinkedCounselorSession());
    if (isLinkedCounselorSession()) {
      const keyword = selectedContentPage.focus_keyword;
      contentCounselorKeywordTip.textContent = keyword
        ? `Your focus keyword: "${keyword}" — try to work this in naturally, ideally once within your first paragraph or two. It's fine if it shows up once more later if it genuinely fits — more than that starts to feel forced. Write for the person reading this, not for a search engine.`
        : '';
      // getPersonEntityTerms() returns one atomic entry per fact (e.g. one
      // per specialty, one per modality) so buildPersonSchema() can build
      // a real knowsAbout array — group them back by label here so the
      // guidance panel reads as "specialty: Anxiety, Depression, OCD"
      // instead of repeating "specialty:" once per value.
      const entityTerms = getPersonEntityTerms(selectedContentPage);
      const groupedTerms = new Map<string, string[]>();
      for (const term of entityTerms) {
        if (!groupedTerms.has(term.label)) groupedTerms.set(term.label, []);
        groupedTerms.get(term.label)!.push(term.value);
      }
      const groupedText = Array.from(groupedTerms.entries())
        .map(([label, values]) => `${label.toLowerCase()}: ${values.join(', ')}`)
        .join('; ');
      contentCounselorEntityTip.textContent = groupedText
        ? `Already on file: ${groupedText} — feel free to reference this naturally in your bio.`
        : '';
      updateKeywordCount();
    }

    const currentImage = selectedContentPage.images?.[imageKeyFor(selectedContentPage.page_type)];
    uploadedImageUrl = currentImage?.url ?? null;
    uploadedImageCreditName = currentImage?.creditName ?? null;
    uploadedImageCreditUrl = currentImage?.creditUrl ?? null;
    contentImageAlt.value = currentImage?.alt ?? '';
    contentImageStatus.textContent = uploadedImageUrl ? 'Current image on file — choose a new one to replace it.' : '';
    if (uploadedImageUrl) {
      contentImagePreview.src = uploadedImageUrl;
      contentImagePreview.classList.remove('hidden');
    } else {
      contentImagePreview.src = '';
      contentImagePreview.classList.add('hidden');
    }
    document.querySelector('[data-field="images"] [data-locked-value]')!.textContent = uploadedImageUrl
      ? `Current image: ${currentImage?.alt}`
      : 'No image set.';

    // Hero.astro isn't used at all on a Counselor Profile page (it has
    // its own header card instead — see CounselorProfile.astro), so a
    // hero-layout choice would have no effect there. Hidden rather than
    // just left inert, so nobody wonders why picking "overlay" for a
    // counselor page never seems to do anything.
    contentHeroStyleWrap.classList.toggle('hidden', selectedContentPage.page_type === 'Counselor Profile');
    contentHeroFocalY.value = selectedContentPage.hero_image_focal_y;
    contentHeroStyle.value = selectedContentPage.hero_style;
    contentHeroOverlayColor.value = selectedContentPage.hero_overlay_color;
    contentHeroOverlayOpacity.value = String(selectedContentPage.hero_overlay_opacity);
    contentHeroOverlayOpacityReadout.textContent = String(selectedContentPage.hero_overlay_opacity);
    contentHeroOverlayControls.style.display = selectedContentPage.hero_style === 'overlay' ? '' : 'none';

    // Content Pillar and Service Hub both render this byline (see
    // ContentPillar.astro and ServiceHub.astro) — a Service Hub is a
    // real bookable service that also functions as a content hub, so it
    // gets the same reviewer byline as a pure informational pillar.
    const BYLINE_PAGE_TYPES = ['Content Pillar', 'Service Hub'];
    contentBylineSection.classList.toggle('hidden', !BYLINE_PAGE_TYPES.includes(selectedContentPage.page_type));
    contentBylineName.value = selectedContentPage.author_name ?? '';
    contentBylineCredential.value = selectedContentPage.credentials ?? '';
    contentBylineDate.value = selectedContentPage.date_modified ?? '';
    contentBylineStatus.textContent = '';

    // Additional page elements — not tier-gated, shown per-page-type per
    // the *_PAGE_TYPES consts above (sourced from the actual templates,
    // not the reference docs).
    const showPlanSteps = PLAN_STEPS_PAGE_TYPES.includes(selectedContentPage.page_type);
    const showFaqs = FAQS_PAGE_TYPES.includes(selectedContentPage.page_type);
    const showConcerns = CONCERNS_PAGE_TYPES.includes(selectedContentPage.page_type);
    const showCta = CTA_PAGE_TYPES.includes(selectedContentPage.page_type);
    contentPlanStepsWrap.classList.toggle('hidden', !showPlanSteps);
    contentFaqsWrap.classList.toggle('hidden', !showFaqs);
    contentConcernsWrap.classList.toggle('hidden', !showConcerns);
    contentCtaWrap.classList.toggle('hidden', !showCta);
    // plan_steps/faqs/cta_heading/cta_subheading/cta_button_text are now
    // in enforce_content_permission()'s linked-counselor allowlist too
    // (0054_linked_counselor_full_page_access.sql, 2026-09-16 client
    // decision — every real field except h1/meta_description/
    // focus_keyword is self-service), so this section is no longer
    // blanket-hidden for a linked-counselor session — it shows/hides
    // purely on whether the session's own page type has anything in it,
    // same as every other role. `concerns`/`featured_on_homepage`/
    // `homepage_feature_order`/`footer_column` were deliberately left out
    // of that allowlist — none of CONCERNS_PAGE_TYPES/
    // FEATURED_SERVICE_PAGE_TYPES ever include 'Counselor Profile', and a
    // linked-counselor session can only ever be on their own Counselor
    // Profile page (see the "linked counselor can update own page" RLS
    // policy), so those fields can never actually reach this session's
    // save payload regardless.
    //
    // For Homepage, plan_steps/cta_wrap are physically relocated into the
    // narrative flow above (see applyHomepageFieldOrder()) — they don't
    // count toward whether THIS section has anything left to show, or
    // Homepage would display an empty "Additional page elements" shell
    // with nothing actually in it.
    const detailsSectionHasContent = isHomepage
      ? showFaqs || showConcerns || showFeatured || showFooterColumn
      : showPlanSteps || showFaqs || showConcerns || showCta || showFeatured || showFooterColumn;
    contentPageDetailsSection.classList.toggle('hidden', !detailsSectionHasContent);
    planStepsEditor.setItems(selectedContentPage.plan_steps.map((s) => ({ a: s.title, b: s.description })));
    faqsEditor.setItems(selectedContentPage.faqs.map((f) => ({ a: f.question, b: f.answer })));
    concernsEditor.setItems(selectedContentPage.concerns.map((c) => ({ a: c.title, b: c.description })));
    contentCtaHeading.value = selectedContentPage.cta_heading ?? '';
    contentCtaSubheading.value = selectedContentPage.cta_subheading ?? '';
    contentCtaButtonText.value = selectedContentPage.cta_button_text ?? '';
    document.querySelector('[data-field="cta_subheading"] [data-locked-value]')!.textContent =
      selectedContentPage.cta_subheading || '(not set)';
    contentDetailsSaveStatus.textContent = '';

    contentSaveStatus.textContent = '';
    renderTierUI();
  }

  contentPageSelect.addEventListener('change', loadContentForm);

  contentHeroStyle.addEventListener('change', () => {
    contentHeroOverlayControls.style.display = contentHeroStyle.value === 'overlay' ? '' : 'none';
  });

  contentHeroOverlayOpacity.addEventListener('input', () => {
    contentHeroOverlayOpacityReadout.textContent = contentHeroOverlayOpacity.value;
  });

  contentFeaturedCheckbox.addEventListener('change', () => {
    contentFeaturedOrderWrap.classList.toggle('hidden', !contentFeaturedCheckbox.checked);
  });

  contentImageFile.addEventListener('change', async () => {
    const file = contentImageFile.files?.[0];
    if (!file) return;
    contentImageStatus.textContent = 'Uploading...';
    const path = `content/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;
    const { error } = await supabase.storage.from('site-images').upload(path, file);
    if (error) {
      contentImageStatus.textContent = 'Upload failed: ' + error.message;
      return;
    }
    const { data: urlData } = supabase.storage.from('site-images').getPublicUrl(path);
    uploadedImageUrl = urlData.publicUrl;
    // A direct upload has no Unsplash attribution — clear any credit left
    // over from a previous Unsplash selection.
    uploadedImageCreditName = null;
    uploadedImageCreditUrl = null;
    contentImagePreview.src = urlData.publicUrl;
    contentImagePreview.classList.remove('hidden');
    contentImageStatus.textContent = 'Image uploaded.';
  });

  // Modeled directly on contentImageFile's own handler above — uploads
  // to the site-videos bucket (0058_video_uploads_bucket.sql, 200MB/
  // MP4-MOV-WebM limits enforced server-side) and writes the resulting
  // public URL into the SAME input the external-link path uses, so
  // brandscript_video_url stays one field regardless of which way it
  // was populated.
  contentVideoFile.addEventListener('change', async () => {
    const file = contentVideoFile.files?.[0];
    if (!file) return;
    contentVideoStatus.textContent = 'Uploading...';
    const path = `content/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;
    const { error } = await supabase.storage.from('site-videos').upload(path, file);
    if (error) {
      contentVideoStatus.textContent = 'Upload failed: ' + error.message;
      return;
    }
    const { data: urlData } = supabase.storage.from('site-videos').getPublicUrl(path);
    contentBrandscriptVideoUrl.value = urlData.publicUrl;
    contentVideoStatus.textContent = 'Video uploaded.';
  });

  initUnsplashSearchModal({
    onSelect: (photo: UnsplashPhoto) => {
      uploadedImageUrl = photo.fullUrl;
      uploadedImageCreditName = photo.creditName || null;
      uploadedImageCreditUrl = photo.creditUrl || null;
      if (!contentImageAlt.value.trim()) contentImageAlt.value = photo.alt;
      contentImagePreview.src = photo.fullUrl;
      contentImagePreview.classList.remove('hidden');
      contentImageStatus.textContent = photo.creditName
        ? `Selected — photo by ${photo.creditName} on Unsplash.`
        : 'Selected.';
    },
  });

  contentSaveButton.addEventListener('click', async () => {
    if (!selectedContentPage || !canEditAnyField()) return;
    if (canEditField('images') && uploadedImageUrl && !contentImageAlt.value.trim()) {
      contentSaveStatus.textContent = 'Alt text is required for the hero image.';
      contentSaveStatus.className = 'text-sm text-red-600';
      return;
    }
    contentSaveStatus.textContent = 'Saving...';
    contentSaveStatus.className = 'text-sm text-slate-600';

    // Only ever send the fields this role is actually allowed to touch —
    // h1/meta_description/focus_keyword only for agency; hero_subhead/
    // copy/images for agency or a full-tier owner. Sending a locked field
    // would just be rejected by the enforce_content_permission trigger
    // anyway, but there's no reason to try.
    const payload: Record<string, unknown> = {};
    if (canEditField('h1')) payload.h1 = contentH1.value.trim();
    if (canEditField('meta_description')) payload.meta_description = contentMetaDescription.value.trim() || null;
    if (canEditField('focus_keyword')) payload.focus_keyword = contentFocusKeyword.value.trim() || null;
    if (canEditField('hero_subhead')) payload.hero_subhead = contentHeroSubhead.value.trim() || null;
    if (HERO_HEADLINE_PAGE_TYPES.includes(selectedContentPage.page_type) && canEditField('hero_headline')) {
      payload.hero_headline = contentHeroHeadline.value.trim() || null;
    }
    if (STORYBRAND_SPLIT_PAGE_TYPES.includes(selectedContentPage.page_type as never)) {
      if (canEditField('storybrand_problem')) payload.storybrand_problem = storybrandProblemEditor.getMarkdown();
      if (canEditField('storybrand_guide_empathy'))
        payload.storybrand_guide_empathy = storybrandGuideEmpathyEditor.getMarkdown();
      if (canEditField('storybrand_pitch')) payload.storybrand_pitch = storybrandPitchEditor.getMarkdown();
      if (canEditField('storybrand_pitch_label'))
        payload.storybrand_pitch_label = contentStorybrandPitchLabel.value.trim() || null;
      if (canEditField('storybrand_success')) payload.storybrand_success = storybrandSuccessEditor.getMarkdown();
      if (canEditField('storybrand_failure')) payload.storybrand_failure = storybrandFailureEditor.getMarkdown();
    } else if (canEditField('copy')) {
      payload.copy = copyEditor.getMarkdown();
    }
    // Fields shared by Homepage and Counselor Profile from the
    // StoryBrand rebuild — meaningless on any other page type, so only
    // ever sent for one of these two rows.
    if (selectedContentPage.page_type === 'Homepage' || selectedContentPage.page_type === 'Counselor Profile') {
      if (canEditField('value_add_items')) payload.value_add_items = valueAddEditor.getItems();
      if (canEditField('guide_authority_stats')) {
        payload.guide_authority_stats = authorityStatsEditor.getItems().map((item) => ({ label: item.a, value: item.b }));
      }
      if (canEditField('brandscript_one_liner')) payload.brandscript_one_liner = contentBrandscriptOneLiner.value.trim() || null;
      if (canEditField('brandscript_teaser')) payload.brandscript_teaser = contentBrandscriptTeaser.value.trim() || null;
      if (canEditField('brandscript_full')) payload.brandscript_full = brandscriptFullEditor.getMarkdown();
      if (canEditField('brandscript_video_url')) payload.brandscript_video_url = contentBrandscriptVideoUrl.value.trim() || null;
    }
    // The counselor's own quote — ungated, Counselor-Profile-only, no
    // canEditField() check (matches cta_heading's always-sent pattern).
    if (selectedContentPage.page_type === 'Counselor Profile') {
      payload.testimonial_quote = contentTestimonialQuote.value.trim() || null;
      payload.testimonial_author = contentTestimonialAuthor.value.trim() || null;
    }
    if (canEditField('images')) {
      payload.images = uploadedImageUrl
        ? {
            [imageKeyFor(selectedContentPage.page_type)]: {
              url: uploadedImageUrl,
              alt: contentImageAlt.value.trim(),
              ...(uploadedImageCreditName && uploadedImageCreditUrl
                ? { creditName: uploadedImageCreditName, creditUrl: uploadedImageCreditUrl }
                : {}),
            },
          }
        : {};
      // Hero layout lives in this same lock group — see the markup
      // comment on #content-hero-style-wrap for why it isn't a separate
      // tier gate. Hidden entirely (not just disabled) for a Counselor
      // Profile page, so nothing here overwrites a value that template
      // never reads anyway.
      if (selectedContentPage.page_type !== 'Counselor Profile') {
        payload.hero_image_focal_y = contentHeroFocalY.value;
        payload.hero_style = contentHeroStyle.value;
        payload.hero_overlay_color = contentHeroOverlayColor.value;
        payload.hero_overlay_opacity = Number(contentHeroOverlayOpacity.value);
      }
    }

    const { error } = await supabase.from('pages').update(payload).eq('id', selectedContentPage.id);
    if (error) {
      contentSaveStatus.textContent = 'Could not save: ' + error.message;
      contentSaveStatus.className = 'text-sm text-red-600';
      return;
    }
    Object.assign(selectedContentPage, payload);
    contentSaveStatus.textContent = 'Saving your site...';
    const result = await triggerRebuild();
    contentSaveStatus.textContent = result.ok
      ? 'Saved! Your site will update shortly.'
      : 'Saved, but the update trigger failed — it will go live on the next rebuild.';
    contentSaveStatus.className = result.ok ? 'text-sm text-emerald-700' : 'text-sm text-amber-700';
  });

  // Independent of contentSaveButton above — author_name/credentials/
  // date_modified aren't tier-locked (see enforce_content_permission),
  // so this stays editable and savable even for a restricted-tier owner
  // who can't touch h1/copy/images on the same page.
  contentBylineSaveButton.addEventListener('click', async () => {
    if (!selectedContentPage) return;
    contentBylineStatus.textContent = 'Saving...';
    contentBylineStatus.className = 'text-sm text-slate-600';
    const payload = {
      author_name: contentBylineName.value.trim() || null,
      credentials: contentBylineCredential.value.trim() || null,
      date_modified: contentBylineDate.value || null,
    };
    const { error } = await supabase.from('pages').update(payload).eq('id', selectedContentPage.id);
    if (error) {
      contentBylineStatus.textContent = 'Could not save: ' + error.message;
      contentBylineStatus.className = 'text-sm text-red-600';
      return;
    }
    Object.assign(selectedContentPage, payload);
    contentBylineStatus.textContent = 'Saving your site...';
    const result = await triggerRebuild();
    contentBylineStatus.textContent = result.ok
      ? 'Saved! Your site will update shortly.'
      : 'Saved, but the update trigger failed — it will go live on the next rebuild.';
    contentBylineStatus.className = result.ok ? 'text-sm text-emerald-700' : 'text-sm text-amber-700';
  });

  // Additional page elements — independent of contentSaveButton above,
  // same reasoning as the byline save button: plan_steps/faqs/concerns/
  // cta_heading/cta_button_text aren't tier-locked (see
  // enforce_content_permission), so this stays editable and savable even
  // for a restricted-tier owner who can't touch the copy fields above.
  // Only sends the fields actually visible for this page's type, so a
  // hidden field's stale value can't accidentally overwrite real data.
  contentDetailsSaveButton.addEventListener('click', async () => {
    if (!selectedContentPage) return;
    contentDetailsSaveStatus.textContent = 'Saving...';
    contentDetailsSaveStatus.className = 'text-sm text-slate-600';

    const payload: Record<string, unknown> = {};
    if (PLAN_STEPS_PAGE_TYPES.includes(selectedContentPage.page_type)) {
      payload.plan_steps = planStepsEditor.getItems().map((item) => ({ title: item.a, description: item.b }));
    }
    if (FAQS_PAGE_TYPES.includes(selectedContentPage.page_type)) {
      payload.faqs = faqsEditor.getItems().map((item) => ({ question: item.a, answer: item.b }));
    }
    if (CONCERNS_PAGE_TYPES.includes(selectedContentPage.page_type)) {
      payload.concerns = concernsEditor.getItems().map((item) => ({ title: item.a, description: item.b }));
    }
    if (CTA_PAGE_TYPES.includes(selectedContentPage.page_type)) {
      payload.cta_heading = contentCtaHeading.value.trim() || null;
      // Unlike cta_heading/cta_button_text (always sent — ungated for
      // everyone), cta_subheading is only sent when this session can
      // actually edit it, so a locked-out linked-counselor save can't
      // even attempt to touch it — the trigger would reject it anyway,
      // but this keeps the UI's own behavior honest about what it's
      // about to do.
      if (canEditField('cta_subheading')) {
        payload.cta_subheading = contentCtaSubheading.value.trim() || null;
      }
      payload.cta_button_text = contentCtaButtonText.value.trim() || null;
    }
    if (FEATURED_SERVICE_PAGE_TYPES.includes(selectedContentPage.page_type)) {
      payload.featured_on_homepage = contentFeaturedCheckbox.checked;
      payload.homepage_feature_order = contentFeaturedCheckbox.checked && contentFeaturedOrder.value
        ? Number(contentFeaturedOrder.value)
        : null;
    }
    if (selectedContentPage.nav_placement === 'footer') {
      payload.footer_column = contentFooterColumn.value;
    }

    const { error } = await supabase.from('pages').update(payload).eq('id', selectedContentPage.id);
    if (error) {
      contentDetailsSaveStatus.textContent = 'Could not save: ' + error.message;
      contentDetailsSaveStatus.className = 'text-sm text-red-600';
      return;
    }
    Object.assign(selectedContentPage, payload);
    contentDetailsSaveStatus.textContent = 'Saving your site...';
    const detailsResult = await triggerRebuild();
    contentDetailsSaveStatus.textContent = detailsResult.ok
      ? 'Saved! Your site will update shortly.'
      : 'Saved, but the update trigger failed — it will go live on the next rebuild.';
    contentDetailsSaveStatus.className = detailsResult.ok ? 'text-sm text-emerald-700' : 'text-sm text-amber-700';
  });

  // ---------------------------------------------------------------------
  // Your suggestions — a client-facing status list of what they've
  // submitted (owner only; agency has the dedicated Suggestions review
  // screen instead). Shows the agency's reviewer_note, most important on
  // a rejection so the client knows why.
  // ---------------------------------------------------------------------
  const FIELD_LABELS: Record<string, string> = {
    h1: 'Page heading (H1)',
    meta_description: 'Meta description',
    focus_keyword: 'Focus keyword',
    hero_subhead: 'Hero subheading',
    hero_headline: 'Headline (H1)',
    copy: 'Page copy',
    storybrand_problem: 'The Problem',
    storybrand_guide_empathy: 'We Understand',
    storybrand_pitch: 'The Full Picture',
    storybrand_pitch_label: '"The Full Picture" link text',
    storybrand_success: "What's Possible",
    storybrand_failure: "Why It's Worth Acting Now",
    value_add_items: 'Value Add strip',
    guide_authority_stats: 'Guide — Authority',
    brandscript_one_liner: 'Explanatory Paragraph one-liner',
    brandscript_teaser: 'Explanatory Paragraph teaser',
    brandscript_full: 'Full BrandScript',
    brandscript_video_url: 'Explanatory Paragraph video',
    images: 'Hero image',
  };

  type ContentSuggestion = {
    id: string;
    page_id: string;
    field_name: string;
    suggested_value: string;
    status: 'pending' | 'approved' | 'rejected';
    reviewer_note: string | null;
    created_at: string;
  };

  const yourSuggestionsSection = document.getElementById('your-suggestions-section')!;
  const yourSuggestionsList = document.getElementById('your-suggestions-list')!;

  const STATUS_BADGE: Record<ContentSuggestion['status'], string> = {
    pending: '<span class="text-amber-700">Pending</span>',
    approved: '<span class="text-emerald-700">Approved</span>',
    rejected: '<span class="text-red-600">Rejected</span>',
  };

  async function loadYourSuggestions() {
    if (!currentUserId) return;
    const { data, error } = await supabase
      .from('content_suggestions')
      .select('*')
      .eq('submitted_by', currentUserId)
      .order('created_at', { ascending: false });
    if (error || !data || data.length === 0) {
      yourSuggestionsSection.classList.add('hidden');
      return;
    }
    yourSuggestionsSection.classList.remove('hidden');
    const suggestions = data as ContentSuggestion[];
    yourSuggestionsList.innerHTML = suggestions
      .map((s) => {
        const page = pages.find((p) => p.id === s.page_id);
        const fieldLabel = FIELD_LABELS[s.field_name] ?? s.field_name;
        const date = new Date(s.created_at).toLocaleDateString();
        return `
      <div class="rounded-md border border-slate-200 bg-white px-4 py-3 text-sm">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-slate-700">${escapeHtml(page?.title ?? 'Page')} — ${escapeHtml(fieldLabel)}</span>
          ${STATUS_BADGE[s.status]}
        </div>
        <p class="mt-1 text-slate-600">"${escapeHtml(s.suggested_value)}"</p>
        <p class="mt-1 text-xs text-slate-400">Submitted ${date}</p>
        ${
          s.reviewer_note
            ? `<p class="mt-2 rounded-md bg-slate-50 px-3 py-2 text-xs text-slate-600"><span class="font-semibold">Note: </span>${escapeHtml(s.reviewer_note)}</p>`
            : ''
        }
      </div>`;
      })
      .join('');
  }

  // ---------------------------------------------------------------------
  async function onAuthed(adminUser: AdminUser) {
    currentAdminUser = adminUser;
    const [{ data: userData }, { data: businessData }] = await Promise.all([
      supabase.auth.getUser(),
      supabase.from('business').select('id, content_permission_level').single(),
    ]);
    currentUserId = userData.user?.id ?? null;
    business = businessData as Business;

    // A linked-counselor staff session only ever sees their own page —
    // no picker, and the page itself is fetched scoped to just that one
    // row rather than the full site-wide list owner/agency get. This is
    // UI-layer convenience, not the real boundary: enforce_content_
    // permission() and the "linked counselor can update own page" RLS
    // policy both hold regardless of what this screen chooses to show.
    if (adminUser.role === 'staff') {
      if (!adminUser.linked_counselor_page_id) {
        contentNotLinkedNotice.classList.remove('hidden');
        return;
      }
      const { data: pageData } = await supabase
        .from('pages')
        .select('*')
        .eq('id', adminUser.linked_counselor_page_id)
        .maybeSingle();
      if (!pageData) {
        contentNotLinkedNotice.classList.remove('hidden');
        return;
      }
      pages = [pageData as ContentPage];
      contentPageSelectWrap.classList.add('hidden');
      contentPageSelect.innerHTML = `<option value="${pageData.id}">${escapeHtml(pageData.title)}</option>`;
      loadContentForm();
      wireSuggestButtons();
      await loadYourSuggestions();
      return;
    }

    const { data: pagesData } = await supabase
      .from('pages')
      .select('*')
      .not('page_type', 'in', '("Blog Post","Blog Index")')
      .order('title');
    pages = (pagesData ?? []) as ContentPage[];

    populatePagePicker(contentPageSelect);
    loadContentForm();
    wireSuggestButtons();
    if (adminUser.role === 'owner') {
      await loadYourSuggestions();
    }
  }

  initAdminAuth(onAuthed, { allowedRoles: ['owner', 'agency', 'staff'] });
</script>
