---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import RichTextEditor from '../../../components/RichTextEditor.astro';
import LockedField from '../../../components/LockedField.astro';
import SuggestEdit from '../../../components/SuggestEdit.astro';
import UnsplashSearchModal from '../../../components/UnsplashSearchModal.astro';
---

<AdminLayout title="Page copy | Admin" current="content-page-copy">
  <div class="max-w-2xl space-y-12">
    <section>
      <p id="content-tier-note" class="mb-4 text-sm text-slate-600"></p>

      <div id="content-not-linked-notice" class="hidden mb-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        Your login isn't linked to a counselor page yet — ask the site owner to link one from the Team page.
      </div>

      <div class="space-y-4">
        <div id="content-page-select-wrap">
          <label class="mb-1 block text-sm font-semibold text-slate-700">Page</label>
          <select id="content-page-select" class="w-full rounded-md border border-slate-300 px-4 py-2"></select>
        </div>

        <div id="content-fields" class="hidden space-y-6">
          <!--
            Hidden entirely for Counselor Profile pages — that page type
            never reads page.h1 at all (CounselorProfile.astro's real
            <h1> comes from hero_headline ?? title instead; see the
            "Headline (H1)" field below). Showing a locked, empty field
            labeled "H1" that has zero effect on the actual page was
            real, confirmed confusion for a linked-counselor session —
            same "hide what genuinely doesn't apply" discipline already
            used for #content-hero-style-wrap on this page.
          -->
          <!--
            Keyword + meta description come first, before H1 — fixed
            across every page type (2026-09-16, client request): these
            are the research/metadata that should inform the H1 you
            write, not an afterthought below it.
          -->
          <LockedField fieldKey="focus_keyword" label="Focus keyword" inputId="content-focus-keyword" />
          <LockedField
            fieldKey="meta_description"
            label="Meta description"
            inputId="content-meta-description"
            inputType="textarea"
          />
          <div id="content-h1-wrap">
            <LockedField fieldKey="h1" label="Page heading (H1)" inputId="content-h1" />
          </div>

          <div id="content-hero-headline-wrap" class="hidden" data-field="hero_headline">
            <label class="mb-1 block text-sm font-semibold text-slate-700">Headline (H1)</label>
            <input id="content-hero-headline" type="text" class="editable-view w-full rounded-md border border-slate-300 px-4 py-2" />
            <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
            <p class="mt-1 text-xs text-slate-500">
              A persuasive tagline shown as the main heading on your page (e.g. "Helping boys and men reclaim peace,
              clarity, and purpose."). Your name still shows separately in the header card either way. Leave blank
              to show your name as the heading instead.
            </p>
            <p class="tier-note mt-1 text-xs text-slate-500">
              Included as an agency-managed field on your plan — suggest a change below.
            </p>
            <SuggestEdit fieldLabel="Headline (H1)" />
          </div>

          <div id="content-hero-subhead-wrap" data-field="hero_subhead">
            <label class="mb-1 block text-sm font-semibold text-slate-700">Hero subheading</label>
            <input id="content-hero-subhead" type="text" class="editable-view w-full rounded-md border border-slate-300 px-4 py-2" />
            <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
            <p class="tier-note mt-1 text-xs text-slate-500">
              Included as an agency-managed field on your plan — suggest a change below.
            </p>
            <SuggestEdit fieldLabel="Hero subheading" />
          </div>

          <div id="content-plain-copy-wrap" data-field="copy">
            <label class="mb-1 block text-sm font-semibold text-slate-700">Page copy</label>
            <div class="editable-view">
              <RichTextEditor id="content-copy-editor" />
            </div>
            <div class="locked-view prose prose-sm max-w-none rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" data-locked-value-html>
            </div>
            <p class="tier-note mt-1 text-xs text-slate-500">
              Included as an agency-managed field on your plan — suggest a change below.
            </p>
            <SuggestEdit fieldLabel="Page copy" />
          </div>

          <!--
            StoryBrand section-by-section copy — shown instead of the plain
            "Page copy" box above, only for Homepage/Service Page/Counselor
            Profile (see STORYBRAND_SPLIT_PAGE_TYPES in lib/pages.ts). These
            3 page types are short/compact enough that the whole page is
            basically one pass through the StoryBrand arc, so breaking the
            narrative into its own labeled box per section keeps a client
            from having to hunt through one long text field to change just
            one part. Content Pillar and Service Hub deliberately keep the
            single "Page copy" box above instead — both are long-form,
            TOC-organized informational content where forcing this same
            5-part split would fight the page's actual job. See CLAUDE.md's
            "StoryBrand section-by-section copy editing" section.
          -->
          <div id="content-storybrand-fields" class="hidden space-y-6">
            <p class="text-xs text-slate-500">
              This page is broken into StoryBrand sections instead of one big text box, so it's easy to update just
              the part that needs changing. Most pages read best when every section below has at least a short
              paragraph, but it's fine to leave one blank if it genuinely doesn't apply.
            </p>

            <!--
              Counselor-facing writing guidance — shown only for a
              linked-counselor staff session (see isLinkedCounselorSession()
              below), never for owner/agency, who have their own SEO
              strategist handling this. Translates keyword-usage-rules.md's
              guidance (no fixed repetition count, natural placement, and
              the schema-alignment rule) into something a non-copywriter can
              actually act on — the entity-term line is read straight from
              getPersonEntityTerms() (src/lib/schema.ts), the same function
              buildPersonSchema() itself uses, so this can't silently drift
              from what the page's real schema markup says. See CLAUDE.md's
              "getPersonEntityTerms()" section for the full reasoning.
            -->
            <div id="content-counselor-guidance" class="hidden space-y-2 rounded-md border border-brand-tint bg-brand-neutral p-4">
              <h4 class="text-sm font-semibold text-brand-ink">Writing tips for your bio</h4>
              <p id="content-counselor-keyword-tip" class="text-sm text-slate-700"></p>
              <p id="content-counselor-entity-tip" class="text-sm text-slate-700"></p>
              <p id="content-counselor-keyword-count" class="text-xs text-slate-500"></p>
            </div>

            <!--
              Homepage-only additions from the StoryBrand rebuild — see
              CLAUDE.md's "Homepage StoryBrand rebuild" section. Hidden
              entirely (via #content-value-add-wrap/#content-authority-
              stats-wrap/#content-explanatory-wrap's own toggles in
              loadContentForm()) for Service Page/Counselor Profile,
              which don't render these sections.
            -->
            <div id="content-value-add-wrap" data-field="value_add_items" class="hidden space-y-2">
              <label class="mb-1 block text-sm font-semibold text-slate-700">Value Add strip</label>
              <p class="mb-2 text-xs text-slate-500">
                2–4 short icon+label items shown right under the Hero (e.g. "Faith-Integrated Care," "Licensed
                Experts"). Pick an icon and a short label for each.
              </p>
              <div id="content-value-add-list" class="editable-view space-y-2"></div>
              <button
                type="button"
                id="content-value-add-add"
                class="editable-view rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
              >
                + Add an item
              </button>
              <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
              <p class="tier-note mt-1 text-xs text-slate-500">
                Included as an agency-managed field on your plan — suggest a change below.
              </p>
              <SuggestEdit fieldLabel="Value Add strip" />
            </div>

            <!--
              The counselor's own quote — Counselor-Profile-only (2026-
              09-16), shown/hidden directly in loadContentForm() rather
              than via *_PAGE_TYPES like the ungated "Additional page
              elements" fields, since it lives inside this StoryBrand
              container, not that section. Ungated on purpose — no
              data-field/locked-view/SuggestEdit — testimonial_quote/
              testimonial_author are never tier-gated for owner/agency
              either (see business-info.astro's Testimonials editor).
            -->
            <div id="content-testimonial-wrap" class="hidden space-y-2">
              <label class="mb-1 block text-sm font-semibold text-slate-700">Your quote</label>
              <p class="mb-2 text-xs text-slate-500">
                A short, personal line shown near the top of your page — your own words about how you work, not a
                client testimonial. This component adds its own decorative quote mark, so don't type literal quote
                characters around it.
              </p>
              <textarea
                id="content-testimonial-quote"
                rows="2"
                placeholder="You don't have to have it figured out before you walk in..."
                class="w-full rounded-md border border-slate-300 px-4 py-2 text-sm"
              ></textarea>
              <input
                id="content-testimonial-author"
                type="text"
                placeholder="Your name, as it should appear under the quote"
                class="mt-2 w-full rounded-md border border-slate-300 px-4 py-2 text-sm"
              />
            </div>

            <div id="content-storybrand-problem-wrap" data-field="storybrand_problem">
              <label id="content-storybrand-problem-field-label" class="mb-1 block text-sm font-semibold text-slate-700">The Problem</label>
              <div class="editable-view">
                <RichTextEditor
                  id="content-storybrand-problem-editor"
                  helpText={`StoryBrand's "Problem" section. Describe the problem your visitor is facing when they land on this page — go beyond the surface issue to how it makes them feel and why it feels unfair. The goal: a visitor reads this and thinks, "they understand exactly what I'm going through."`}
                />
              </div>
              <div class="locked-view prose prose-sm max-w-none rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" data-locked-value-html>
              </div>
              <p class="tier-note mt-1 text-xs text-slate-500">
                Included as an agency-managed field on your plan — suggest a change below.
              </p>
              <SuggestEdit fieldLabel="The Problem" />
            </div>

            <div id="content-storybrand-guide-empathy-wrap" data-field="storybrand_guide_empathy">
              <label class="mb-1 block text-sm font-semibold text-slate-700">We Understand</label>
              <div class="editable-view">
                <RichTextEditor
                  id="content-storybrand-guide-empathy-editor"
                  helpText={`StoryBrand's "Guide — Empathy" section. Show that you truly understand what your visitor is going through, before you ever mention what you offer. This is where trust starts to build — proving you "get it," not listing credentials yet (that comes through your testimonials and results elsewhere on the page).`}
                />
              </div>
              <div class="locked-view prose prose-sm max-w-none rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" data-locked-value-html>
              </div>
              <p class="tier-note mt-1 text-xs text-slate-500">
                Included as an agency-managed field on your plan — suggest a change below.
              </p>
              <SuggestEdit fieldLabel="We Understand" />
            </div>

            <div id="content-authority-stats-wrap" data-field="guide_authority_stats" class="hidden space-y-2">
              <label class="mb-1 block text-sm font-semibold text-slate-700">Guide — Authority</label>
              <p class="mb-2 text-xs text-slate-500">
                Short, scannable credibility facts shown next to your empathy statement (e.g. "Experience" / "15+
                years", "Credentials" / "LPCA, LCSW"). Optional — leave empty to skip this.
              </p>
              <div id="content-authority-stats-list" class="editable-view space-y-2"></div>
              <button
                type="button"
                id="content-authority-stats-add"
                class="editable-view rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
              >
                + Add a fact
              </button>
              <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
              <p class="tier-note mt-1 text-xs text-slate-500">
                Included as an agency-managed field on your plan — suggest a change below.
              </p>
              <SuggestEdit fieldLabel="Guide — Authority" />
            </div>

            <div id="content-storybrand-pitch-wrap" data-field="storybrand_pitch">
              <label id="content-storybrand-pitch-field-label" class="mb-1 block text-sm font-semibold text-slate-700">The Full Picture</label>
              <div class="editable-view">
                <RichTextEditor
                  id="content-storybrand-pitch-editor"
                  helpText={`StoryBrand's fuller explanation. For visitors who want more detail before deciding — explain your approach and why it's the right next step. Write like you're personally reassuring someone who still has questions.`}
                />
              </div>
              <div class="locked-view prose prose-sm max-w-none rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" data-locked-value-html>
              </div>
              <p class="tier-note mt-1 text-xs text-slate-500">
                Included as an agency-managed field on your plan — suggest a change below.
              </p>
              <SuggestEdit fieldLabel="The Full Picture" />
            </div>

            <div id="content-storybrand-pitch-label-wrap" data-field="storybrand_pitch_label">
              <label id="content-storybrand-pitch-label-field-label" class="mb-1 block text-sm font-semibold text-slate-700">"The Full Picture" link text</label>
              <input
                id="content-storybrand-pitch-label"
                type="text"
                placeholder="Learn more about our approach"
                class="editable-view w-full rounded-md border border-slate-300 px-4 py-2"
              />
              <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
              <p id="content-storybrand-pitch-label-help" class="mt-1 text-xs text-slate-500">
                Shown as a heading visitors click to expand "The Full Picture" above. Leave blank to use the default,
                "Learn more about our approach."
              </p>
              <p class="tier-note mt-1 text-xs text-slate-500">
                Included as an agency-managed field on your plan — suggest a change below.
              </p>
              <SuggestEdit fieldLabel="&quot;The Full Picture&quot; link text" />
            </div>

            <div id="content-storybrand-success-wrap" data-field="storybrand_success">
              <label class="mb-1 block text-sm font-semibold text-slate-700">What's Possible</label>
              <div class="editable-view">
                <RichTextEditor
                  id="content-storybrand-success-editor"
                  helpText={`StoryBrand's "Success" section. Paint a specific, hopeful picture of what life looks like once this problem is solved. Be concrete — a real, specific picture lands better than vague optimism.`}
                />
              </div>
              <div class="locked-view prose prose-sm max-w-none rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" data-locked-value-html>
              </div>
              <p class="tier-note mt-1 text-xs text-slate-500">
                Included as an agency-managed field on your plan — suggest a change below.
              </p>
              <SuggestEdit fieldLabel="What's Possible" />
            </div>

            <div id="content-storybrand-failure-wrap" data-field="storybrand_failure">
              <label class="mb-1 block text-sm font-semibold text-slate-700">Why It's Worth Acting Now</label>
              <div class="editable-view">
                <RichTextEditor
                  id="content-storybrand-failure-editor"
                  helpText={`StoryBrand's "Failure" section. A brief, honest reminder of what it costs to keep putting this off. Keep it factual and caring, not fear-mongering — and keep it short, since your call-to-action follows right after this.`}
                />
              </div>
              <div class="locked-view prose prose-sm max-w-none rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" data-locked-value-html>
              </div>
              <p class="tier-note mt-1 text-xs text-slate-500">
                Included as an agency-managed field on your plan — suggest a change below.
              </p>
              <SuggestEdit fieldLabel="Why It's Worth Acting Now" />
            </div>

            <div id="content-explanatory-wrap" class="hidden space-y-6 border-t border-slate-200 pt-6">
              <div>
                <h3 class="text-sm font-semibold text-slate-700">Explanatory Paragraph</h3>
                <p class="mt-1 text-xs text-slate-500">
                  A genuinely separate, freestanding full BrandScript — not one of the short sections above. Visitors
                  see a one-line heading and a short teaser; "Continue reading" expands the full text. This is where
                  most of your SEO content lives.
                </p>
              </div>

              <div data-field="brandscript_one_liner">
                <label class="mb-1 block text-sm font-semibold text-slate-700">One-liner</label>
                <input id="content-brandscript-one-liner" type="text" class="editable-view w-full rounded-md border border-slate-300 px-4 py-2" />
                <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
                <p class="tier-note mt-1 text-xs text-slate-500">
                  Included as an agency-managed field on your plan — suggest a change below.
                </p>
                <SuggestEdit fieldLabel="Explanatory Paragraph one-liner" />
              </div>

              <div data-field="brandscript_teaser">
                <label class="mb-1 block text-sm font-semibold text-slate-700">Teaser</label>
                <textarea id="content-brandscript-teaser" rows="2" class="editable-view w-full rounded-md border border-slate-300 px-4 py-2"></textarea>
                <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
                <p class="tier-note mt-1 text-xs text-slate-500">
                  Included as an agency-managed field on your plan — suggest a change below.
                </p>
                <SuggestEdit fieldLabel="Explanatory Paragraph teaser" />
              </div>

              <div data-field="brandscript_full">
                <label class="mb-1 block text-sm font-semibold text-slate-700">Full BrandScript</label>
                <div class="editable-view">
                  <RichTextEditor
                    id="content-brandscript-full-editor"
                    helpText="The complete, long-form BrandScript — paste the whole thing in. This is only revealed when a visitor clicks 'Continue reading,' so it's the right place for the fuller SEO-oriented version of your story."
                  />
                </div>
                <div class="locked-view prose prose-sm max-w-none rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" data-locked-value-html>
                </div>
                <p class="tier-note mt-1 text-xs text-slate-500">
                  Included as an agency-managed field on your plan — suggest a change below.
                </p>
                <SuggestEdit fieldLabel="Full BrandScript" />
              </div>

              <div data-field="brandscript_video_url">
                <label class="mb-1 block text-sm font-semibold text-slate-700">Video (optional)</label>
                <div class="editable-view space-y-2">
                  <input
                    id="content-brandscript-video-url"
                    type="url"
                    placeholder="https://www.youtube.com/watch?v=..."
                    class="w-full rounded-md border border-slate-300 px-4 py-2"
                  />
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs text-slate-400">or upload a file</span>
                    <label
                      for="content-video-file"
                      class="inline-block cursor-pointer rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                    >
                      Choose File
                    </label>
                    <input id="content-video-file" type="file" accept="video/mp4,video/quicktime,video/webm" class="sr-only" />
                  </div>
                  <p id="content-video-status" class="text-xs text-slate-500"></p>
                </div>
                <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
                <p class="mt-1 text-xs text-slate-500">
                  A YouTube/Vimeo link, or upload a video file directly (200MB max, MP4/MOV/WebM). Leave blank to skip
                  the video.
                </p>
                <p class="tier-note mt-1 text-xs text-slate-500">
                  Included as an agency-managed field on your plan — suggest a change below.
                </p>
                <SuggestEdit fieldLabel="Explanatory Paragraph video" />
              </div>
            </div>
          </div>

          <div id="content-images-wrap" data-field="images">
            <label class="mb-1 block text-sm font-semibold text-slate-700">Hero image</label>
            <div class="editable-view space-y-2">
              <div class="flex flex-wrap items-center gap-2">
                <button
                  id="search-unsplash-button"
                  type="button"
                  class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                >
                  Search Unsplash
                </button>
                <span class="text-xs text-slate-400">or</span>
                <label
                  for="content-image-file"
                  class="inline-block cursor-pointer rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                >
                  Choose File
                </label>
                <input id="content-image-file" type="file" accept="image/*" class="sr-only" />
              </div>
              <p id="content-image-status" class="text-xs text-slate-500"></p>
              <img id="content-image-preview" class="hidden h-32 w-auto rounded-md border border-slate-200 object-cover" />
              <input
                id="content-image-alt"
                type="text"
                placeholder="Describe what's in the photo"
                class="w-full rounded-md border border-slate-300 px-4 py-2 text-sm"
              />
            </div>
            <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
            <p class="tier-note mt-1 text-xs text-slate-500">
              Included as an agency-managed field on your plan — suggest a change below.
            </p>
            <SuggestEdit fieldLabel="Hero image" />

            <!--
              Hero layout + focal point — never shown for a 'Counselor
              Profile' page, which doesn't use Hero.astro at all (see
              CounselorProfile.astro's own header card). Lives inside this
              same [data-field="images"] container so it shares its
              editable/locked tier-gating rather than needing a second
              lock group for something this closely tied to the hero
              image itself.
            -->
            <div id="content-hero-style-wrap" class="mt-4 space-y-3 border-t border-slate-100 pt-4">
              <div class="editable-view space-y-3">
                <div>
                  <label class="mb-1 block text-sm font-semibold text-slate-700">Image focal point</label>
                  <select id="content-hero-focal-y" class="w-full rounded-md border border-slate-300 px-4 py-2 text-sm">
                    <option value="top">Keep the top of the photo visible</option>
                    <option value="center">Center (default)</option>
                    <option value="bottom">Keep the bottom of the photo visible</option>
                  </select>
                  <p class="mt-1 text-xs text-slate-500">
                    If the subject in your photo is getting cropped out, use this to tell it which part of the
                    photo matters most — e.g. choose "bottom" if the subject sits low in the frame with empty
                    space above it.
                  </p>
                </div>
                <div>
                  <label class="mb-1 block text-sm font-semibold text-slate-700">Hero layout</label>
                  <select id="content-hero-style" class="w-full rounded-md border border-slate-300 px-4 py-2 text-sm">
                    <option value="default">Default — image beside text</option>
                    <option value="overlay">Full-width image with color overlay</option>
                  </select>
                </div>
                <!--
                  Deliberately inline `style.display`, not a classList
                  toggle — this div also carries no `editable-view`/
                  `locked-view` class of its own, specifically so
                  renderTierUI()'s indiscriminate `.editable-view` un-hide
                  (see below) can't fight this select-value-driven
                  show/hide over the same `hidden` class. Same fix as the
                  documented Tailwind `hidden`/`md:flex` bug elsewhere in
                  this app: two independent visibility concerns on one
                  element need two independent mechanisms.
                -->
                <div id="content-hero-overlay-controls" class="space-y-3 rounded-md bg-slate-50 p-3" style="display: none;">
                  <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-700">Overlay color</label>
                    <input id="content-hero-overlay-color" type="color" class="h-10 w-16 rounded border border-slate-300" />
                  </div>
                  <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-700">
                      Overlay opacity — <span id="content-hero-overlay-opacity-readout">50</span>%
                    </label>
                    <input
                      id="content-hero-overlay-opacity"
                      type="range"
                      min="0"
                      max="100"
                      class="w-full"
                    />
                    <p class="mt-1 text-xs text-slate-500">
                      Darkens or lightens the image behind your heading so it stays easy to read no matter what photo you pick.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <button
            id="content-save-button"
            type="button"
            class="save-only-when-full rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
          >
            Save
          </button>
          <p id="content-save-status" class="text-sm" role="status"></p>

          <!--
            Additional page elements — plan_steps/faqs/concerns/cta_heading/
            cta_button_text all already existed as real columns the public
            templates render, but none were ever editable from any admin
            screen before this. Not tier-gated (enforce_content_permission
            doesn't cover these columns — same "safe on every tier" category
            as Testimonials on the Business info page), so this gets its own
            always-on save button rather than folding into
            content-save-button's tier-gated visibility. Each sub-block is
            shown only for the page types whose template actually reads that
            field — see the PLAN_STEPS/FAQS/CONCERNS/CTA _PAGE_TYPES consts
            below, sourced directly from grepping every template file for
            these column names, not guessed from the docs.
          -->
          <div id="content-page-details-section" class="hidden space-y-6 border-t border-slate-200 pt-6">
            <h3 class="text-sm font-semibold text-slate-700">Additional page elements</h3>
            <p class="text-xs text-slate-500">
              These are separate from the plan tiers above — always editable, on every plan.
            </p>

            <div id="content-plan-steps-wrap" class="hidden space-y-2">
              <label class="mb-1 block text-sm font-semibold text-slate-700">Plan steps</label>
              <p class="mb-2 text-xs text-slate-500">
                The 3–4 simple steps a visitor takes to work with you (e.g. "Book a free call," "Meet your
                counselor," "Start your first session"). Rendered as a numbered list on the page — leave this empty
                and it just won't show.
              </p>
              <div id="content-plan-steps-list" class="space-y-2"></div>
              <button
                type="button"
                id="content-plan-steps-add"
                class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
              >
                + Add a step
              </button>
            </div>

            <div id="content-faqs-wrap" class="hidden space-y-2">
              <label class="mb-1 block text-sm font-semibold text-slate-700">FAQs</label>
              <p class="mb-2 text-xs text-slate-500">
                Real questions a visitor would actually ask about this page's topic, with honest answers. Never add a
                question just to have one — this also feeds this page's FAQ markup for Google, so it needs to match
                what's genuinely on the page.
              </p>
              <div id="content-faqs-list" class="space-y-2"></div>
              <button
                type="button"
                id="content-faqs-add"
                class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
              >
                + Add a question
              </button>
            </div>

            <div id="content-concerns-wrap" class="hidden space-y-2">
              <label class="mb-1 block text-sm font-semibold text-slate-700">Benefits list</label>
              <p class="mb-2 text-xs text-slate-500">
                A short, unordered set of benefits or things you help with (e.g. "Flexible scheduling," "Telehealth
                available"). Rendered as a simple grid — not a numbered sequence like Plan steps, since these aren't
                meant to be followed in order.
              </p>
              <div id="content-concerns-list" class="space-y-2"></div>
              <button
                type="button"
                id="content-concerns-add"
                class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
              >
                + Add a benefit
              </button>
            </div>

            <div id="content-cta-wrap" class="hidden space-y-3">
              <div>
                <label class="mb-1 block text-sm font-semibold text-slate-700">Call-to-action heading</label>
                <input
                  id="content-cta-heading"
                  type="text"
                  placeholder="Ready to get started?"
                  class="w-full rounded-md border border-slate-300 px-4 py-2 text-sm"
                />
              </div>
              <!--
                Unlike cta_heading/cta_button_text (always editable, on
                every plan, for everyone), this one field is locked
                specifically — and only — for a linked-counselor session
                (client decision, 2026-09-16: the agency writes this one,
                counselors may suggest a change). See canEditField()'s
                explicit 'cta_subheading' case and
                0055_lock_cta_subheading_for_counselors.sql.
              -->
              <div data-field="cta_subheading">
                <label class="mb-1 block text-sm font-semibold text-slate-700">Call-to-action subheading (optional)</label>
                <textarea
                  id="content-cta-subheading"
                  rows="2"
                  placeholder="A short line reinforcing why now is worth acting on."
                  class="editable-view w-full rounded-md border border-slate-300 px-4 py-2 text-sm"
                ></textarea>
                <p class="locked-view rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700" data-locked-value></p>
                <p class="mt-1 text-xs text-slate-500">
                  Shown between the heading and the button — a good place to briefly reiterate why it's worth
                  reaching out now.
                </p>
                <p class="tier-note mt-1 text-xs text-slate-500">Managed by your agency — suggest a change below.</p>
                <SuggestEdit fieldLabel="Call-to-action subheading" />
              </div>
              <div>
                <label class="mb-1 block text-sm font-semibold text-slate-700">Call-to-action button text</label>
                <input
                  id="content-cta-button-text"
                  type="text"
                  placeholder="Get Started"
                  class="w-full rounded-md border border-slate-300 px-4 py-2 text-sm"
                />
              </div>
            </div>

            <div id="content-featured-wrap" class="hidden space-y-2">
              <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                <input id="content-featured-checkbox" type="checkbox" class="h-4 w-4 rounded border-slate-300" />
                Feature this service on the homepage
              </label>
              <p class="text-xs text-slate-500">
                Shown as one of the Homepage's up to 3 Featured Services cards.
              </p>
              <div id="content-featured-order-wrap" class="hidden">
                <label class="mb-1 block text-sm font-semibold text-slate-700">Display order</label>
                <input
                  id="content-featured-order"
                  type="number"
                  min="1"
                  class="w-24 rounded-md border border-slate-300 px-3 py-2 text-sm"
                />
                <p class="mt-1 text-xs text-slate-500">Lower numbers show first. Only the first 3 (by this order) appear.</p>
              </div>
            </div>

            <div id="content-footer-column-wrap" class="hidden">
              <label class="mb-1 block text-sm font-semibold text-slate-700">Footer column</label>
              <select id="content-footer-column" class="w-full rounded-md border border-slate-300 px-4 py-2 text-sm sm:w-64">
                <option value="explore">Explore</option>
                <option value="company">Company</option>
                <option value="legal">Legal</option>
              </select>
              <p class="mt-1 text-xs text-slate-500">Which of the footer's 3 columns this page's link shows in.</p>
            </div>

            <button
              id="content-details-save-button"
              type="button"
              class="rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
            >
              Save
            </button>
            <p id="content-details-save-status" class="text-sm" role="status"></p>
          </div>

          <!--
            Reviewer byline — pillar/hub pages only ("Content Pillar" and
            "Service Hub" page types; see BYLINE_PAGE_TYPES below). Not
            tier-gated like the fields above: author_name/credentials/
            date_modified aren't locked by enforce_content_permission, so
            this gets its own always-on save button rather than being
            folded into content-save-button's tier-gated visibility.
          -->
          <div id="content-byline-section" class="hidden space-y-3 border-t border-slate-200 pt-6">
            <h3 class="text-sm font-semibold text-slate-700">Reviewed-by byline</h3>
            <p class="text-xs text-slate-500">
              Shown on the page as "Reviewed by [name], [credential] — Updated [date]" and included in this page's
              schema markup. Leave the name blank to hide the byline entirely.
            </p>
            <div>
              <label class="mb-1 block text-sm font-semibold text-slate-700">Reviewer name</label>
              <input id="content-byline-name" type="text" placeholder="Jane Smith" class="w-full rounded-md border border-slate-300 px-4 py-2" />
            </div>
            <div>
              <label class="mb-1 block text-sm font-semibold text-slate-700">Reviewer credential (optional)</label>
              <input id="content-byline-credential" type="text" placeholder="LCSW, Owner/Director" class="w-full rounded-md border border-slate-300 px-4 py-2" />
            </div>
            <div>
              <label class="mb-1 block text-sm font-semibold text-slate-700">Date updated</label>
              <input id="content-byline-date" type="date" class="w-full rounded-md border border-slate-300 px-4 py-2" />
            </div>
            <button
              id="content-byline-save-button"
              type="button"
              class="rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
            >
              Save byline
            </button>
            <p id="content-byline-status" class="text-sm" role="status"></p>
          </div>
        </div>
      </div>
    </section>

    <section id="your-suggestions-section" class="hidden">
      <h2 class="mb-4 font-[family-name:var(--font-heading)] text-xl font-extrabold text-brand-ink">Your suggestions</h2>
      <p class="mb-4 text-sm text-slate-600">
        Edits you've suggested for locked fields, and their status.
      </p>
      <div id="your-suggestions-list" class="space-y-3"></div>
    </section>
  </div>

  <UnsplashSearchModal />
</AdminLayout>

<script>
  import { supabase, initAdminAuth, type AdminUser } from '../../../lib/adminAuth';
  import { initRichTextEditor } from '../../../lib/richTextEditor';
  import { renderCopy } from '../../../lib/markdown';
  import { triggerRebuild } from '../../../lib/publishFunction';
  import { initUnsplashSearchModal, type UnsplashPhoto } from '../../../lib/unsplashSearch';
  import { STORYBRAND_SPLIT_PAGE_TYPES } from '../../../lib/pages';
  import { getPersonEntityTerms } from '../../../lib/schema';
  import { VALUE_ADD_ICON_NAMES } from '../../../lib/icons';

  type ContentPage = {
    id: string;
    title: string;
    page_type: string;
    nav_placement: 'primary' | 'footer' | 'utility' | 'none';
    h1: string | null;
    meta_description: string | null;
    focus_keyword: string | null;
    hero_subhead: string | null;
    hero_headline: string | null;
    copy: string | null;
    storybrand_problem: string | null;
    storybrand_guide_empathy: string | null;
    storybrand_pitch: string | null;
    storybrand_pitch_label: string | null;
    storybrand_success: string | null;
    storybrand_failure: string | null;
    value_add_items: { icon: string; label: string }[];
    guide_authority_stats: { label: string; value: string }[];
    featured_on_homepage: boolean;
    homepage_feature_order: number | null;
    brandscript_one_liner: string | null;
    brandscript_teaser: string | null;
    brandscript_full: string | null;
    brandscript_video_url: string | null;
    footer_column: 'explore' | 'company' | 'legal' | null;
    plan_steps: { title: string; description: string }[];
    faqs: { question: string; answer: string }[];
    concerns: { title: string; description: string }[];
    cta_heading: string | null;
    cta_subheading: string | null;
    cta_button_text: string | null;
    images: {
      hero?: { url: string; alt: string; creditName?: string; creditUrl?: string };
      headshot?: { url: string; alt: string; creditName?: string; creditUrl?: string };
    } | null;
    author_name: string | null;
    credentials: string | null;
    date_modified: string | null;
    // Counselor Profile's own quote (CounselorQuote.astro) — shared
    // columns with Homepage's third-party Testimonial.astro, edited here
    // only when page_type === 'Counselor Profile' (see the ungated
    // markup block and loadContentForm()'s own comment on why).
    testimonial_quote: string | null;
    testimonial_author: string | null;
    hero_style: 'default' | 'overlay';
    hero_overlay_color: string;
    hero_overlay_opacity: number;
    hero_image_focal_y: 'top' | 'center' | 'bottom';
    // Not edited on this screen (Counselor settings owns these) — fetched
    // only so getPersonEntityTerms() can read them for the counselor-
    // facing guidance panel below.
    professional_title: string | null;
    specialties: { label: string; page_slug: string | null }[];
    modalities: string[];
  };

  // Which page types each "Additional page elements" field applies to —
  // sourced by grepping every src/templates/*.astro file for these exact
  // column names, not guessed from the reference docs (which turned out to
  // have drifted from the actual code on at least one of these). Keep this
  // in sync if a future template starts or stops reading one of these
  // fields.
  // Only Counselor Profile has a name (page.title) that can stand in for
  // the heading when this is unset — every other page type's H1 already
  // falls back to page.title in a way that reads correctly on its own
  // (a business name, a service name), so this field is scoped narrowly
  // rather than offered everywhere STORYBRAND_SPLIT_PAGE_TYPES covers.
  const HERO_HEADLINE_PAGE_TYPES = ['Counselor Profile'];
  const PLAN_STEPS_PAGE_TYPES = ['Counselor Profile', 'Homepage', 'Service Area', 'Service Hub', 'Service Page'];
  const FAQS_PAGE_TYPES = ['Content Pillar', 'Counselor Profile', 'Service Area', 'Service Hub', 'Service Page'];
  // 'Homepage' removed 2026-09-16 — the Homepage rebuild dropped the
  // FeatureGrid/concerns rendering entirely (superseded by the Value Add
  // strip + Value Proposition + Guide/Authority sections), so this field
  // was a real "editable but nothing renders it" gap until this fix.
  const CONCERNS_PAGE_TYPES = ['Service Hub'];
  // Which page types can be featured on the Homepage's Featured Services
  // section — see 0049_featured_services.sql.
  const FEATURED_SERVICE_PAGE_TYPES = ['Service Page', 'Service Hub'];
  const CTA_PAGE_TYPES = [
    'About',
    'Blog Post',
    'Content Pillar',
    'Counselor Profile',
    'Counselors Overview',
    'Homepage',
    'Service Area',
    'Service Areas Overview',
    'Service Hub',
    'Service Page',
    'Services Overview',
    'Who We Serve',
  ];

  type Business = {
    id: string;
    content_permission_level: 'restricted' | 'full';
  };

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  let business: Business | null = null;
  let pages: ContentPage[] = [];
  let currentUserId: string | null = null;
  let currentAdminUser: AdminUser | null = null;
  let selectedContentPage: ContentPage | null = null;
  let uploadedImageUrl: string | null = null;
  let uploadedImageCreditName: string | null = null;
  let uploadedImageCreditUrl: string | null = null;

  function populatePagePicker(select: HTMLSelectElement) {
    select.innerHTML = pages
      .map((p) => `<option value="${p.id}">${escapeHtml(p.title)}</option>`)
      .join('');
  }

  // ---------------------------------------------------------------------
  // Page copy — H1/meta description/focus keyword are locked on every
  // plan; hero subheading/copy/hero image are locked unless
  // business.content_permission_level is 'full'. A locked field gets a
  // "Suggest an edit" affordance (content_suggestions) instead of a
  // direct save — see 0011_content_permission_and_suggestions.sql, which
  // enforces this server-side too, not just in this UI.
  // ---------------------------------------------------------------------
  const contentTierNote = document.getElementById('content-tier-note')!;
  const contentPageSelect = document.getElementById('content-page-select') as HTMLSelectElement;
  const contentFields = document.getElementById('content-fields')!;
  const contentH1Wrap = document.getElementById('content-h1-wrap')!;
  const contentH1 = document.getElementById('content-h1') as HTMLInputElement;
  const contentMetaDescription = document.getElementById('content-meta-description') as HTMLTextAreaElement;
  const contentFocusKeyword = document.getElementById('content-focus-keyword') as HTMLInputElement;
  const contentHeroSubhead = document.getElementById('content-hero-subhead') as HTMLInputElement;
  const contentHeroHeadlineWrap = document.getElementById('content-hero-headline-wrap')!;
  const contentHeroHeadline = document.getElementById('content-hero-headline') as HTMLInputElement;
  const contentStorybrandPitchLabel = document.getElementById('content-storybrand-pitch-label') as HTMLInputElement;
  const copyEditor = initRichTextEditor('content-copy-editor');
  const contentPlainCopyWrap = document.getElementById('content-plain-copy-wrap')!;
  const contentStorybrandFields = document.getElementById('content-storybrand-fields')!;
  const storybrandProblemEditor = initRichTextEditor('content-storybrand-problem-editor');
  const storybrandGuideEmpathyEditor = initRichTextEditor('content-storybrand-guide-empathy-editor');
  const storybrandPitchEditor = initRichTextEditor('content-storybrand-pitch-editor');
  const storybrandSuccessEditor = initRichTextEditor('content-storybrand-success-editor');
  const storybrandFailureEditor = initRichTextEditor('content-storybrand-failure-editor');

  // Homepage-specific relabeling — same field/column as Service Page/
  // Counselor Profile's "The Problem"/"The Full Picture", different
  // admin-facing copy for Homepage rows only (see loadContentForm()).
  const contentStorybrandProblemFieldLabel = document.getElementById('content-storybrand-problem-field-label')!;
  const contentStorybrandProblemHelp = document.getElementById('content-storybrand-problem-editor-help')!;
  const contentStorybrandPitchFieldLabel = document.getElementById('content-storybrand-pitch-field-label')!;
  const contentStorybrandPitchHelp = document.getElementById('content-storybrand-pitch-editor-help')!;
  const contentStorybrandPitchLabelFieldLabel = document.getElementById('content-storybrand-pitch-label-field-label')!;
  const contentStorybrandPitchLabelHelp = document.getElementById('content-storybrand-pitch-label-help')!;

  // Fields shared by Homepage and Counselor Profile from the StoryBrand
  // rebuild (originally Homepage-only; Counselor Profile joined
  // 2026-09-16).
  const contentValueAddWrap = document.getElementById('content-value-add-wrap')!;
  const contentAuthorityStatsWrap = document.getElementById('content-authority-stats-wrap')!;
  const contentExplanatoryWrap = document.getElementById('content-explanatory-wrap')!;
  const contentBrandscriptOneLiner = document.getElementById('content-brandscript-one-liner') as HTMLInputElement;
  const contentBrandscriptTeaser = document.getElementById('content-brandscript-teaser') as HTMLTextAreaElement;
  const brandscriptFullEditor = initRichTextEditor('content-brandscript-full-editor');
  const contentBrandscriptVideoUrl = document.getElementById('content-brandscript-video-url') as HTMLInputElement;
  const contentVideoFile = document.getElementById('content-video-file') as HTMLInputElement;
  const contentVideoStatus = document.getElementById('content-video-status')!;

  // The counselor's own quote — Counselor-Profile-only, new 2026-09-16.
  // Ungated (no data-field wrapper) — see the loadContentForm() comment
  // on why this matches cta_heading's pattern, not value_add_items'.
  const contentTestimonialWrap = document.getElementById('content-testimonial-wrap')!;
  const contentTestimonialQuote = document.getElementById('content-testimonial-quote') as HTMLTextAreaElement;
  const contentTestimonialAuthor = document.getElementById('content-testimonial-author') as HTMLInputElement;

  // Refs needed to physically reorder fields for a Homepage row's real
  // page order (see applyHomepageFieldOrder()/restoreDefaultFieldOrder()
  // below) — Service Page/Counselor Profile keep the static markup order
  // below untouched, since it already matches their own templates.
  const contentHeroSubheadWrap = document.getElementById('content-hero-subhead-wrap')!;
  const contentImagesWrap = document.getElementById('content-images-wrap')!;
  const contentStorybrandProblemWrap = document.getElementById('content-storybrand-problem-wrap')!;
  const contentStorybrandPitchLabelWrap = document.getElementById('content-storybrand-pitch-label-wrap')!;
  const contentStorybrandPitchWrap = document.getElementById('content-storybrand-pitch-wrap')!;
  const contentStorybrandGuideEmpathyWrap = document.getElementById('content-storybrand-guide-empathy-wrap')!;
  const contentStorybrandSuccessWrap = document.getElementById('content-storybrand-success-wrap')!;
  const contentStorybrandFailureWrap = document.getElementById('content-storybrand-failure-wrap')!;

  // Featured Services (Service Page/Service Hub rows) + footer column
  // (any footer-placed page) — both ungated, live in the "Additional
  // page elements" section below alongside plan_steps/faqs/concerns.
  const contentFeaturedWrap = document.getElementById('content-featured-wrap')!;
  const contentFeaturedCheckbox = document.getElementById('content-featured-checkbox') as HTMLInputElement;
  const contentFeaturedOrderWrap = document.getElementById('content-featured-order-wrap')!;
  const contentFeaturedOrder = document.getElementById('content-featured-order') as HTMLInputElement;
  const contentFooterColumnWrap = document.getElementById('content-footer-column-wrap')!;
  const contentFooterColumn = document.getElementById('content-footer-column') as HTMLSelectElement;

  // Live, non-blocking count of the focus keyword's exact-match occurrences
  // across the 5 StoryBrand fields — informational only, never a hard gate.
  // keyword-usage-rules.md deliberately gives no fixed repetition target
  // ("do not chase a keyword density target"), so this shows the counselor
  // the real, current number as they write instead of us inventing one to
  // enforce. Only meaningful (and only wired up) for a linked-counselor
  // session — see isLinkedCounselorSession() below.
  const STORYBRAND_EDITORS_FOR_COUNT = [
    storybrandProblemEditor,
    storybrandGuideEmpathyEditor,
    storybrandPitchEditor,
    storybrandSuccessEditor,
    storybrandFailureEditor,
  ];
  function updateKeywordCount() {
    if (!isLinkedCounselorSession() || !selectedContentPage?.focus_keyword) {
      contentCounselorKeywordCount.textContent = '';
      return;
    }
    const keyword = selectedContentPage.focus_keyword.toLowerCase();
    const combinedText = STORYBRAND_EDITORS_FOR_COUNT.map((e) => e.editor.textContent ?? '')
      .join(' ')
      .toLowerCase();
    const count = combinedText.split(keyword).length - 1;
    contentCounselorKeywordCount.textContent =
      count === 0
        ? `Your focus keyword doesn't appear yet across these sections.`
        : `Your focus keyword appears ${count} time${count === 1 ? '' : 's'} across these sections.`;
  }
  STORYBRAND_EDITORS_FOR_COUNT.forEach((e) => e.editor.addEventListener('input', updateKeywordCount));
  const contentImageFile = document.getElementById('content-image-file') as HTMLInputElement;
  const contentImageAlt = document.getElementById('content-image-alt') as HTMLInputElement;
  const contentImageStatus = document.getElementById('content-image-status')!;
  const contentImagePreview = document.getElementById('content-image-preview') as HTMLImageElement;
  const contentHeroStyleWrap = document.getElementById('content-hero-style-wrap')!;
  const contentHeroFocalY = document.getElementById('content-hero-focal-y') as HTMLSelectElement;
  const contentHeroStyle = document.getElementById('content-hero-style') as HTMLSelectElement;
  const contentHeroOverlayControls = document.getElementById('content-hero-overlay-controls')!;
  const contentHeroOverlayColor = document.getElementById('content-hero-overlay-color') as HTMLInputElement;
  const contentHeroOverlayOpacity = document.getElementById('content-hero-overlay-opacity') as HTMLInputElement;
  const contentHeroOverlayOpacityReadout = document.getElementById('content-hero-overlay-opacity-readout')!;
  const contentSaveButton = document.getElementById('content-save-button')!;
  const contentSaveStatus = document.getElementById('content-save-status')!;
  const contentPageSelectWrap = document.getElementById('content-page-select-wrap')!;
  const contentNotLinkedNotice = document.getElementById('content-not-linked-notice')!;
  const contentCounselorGuidance = document.getElementById('content-counselor-guidance')!;
  const contentCounselorKeywordTip = document.getElementById('content-counselor-keyword-tip')!;
  const contentCounselorEntityTip = document.getElementById('content-counselor-entity-tip')!;
  const contentCounselorKeywordCount = document.getElementById('content-counselor-keyword-count')!;
  const contentBylineSection = document.getElementById('content-byline-section')!;
  const contentBylineName = document.getElementById('content-byline-name') as HTMLInputElement;
  const contentBylineCredential = document.getElementById('content-byline-credential') as HTMLInputElement;
  const contentBylineDate = document.getElementById('content-byline-date') as HTMLInputElement;
  const contentBylineSaveButton = document.getElementById('content-byline-save-button')!;
  const contentBylineStatus = document.getElementById('content-byline-status')!;

  const contentPageDetailsSection = document.getElementById('content-page-details-section')!;
  const contentPlanStepsWrap = document.getElementById('content-plan-steps-wrap')!;
  const contentFaqsWrap = document.getElementById('content-faqs-wrap')!;
  const contentConcernsWrap = document.getElementById('content-concerns-wrap')!;
  const contentCtaWrap = document.getElementById('content-cta-wrap')!;
  const contentCtaHeading = document.getElementById('content-cta-heading') as HTMLInputElement;
  const contentCtaSubheading = document.getElementById('content-cta-subheading') as HTMLTextAreaElement;
  const contentCtaButtonText = document.getElementById('content-cta-button-text') as HTMLInputElement;
  const contentDetailsSaveButton = document.getElementById('content-details-save-button')!;
  const contentDetailsSaveStatus = document.getElementById('content-details-save-status')!;

  // Generic add/remove/collect editor for a list of two-field items
  // (plan_steps, faqs, concerns all share this exact {a, b} shape under
  // different real column names) — written once and instantiated 3 times
  // below rather than hand-rolling near-identical markup/JS for each.
  function createItemListEditor(containerId: string, addButtonId: string, placeholderA: string, placeholderB: string) {
    const container = document.getElementById(containerId)!;
    const addButton = document.getElementById(addButtonId)!;

    function addRow(a = '', b = '') {
      const row = document.createElement('div');
      row.className = 'item-row flex flex-col gap-2 rounded-md border border-slate-200 bg-slate-50 p-3 sm:flex-row sm:items-start';
      row.innerHTML = `
        <div class="flex-1 space-y-2">
          <input type="text" class="item-a w-full rounded-md border border-slate-300 px-3 py-2 text-sm" placeholder="${escapeHtml(placeholderA)}" value="${escapeHtml(a)}" />
          <textarea rows="2" class="item-b w-full rounded-md border border-slate-300 px-3 py-2 text-sm" placeholder="${escapeHtml(placeholderB)}">${escapeHtml(b)}</textarea>
        </div>
        <button type="button" class="remove-item-button shrink-0 rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100">Remove</button>
      `;
      row.querySelector('.remove-item-button')!.addEventListener('click', () => row.remove());
      container.appendChild(row);
    }

    addButton.addEventListener('click', () => addRow());

    return {
      setItems(items: { a: string; b: string }[]) {
        container.innerHTML = '';
        items.forEach((item) => addRow(item.a, item.b));
      },
      getItems(): { a: string; b: string }[] {
        return Array.from(container.querySelectorAll<HTMLElement>('.item-row'))
          .map((row) => ({
            a: (row.querySelector('.item-a') as HTMLInputElement).value.trim(),
            b: (row.querySelector('.item-b') as HTMLTextAreaElement).value.trim(),
          }))
          .filter((item) => item.a || item.b);
      },
    };
  }

  // The Value Add strip's items don't fit createItemListEditor()'s plain
  // text+textarea {a,b} shape — icon is a pick from a fixed set, not free
  // text. Small variant of the same add/remove/collect pattern.
  function createIconListEditor(containerId: string, addButtonId: string) {
    const container = document.getElementById(containerId)!;
    const addButton = document.getElementById(addButtonId)!;
    const iconOptions = VALUE_ADD_ICON_NAMES.map((name) => `<option value="${name}">${name}</option>`).join('');

    function addRow(icon: string = VALUE_ADD_ICON_NAMES[0], label = '') {
      const row = document.createElement('div');
      row.className = 'item-row flex flex-col gap-2 rounded-md border border-slate-200 bg-slate-50 p-3 sm:flex-row sm:items-center';
      row.innerHTML = `
        <select class="item-icon rounded-md border border-slate-300 px-3 py-2 text-sm">${iconOptions}</select>
        <input type="text" class="item-label flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm" placeholder="Short label (e.g. &quot;Licensed Experts&quot;)" value="${escapeHtml(label)}" />
        <button type="button" class="remove-item-button shrink-0 rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100">Remove</button>
      `;
      (row.querySelector('.item-icon') as HTMLSelectElement).value = icon;
      row.querySelector('.remove-item-button')!.addEventListener('click', () => row.remove());
      container.appendChild(row);
    }

    addButton.addEventListener('click', () => {
      if (container.querySelectorAll('.item-row').length >= 4) return;
      addRow();
    });

    return {
      setItems(items: { icon: string; label: string }[]) {
        container.innerHTML = '';
        items.forEach((item) => addRow(item.icon, item.label));
      },
      getItems(): { icon: string; label: string }[] {
        return Array.from(container.querySelectorAll<HTMLElement>('.item-row'))
          .map((row) => ({
            icon: (row.querySelector('.item-icon') as HTMLSelectElement).value,
            label: (row.querySelector('.item-label') as HTMLInputElement).value.trim(),
          }))
          .filter((item) => item.label)
          .slice(0, 4);
      },
    };
  }

  const valueAddEditor = createIconListEditor('content-value-add-list', 'content-value-add-add');
  const authorityStatsEditor = createItemListEditor(
    'content-authority-stats-list',
