---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Leads | Admin" current="leads">
  <!--
    Real-data proof-of-work dashboard, computed entirely client-side from
    the same `leads` fetch the table below already does — no second
    query, no new table, no analytics tool wired in yet (see CLAUDE.md's
    "Outstanding" for the traffic/rankings tiers planned on top of this
    later). This exists so a client can see their marketing is working
    without waiting on a monthly report.
  -->
  <div class="mb-8 grid gap-4 sm:grid-cols-3">
    <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Total leads</p>
      <p id="stat-total" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
    </div>
    <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">This month</p>
      <p id="stat-this-month" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
      <p id="stat-month-change" class="mt-1 text-xs"></p>
    </div>
    <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Last month</p>
      <p id="stat-last-month" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
    </div>
  </div>

  <!--
    Deliberately separate from the "Total leads" stats above, not a 4th
    column in that grid — someone downloading a free guide is a much
    earlier-funnel signal than someone asking to be matched with a
    counselor, and folding it into "leads" would quietly inflate that
    number past what it's supposed to prove. Muted/dashed styling and its
    own heading are the visual cue that this is supplementary context,
    not part of the main lead count this page exists to protect. See
    CLAUDE.md's "Contacts vs. leads" section.
  -->
  <div id="contacts-widget" class="mb-8 hidden rounded-lg border border-dashed border-slate-300 bg-slate-50 p-5">
    <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Guide downloads (not counted as leads above)</p>
    <div class="grid gap-4 sm:grid-cols-3">
      <div>
        <p class="text-[11px] uppercase tracking-wide text-slate-400">This month</p>
        <p id="contacts-this-month" class="mt-0.5 font-[family-name:var(--font-heading)] text-2xl font-bold text-slate-700">—</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-wide text-slate-400">Last month</p>
        <p id="contacts-last-month" class="mt-0.5 font-[family-name:var(--font-heading)] text-2xl font-bold text-slate-700">—</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-wide text-slate-400">All-time conversion</p>
        <p id="contacts-conversion" class="mt-0.5 text-sm text-slate-600">—</p>
      </div>
    </div>
  </div>

  <div class="mb-8 rounded-lg border border-black/5 bg-white p-5 shadow-sm">
    <p class="mb-4 text-xs font-semibold uppercase tracking-wide text-slate-500">Leads per week (last 10 weeks)</p>
    <div id="weekly-chart" class="flex h-32 gap-2"></div>
  </div>

  <div class="mb-8 rounded-lg border border-black/5 bg-white p-5 shadow-sm">
    <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Leads by page</p>
    <div id="by-page-list" class="space-y-2 text-sm"></div>
  </div>

  <div class="mb-4 flex items-center justify-between">
    <p id="leads-count" class="text-sm text-slate-600"></p>
  </div>
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50">
        <tr>
          <th class="px-4 py-3 font-semibold">Date</th>
          <th class="px-4 py-3 font-semibold">Name</th>
          <th class="px-4 py-3 font-semibold">Email</th>
          <th class="px-4 py-3 font-semibold">Phone</th>
          <th class="px-4 py-3 font-semibold">Current site</th>
          <th class="px-4 py-3 font-semibold">Message</th>
          <th class="px-4 py-3 font-semibold">From page</th>
          <th class="px-4 py-3 font-semibold">Counselor</th>
          <th class="px-4 py-3 font-semibold">Status</th>
        </tr>
      </thead>
      <tbody id="leads-table-body"></tbody>
    </table>
  </div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth } from '../../lib/adminAuth';
  import { renderStatusSelect, initStatusSelectHandler } from '../../lib/leadStatus';

  const tableBody = document.getElementById('leads-table-body')!;
  const leadsCount = document.getElementById('leads-count')!;

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  type Lead = {
    id: string;
    created_at: string;
    name: string | null;
    email: string | null;
    phone: string | null;
    message: string | null;
    existing_website_url: string | null;
    source_page: string | null;
    status: string | null;
    preferred_counselor_page_id: string | null;
    lead_magnet_id: string | null;
  };

  // Populated in loadLeads() from a live query, not hardcoded — a
  // counselor rename/removal is reflected automatically. Empty on any
  // site that doesn't have collect_counselor_preference on, which is the
  // common case, so this is a no-op cost there.
  let counselorNames = new Map<string, string>();

  function renderDashboard(leads: Lead[]) {
    const now = new Date();
    const startOfThisMonth = new Date(now.getFullYear(), now.getMonth(), 1);
    const startOfLastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);

    const thisMonthCount = leads.filter((l) => new Date(l.created_at) >= startOfThisMonth).length;
    const lastMonthCount = leads.filter((l) => {
      const d = new Date(l.created_at);
      return d >= startOfLastMonth && d < startOfThisMonth;
    }).length;

    document.getElementById('stat-total')!.textContent = String(leads.length);
    document.getElementById('stat-this-month')!.textContent = String(thisMonthCount);
    document.getElementById('stat-last-month')!.textContent = String(lastMonthCount);

    const changeEl = document.getElementById('stat-month-change')!;
    if (lastMonthCount > 0) {
      const pct = Math.round(((thisMonthCount - lastMonthCount) / lastMonthCount) * 100);
      changeEl.textContent = `${pct > 0 ? '+' : ''}${pct}% vs last month`;
      changeEl.className = 'mt-1 text-xs ' + (pct >= 0 ? 'text-emerald-600' : 'text-red-500');
    } else if (thisMonthCount > 0) {
      changeEl.textContent = 'No leads last month';
      changeEl.className = 'mt-1 text-xs text-slate-500';
    } else {
      changeEl.textContent = '';
    }

    // Weekly chart: last 10 Monday-start weeks, bucketed client-side — no
    // SQL date_trunc needed for a dataset this small.
    const WEEKS = 10;
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const dayOfWeek = (today.getDay() + 6) % 7; // Mon=0 ... Sun=6
    const mondayThisWeek = new Date(today);
    mondayThisWeek.setDate(today.getDate() - dayOfWeek);

    const weekBuckets: { start: Date; end: Date; count: number }[] = [];
    for (let i = WEEKS - 1; i >= 0; i--) {
      const start = new Date(mondayThisWeek);
      start.setDate(mondayThisWeek.getDate() - i * 7);
      const end = new Date(start);
      end.setDate(start.getDate() + 7);
      weekBuckets.push({ start, end, count: 0 });
    }
    for (const lead of leads) {
      const d = new Date(lead.created_at);
      const bucket = weekBuckets.find((b) => d >= b.start && d < b.end);
      if (bucket) bucket.count++;
    }
    const maxWeekCount = Math.max(1, ...weekBuckets.map((b) => b.count));
    const chartEl = document.getElementById('weekly-chart')!;
    chartEl.innerHTML = weekBuckets
      .map((b) => {
        const heightPct = Math.max(Math.round((b.count / maxWeekCount) * 100), b.count > 0 ? 6 : 2);
        const label = b.start.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
        return `
      <div class="flex flex-1 flex-col items-center justify-end gap-1" title="${b.count} lead${b.count === 1 ? '' : 's'} — week of ${label}">
        <span class="text-[10px] font-semibold text-slate-500">${b.count > 0 ? b.count : ''}</span>
        <div class="w-full rounded-t bg-brand-accent" style="height: ${heightPct}%"></div>
        <span class="text-[9px] text-slate-400">${label}</span>
      </div>`;
      })
      .join('');

    // Which pages are actually converting — ties lead volume back to
    // specific content/SEO work, not just an undifferentiated total.
    const byPage = new Map<string, number>();
    for (const lead of leads) {
      const key = lead.source_page || '(unknown page)';
      byPage.set(key, (byPage.get(key) ?? 0) + 1);
    }
    const sorted = [...byPage.entries()].sort((a, b) => b[1] - a[1]);
    const byPageEl = document.getElementById('by-page-list')!;
    if (sorted.length === 0) {
      byPageEl.innerHTML = '<p class="text-slate-500">No leads yet.</p>';
    } else {
      const maxPageCount = sorted[0][1];
      byPageEl.innerHTML = sorted
        .map(
          ([page, count]) => `
      <div class="flex items-center gap-3">
        <span class="w-32 shrink-0 truncate text-slate-700">${escapeHtml(page)}</span>
        <div class="h-2 flex-1 rounded-full bg-slate-100">
          <div class="h-2 rounded-full bg-brand-accent" style="width: ${Math.round((count / maxPageCount) * 100)}%"></div>
        </div>
        <span class="w-6 shrink-0 text-right font-semibold text-brand-ink">${count}</span>
      </div>`
        )
        .join('');
    }
  }

  // Guide downloads (lead_magnet_id set) get their own widget, entirely
  // separate from renderDashboard() above — kept as raw submission counts
  // for the month-over-month numbers (consistent with how the main lead
  // stats count every submission, not distinct people), but the all-time
  // conversion stat below deliberately dedupes by email, since "did this
  // person convert" only makes sense once per person, not once per
  // download.
  function renderContactsWidget(contacts: Lead[], realLeads: Lead[]) {
    const widget = document.getElementById('contacts-widget')!;
    if (contacts.length === 0) {
      widget.classList.add('hidden');
      return;
    }
    widget.classList.remove('hidden');

    const now = new Date();
    const startOfThisMonth = new Date(now.getFullYear(), now.getMonth(), 1);
    const startOfLastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);
    const thisMonthCount = contacts.filter((c) => new Date(c.created_at) >= startOfThisMonth).length;
    const lastMonthCount = contacts.filter((c) => {
      const d = new Date(c.created_at);
      return d >= startOfLastMonth && d < startOfThisMonth;
    }).length;
    document.getElementById('contacts-this-month')!.textContent = String(thisMonthCount);
    document.getElementById('contacts-last-month')!.textContent = String(lastMonthCount);

    // "Did this contact ever also become a real lead" — matched by email,
    // deduplicated on both sides so someone who downloaded two different
    // guides (two contact rows) or submitted the appointment form twice
    // isn't double-counted in either direction.
    const norm = (email: string | null) => (email ?? '').trim().toLowerCase();
    const leadEmails = new Set(realLeads.map((l) => norm(l.email)).filter(Boolean));
    const contactEmails = new Set(contacts.map((c) => norm(c.email)).filter(Boolean));
    let converted = 0;
    for (const email of contactEmails) {
      if (leadEmails.has(email)) converted++;
    }
    const conversionEl = document.getElementById('contacts-conversion')!;
    if (contactEmails.size === 0) {
      conversionEl.textContent = '—';
    } else {
      const pct = Math.round((converted / contactEmails.size) * 100);
      conversionEl.textContent = `${contactEmails.size} download${contactEmails.size === 1 ? '' : 's'} → ${converted} became lead${converted === 1 ? '' : 's'} (${pct}%)`;
    }
  }

  // Event delegation on the table body, not a per-row listener — rows are
  // re-rendered wholesale on every loadLeads(), so a listener attached to
  // individual <select> elements would need re-binding every time anyway.
  initStatusSelectHandler(tableBody);

  async function loadLeads() {
    const { data, error } = await supabase.from('leads').select('*').order('created_at', { ascending: false });

    if (error) {
      leadsCount.textContent = 'Could not load leads: ' + error.message;
      return;
    }

    const { data: counselorPages } = await supabase
      .from('pages')
      .select('id, title')
      .eq('page_type', 'Counselor Profile');
    counselorNames = new Map((counselorPages ?? []).map((p) => [p.id, p.title]));

    // A guide download (lead_magnet_id set) is a much earlier-funnel
    // signal than someone asking to be matched with a counselor — kept
    // out of every stat/chart/table on this page so "leads" here always
    // means real appointment-request intent, not inflated by downloads.
    // See admin/crm.astro for where those live day-to-day.
    const realLeads = (data as Lead[]).filter((l) => !l.lead_magnet_id);
    const contacts = (data as Lead[]).filter((l) => l.lead_magnet_id);

    renderDashboard(realLeads);
    renderContactsWidget(contacts, realLeads);

    leadsCount.textContent = `${realLeads.length} lead${realLeads.length === 1 ? '' : 's'}`;
    tableBody.innerHTML = realLeads
      .map(
        (lead) => `
      <tr class="border-b border-slate-100 last:border-0">
        <td class="px-4 py-3 whitespace-nowrap">${new Date(lead.created_at).toLocaleDateString()}</td>
        <td class="px-4 py-3">${escapeHtml(lead.name ?? '')}</td>
        <td class="px-4 py-3">${escapeHtml(lead.email ?? '')}</td>
        <td class="px-4 py-3">${escapeHtml(lead.phone ?? '')}</td>
        <td class="px-4 py-3">${lead.existing_website_url ? `<a href="${escapeHtml(lead.existing_website_url)}" target="_blank" rel="noopener" class="text-brand-primary hover:underline">link</a>` : ''}</td>
        <td class="px-4 py-3 max-w-xs truncate" title="${escapeHtml(lead.message ?? '')}">${escapeHtml(lead.message ?? '')}</td>
        <td class="px-4 py-3">${escapeHtml(lead.source_page ?? '')}</td>
        <td class="px-4 py-3">${lead.preferred_counselor_page_id ? escapeHtml(counselorNames.get(lead.preferred_counselor_page_id) ?? 'Unknown') : ''}</td>
        <td class="px-4 py-3">${renderStatusSelect(lead.id, lead.status)}</td>
      </tr>`
      )
      .join('');
  }

  initAdminAuth(loadLeads, { allowedRoles: ['owner', 'agency'] });
</script>
