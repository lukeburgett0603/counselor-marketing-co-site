---
// rebuild/copy/14-group-practice.md. Conversion page.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Section from '../components/site/Section.astro';
import FeatureList from '../components/site/FeatureList.astro';
import ProductShot from '../components/site/ProductShot.astro';
import Faq from '../components/site/Faq.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Ph from '../components/site/Ph.astro';
import { SITE, GROUP_PRICES, BUILD_FEE, money, FREEDOM_CONVERSION } from '../lib/site';
import { withBase } from '../lib/url';
import { rootUrl, service } from '../lib/siteSchema';

const path = '/group-practice-marketing';
const description =
  "Group practice marketing that fills every clinician's caseload: per-clinician pages, lead routing, a caseload meter for each counselor, and one dashboard for the whole practice.";
const crumbs = [{ name: 'Who We Serve', path: '/who-we-serve' }, { name: 'Group Practices', path }];
const faqs = [
  { q: 'Can each counselor see their own numbers?', a: 'Yes. Counselors manage their own caseload settings; owners see the whole practice.' },
  { q: 'We have an office manager. Will they use this?', a: 'They\'ll probably use it most. The CRM and "due this week" list are built for them.' },
  { q: "We're adding clinicians. Does that change the price?", a: 'Only when you cross 5 or 10 clinicians.' },
];
const siteUrl = rootUrl(Astro.site, Astro.url);
---

<SiteLayout
  title="Group Practice Marketing | Fill Every Clinician's Caseload"
  description={description}
  path={path}
  crumbs={crumbs}
  faqs={faqs}
  schema={[service(siteUrl, { name: 'Group Practice Marketing', description, path, serviceType: 'Marketing for group counseling practices' })]}
>
  <PageHero
    eyebrow="For group practices"
    title="Every clinician's caseload full, not just yours."
    sub="Group practice marketing has a harder job: keeping a whole team busy. We do it clinician by clinician, and show you where each one stands."
    crumbs={crumbs}
    cta={{ label: SITE.auditCta, href: `${SITE.auditPath}?plan=group` }}
  />

  <Section>
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <h2 class="h2 lg:sticky lg:top-24 lg:self-start">Uneven caseloads are expensive.</h2>
      <p class="text-[17px] text-muted">
        Your most established counselors are full and turning people away. Your newest, including the associate you hired last month,
        are sitting with open hours you're paying for. Inquiries land in a shared inbox, some wait days for a reply, and no one can say
        which marketing brought in which client. When revenue dips, it's hard to tell why.
      </p>
    </div>
  </Section>

  <Section title="What's different for a group">
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
      <FeatureList
        cols={1}
        items={[
          { t: 'A page for each clinician and specialty', d: 'So the right clients find the right counselor.', icon: 'user' },
          { t: 'Lead routing', d: 'Each inquiry goes to the counselor it\'s meant for, with a "due this week" list for your intake team.', icon: 'arrows-split' },
          { t: 'A caseload meter for each counselor', d: "See who's full, who has room, and where to send the next referral.", icon: 'gauge' },
          { t: 'New clients by source and by counselor', d: 'Know which marketing fills which caseload.', icon: 'chart-line-up' },
          { t: 'Intake-team training', d: 'Your front desk learns the CRM and the fastest-reply habits.', icon: 'chalkboard-teacher' },
        ]}
      />
      <ProductShot shot="caseload" class="lg:sticky lg:top-24" />
    </div>
  </Section>

  <Section title="Pricing">
    <div class="card grid divide-y divide-line md:grid-cols-3 md:divide-x md:divide-y-0">
      {GROUP_PRICES.map((g) => (
        <div class="p-6">
          <p class="text-sm text-muted">{g.label}</p>
          <p class="mt-1 font-mono text-3xl font-medium tracking-tight text-ink">{money(g.price)}<span class="text-base text-muted">/mo</span></p>
        </div>
      ))}
      <div class="p-6">
        <p class="text-sm text-muted">11 or more clinicians</p>
        <p class="mt-1 text-2xl font-semibold tracking-tight text-ink">Custom quote</p>
      </div>
    </div>
    <p class="mt-6 max-w-3xl text-muted">
      Includes 4 articles a month, rank tracking for 60 searches, and a monthly call with Luke. Starts with a {money(BUILD_FEE)} build.
      <span class="font-medium text-ink">Self-Guided</span> ($149/mo) is also available for groups that want to run it themselves.
    </p>
    <a href={withBase('/pricing')} class="link-arrow mt-4">Compare plans <Ph name="arrow-right" class="size-4" /></a>
  </Section>

  <Section>
    <div class="card grid gap-6 p-8 md:grid-cols-[1fr_auto] md:items-center">
      <p class="text-[17px] text-muted">
        <span class="font-medium text-ink">Freedom Counseling Services</span>, a five-counselor group practice in Louisville, runs on
        this platform, with a page and a caseload meter for each counselor. {FREEDOM_CONVERSION.rate} of their inquiries have become
        clients ({FREEDOM_CONVERSION.detail}).
      </p>
      <a href={withBase('/results/freedom-counseling-services')} class="link-arrow whitespace-nowrap">Read Freedom's story <Ph name="arrow-right" class="size-4" /></a>
    </div>
  </Section>

  <Faq faqs={faqs} />
  <CtaBand title="See which clinicians have room, and how to fill it." href={`${SITE.auditPath}?plan=group`} />
</SiteLayout>
